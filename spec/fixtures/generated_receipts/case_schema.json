{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated Receipt Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "category", "intent", "receipt_kind", "expected", "render", "degradation", "assertions"],
  "allOf": [
    {
      "if": {
        "properties": {
          "receipt_kind": { "const": "receipt" }
        }
      },
      "then": {
        "properties": {
          "expected": {
            "required": [
              "store_name",
              "store_address",
              "purchased_at",
              "currency",
              "amount_basis",
              "tax_rate",
              "rounding",
              "items",
              "receipt_adjustments",
              "tax_details",
              "subtotal",
              "tax",
              "total",
              "payments",
              "payment_sum",
              "payment_method",
              "status",
              "review_reasons"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "expected": {
            "required": ["status", "review_reasons", "processing_error_code"]
          }
        }
      }
    }
  ],
  "properties": {
    "case_id": { "type": "string", "maxLength": 64, "pattern": "^g[0-9]{3}_[a-z0-9_]+$" },
    "category": { "enum": ["normal", "payment", "discount_adjustment", "tax_rounding", "ocr_anomaly", "non_receipt", "conflict", "measurement"] },
    "intent": { "type": "string" },
    "receipt_kind": { "enum": ["receipt", "non_receipt"] },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "store_name": { "type": "string" },
        "store_address": { "type": "string" },
        "purchased_at": { "type": "string" },
        "currency": { "type": "string" },
        "amount_basis": { "enum": ["tax_included", "tax_excluded", "mixed"] },
        "tax_rate": { "type": ["number", "null"] },
        "rounding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tax", "discount", "scope"],
          "properties": {
            "tax": { "enum": ["floor", "round", "ceil"] },
            "discount": { "enum": ["floor", "round", "ceil"] },
            "scope": { "type": "string" }
          }
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "unit_price", "quantity", "line_total", "tax_rate", "discount_amount"],
            "properties": {
              "name": { "type": "string" },
              "unit_price": { "type": ["number", "null"] },
              "quantity": { "type": ["number", "string", "null"], "maxLength": 64, "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$" },
              "quantity_unit_code": { "type": ["string", "null"], "maxLength": 64, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" },
              "pricing_source_kind": { "enum": ["count_unit_price", "reference_quantity_price", "explicit_line_total", null] },
              "reference_price_amount": { "type": ["number", "string", "null"], "maxLength": 64, "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$" },
              "reference_quantity": { "type": ["number", "string", "null"], "maxLength": 64, "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$" },
              "reference_quantity_unit_code": { "type": ["string", "null"], "maxLength": 64, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" },
              "reference_price_tax_inclusion": { "enum": ["gross", "net", null] },
              "original_line_total": { "type": ["integer", "null"], "minimum": 0, "maximum": 999999999 },
              "line_total": { "type": ["integer", "null"] },
              "tax_rate": { "type": ["number", "null"] },
              "discount_amount": { "type": ["integer", "null"] },
              "tax_inclusion": { "enum": ["gross", "net"] }
            }
          }
        },
        "receipt_adjustments": { "type": "array", "maxItems": 100 },
        "tax_details": { "type": "array", "maxItems": 100 },
        "subtotal": { "type": "integer" },
        "tax": { "type": "integer" },
        "total": { "type": "integer" },
        "payments": { "type": "array", "maxItems": 100 },
        "payment_sum": { "type": "integer" },
        "payment_method": { "type": "string" },
        "settlement": { "type": "object" },
        "status": { "type": "string" },
        "review_reasons": { "type": "array", "maxItems": 100 },
        "processing_error_code": { "type": ["string", "null"] },
        "measurement_projections": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_index",
              "exact_reference_amount",
              "projected_reference_line_total",
              "discount_amount",
              "discounted_source_line_total",
              "projected_gross_line_total"
            ],
            "properties": {
              "item_index": { "type": "integer", "minimum": 0, "maximum": 99 },
              "exact_reference_amount": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "required": ["numerator", "denominator"],
                "properties": {
                  "numerator": { "type": "string", "maxLength": 64, "pattern": "^(?:0|[1-9]\\d*)$" },
                  "denominator": { "type": "string", "maxLength": 64, "pattern": "^[1-9]\\d*$" }
                }
              },
              "projected_reference_line_total": { "type": ["integer", "null"], "minimum": 0, "maximum": 999999999 },
              "discount_amount": { "type": ["integer", "null"], "minimum": 0, "maximum": 999999999 },
              "discounted_source_line_total": { "type": ["integer", "null"], "minimum": 0, "maximum": 999999999 },
              "projected_gross_line_total": { "type": ["integer", "null"], "minimum": 0, "maximum": 999999999 }
            }
          }
        },
        "reference_pricing_candidates": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item_index", "validation_state", "rejection_reasons"],
            "properties": {
              "item_index": { "type": "integer", "minimum": 0, "maximum": 99 },
              "validation_state": { "enum": ["valid", "missing", "ambiguous", "unsupported", "none"] },
              "rejection_reasons": {
                "type": "array",
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "missing_reference_price",
                    "missing_reference_quantity",
                    "missing_reference_unit",
                    "missing_purchased_quantity",
                    "missing_purchased_unit",
                    "ambiguous_reference_expression",
                    "ambiguous_purchased_quantity",
                    "ambiguous_tax_inclusion",
                    "unsupported_reference_unit",
                    "unsupported_purchased_unit",
                    "incompatible_unit_dimension",
                    "invalid_reference_price",
                    "invalid_reference_quantity",
                    "invalid_purchased_quantity",
                    "reference_price_out_of_bounds",
                    "reference_quantity_out_of_bounds",
                    "purchased_quantity_out_of_bounds",
                    "evidence_outside_item",
                    "insufficient_component_evidence"
                  ]
                }
              },
              "reference_price_amount": { "type": ["string", "null"], "maxLength": 64, "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$" },
              "reference_quantity": { "type": ["string", "null"], "maxLength": 64, "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$" },
              "reference_unit_code": { "type": ["string", "null"], "maxLength": 64, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" },
              "purchased_quantity": { "type": ["string", "null"], "maxLength": 64, "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$" },
              "purchased_unit_code": { "type": ["string", "null"], "maxLength": 64, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" },
              "reference_price_tax_inclusion": { "enum": ["gross", "net", "unknown", null] },
              "projected_line_total": { "type": ["integer", "null"], "minimum": 0, "maximum": 999999999 },
              "printed_line_total": { "type": ["string", "null"], "maxLength": 64, "pattern": "^(?:0|[1-9]\\d*)$" },
              "rounding_matches": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "enum": ["floor", "half_up", "ceil"] } }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "items"],
      "properties": {
        "context": { "enum": ["analysis", "manual", "edit_save"] },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item_index", "printed_lines", "purchased_quantity", "purchased_unit"],
            "properties": {
              "item_index": { "type": "integer", "minimum": 0, "maximum": 99 },
              "printed_lines": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" } },
              "purchased_quantity": { "type": ["string", "null"], "maxLength": 64, "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$" },
              "purchased_unit": { "type": ["string", "null"], "maxLength": 64, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" },
              "reference_price_amount": { "type": ["string", "null"], "maxLength": 64, "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$" },
              "reference_quantity": { "type": ["string", "null"], "maxLength": 64, "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$" },
              "reference_unit": { "type": ["string", "null"], "maxLength": 64, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$" },
              "reference_price_tax_inclusion": { "enum": ["gross", "net", "unknown", null] },
              "printed_line_total": { "type": ["integer", "null"], "minimum": 0, "maximum": 999999999 },
              "discount_rate": { "type": ["string", "null"], "maxLength": 64, "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$" },
              "discount_amount": { "type": ["integer", "null"], "minimum": 0, "maximum": 999999999 }
            }
          }
        }
      }
    },
    "render": { "type": "object" },
    "degradation": { "type": "object" },
    "assertions": { "type": "object" }
  }
}
