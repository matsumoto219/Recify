<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <style>
      :root { color-scheme: light; supported-color-schemes: light; }
      body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
      table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
      table { border-collapse: collapse; }
      img { border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
      a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; }
      @media screen and (max-width: 600px) {
        .mailer-shell { padding: 22px 12px !important; }
        .mailer-brand { padding: 0 0 14px !important; }
        .mailer-panel-content { padding: 34px 24px !important; }
      }
    </style>
  </head>

  <body bgcolor="#f5f7fb" style="margin: 0; padding: 0; width: 100%; background-color: #f5f7fb; color: #4d4b5f; color-scheme: light; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#f5f7fb" style="width: 100%; background-color: #f5f7fb; color: #4d4b5f; color-scheme: light;">
      <tr>
        <td class="mailer-shell" align="center" style="padding: 28px 16px;">
          <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="width: 100%; max-width: 600px;">
            <tr>
              <td class="mailer-brand" align="left" style="padding: 0 0 16px;">
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse;">
                  <tr>
                    <td valign="middle" width="32" style="width: 32px; padding: 0 4px 0 0;">
                      <% if mailer_brand_icon_url.present? %>
                        <%= image_tag mailer_brand_icon_url,
                                      alt: "",
                                      width: 28,
                                      height: 28,
                                      class: "mailer-brand-icon",
                                      style: "display: block; width: 28px; height: 28px; max-width: 28px; border: 0; outline: none; text-decoration: none;" %>
                      <% else %>
                        <span class="mailer-brand-icon-fallback" aria-hidden="true" style="display: inline-block; width: 28px; height: 28px; border-radius: 8px; background-color: #4b4dd8; color: #ffffff; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 16px; font-weight: 700; line-height: 28px; text-align: center;">R</span>
                      <% end %>
                    </td>
                    <td valign="middle" style="padding: 0;">
                      <p style="margin: 0; color: #4b4dd8; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 28px; font-weight: 700; line-height: 1.1;">
                        <%= t("auth.mailer.layout.app_name") %>
                      </p>
                      <p style="margin: 3px 0 0; color: #777184; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 13px; font-weight: 700; line-height: 1.4;">
                        <%= t("auth.mailer.layout.tagline") %>
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td align="center" style="padding: 0;">
                <table class="mailer-panel" role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="width: 100%; background-color: #ffffff; color: #4d4b5f; color-scheme: light; border: 1px solid #f0f0f0; border-radius: 12px; border-collapse: separate; border-spacing: 0; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05); overflow: hidden;">
                  <tr>
                    <td class="mailer-panel-content" style="padding: 44px 40px;">
                      <%= yield %>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td height="32" style="height: 32px; font-size: 32px; line-height: 32px;">&nbsp;</td>
            </tr>

            <tr>
              <td align="center" style="padding: 0 24px;">
                <p style="margin: 0; color: #8b8798; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 12px; line-height: 1.7;">
                  <%= t("auth.mailer.layout.footer_notice") %>
                </p>
                <p style="margin: 12px 0 0; color: #9a96a7; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 12px; line-height: 1.5;">
                  <%= t("auth.mailer.layout.copyright", year: Time.current.year) %>
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
