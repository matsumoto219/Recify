<!DOCTYPE html>
<html
  lang="<%= I18n.locale %>"
  data-theme="<%= user_signed_in? ? current_user.theme_preference : 'system' %>">
  <head>
    <title><%= public_meta_page? ? page_meta_title : (content_for(:title) || t("meta.site_name", default: "Recify")) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Recify">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#e8e9ff" data-browser-chrome-theme-color>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512">
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#C0C1FF">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= render_robots_meta_tags %>
    <%= render_public_meta_tags %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= yield :head %>
    <%= javascript_importmap_tags %>

    <%# フォント %>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">
  </head>

  <body
    data-controller="email-address-copy"
    data-action="copy->email-address-copy#copy"
    data-theme-preference="<%= user_signed_in? ? current_user.theme_preference : 'system' %>">
    <% show_dashboard_shell = user_signed_in? && !public_layout_page? %>

    <div
      id="flash"
      class="fixed top-4 md:top-20 left-1/2 -translate-x-1/2 md:left-auto md:right-4 md:translate-x-0 z-[9999] flex flex-col gap-3 pointer-events-none w-full max-w-[calc(100%-2rem)] md:max-w-sm"
      data-notice-surface-container
      data-notice-surface-max-visible="5">
      <%= render "shared/ui/feedback/flash" %>
      <%# 非同期broadcast済みjobとの互換性を保つ共通stackの受付口 %>
      <div id="toast-stream" class="contents"></div>
    </div>

    <%= render "shared/noscript_banner" unless show_dashboard_shell %>

    <%= render "shared/ui/feedback/confirm_dialog" %>

    <% if show_dashboard_shell %>
      <%= render "layouts/dashboard_shell" do %>
        <%= yield %>
      <% end %>
    <% else %>
      <%= render "shared/public_header" if public_header_page? %>

      <main class="token-bg-page min-h-screen">
        <%= yield %>
      </main>

      <%= render "shared/footer" %>
    <% end %>
  </body>
</html>
