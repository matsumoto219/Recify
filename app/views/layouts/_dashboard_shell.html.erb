<div class="relative isolate flex min-h-screen token-bg-page">
  <%= render "shared/ui/ambient_background" %>

  <!-- サイドバー（デスクトップ用） -->
  <%= render "shared/sidebar" %>

  <div class="relative z-10 md:ml-20 xl:ml-64 flex flex-col min-h-screen w-full" data-controller="search">
    <!-- ヘッダー（上部固定ナビ） -->
    <%= render "shared/header" %>
    <%= render "shared/mobile_search_overlay" %>
    <%= render "shared/notifications/dropdown_overlay" if user_signed_in? %>

    <!-- メインコンテンツ（各ページの内容が入る） -->
    <main class="
      mt-16 p-4 md:p-10 flex-1 flex flex-col
      <%= content_for?(:mobile_bottom_actions) ? 'pb-55' : 'pb-28' %>
      md:pb-10
    ">
      <%= yield %>
    </main>
  </div>
</div>

<!-- モバイル用下部ナビゲーション -->
<%= render "shared/mobile_bottom_nav" %>
