<!doctype html>
<html lang="en">
  <head>
    <title>Service Available - Recify</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1, viewport-fit=cover">
    <meta name="robots" content="noindex, nofollow">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#e8e9ff">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <style>
      :root {
        color-scheme: light;
        --bg-page: #fafafa;
        --bg-card: #ffffff;
        --bg-subtle: #f4f4f4;
        --text-base: #1c1b1b;
        --text-muted: #464555;
        --brand: #4b4dd8;
        --border: rgba(199, 196, 216, 0.35);
        --shadow: 0 20px 40px rgba(49, 48, 192, 0.08), 0 0 0 1px rgba(49, 48, 192, 0.06);
        --glow-a: rgba(138, 140, 255, 0.14);
        --glow-b: rgba(75, 77, 216, 0.1);
      }

      @media (prefers-color-scheme: dark) {
        :root {
          color-scheme: dark;
          --bg-page: #131313;
          --bg-card: #201f1f;
          --bg-subtle: #1c1b1b;
          --text-base: #e5e2e1;
          --text-muted: #c7c4d8;
          --brand: #c0c1ff;
          --border: rgba(255, 255, 255, 0.06);
          --shadow: 0 20px 40px rgba(49, 46, 129, 0.35), 0 0 0 1px rgba(229, 226, 225, 0.05);
          --glow-a: rgba(192, 193, 255, 0.16);
          --glow-b: rgba(75, 77, 216, 0.12);
        }
      }

      *, *::before, *::after { box-sizing: border-box; }
      * { margin: 0; }

      body {
        min-height: 100dvh;
        background:
          radial-gradient(circle at top left, var(--glow-a), transparent 28rem),
          radial-gradient(circle at bottom right, var(--glow-b), transparent 30rem),
          var(--bg-page);
        color: var(--text-base);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      main {
        display: grid;
        min-height: 100dvh;
        place-items: center;
        padding: 2rem 1rem;
      }

      .card {
        width: min(100%, 28rem);
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        background: var(--bg-card);
        box-shadow: var(--shadow);
        padding: 2rem;
        text-align: center;
      }

      .mark {
        display: grid;
        width: 4.5rem;
        height: 4.5rem;
        margin: 0 auto 1.5rem;
        place-items: center;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--bg-subtle);
        color: var(--brand);
      }

      .mark svg {
        width: 2.25rem;
        height: 2.25rem;
      }

      h1 {
        font-size: 1.5rem;
        line-height: 2rem;
        letter-spacing: 0;
      }

      p {
        margin-top: 0.75rem;
        color: var(--text-muted);
        font-size: 0.9375rem;
        line-height: 1.75rem;
      }
    </style>
  </head>
  <body>
    <main>
      <section class="card" aria-labelledby="health-title">
        <div class="mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img" focusable="false">
            <path fill="currentColor" d="M9.55 17.2 4.8 12.45l1.4-1.4 3.35 3.35 8.25-8.25 1.4 1.4z" />
          </svg>
        </div>
        <h1 id="health-title">Recify</h1>
        <p>Service is available.</p>
      </section>
    </main>
  </body>
</html>
