<h2 style="margin: 0 0 16px; color: #1c1b1b; font-size: 20px;">
  <%= t("contact_requests.mailer.auto_reply.title") %>
</h2>

<p style="margin: 0 0 16px; color: #4d4b5f; font-size: 14px; line-height: 1.7;">
  <%= t("auth.mailer.greeting", email: @recipient_name) %>
</p>

<p style="margin: 0 0 20px; color: #4d4b5f; font-size: 14px; line-height: 1.7;">
  <%= t("contact_requests.mailer.auto_reply.description") %>
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse; margin: 0 0 20px;">
  <tbody>
    <tr>
      <th align="left" style="padding: 8px 0; color: #777184; font-size: 12px;"><%= t("contact_requests.mailer.auto_reply.fields.request_uid") %></th>
      <td style="padding: 8px 0; color: #1c1b1b; font-size: 14px;"><%= @contact_request.request_uid %></td>
    </tr>
    <tr>
      <th align="left" style="padding: 8px 0; color: #777184; font-size: 12px;"><%= t("contact_requests.mailer.auto_reply.fields.created_at") %></th>
      <td style="padding: 8px 0; color: #1c1b1b; font-size: 14px;"><%= @created_at %></td>
    </tr>
    <tr>
      <th align="left" style="padding: 8px 0; color: #777184; font-size: 12px;"><%= t("contact_requests.mailer.auto_reply.fields.category") %></th>
      <td style="padding: 8px 0; color: #1c1b1b; font-size: 14px;"><%= t("contact_requests.categories.#{@contact_request.category}") %></td>
    </tr>
    <tr>
      <th align="left" style="padding: 8px 0; color: #777184; font-size: 12px;"><%= t("contact_requests.mailer.auto_reply.fields.subject") %></th>
      <td style="padding: 8px 0; color: #1c1b1b; font-size: 14px;"><%= @contact_request.subject %></td>
    </tr>
  </tbody>
</table>

<p style="margin: 0; color: #6b687a; font-size: 13px; line-height: 1.6;">
  <%= t("contact_requests.mailer.auto_reply.body_notice") %>
</p>
