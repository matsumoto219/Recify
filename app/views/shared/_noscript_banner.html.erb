<%#
  JavaScript 無効時の案内バナー

  必須:
  - なし

  任意:
  - layout: 表示場所に応じた余白・枠線の種類。:page / :dashboard。未指定時は :page
%>

<%
  layout = local_assigns.fetch(:layout, :page).to_sym
  banner_classes = case layout
                   when :dashboard
                     "relative z-30 mb-6 rounded-xl border token-border-soft token-bg-card px-4 py-3 token-text-base shadow-sm"
                   else
                     "relative z-30 border-b token-border-soft token-bg-card px-4 py-3 token-text-base shadow-sm"
                   end
%>

<noscript>
  <div class="<%= banner_classes %>">
    <div class="mx-auto max-w-5xl text-center">
      <p class="text-sm font-bold"><%= t("shared.noscript.title") %></p>
      <p class="mt-1 text-sm leading-relaxed token-text-muted"><%= t("shared.noscript.body") %></p>
    </div>
  </div>
</noscript>
