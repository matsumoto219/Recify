<div id="notifications-dropdown"
  class="hidden fixed left-4 right-4 top-[calc(4rem+env(safe-area-inset-top)+0.75rem)] z-50 -translate-y-2 opacity-0 notification-dropdown-motion transition-transform transition-opacity duration-200 ease-out will-change-transform sm:left-auto sm:right-4 md:right-8 sm:w-96 sm:max-w-[calc(100vw-2rem)]"
  role="dialog"
  aria-label="通知">
  <%= render "shared/notifications/dropdown",
    notifications: current_user.notifications.recent.limit(5) %>
</div>
