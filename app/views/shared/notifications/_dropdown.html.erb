<%
  notifications = Array(local_assigns.fetch(:notifications, []))
%>

<div class="glass-panel flex max-h-[min(70vh,28rem)] w-full flex-col overflow-hidden rounded-2xl token-text-base">
  <div class="flex items-center justify-between border-b token-border-glass px-4 py-3">
    <h3 class="text-sm font-bold token-text-base">通知</h3>
  </div>

  <div class="max-h-80 overflow-y-auto">
    <% if notifications.any? %>
      <%= render partial: "shared/notifications/dropdown_item",
        collection: notifications,
        as: :notification %>
    <% else %>
      <div class="px-4 py-8 text-center">
        <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full notice-icon-info">
          <span class="material-symbols-outlined text-[20px]" aria-hidden="true">notifications</span>
        </div>
        <p class="mt-3 text-sm font-semibold token-text-base">通知はありません</p>
        <p class="mt-1 text-xs token-text-muted">通知内容はここに表示されます。</p>
      </div>
    <% end %>
  </div>

  <div class="border-t token-border-glass px-3 py-3 text-center">
    <%= link_to "すべて見る",
      notifications_path,
      class: "inline-flex items-center justify-center rounded-lg px-3 py-2 text-xs font-bold token-text-brand header-text-hover transition-colors" %>
  </div>
</div>
