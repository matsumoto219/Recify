<%#
  通知ドロップダウン外枠

  必須:
  - なし

  任意:
  - notifications: ドロップダウンに表示する通知コレクション。未指定時は空配列
%>

<%
  notifications = Array(local_assigns.fetch(:notifications, []))
%>

<div data-notification-dropdown-surface class="glass-panel notification-dropdown-panel notification-dropdown-motion flex max-h-[min(70vh,28rem)] w-full flex-col overflow-hidden rounded-2xl token-text-base transition-transform transition-opacity duration-200 ease-out will-change-transform">
  <div data-notification-dropdown-motion class="-translate-y-2 opacity-0 notification-dropdown-motion transition-transform transition-opacity duration-200 ease-out will-change-transform">
    <%= render "shared/notifications/dropdown_content", notifications: notifications %>
  </div>
</div>
