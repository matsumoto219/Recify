<%#
  通知ドロップダウン項目

  必須:
  - notification: 表示する通知オブジェクト

  任意:
  - なし
%>

<%
  item_state = notification_dropdown_item_state(notification)
%>

<div class="<%= item_state.item_classes %>">
  <%= link_to item_state.read_path,
    class: "flex min-w-0 flex-1 gap-3",
    data: { turbo_method: :patch } do %>
    <div class="mt-0.5 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full <%= item_state.icon_class %>">
      <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;" aria-hidden="true"><%= item_state.icon %></span>
    </div>

    <div class="min-w-0 flex-1">
      <div class="flex items-start gap-2">
        <p class="min-w-0 flex-1 truncate text-[13px] font-semibold token-text-base" data-notification-dropdown-item-title>
          <%= notification.title %>
        </p>

        <% if item_state.unread? %>
          <span class="mt-1.5 h-2 w-2 flex-shrink-0 rounded-full token-state-error-soft" aria-label="<%= t("shared.notifications.unread_aria") %>"></span>
        <% end %>
      </div>

      <% if notification.body.present? %>
        <p class="mt-1 line-clamp-2 text-[12px] leading-relaxed token-text-muted">
          <%= notification.body %>
        </p>
      <% end %>

      <% if item_state.stale_notifiable? %>
        <p class="mt-1 text-[12px] token-text-subtle">
          <%= t("notifications.item.deleted_target") %>
        </p>
      <% end %>

      <p class="mt-1 text-[10px] token-text-subtle">
        <%= l(notification.created_at, format: :short) %>
      </p>
    </div>
  <% end %>

  <%= button_to notification_path(notification),
    method: :delete,
    form: { class: "contents" },
    data: item_state.delete_confirm_data,
    class: "ui-touch-control mt-0.5 inline-flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-lg token-text-muted header-text-error-hover transition-colors",
    aria: { label: t("notifications.item.delete_aria", title: notification.title) },
    title: t("notifications.item.delete_aria", title: notification.title) do %>
    <span class="material-symbols-outlined text-[17px]" aria-hidden="true">close</span>
  <% end %>
</div>
