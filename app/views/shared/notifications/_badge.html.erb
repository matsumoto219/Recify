<%#
  通知未読バッジ

  必須:
  - unread_count: 未読通知数

  任意:
  - なし
%>

<%
  count = unread_count.to_i
  label = count > 99 ? "99+" : count.to_s
%>

<span id="notifications_unread_badge">
  <% if count.positive? %>
    <span
      class="absolute -right-1 -top-1 min-w-5 rounded-full token-state-error-soft px-1.5 py-0.5 text-center text-[0.65rem] font-bold leading-none"
      aria-label="<%= t("notifications.badge.unread_label", count: count) %>"
      data-notifications-unread-badge>
      <%= label %>
    </span>
  <% end %>
</span>
