<%
  disable_with = local_assigns.fetch(:disable_with, label)
  base_classes = "w-full py-4 bg-gradient-to-r from-[#C0C1FF] to-[#4B4DD8] text-black font-bold rounded-lg transition-all shadow-lg shadow-[#C0C1FF]/10"
  interactive_classes = "hover:brightness-110 active:scale-[0.98] cursor-pointer"
  disabled_classes = "disabled:opacity-60 disabled:cursor-not-allowed"
  button_class = [base_classes, interactive_classes, disabled_classes].join(" ")
%>

<%= f.submit label,
      class: button_class,
      data: {
        disable_with: disable_with,
        turbo_submits_with: disable_with
      } %>
