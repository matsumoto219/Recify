<%
  title = local_assigns.fetch(:title)
  value = local_assigns.fetch(:value)
  subtext = local_assigns[:subtext]
  subtext_icon = local_assigns[:subtext_icon]
  subtext_icon_class = local_assigns.fetch(:subtext_icon_class, "text-[#C7C4D8]")
  accent_color = local_assigns.fetch(:accent_color, "#C0C1FF")
  title_id = local_assigns[:title_id]
  value_id = local_assigns[:value_id]
  subtext_id = local_assigns[:subtext_id]
  value_data = local_assigns.fetch(:value_data, {})
  subtext_data = local_assigns.fetch(:subtext_data, {})
  title_data = local_assigns.fetch(:title_data, {})
  action_label = local_assigns[:action_label]
  action_onclick = local_assigns[:action_onclick]
  action_data = local_assigns.fetch(:action_data, {})
  extra_class = local_assigns[:class]

  card_classes = [
    "p-5",
    extra_class
  ].compact.join(" ")
%>

<%= render "shared/ui/surface_card",
  class: card_classes,
  background_class: "bg-[#201F1F]",
  accent_side: :left,
  accent_color: accent_color,
  hoverable: false do %>
  <%# NOTE: 旧外枠 `rounded-xl` は surface_card 側のクラスへ置き換え。 %>
  <%# NOTE: 旧背景 `bg-[#201F1F]` と旧左アクセント `border-l-2` / `border-left-color` は surface_card の background_class / accent_side / accent_color オプションで維持。 %>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0 flex-1">
      <p id="<%= title_id %>"
        class="truncate text-[0.6875rem] uppercase tracking-widest text-[#C7C4D8] font-bold"
        <% title_data.each do |key, data_value| %>
          data-<%= key.to_s.dasherize %>="<%= data_value %>"
        <% end %>>
        <%= title %>
      </p>
    </div>

    <% if action_label.present? %>
      <button type="button"
        class="text-[0.6875rem] font-bold text-[#C0C1FF] hover:text-white transition-colors shrink-0"
        <% action_data.each do |key, data_value| %>
          data-<%= key.to_s.dasherize %>="<%= data_value %>"
        <% end %>
        <% if action_onclick.present? %> onclick="<%= action_onclick %>"<% end %>>
        <%= action_label %>
      </button>
    <% end %>
  </div>

  <p id="<%= value_id %>"
    class="truncate text-2xl font-bold mt-2 text-[#E5E2E1]"
    title="<%= value %>"
    <% value_data.each do |key, data_value| %>
      data-<%= key.to_s.dasherize %>="<%= data_value %>"
    <% end %>>
    <%= value %>
  </p>

  <% if subtext.present? %>
    <p id="<%= subtext_id %>"
      class="flex min-w-0 items-center gap-1 text-[0.6875rem] leading-none text-[#C7C4D8] mt-1"
      <% subtext_data.each do |key, data_value| %>
        data-<%= key.to_s.dasherize %>="<%= data_value %>"
      <% end %>>
      <% if subtext_icon.present? %>
        <span class="material-symbols-outlined <%= subtext_icon_class %>" style="font-size: 11px; line-height: 1;"><%= subtext_icon %></span>
      <% end %>
      <span class="min-w-0 truncate" title="<%= subtext %>"><%= subtext %></span>
    </p>
  <% end %>
<% end %>
