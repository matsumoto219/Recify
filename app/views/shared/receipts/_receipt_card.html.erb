<%
  receipt = local_assigns.fetch(:receipt)
  status_label = local_assigns[:status_label] || (receipt.respond_to?(:status_label) ? receipt.status_label : receipt.status)
  processing = receipt.status.to_s == "processing"
  display_store_name = if processing
                         receipt.store_name.presence || "解析中のレシート"
                       else
                         receipt.store_name.presence || "店舗名なし"
                       end

  card_classes = [
    "group",
    processing ? "animate-pulse" : nil
  ].compact.join(" ")

  card_surface_variant = processing ? :bg_card : :bg_elevated

  icon_box_class = [
    "w-10 h-10 rounded-lg receipt-card-icon-box flex items-center justify-center shrink-0",
    processing ? "opacity-90" : nil
  ].compact.join(" ")
%>

<%= render "shared/ui/surface_card",
  id: dom_id(receipt),
  padding: :card,
  class: card_classes,
  surface_variant: card_surface_variant,
  hoverable: !processing do %>

  <div class="flex items-start justify-between gap-4">
    <div class="flex items-start gap-3 min-w-0">
      <div class="<%= icon_box_class %>">
        <% if processing %>
          <span class="material-symbols-outlined animate-spin">autorenew</span>
        <% else %>
          <span class="material-symbols-outlined">receipt_long</span>
        <% end %>
      </div>

      <div class="min-w-0 flex-1">
        <h2 class="max-w-full font-bold token-text-base receipt-card-title-hover transition-colors truncate">
          <% if processing %>
            <span class="block truncate"><%= display_store_name %></span>
          <% else %>
            <%= link_to display_store_name, receipt_path(receipt), class: "block truncate hover:underline" %>
          <% end %>
        </h2>

        <p class="truncate text-[0.75rem] token-text-muted">
          <%= processing ? "解析完了後に表示されます" : (receipt.purchased_at ? l(receipt.purchased_at, format: :short) : "日時未設定") %>
        </p>
      </div>
    </div>

    <%= render "shared/ui/receipt_status_badge",
      status: receipt.status,
      label: status_label %>
  </div>

  <div class="flex justify-between items-end mt-2 gap-4">
    <div class="min-w-0 flex-1">
      <p class="text-[0.6875rem] token-text-muted mb-1">合計金額</p>
      <% if processing %>
        <div class="mt-2 h-7 w-24 rounded receipt-card-skeleton"></div>
      <% else %>
        <p class="truncate text-xl font-bold token-text-base" title="¥<%= number_with_delimiter(receipt.total_amount.to_i) %>">
          ¥<%= number_with_delimiter(receipt.total_amount.to_i) %>
        </p>
      <% end %>
    </div>

    <div class="flex shrink-0 items-center gap-3 text-sm">
      <% if processing %>
        <span class="token-text-subtle cursor-not-allowed">詳細</span>
        <span class="receipt-card-disabled-brand cursor-not-allowed">編集</span>
      <% else %>
        <%= link_to "詳細", receipt_path(receipt), class: "token-text-muted receipt-card-link-hover transition-colors" %>
        <%= link_to "編集", edit_receipt_path(receipt), class: "token-text-brand hover:opacity-80 transition-opacity" %>
      <% end %>
    </div>
  </div>
<% end %>
