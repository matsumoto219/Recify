<%#
  レシート一覧カード

  必須:
  - receipt: 表示するレシートオブジェクト

  任意:
  - status_label: ステータスバッジに表示する文言。未指定時は receipt の状態から取得
%>

<%
  receipt = local_assigns.fetch(:receipt)
  phase_presenter = Receipts::ProcessingPhasePresenter.new(
    receipt: receipt,
    analysis_run: local_assigns[:analysis_run]
  )
  processing = receipt.status.to_s == "processing"
  default_status_label =
    if processing
      phase_presenter.label
    elsif receipt.respond_to?(:status_label)
      receipt.status_label
    else
      receipt.status
    end
  status_label = local_assigns[:status_label] || default_status_label
  display_store_name =
    if processing
      receipt.store_name.presence || t("receipt_cards.fallback.processing_store_name")
    else
      receipt.store_name.presence || t("receipt_cards.fallback.store_name")
    end
  processing_popover_id = "receipt-processing-popover-#{receipt.public_id}" if processing
  processing_popover_title_id = "#{processing_popover_id}-title" if processing
  card_data = {
    receipt_card_public_id: receipt.public_id,
    receipt_card_state_revision: phase_presenter.state_revision,
    receipt_card_phase: phase_presenter.key,
    receipt_card_phase_order: phase_presenter.phase_order,
    receipt_card_terminal: phase_presenter.terminal?
  }
  card_data[:receipt_processing_sync_target] = "card" if processing

  card_classes = [
    "group",
    "flex",
    "flex-col",
    "receipt-card-surface",
    processing ? "receipt-processing-card" : nil,
    processing ? phase_presenter.css_class : nil
  ].compact.join(" ")

  icon_box_class = [
    "w-10 h-10 rounded-lg receipt-card-icon-box flex items-center justify-center shrink-0",
    processing ? "receipt-processing-icon-box" : nil
  ].compact.join(" ")
%>

<%= render "shared/ui/layout/surface_card",
  id: receipt_dom_id(receipt),
  data: card_data,
  padding: :card,
  class: card_classes,
  hoverable: !processing do %>

  <div class="flex min-w-0 items-start justify-between gap-4">
    <div class="flex flex-1 items-start gap-3 min-w-0">
      <div class="<%= icon_box_class %>">
        <% if processing %>
          <span class="material-symbols-outlined receipt-processing-card-icon"><%= phase_presenter.icon %></span>
        <% else %>
          <span class="material-symbols-outlined">receipt_long</span>
        <% end %>
      </div>

      <div class="min-w-0 flex-1">
        <h2 class="max-w-full font-bold token-text-base receipt-card-title-hover transition-colors truncate">
          <% if processing %>
            <span class="block truncate" title="<%= display_store_name %>"><%= display_store_name %></span>
          <% else %>
            <%= link_to display_store_name, receipt_path(receipt, from: "index"), class: "block truncate hover:underline", title: display_store_name %>
          <% end %>
        </h2>

        <p class="truncate text-[0.75rem] token-text-muted">
          <%= processing ? t("receipt_cards.fallback.processing_description") : (receipt.purchased_at ? l(receipt.purchased_at, format: :short) : t("receipt_cards.fallback.purchased_at")) %>
        </p>
      </div>
    </div>

    <%= render "shared/ui/badge/receipt_status_badge",
      status: receipt.status,
      label: status_label,
      class: "shrink-0" %>
  </div>

  <div class="flex justify-between items-end mt-auto pt-2 gap-4">
    <div class="min-w-0 flex-1">
      <p class="text-[0.6875rem] token-text-muted mb-1"><%= t("receipt_cards.labels.total_amount") %></p>
      <% if processing %>
        <div class="mt-2 h-7 w-24 rounded receipt-card-skeleton"></div>
      <% else %>
        <% total_amount_display = receipt_total_amount_display(receipt.total_amount) %>
        <p class="truncate text-xl font-bold token-text-base" title="<%= total_amount_display %>">
          <%= total_amount_display %>
        </p>
      <% end %>
    </div>

    <div class="flex shrink-0 items-center gap-3 text-sm">
      <% if processing %>
        <span class="token-text-subtle cursor-not-allowed"><%= t("receipt_cards.actions.show") %></span>
        <span class="receipt-card-disabled-brand cursor-not-allowed"><%= t("receipt_cards.actions.edit") %></span>
      <% else %>
        <%= link_to t("receipt_cards.actions.show"), receipt_path(receipt, from: "index"), class: "ui-touch-control token-text-muted receipt-card-link-hover transition-colors" %>
        <%= link_to t("receipt_cards.actions.edit"), edit_receipt_path(receipt, from: "index"), class: "ui-touch-control token-text-brand hover:opacity-80 transition-opacity" %>
      <% end %>
    </div>
  </div>

  <% if processing %>
    <div
      class="receipt-processing-popover"
      data-controller="receipt-processing-popover"
      data-receipt-processing-popover-storage-key-value="receipt-processing-popover:<%= receipt.public_id %>"
      data-receipt-processing-phase="<%= phase_presenter.key %>">
      <button
        type="button"
        class="ui-touch-control receipt-processing-trigger"
        data-receipt-processing-popover-target="trigger"
        data-action="click->receipt-processing-popover#toggle"
        aria-expanded="false"
        aria-controls="<%= processing_popover_id %>">
        <span class="receipt-processing-trigger-content">
          <span class="material-symbols-outlined receipt-processing-trigger-icon" aria-hidden="true"><%= phase_presenter.icon %></span>
          <span class="receipt-processing-trigger-copy">
            <span class="block text-sm font-bold token-text-base"><%= phase_presenter.label %></span>
            <span class="receipt-processing-trigger-hint">
              <span class="hidden sm:inline"><%= t("receipt_cards.processing_phase.click_hint") %></span>
              <span class="sm:hidden"><%= t("receipt_cards.processing_phase.tap_hint") %></span>
            </span>
          </span>

          <% if phase_presenter.ai? %>
            <span class="receipt-processing-ai-dots" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
          <% end %>
        </span>
      </button>

      <div
        id="<%= processing_popover_id %>"
        class="receipt-processing-popover-panel"
        data-receipt-processing-popover-target="panel"
        role="dialog"
        aria-modal="false"
        aria-labelledby="<%= processing_popover_title_id %>"
        tabindex="-1"
        hidden>
        <div class="receipt-processing-popover-header">
          <div class="min-w-0">
            <p class="receipt-processing-popover-eyebrow"><%= t("receipt_cards.processing_phase.current") %></p>
            <h3 id="<%= processing_popover_title_id %>" class="truncate text-sm font-bold token-text-base"><%= phase_presenter.label %></h3>
          </div>
          <button
            type="button"
            class="ui-touch-control receipt-processing-popover-close"
            data-receipt-processing-popover-close
            aria-label="<%= t("receipt_cards.processing_phase.close") %>">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
          </button>
        </div>

        <div class="receipt-processing-popover-content">
          <p class="text-xs token-text-muted"><%= phase_presenter.description %></p>

          <ol class="receipt-processing-steps mt-4" aria-label="<%= t("receipt_cards.processing_steps.label") %>">
            <% phase_presenter.steps.each do |step| %>
              <%
                step_classes = [
                  "receipt-processing-step",
                  "receipt-processing-step-#{step.state}",
                  ("receipt-processing-interval-#{step.interval_state}" if step.interval_state)
                ].compact.join(" ")
                step_aria = step.state == "active" ? { current: "step" } : nil
              %>
              <%= content_tag :li, class: step_classes, aria: step_aria do %>
                <span class="receipt-processing-step-dot" aria-hidden="true"></span>
                <span class="receipt-processing-step-label"><%= step.label %></span>
              <% end %>
            <% end %>
          </ol>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
