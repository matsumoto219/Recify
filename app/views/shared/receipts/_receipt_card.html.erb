<%
  receipt = local_assigns.fetch(:receipt)
  status_label = local_assigns[:status_label] || (receipt.respond_to?(:status_label) ? receipt.status_label : receipt.status)
  processing = receipt.status.to_s == "processing"
  display_store_name = if processing
                         receipt.store_name.presence || "解析中のレシート"
                       else
                         receipt.store_name.presence || "店舗名なし"
                       end

  card_classes = [
    "p-5 group",
    processing ? "animate-pulse" : nil
  ].compact.join(" ")

  card_background_class = processing ? "bg-[#242424]" : "bg-[#2A2A2A]"
  card_hover_class = processing ? nil : "hover:bg-[#393939]"

  icon_box_class = [
    "w-10 h-10 rounded-lg bg-[#131313] flex items-center justify-center text-[#C0C1FF] shrink-0",
    processing ? "opacity-90" : nil
  ].compact.join(" ")
%>

<%= render "shared/ui/surface_card",
  id: dom_id(receipt),
  class: card_classes,
  background_class: card_background_class,
  hover_class: card_hover_class,
  hoverable: !processing do %>
  <%# NOTE: 旧外枠 `rounded-xl`, `transition-colors`, `border border-white/5` は surface_card 側のクラスへ置き換え。 %>
  <%# NOTE: 旧背景 `bg-[#242424]` / `bg-[#2A2A2A]` と旧hover `hover:bg-[#393939]` は surface_card の background_class / hover_class オプションで復活。 %>
  <div class="flex items-start justify-between gap-4">
    <div class="flex items-start gap-3 min-w-0">
      <div class="<%= icon_box_class %>">
        <% if processing %>
          <span class="material-symbols-outlined animate-spin">autorenew</span>
        <% else %>
          <span class="material-symbols-outlined">receipt_long</span>
        <% end %>
      </div>

      <div class="min-w-0 flex-1">
        <h2 class="max-w-full font-bold text-[#E5E2E1] group-hover:text-[#C0C1FF] transition-colors truncate">
          <% if processing %>
            <span class="block truncate"><%= display_store_name %></span>
          <% else %>
            <%= link_to display_store_name, receipt_path(receipt), class: "block truncate hover:underline" %>
          <% end %>
        </h2>

        <p class="truncate text-[0.75rem] text-[#C7C4D8]">
          <%= processing ? "解析完了後に表示されます" : (receipt.purchased_at ? l(receipt.purchased_at, format: :short) : "日時未設定") %>
        </p>
      </div>
    </div>

    <%= render "shared/ui/receipt_status_badge",
      status: receipt.status,
      label: status_label %>
  </div>

  <div class="flex justify-between items-end mt-2 gap-4">
    <div class="min-w-0 flex-1">
      <p class="text-[0.6875rem] text-[#C7C4D8] mb-1">合計金額</p>
      <% if processing %>
        <div class="mt-2 h-7 w-24 rounded bg-[#3A3938]"></div>
      <% else %>
        <p class="truncate text-xl font-bold text-[#E5E2E1]" title="¥<%= number_with_delimiter(receipt.total_amount.to_i) %>">
          ¥<%= number_with_delimiter(receipt.total_amount.to_i) %>
        </p>
      <% end %>
    </div>

    <div class="flex shrink-0 items-center gap-3 text-sm">
      <% if processing %>
        <span class="text-[#C7C4D8]/60 cursor-not-allowed">詳細</span>
        <span class="text-[#C0C1FF]/50 cursor-not-allowed">編集</span>
      <% else %>
        <%= link_to "詳細", receipt_path(receipt), class: "text-[#C7C4D8] hover:text-white transition-colors" %>
        <%= link_to "編集", edit_receipt_path(receipt), class: "text-[#C0C1FF] hover:opacity-80 transition-opacity" %>
      <% end %>
    </div>
  </div>
<% end %>
