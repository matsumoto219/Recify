<section id="receipts_summary"
  class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-10"
  data-controller="receipt-summary"
  data-receipt-summary-storage-key-value="receiptAmountMode"
  data-receipt-summary-monthly-label-value="<%= t("dashboard.summary.amount.current_month_title") %>"
  data-receipt-summary-overall-label-value="<%= t("dashboard.summary.amount.overall_title") %>"
  data-receipt-summary-change-label-value="<%= t("dashboard.summary.amount.monthly_change_prefix") %>"
  data-receipt-summary-count-suffix-value="<%= t("dashboard.summary.count_suffix") %>">
  <% count_suffix = t("dashboard.summary.count_suffix") %>

  <%= render "shared/receipts/summary_card",
    title: t("dashboard.summary.total_count.title"),
    value: "#{receipts_count}#{count_suffix}",
    subtext: t("dashboard.summary.total_count.subtext"),
    value_data: {
      receipt_summary_target: "summaryValue",
      summary_key: "receipts_count",
      raw_value: receipts_count,
      suffix: count_suffix
    } %>

  <%= render "shared/receipts/summary_card",
    title: t("dashboard.summary.amount.current_month_title"),
    value: "¥#{number_with_delimiter(current_month_total)}",
    subtext: monthly_change_label,
    title_data: { receipt_summary_target: "label" },
    value_data: {
      receipt_summary_target: "value summaryValue",
      current_month_total: number_with_delimiter(current_month_total),
      overall_total: number_with_delimiter(overall_total),
      current_month_raw_value: current_month_total,
      overall_raw_value: overall_total,
      prefix: "¥"
    },
    subtext_data: {
      receipt_summary_target: "subtext",
      monthly_text: monthly_change_label,
      overall_text: t("dashboard.summary.amount.overall_subtext"),
      monthly_icon: monthly_change_icon,
      monthly_icon_class: local_assigns.fetch(:monthly_change_icon_class, "token-text-muted"),
      overall_icon: "",
      overall_icon_class: "token-text-muted"
    },
    action_label: t("dashboard.summary.amount.toggle"),
    action_data: { action: "receipt-summary#toggle" } %>

  <%= render "shared/receipts/summary_card",
    title: t("dashboard.summary.processing.title"),
    value: "#{processing_count}#{count_suffix}",
    subtext: processing_count.positive? ? t("dashboard.summary.processing.active") : t("dashboard.summary.processing.empty"),
    value_data: {
      receipt_summary_target: "summaryValue",
      summary_key: "processing_count",
      raw_value: processing_count,
      suffix: count_suffix
    } %>

  <%= render "shared/receipts/summary_card",
    title: t("dashboard.summary.review_needed.title"),
    value: "#{review_needed_count}#{count_suffix}",
    subtext: review_needed_count.positive? ? t("dashboard.summary.review_needed.active") : t("dashboard.summary.review_needed.empty"),
    accent: :warning,
    value_data: {
      receipt_summary_target: "summaryValue",
      summary_key: "review_needed_count",
      raw_value: review_needed_count,
      suffix: count_suffix
    } %>

  <%= render "shared/receipts/summary_card",
    title: t("dashboard.summary.failed.title"),
    value: "#{failed_count}#{count_suffix}",
    subtext: failed_count.positive? ? t("dashboard.summary.failed.active") : t("dashboard.summary.failed.empty"),
    accent: :error,
    value_data: {
      receipt_summary_target: "summaryValue",
      summary_key: "failed_count",
      raw_value: failed_count,
      suffix: count_suffix
    } %>
</section>
