<%
  title = local_assigns.fetch(:title)
  subtitle = local_assigns[:subtitle]
  breadcrumb_label = local_assigns[:breadcrumb_label]
  breadcrumb_path = local_assigns[:breadcrumb_path]
  icon = local_assigns[:icon]
  variant = local_assigns.fetch(:variant, :default).to_sym
  wrapper_class = local_assigns[:class]
  icon_class = local_assigns[:icon_class]
  title_size = local_assigns.fetch(:title_size, "text-lg")
  subtitle_size = local_assigns.fetch(:subtitle_size, "text-sm")
  breadcrumb_wrapper_class = "flex flex-wrap items-center text-sm text-[#C7C4D8] mb-2 space-x-2"
  breadcrumb_link_class = "text-[#C7C4D8] hover:text-[#C0C1FF] transition-colors"
  breadcrumb_current_class = "text-[#C0C1FF] font-medium"
  breadcrumb_separator_class = "text-xs text-[#C7C4D8]"

  tone = case variant
         when :danger
           {
             title: "text-[#FFB4AB]",
             subtitle: "text-[#FFB4AB]/80",
             icon: "text-[#FFB4AB]"
           }
         else
           {
             title: "text-white",
             subtitle: "text-[#C7C4D8]",
             icon: "text-[#C0C1FF]"
           }
         end

  resolved_icon_class = [tone[:icon], icon_class].compact.join(" ")
  title_class = [title_size, "font-extrabold", "tracking-tight", "leading-tight", tone[:title]].join(" ")
  subtitle_class = [subtitle_size, "leading-relaxed", tone[:subtitle]].join(" ")
  header_classes = ["space-y-1", wrapper_class].compact.join(" ")
%>

<div class="<%= header_classes %>">
  <% if breadcrumb_label.present? %>
    <nav aria-label="パンくずリスト" class="<%= breadcrumb_wrapper_class %>">
      <% if breadcrumb_path.present? %>
        <%= link_to breadcrumb_label, breadcrumb_path, class: breadcrumb_link_class %>
      <% else %>
        <span class="<%= breadcrumb_link_class %>"><%= breadcrumb_label %></span>
      <% end %>

      <span class="material-symbols-outlined <%= breadcrumb_separator_class %>" aria-hidden="true">chevron_right</span>
      <span class="<%= breadcrumb_current_class %>"><%= title %></span>
    </nav>
  <% end %>

  <div class="flex items-center gap-2">
    <% if icon.present? %>
      <span class="material-symbols-outlined <%= resolved_icon_class %>" aria-hidden="true"><%= icon %></span>
    <% end %>

    <h2 class="<%= title_class %>"><%= title %></h2>
  </div>

  <% if subtitle.present? %>
    <p class="<%= subtitle_class %>"><%= subtitle %></p>
  <% end %>
</div>
