<%#
  トグルスイッチ

  必須:
  - label: 表示ラベル

  任意:
  - description: 補足テキスト
  - checked: ON 状態にする場合は true。未指定時は false
  - disabled: 無効化する場合は true。未指定時は false
  - name: hidden input の name 属性
  - id: hidden input の id 属性。未指定時は name
  - class: 外側ラッパーに追加するCSSクラス
  - label_class: ラベルに追加するCSSクラス
  - description_class: 補足テキストに追加するCSSクラス
  - remote: クリック時にリモート更新する場合は true。未指定時は false
  - url: remote 更新先
%>

<%
  label = local_assigns.fetch(:label)
  description = local_assigns[:description]
  checked = local_assigns.fetch(:checked, false)
  disabled = local_assigns.fetch(:disabled, false)
  input_name = local_assigns[:name]
  input_id = local_assigns[:id] || input_name
  wrapper_class = local_assigns[:class]
  label_class = local_assigns[:label_class]
  description_class = local_assigns[:description_class]
  remote = local_assigns.fetch(:remote, false)
  update_url = local_assigns[:url]

  resolved_label_class = ["text-sm font-medium token-text-base", label_class].compact.join(" ")
  resolved_description_class = ["text-xs token-text-muted", description_class].compact.join(" ")
  wrapper_classes = ["flex items-center justify-between gap-4", wrapper_class].compact.join(" ")

  controller_data_enabled = remote && input_name.present? && update_url.present?

  track_classes = [
    "w-11 h-6 rounded-full relative transition-colors duration-200 border shrink-0",
    checked ? "toggle-track-on" : "toggle-track-off",
    disabled ? "opacity-60 cursor-not-allowed" : "cursor-pointer"
  ].join(" ")

  thumb_classes = [
    "absolute top-1/2 -translate-y-1/2 w-4 h-4 rounded-full transition-all duration-200",
    checked ? "left-6 toggle-thumb-on" : "left-1 toggle-thumb-off"
  ].join(" ")
%>

<div
  class="<%= wrapper_classes %>"
  <% if controller_data_enabled %>
    data-controller="settings-toggle"
    data-settings-toggle-url-value="<%= update_url %>"
    data-settings-toggle-name-value="<%= input_name %>"
    data-settings-toggle-checked-value="<%= checked %>"
  <% end %>>
  <div class="space-y-0.5 min-w-0">
    <p class="<%= resolved_label_class %>"><%= label %></p>
    <% if description.present? %>
      <p class="<%= resolved_description_class %>"><%= description %></p>
    <% end %>
  </div>

  <button
    type="button"
    class="ui-touch-control inline-flex cursor-pointer items-center justify-center p-2 -m-2 shrink-0 disabled:cursor-not-allowed"
    role="switch"
    aria-checked="<%= checked %>"
    <% if input_id.present? %> aria-controls="<%= input_id %>"<% end %>
    <%= "disabled" if disabled %>
    <% if controller_data_enabled && !disabled %>
      data-action="click->settings-toggle#toggle"
    <% end %>>
    <span
      class="<%= track_classes %>"
      <% if controller_data_enabled %> data-settings-toggle-target="track"<% end %>>
      <span
        class="<%= thumb_classes %>"
        aria-hidden="true"
        <% if controller_data_enabled %> data-settings-toggle-target="thumb"<% end %>></span>
    </span>
  </button>

  <% if input_name.present? %>
    <input
      type="hidden"
      name="<%= input_name %>"
      id="<%= input_id %>"
      value="<%= checked ? 1 : 0 %>"
      <% if controller_data_enabled %> data-settings-toggle-target="hidden"<% end %>>
  <% end %>
</div>
