<%#
  共通テキスト入力欄

  必須:
    - label: ラベル文言
    - f / form と attribute: form builder の入力欄として使う場合に指定
    - name: standalone入力として使う場合に指定
    - icon: with_icon が true の場合に表示する Material Symbols アイコン名

  任意:
    - name / id: form builderを使わないstandalone入力で使用
    - field_type: :email_field / :password_field / :text_field（default: :text_field）
    - type: standalone入力の type 属性。未指定時は field_type から決定
    - placeholder: placeholder文言
    - value: inputの表示値を明示指定する場合に使用
    - autocomplete: autocomplete属性
    - autofocus: true/false
    - required: true/false
    - show_label: true/false（default: true）
    - with_icon: true/false（default: true）
    - highlight_variant: :default / :error / :none（default: :default）
    - show_error_state: true/false（default: true）
    - show_error_message: true/false（default: true）
    - input_class: 追加class
    - input_wrapper_class: 入力欄ラッパー用class
    - label_class: ラベル用追加class
    - error_message_class: エラーメッセージ用追加class
    - size: 入力欄サイズ（例: :dense, :regular, :prominent, :comfortable。default: :md）
    - html_options: inputへ渡す追加HTML属性（例: inputmode, pattern, data, aria）
    - password_reveal: password入力の表示/非表示切り替えボタンを表示する場合は true（default: false）
    - password_reveal_animation: password_revealボタンのアイコンをアニメーションSVGにする場合は true（default: false）
%>
<%
  f = local_assigns[:f] || local_assigns[:form]
  attribute = local_assigns[:attribute]
  name = local_assigns[:name]
  input_id = local_assigns[:id]
  field_type = local_assigns.fetch(:field_type, :text_field)
  placeholder = local_assigns[:placeholder]
  value = local_assigns[:value]
  autocomplete = local_assigns[:autocomplete]
  autofocus = local_assigns.fetch(:autofocus, false)
  required = local_assigns.fetch(:required, false)
  show_label = local_assigns.fetch(:show_label, true)
  input_class = local_assigns[:input_class]

  with_icon = local_assigns.fetch(:with_icon, true)
  highlight_variant = (local_assigns[:highlight_variant].presence || :default).to_sym
  show_error_state = local_assigns.fetch(:show_error_state, true)
  show_error_message = local_assigns.fetch(:show_error_message, true)
  input_wrapper_class = local_assigns[:input_wrapper_class]
  label_class = local_assigns[:label_class]
  error_message_class = local_assigns[:error_message_class]
  size = local_assigns.fetch(:size, :md).to_sym
  html_options = local_assigns.fetch(:html_options, {})
  password_reveal = local_assigns.fetch(:password_reveal, false)
  password_reveal_animation = local_assigns.fetch(:password_reveal_animation, false)
  truthy_html_attribute = ->(value) { value == true || %w[true disabled readonly].include?(value.to_s) }
  input_disabled = truthy_html_attribute.call(html_options[:disabled] || html_options["disabled"])
  input_readonly = truthy_html_attribute.call(html_options[:readonly] || html_options["readonly"] || html_options[:read_only] || html_options["read_only"])
  password_reveal_enabled = password_reveal && field_type.to_sym == :password_field && !input_disabled && !input_readonly
  password_reveal_animation_enabled = password_reveal_enabled && password_reveal_animation

  attribute_errors =
    if show_error_state && f.present? && attribute.present?
      Array(f.object&.errors&.[](attribute))
    else
      []
    end
  has_error = attribute_errors.any?
  attribute_full_messages =
    if f.present? && attribute.present?
      Array(f.object&.errors&.full_messages_for(attribute))
    else
      []
    end

  base_input_class = "input-field w-full text-base"

  highlight_classes =
    case highlight_variant
    when :none
      "border border-transparent focus:ring-0"
    when :error
      "input-field-error"
    else
      has_error ? "input-field-error" : nil
    end

  error_active = has_error || highlight_variant == :error

  label_classes = ["text-xs font-bold token-text-muted uppercase tracking-widest block px-1", label_class].compact.join(" ")
  wrapper_classes = ["relative group", input_wrapper_class].compact.join(" ")
  icon_classes = [
    "material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 transition-colors text-xl",
    error_active ? "token-text-error field-icon-error-focus" : "token-text-muted field-icon-focus"
  ].compact.join(" ")
  error_classes = ["px-1 text-xs token-text-error leading-relaxed", error_message_class].compact.join(" ")

  input_spacing_class =
    case size
    when :comfortable
      if password_reveal_enabled
        with_icon ? "py-3 pl-12 pr-12" : "py-3 pl-4 pr-12"
      else
        with_icon ? "px-4 py-3 pl-12" : "px-4 py-3"
      end
    when :prominent
      if password_reveal_enabled
        with_icon ? "py-3.5 pl-12 pr-12" : "py-3.5 pl-4 pr-12"
      else
        with_icon ? "py-3.5 pl-12 pr-4" : "px-4 py-3.5"
      end
    when :regular
      if password_reveal_enabled
        with_icon ? "h-11 pl-11 pr-12" : "h-11 pl-4 pr-12"
      else
        with_icon ? "h-11 pl-11 pr-4" : "h-11 px-4"
      end
    when :dense
      if password_reveal_enabled
        with_icon ? "h-10 pl-11 pr-11 py-2 rounded-md" : "h-10 pl-3 pr-11 py-2 rounded-md"
      else
        with_icon ? "h-10 pl-11 pr-4 py-2 rounded-md" : "h-10 px-3 py-2 rounded-md"
      end
    else
      if password_reveal_enabled
        with_icon ? "pl-11 pr-12" : "pl-4 pr-12"
      else
        with_icon ? "pl-11 pr-4" : "px-4"
      end
    end
  merged_input_class = [base_input_class, highlight_classes, input_spacing_class, input_class].compact.join(" ")
  field_options = {
    placeholder: placeholder,
    value: value,
    autocomplete: autocomplete,
    autofocus: autofocus,
    required: required,
    class: merged_input_class
  }.compact.merge(html_options)
  if password_reveal_enabled
    field_options[:data] = (field_options[:data] || {}).merge(password_reveal_target: "input")
  end
  password_reveal_data =
    if password_reveal_enabled
      {
        controller: "password-reveal",
        password_reveal_show_label_value: t("shared.password_reveal.show"),
        password_reveal_hide_label_value: t("shared.password_reveal.hide")
      }
    else
      {}
    end
%>

<div class="space-y-2">
  <% if show_label %>
    <% if f.present? && attribute.present? %>
      <%= f.label attribute, label, class: label_classes %>
    <% else %>
      <%= tag.label(label, for: input_id || name, class: label_classes) %>
    <% end %>
  <% end %>
  <div class="<%= wrapper_classes %>" <%= tag.attributes(data: password_reveal_data) if password_reveal_enabled %>>
    <% if with_icon %>
      <span class="<%= icon_classes %>" aria-hidden="true"><%= icon %></span>
    <% end %>
    <% if f.present? && attribute.present? %>
      <%= f.public_send(field_type, attribute, **field_options) %>
    <% else %>
      <%
        standalone_type =
          if local_assigns[:type]
            local_assigns[:type]
          else
            case field_type.to_sym
            when :email_field
              "email"
            when :password_field
              "password"
            else
              "text"
            end
          end
        standalone_options = field_options.merge(type: standalone_type, name: name, id: input_id).compact
      %>
      <%= tag.input(**standalone_options) %>
    <% end %>
    <% if password_reveal_enabled %>
      <button
        type="button"
        class="password-reveal-button ui-touch-control absolute right-2 top-1/2 inline-flex h-9 w-9 -translate-y-1/2 cursor-pointer items-center justify-center rounded-md focus:outline-none focus:ring-2 token-focus-ring-brand"
        data-action="password-reveal#toggle"
        data-password-reveal-target="button"
        aria-label="<%= t("shared.password_reveal.show") %>"
        aria-pressed="false">
        <% if password_reveal_animation_enabled %>
          <%= render "shared/ui/icons/password_visibility_icon" %>
        <% else %>
          <span class="material-symbols-outlined text-[20px]" data-password-reveal-target="icon" aria-hidden="true">visibility</span>
        <% end %>
      </button>
    <% end %>
  </div>

  <% if has_error && show_error_message %>
    <p class="<%= error_classes %>">
      <%= attribute_full_messages.first %>
    </p>
  <% end %>
</div>
