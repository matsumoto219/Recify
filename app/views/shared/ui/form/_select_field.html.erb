<%#
  共通セレクト入力欄

  必須:
  - f: form builder
  - attribute: フィールド名
  - label: ラベル文言
  - options: select の選択肢

  任意:
  - selected: 選択中の値。未指定時は f.object から取得
  - include_blank: 空選択肢
  - required: required 属性を付ける場合は true。未指定時は false
  - show_label: ラベルを表示する場合は true。未指定時は true
  - with_icon: アイコン領域を表示する場合は true。未指定時は icon の有無で決定
  - icon: 表示する Material Symbols アイコン名
  - highlight_variant: 強調表示。:error を指定するとエラー表示
  - show_error_message: エラーメッセージを表示する場合は true。未指定時は true
  - select_class: select に追加するCSSクラス
  - select_wrapper_class: select ラッパーに追加するCSSクラス
  - label_class: ラベルに追加するCSSクラス
  - error_message_class: エラーメッセージに追加するCSSクラス
  - size: 入力欄サイズ。:md / :regular / :dense。未指定時は :md
%>

<%
  selected =
    if local_assigns.key?(:selected)
      local_assigns[:selected]
    else
      f.object&.public_send(attribute)
    end
  include_blank = local_assigns.fetch(:include_blank, nil)
  required = local_assigns.fetch(:required, false)
  show_label = local_assigns.fetch(:show_label, true)
  with_icon = local_assigns.fetch(:with_icon, local_assigns[:icon].present?)
  icon = local_assigns.fetch(:icon, nil)
  highlight_variant = local_assigns.fetch(:highlight_variant, nil)
  show_error_message = local_assigns.fetch(:show_error_message, true)
  select_class = local_assigns.fetch(:select_class, nil)
  select_wrapper_class = local_assigns.fetch(:select_wrapper_class, nil)
  label_class = local_assigns.fetch(:label_class, nil)
  error_message_class = local_assigns.fetch(:error_message_class, nil)
  size = local_assigns.fetch(:size, :md).to_sym
  html_options = local_assigns.fetch(:html_options, {})

  has_error = f.object.respond_to?(:errors) && f.object.errors[attribute].present?

  base_wrapper_class = "space-y-2"
  base_label_class = "text-xs font-bold uppercase tracking-wider token-text-muted"
  base_select_class = "ui-touch-control w-full rounded-lg input-field text-base appearance-none outline-none transition-all"
  highlight_classes =
    if has_error || highlight_variant == :error
      "input-field-error"
    else
      nil
    end
  select_spacing_class =
    case size
    when :regular
      with_icon ? "h-11 pl-11 pr-10 py-2.5" : "h-11 px-3 py-2.5 pr-10"
    when :dense
      with_icon ? "h-10 pl-11 pr-10 py-2 rounded-md" : "h-10 px-3 py-2 rounded-md"
    else
      with_icon ? "pl-11 pr-10" : "px-4 pr-10"
    end
  merged_wrapper_class = [base_wrapper_class, select_wrapper_class].compact.join(" ")
  merged_label_class = [base_label_class, label_class].compact.join(" ")
  merged_select_class = [base_select_class, highlight_classes, select_spacing_class, select_class].compact.join(" ")
  merged_error_class = ["text-xs token-text-error", error_message_class].compact.join(" ")
%>

<div class="<%= merged_wrapper_class %>">
  <% if show_label %>
    <%= f.label attribute, label, class: merged_label_class %>
  <% end %>

  <div class="group relative">
    <% if with_icon && icon.present? %>
      <span class="ui-no-select material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-sm pointer-events-none transition-colors <%= has_error || highlight_variant == :error ? 'token-text-error field-icon-error-focus' : 'token-text-muted field-icon-focus' %>"><%= icon %></span>
    <% end %>

    <%= f.select attribute,
                 options_for_select(options, selected),
                 { include_blank: include_blank },
                 { class: merged_select_class,
                   required: required }.merge(html_options) %>

    <span class="ui-no-select material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-base pointer-events-none transition-colors <%= has_error || highlight_variant == :error ? 'token-text-error field-icon-error-focus' : 'token-text-muted field-icon-focus' %>">expand_more</span>
  </div>

  <% if show_error_message && has_error %>
    <p class="<%= merged_error_class %>"><%= f.object.errors[attribute].first %></p>
  <% end %>
</div>
