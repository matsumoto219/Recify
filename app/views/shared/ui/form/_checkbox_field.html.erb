<%#
  共通チェックボックス入力

  必須:
  - f / form と attribute: form builder のチェックボックスとして使う場合に指定
  - name: check_box_tag として使う場合に指定

  任意:
  - value: check_box_tag の checked value。未指定時は "1"
  - checked_value / unchecked_value: form.check_box の値。未指定時は "1" / "0"
  - label: ラベル本文
  - hint: 補足テキスト
  - checked: check_box_tag のチェック状態。未指定時は false
  - required: required 属性を付ける場合は true。未指定時は false
  - disabled: disabled 属性を付ける場合は true。未指定時は false
  - include_hidden: form.check_box の hidden input 出力設定
  - wrapper_class: ラベル全体に追加するCSSクラス
  - checkbox_class: checkbox に追加するCSSクラス
  - content_class: ラベル本文ラッパーに追加するCSSクラス
  - label_class: ラベル本文に追加するCSSクラス
  - hint_class: 補足テキストに追加するCSSクラス
  - error_message_class: エラーメッセージに追加するCSSクラス
  - show_error_message: エラーメッセージを表示する場合は true。未指定時は true
  - html_options: checkbox に追加するHTML属性
%>

<%
  form_builder = local_assigns[:f] || local_assigns[:form]
  attribute = local_assigns[:attribute]
  name = local_assigns[:name]
  value = local_assigns.fetch(:value, "1")
  checked_value = local_assigns.fetch(:checked_value, "1")
  unchecked_value = local_assigns.fetch(:unchecked_value, "0")
  label = local_assigns[:label]
  hint = local_assigns[:hint]
  checked = local_assigns.fetch(:checked, false)
  required = local_assigns.fetch(:required, false)
  disabled = local_assigns.fetch(:disabled, false)
  show_error_message = local_assigns.fetch(:show_error_message, true)
  html_options = local_assigns.fetch(:html_options, {}).dup
  include_hidden = local_assigns[:include_hidden]

  wrapper_class = local_assigns[:wrapper_class]
  checkbox_class = local_assigns[:checkbox_class]
  content_class = local_assigns[:content_class]
  label_class = local_assigns[:label_class]
  hint_class = local_assigns[:hint_class]
  error_message_class = local_assigns[:error_message_class]

  option_class = html_options.delete(:class)
  checkbox_classes = [
    "mt-0.5 h-4 w-4 rounded border token-border-strong token-bg-input token-text-brand focus:ring-2 token-focus-ring-brand",
    checkbox_class,
    option_class
  ].compact.join(" ")

  field_options = html_options.merge(
    class: checkbox_classes,
    required: required,
    disabled: disabled
  ).compact
  field_options[:include_hidden] = include_hidden unless include_hidden.nil?

  checkbox_input =
    if form_builder.present? && attribute.present?
      form_builder.check_box(attribute, field_options, checked_value, unchecked_value)
    else
      check_box_tag(name, value, checked, field_options)
    end

  attribute_errors =
    if form_builder.present? && attribute.present? && form_builder.object.respond_to?(:errors)
      Array(form_builder.object.errors.full_messages_for(attribute))
    else
      []
    end

  wrapper_classes = [
    "ui-touch-control flex items-start gap-3 text-sm token-text-base",
    wrapper_class
  ].compact.join(" ")
  content_classes = ["min-w-0", content_class].compact.join(" ")
  label_classes = ["block leading-relaxed", label_class].compact.join(" ")
  hint_classes = ["mt-1 block text-xs token-text-muted leading-relaxed", hint_class].compact.join(" ")
  error_classes = ["px-1 text-xs token-text-error leading-relaxed", error_message_class].compact.join(" ")
%>

<div class="space-y-2">
  <label class="<%= wrapper_classes %>">
    <%= checkbox_input %>
    <span class="<%= content_classes %>">
      <% if label.present? %>
        <span class="<%= label_classes %>"><%= label %></span>
      <% end %>
      <% if hint.present? %>
        <span class="<%= hint_classes %>"><%= hint %></span>
      <% end %>
    </span>
  </label>

  <% if show_error_message && attribute_errors.any? %>
    <p class="<%= error_classes %>"><%= attribute_errors.first %></p>
  <% end %>
</div>
