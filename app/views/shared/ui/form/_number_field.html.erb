<%#
  共通数値入力欄

  必須:
    - f: form builder
    - attribute: フィールド名（例: :quantity, :price, :tax_rate）
    - label: ラベル文言

  任意:
    - placeholder: placeholder文言
    - value: inputの表示値を明示指定する場合に使用
    - min: min属性
    - max: max属性
    - step: step属性
    - decimal_precision: ステッパー操作時の小数表示桁数（例: 1）
    - decimal_comma: trueの場合、単一カンマを小数点として扱う（default: false）
    - inputmode: inputmode属性（default: :decimal）
    - autofocus: true/false
    - required: true/false
    - show_label: true/false（default: true）
    - highlight_variant: :default / :error / :none（default: :default）
    - show_error_message: true/false（default: true）
    - prefix: 入力欄内の左側表示（例: "¥"）
    - suffix: 入力欄内の右側表示（例: "%"）
    - text_align: :left / :center / :right（default: :right）
    - hide_spinner: true/false（default: true）
    - show_stepper_buttons: true/false（default: false）
    - stepper_button_class: +/-ボタン用追加class（例: "md:hidden"）
    - stepper_button_size_class: +/-ボタンサイズ用追加class
    - size: 入力欄サイズ（例: :dense, :regular, :prominent, :comfortable。default: :md）
    - input_class: 追加class
    - input_wrapper_class: 入力欄ラッパー用class
    - label_class: ラベル用追加class
    - error_message_class: エラーメッセージ用追加class
    - html_options: inputへ渡す追加HTML属性（例: data, aria）
%>
<%
  placeholder = local_assigns[:placeholder]
  value = local_assigns[:value]
  min = local_assigns[:min]
  max = local_assigns[:max]
  step = local_assigns[:step]
  decimal_precision = local_assigns[:decimal_precision]
  decimal_comma = local_assigns.fetch(:decimal_comma, false)
  inputmode = local_assigns.fetch(:inputmode, :decimal)
  autofocus = local_assigns.fetch(:autofocus, false)
  required = local_assigns.fetch(:required, false)
  show_label = local_assigns.fetch(:show_label, true)
  input_class = local_assigns[:input_class]

  highlight_variant = (local_assigns[:highlight_variant].presence || :default).to_sym
  show_error_message = local_assigns.fetch(:show_error_message, true)
  prefix = local_assigns[:prefix]
  suffix = local_assigns[:suffix]
  text_align = (local_assigns[:text_align].presence || :right).to_sym
  show_stepper_buttons = local_assigns.fetch(:show_stepper_buttons, false)
  stepper_button_class = local_assigns[:stepper_button_class]
  stepper_button_size_class = local_assigns[:stepper_button_size_class]
  hide_spinner = show_stepper_buttons ? true : local_assigns.fetch(:hide_spinner, true)
  input_wrapper_class = local_assigns[:input_wrapper_class]
  label_class = local_assigns[:label_class]
  error_message_class = local_assigns[:error_message_class]
  size = local_assigns.fetch(:size, :md).to_sym
  html_options = local_assigns.fetch(:html_options, {})

  attribute_errors = Array(f.object&.errors&.[](attribute))
  has_error = attribute_errors.any?
  attribute_full_messages = Array(f.object&.errors&.full_messages_for(attribute))

  base_input_class = show_stepper_buttons ? "w-full field-stepper-input text-base transition-all outline-none" : "w-full input-field text-base transition-all outline-none"

  highlight_classes = case highlight_variant
                      when :none
                        "border border-transparent focus:ring-0"
                      when :error
                        "input-field-error"
                      else
                        has_error ? "input-field-error" : nil
                      end

  text_align_class = case text_align
                     when :left
                       "text-left"
                     when :center
                       "text-center"
                     else
                       "text-right"
                     end

  balanced_affix_spacing = text_align == :center && (prefix.present? || suffix.present?)
  prefix_spacing_class = (balanced_affix_spacing || prefix.present?) ? "pl-8" : "pl-4"
  # ステッパー表示時は余白を上書きせず、呼び出し側の input_class に委ねる
  suffix_spacing_class = (balanced_affix_spacing || suffix.present?) ? "pr-8" : "pr-4"
  # ステッパー表示時は余白を上書きせず、呼び出し側の input_class に委ねる
  spinner_class = hide_spinner ? "[appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" : nil
  input_spacing_class = size == :dense ? "h-10 px-3 py-2" : nil

  label_classes = ["text-xs font-bold token-text-muted uppercase tracking-widest block px-1", label_class].compact.join(" ")
  wrapper_classes = [
    "relative group",
    (show_stepper_buttons ? "flex items-stretch overflow-hidden rounded-lg border field-control-wrapper #{highlight_variant == :error || has_error ? 'field-control-wrapper-error' : nil}" : nil),
    input_wrapper_class
  ].compact.join(" ")
  affix_base_class = "absolute top-1/2 -translate-y-1/2 text-xs token-text-muted pointer-events-none transition-colors field-icon-focus"
  prefix_classes = [affix_base_class, "left-3"].join(" ")
  suffix_classes = [affix_base_class, "right-3"].join(" ")
  error_classes = ["px-1 text-xs token-text-error leading-relaxed", error_message_class].compact.join(" ")

  base_stepper_button_size = stepper_button_size_class.presence || "min-w-10 px-3"
  stepper_button_classes = [
    "flex self-stretch shrink-0 cursor-pointer items-center justify-center field-stepper-button focus:outline-none transition-colors",
    base_stepper_button_size,
    stepper_button_class
  ].compact.join(" ")

  merged_input_class = [
    base_input_class,
    (show_stepper_buttons ? "border-0 focus:ring-0 rounded-none bg-transparent" : highlight_classes),
    text_align_class,
    prefix_spacing_class,
    suffix_spacing_class,
    spinner_class,
    input_spacing_class,
    input_class
  ].compact.join(" ")

  field_options = {
    placeholder: placeholder,
    value: value,
    min: min,
    max: max,
    step: step,
    inputmode: inputmode,
    autofocus: autofocus,
    required: required,
    class: merged_input_class
  }.compact.merge(html_options)

  number_field_data = {
    controller: "number-field",
    number_field_decimal_precision_value: decimal_precision
  }.compact
  number_field_data[:number_field_decimal_comma_value] = true if decimal_comma
%>

<div class="space-y-2">
  <% if show_label %>
    <%= f.label attribute, label, class: label_classes %>
  <% end %>

  <%= tag.div class: wrapper_classes, data: number_field_data do %>
    <% if show_stepper_buttons %>
      <button type="button"
              class="<%= stepper_button_classes %>"
              aria-label="<%= t("shared.number_field.decrement_aria", label: label) %>"
              data-action="pointerdown->number-field#startDecrementing pointerup->number-field#stopChanging pointerleave->number-field#stopChanging pointercancel->number-field#stopChanging">
        <span class="material-symbols-outlined text-base" aria-hidden="true">remove</span>
      </button>
    <% end %>

    <div class="relative <%= show_stepper_buttons ? 'flex-1 min-w-0' : nil %>">
      <% if prefix.present? %>
        <span class="<%= prefix_classes %>" aria-hidden="true"><%= prefix %></span>
      <% end %>

      <%
        existing_data = field_options[:data] || {}
        existing_action = existing_data[:action].presence
        normalized_action = [
          "compositionstart->number-field#startComposition",
          "compositionend->number-field#finishComposition",
          "input->number-field#normalize",
          existing_action,
          "blur->number-field#finishComposition"
        ].compact.join(" ")
        merged_data = existing_data.merge(action: normalized_action)
        merged_data = merged_data.merge(number_field_target: "input") if show_stepper_buttons
        merged_field_options = field_options.merge(data: merged_data)
      %>

      <%= f.text_field attribute, **merged_field_options %>

      <% if suffix.present? %>
        <span class="<%= suffix_classes %>" aria-hidden="true"><%= suffix %></span>
      <% end %>
    </div>

    <% if show_stepper_buttons %>
      <button type="button"
              class="<%= stepper_button_classes %>"
              aria-label="<%= t("shared.number_field.increment_aria", label: label) %>"
              data-action="pointerdown->number-field#startIncrementing pointerup->number-field#stopChanging pointerleave->number-field#stopChanging pointercancel->number-field#stopChanging">
        <span class="material-symbols-outlined text-base" aria-hidden="true">add</span>
      </button>
    <% end %>
  <% end %>

  <% if has_error && show_error_message %>
    <p class="<%= error_classes %>">
      <%= attribute_full_messages.first %>
    </p>
  <% end %>
</div>
