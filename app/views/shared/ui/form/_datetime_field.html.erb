<%#
  共通日時入力欄

  必須:
  - name: input の name 属性
  - id: input の id 属性
  - label: ラベル文言
  - type: input の type

  任意:
  - value: input の表示値
  - icon: 表示する Material Symbols アイコン名
  - required: required 属性を付ける場合は true。未指定時は false
  - show_label: ラベルを表示する場合は true。未指定時は true
  - with_icon: アイコン領域を表示する場合は true。未指定時は icon の有無で決定
  - field_class: input に追加するCSSクラス
  - field_wrapper_class: 入力欄ラッパーに追加するCSSクラス
  - label_class: ラベルに追加するCSSクラス
  - highlight_variant: 強調表示。:error を指定するとエラー表示
  - error_message: 表示するエラーメッセージ
  - error_message_class: エラーメッセージに追加するCSSクラス
  - show_error_message: エラーメッセージを表示する場合は true。未指定時は true
  - size: 入力欄サイズ。:md / :regular / :dense。未指定時は :md
%>

<%
  value = local_assigns.fetch(:value, nil)
  icon = local_assigns.fetch(:icon, nil)
  required = local_assigns.fetch(:required, false)
  show_label = local_assigns.fetch(:show_label, true)
  with_icon = local_assigns.fetch(:with_icon, icon.present?)
  field_class = local_assigns.fetch(:field_class, nil)
  field_wrapper_class = local_assigns.fetch(:field_wrapper_class, nil)
  label_class = local_assigns.fetch(:label_class, nil)
  highlight_variant = local_assigns.fetch(:highlight_variant, nil)
  error_message = local_assigns.fetch(:error_message, nil)
  error_message_class = local_assigns.fetch(:error_message_class, nil)
  show_error_message = local_assigns.fetch(:show_error_message, true)
  size = local_assigns.fetch(:size, :md).to_sym

  input_type = type.to_s
  base_wrapper_class = "space-y-2"
  base_label_class = "text-xs font-bold uppercase tracking-wider token-text-muted"
  has_error = highlight_variant == :error || error_message.present?

  highlight_classes = has_error ? "input-field-error" : nil

  base_field_class = "w-full rounded-lg input-field input-field-datetime text-base outline-none transition-all #{highlight_classes}"
  field_size_class =
    case size
    when :regular
      "input-field-datetime-regular"
    when :dense
      "input-field-datetime-dense"
    end
  field_spacing_class = with_icon ? "pl-10 pr-4" : "px-4"

  merged_wrapper_class = [base_wrapper_class, field_wrapper_class].compact.join(" ")
  merged_label_class = [base_label_class, label_class].compact.join(" ")
  merged_field_class = [base_field_class, field_size_class, field_spacing_class, field_class].compact.join(" ")
  merged_error_class = ["px-1 text-xs token-text-error leading-relaxed", error_message_class].compact.join(" ")
%>

<div class="<%= merged_wrapper_class %>">
  <% if show_label %>
    <label class="<%= merged_label_class %>" for="<%= id %>"><%= label %></label>
  <% end %>

  <div class="group relative">
    <%= tag.input type: input_type,
                  name: name,
                  id: id,
                  value: value,
                  required: required,
                  class: merged_field_class %>

    <% if with_icon && icon.present? %>
      <span class="ui-no-select material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-sm pointer-events-none transition-colors <%= has_error ? 'token-text-error field-icon-error-focus' : 'token-text-muted field-icon-focus' %>"><%= icon %></span>
    <% end %>
  </div>

  <% if error_message.present? && show_error_message %>
    <p class="<%= merged_error_class %>"><%= error_message %></p>
  <% end %>
</div>
