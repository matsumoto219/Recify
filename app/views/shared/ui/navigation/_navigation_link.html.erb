<%#
  ナビゲーションリンク

  必須:
  - path: リンク先
  - text: 表示テキスト

  任意:
  - arrow: 矢印の向き。:left / :right。未指定時は :left
  - align: 外側の揃え。:center の場合は中央寄せ。未指定時は :center
%>

<%
  arrow ||= :left
  align = local_assigns.fetch(:align, :center)
%>

<section class="<%= align == :center ? 'flex justify-center' : '' %>">
  <%= link_to path, class: "flex items-center gap-2 text-sm font-medium navigation-link transition-colors group" do %>

    <% if arrow == :left %>
      <span class="material-symbols-outlined text-[18px] group-hover:-translate-x-1 transition-transform">
        arrow_back
      </span>
    <% end %>

    <%= text %>

    <% if arrow == :right %>
      <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">
        arrow_forward
      </span>
    <% end %>

  <% end %>
</section>
