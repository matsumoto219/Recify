<%#
  ページネーション

  必須:
  - pagy: Pagy オブジェクト

  任意:
  - なし

  Pagy v43.x では protected な series を直接呼ばず、公開されている page / last から表示ページを組み立てる。
%>
<% pagination = navigation_pagination_state(local_assigns.fetch(:pagy)) %>

<% if pagination.render? %>
  <nav class="max-w-full overflow-x-auto no-scrollbar px-1 mt-8 mb-4" aria-label="<%= t("common.pagination.label") %>">
    <div class="mx-auto flex min-w-max items-center justify-center gap-1 sm:gap-2">
      <% if pagination.back_enabled? %>
        <%= link_to pagination.back_url,
          class: "flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 shrink-0 rounded-lg token-bg-card-subtle token-text-muted hover:bg-[var(--bg-elevated)] hover:text-[var(--text-base)] transition-colors shadow-sm border token-border-soft",
          aria: { label: pagination.back_label } do %>
          <span class="material-symbols-outlined" data-icon="chevron_left">chevron_left</span>
        <% end %>
      <% else %>
        <span class="flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 shrink-0 rounded-lg token-bg-card-subtle token-text-subtle shadow-sm border token-border-soft cursor-not-allowed opacity-60" aria-disabled="true" aria-label="<%= pagination.back_label %>">
          <span class="material-symbols-outlined" data-icon="chevron_left">chevron_left</span>
        </span>
      <% end %>

      <div class="flex shrink-0 items-center gap-1">
        <% pagination.items.each do |item| %>
          <% if item.gap? %>
            <span class="w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center token-text-subtle" aria-hidden="true">
              ...
            </span>
          <% elsif item.current? %>
            <span class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg token-bg-brand-strong token-text-on-brand font-bold shadow-[var(--shadow-card)] flex items-center justify-center" aria-current="page">
              <%= item.page %>
            </span>
          <% else %>
            <%= link_to item.page,
              item.url,
              class: "w-9 h-9 sm:w-10 sm:h-10 rounded-lg token-bg-card-subtle token-text-muted hover:bg-[var(--bg-elevated)] hover:text-[var(--text-base)] transition-colors font-medium border token-border-soft flex items-center justify-center",
              aria: { label: t("common.pagination.page", page: item.page) } %>
          <% end %>
        <% end %>
      </div>

      <% if pagination.forward_enabled? %>
        <%= link_to pagination.forward_url,
          class: "flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 shrink-0 rounded-lg token-bg-card-subtle token-text-muted hover:bg-[var(--bg-elevated)] hover:text-[var(--text-base)] transition-colors shadow-sm border token-border-soft",
          aria: { label: pagination.forward_label } do %>
          <span class="material-symbols-outlined" data-icon="chevron_right">chevron_right</span>
        <% end %>
      <% else %>
        <span class="flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 shrink-0 rounded-lg token-bg-card-subtle token-text-subtle shadow-sm border token-border-soft cursor-not-allowed opacity-60" aria-disabled="true" aria-label="<%= pagination.forward_label %>">
          <span class="material-symbols-outlined" data-icon="chevron_right">chevron_right</span>
        </span>
      <% end %>
    </div>
  </nav>
<% end %>
