<%# =========================
   locals:
   - status: 必須
   - label: 任意（なければstatusから生成）
   - size: :sm / :md / :lg（default: :md）
   - class: 追加クラス
   ========================= %>

<%
status = local_assigns[:status].to_s
label  = local_assigns[:label] || status.humanize
size   = (local_assigns[:size] || :md).to_sym
extra_class = local_assigns[:class]

# --- ステータスカラー ---
status_classes =
  case status
  when "completed"
    "token-state-success-soft"
  when "processing"
    "receipt-status-processing"
  when "review_needed"
    "token-state-warning-soft"
  when "failed"
    "token-state-error-soft"
  else
    "receipt-status-default"
  end

# --- サイズ ---
size_classes =
  case size
  when :sm
    "px-2 py-0.5 text-[10px]"
  when :lg
    "px-4 py-1.5 text-sm"
  else # :md
    "px-3 py-1 text-xs"
  end
%>

<span class="inline-flex items-center rounded-full font-bold whitespace-nowrap <%= status_classes %> <%= size_classes %> <%= extra_class %>">
  <%= label %>
</span>
