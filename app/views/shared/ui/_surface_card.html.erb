<!-- 共通カードパーツ -->
<%
  variant = local_assigns.fetch(:variant, :default).to_sym
  surface_variant = local_assigns[:surface_variant]&.to_sym
  shadow_variant = local_assigns.fetch(:shadow_variant, :default).to_sym
  hoverable = local_assigns.fetch(:hoverable, false)
  padding = local_assigns[:padding]&.to_sym
  extra_classes = local_assigns[:class]
  style = local_assigns[:style]

  accent = local_assigns.fetch(:accent, :brand).to_sym
  accent_width_class = local_assigns[:accent_width_class]
  accent_width = local_assigns[:accent_width] || (accent_width_class.to_s.include?("4") ? "4px" : "2px")
  accent_sides = Array(local_assigns[:accent_sides] || local_assigns[:accent_side]).map(&:to_sym)
  accent_sides = [:top, :right, :bottom, :left] if accent_sides.include?(:all)
  id = local_assigns[:id]
  title_id = local_assigns[:title_id]
  extra_class_tokens = extra_classes.to_s.split
  custom_background = extra_class_tokens.any? { |class_name| class_name.start_with?("bg-", "from-", "to-") }

  shadow_classes = case shadow_variant
                   when :indigo
                     "surface-card-shadow-indigo"
                   when :danger
                     "surface-card-shadow-danger"
                   when :warning
                     "surface-card-shadow-warning"
                   else
                     "surface-card-shadow"
                   end

  base_classes = [
    "relative w-full rounded-xl overflow-hidden surface-card-blur transition-all",
    shadow_classes
  ].join(" ")

  surface_variant_class = case surface_variant
                          when :bg_card
                            "surface-card-bg-card"
                          when :bg_elevated
                            "token-bg-elevated"
                          when :bg_card_subtle
                            "surface-card-bg-card-subtle"
                          when :bg_input
                            "token-bg-input"
                          when :bg_floating
                            "token-bg-floating"
                          end

  accent_color = case accent
                 when :error
                   "var(--text-error)"
                 else
                   "var(--brand-primary)"
                 end

  variant_classes = case variant
                    when :danger
                      "surface-card-danger border"
                    when :warning
                      "surface-card-warning border"
                    else
                      custom_background ? nil : (surface_variant_class || "surface-card-bg-card")
                    end

  hover_classes = if hoverable
                    case variant
                    when :danger
                      "surface-card-danger-hover"
                    when :warning
                      "surface-card-warning-hover"
                    else
                      "surface-card-hover"
                    end
                  end

  padding_classes = case padding
                    when :sm
                      "p-4"
                    when :md
                      "p-6"
                    when :lg
                      "p-8"
                    when :responsive
                      "p-6 lg:p-8"
                    when :card
                      "p-5"
                    end

  accent_style_rules = if accent_color.present? && accent_sides.any?
                         accent_sides.map do |side|
                           case side
                           when :top
                             "border-top: #{accent_width} solid #{accent_color};"
                           when :right
                             "border-right: #{accent_width} solid #{accent_color};"
                           when :bottom
                             "border-bottom: #{accent_width} solid #{accent_color};"
                           when :left
                             "border-left: #{accent_width} solid #{accent_color};"
                           end
                         end.compact.join(" ")
                       end

  surface_style = [style].flatten.compact.join(" ")

  surface_classes = [base_classes, variant_classes, hover_classes, padding_classes, extra_classes].compact.join(" ")
%>

<section <%= id.present? ? " id=\"#{id}\"".html_safe : "" %> class="<%= surface_classes %>"<%= surface_style.present? ? " style=\"#{surface_style}\"".html_safe : "" %><%= title_id.present? ? " aria-labelledby=\"#{title_id}\"".html_safe : "" %>>
  <% if accent_style_rules.present? %>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 rounded-[inherit]"
      style="<%= accent_style_rules %>">
    </span>
  <% end %>

  <%= yield %>
</section>
