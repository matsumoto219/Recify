<!-- 共通カードパーツ -->
<%
  variant = local_assigns.fetch(:variant, :default).to_sym
  shadow_variant = local_assigns.fetch(:shadow_variant, :default).to_sym
  hoverable = local_assigns.fetch(:hoverable, false)
  extra_classes = local_assigns[:class]
  background_class = local_assigns[:background_class]
  hover_class = local_assigns[:hover_class]
  id = local_assigns[:id]
  title_id = local_assigns[:title_id]
  custom_background = background_class.present? || extra_classes&.match?(/bg-|from-|to-/)

  shadow_classes = case shadow_variant
                   when :indigo
                     "surface-card-shadow-indigo"
                   else
                     "surface-card-shadow"
                   end

  base_classes = [
    "w-full rounded-xl overflow-hidden surface-card-blur transition-all",
    shadow_classes
  ].join(" ")

  variant_classes = case variant
                    when :danger
                      "surface-card-danger border"
                    when :warning
                      "surface-card-warning border surface-card-warning-border"
                    else
                      custom_background ? nil : "surface-card-default"
                    end

  hover_classes = if hoverable
                    hover_class.presence ||
                      case variant
                      when :danger
                        "surface-card-danger-hover"
                      when :warning
                        "surface-card-warning-hover"
                      else
                        "surface-card-hover"
                      end
                  end

  surface_classes = [base_classes, variant_classes, background_class, hover_classes, extra_classes].compact.join(" ")
%>

<section <%= id.present? ? " id=\"#{id}\"".html_safe : "" %> class="<%= surface_classes %>"<%= title_id.present? ? " aria-labelledby=\"#{title_id}\"".html_safe : "" %>>
  <%= yield %>
</section>
