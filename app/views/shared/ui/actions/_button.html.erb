<%#
  共通ボタンパーシャル

  必須:
  - label: ボタンに表示するテキスト

  任意:
  - variant: 見た目の種類。:primary / :secondary / :ghost / :danger。未指定時は :primary
  - size: ボタンサイズ。:sm / :md / :compact / :lg。未指定時は :md
  - weight: 文字の太さ。:medium / :bold。未指定時は :medium
  - radius: 角丸サイズ。:lg / :xl
  - type: button 要素の type。未指定時は "button"
  - as: 出力形式。:button / :link / :content。未指定時は :button
  - href: as: :link の場合の遷移先
  - data: button または link に付与する data 属性
  - full_width: 横幅いっぱいに表示する場合は true。未指定時は false
  - disabled: 無効化する場合は true。未指定時は false
  - loading: 送信中表示にする場合は true。未指定時は false
  - icon: 表示する Material Symbols アイコン名
  - icon_position: icon の位置。:left / :right。未指定時は :left
  - trailing_icon: 右端に表示する Material Symbols アイコン名
  - trailing_icon_animated: trailing_icon を hover 時に動かす場合は true。未指定時は false
  - class: 追加CSSクラス
  - disable_with: 送信中に表示するテキスト
  - form: button 要素に付与する form 属性
  - html_options: button 要素に追加するHTML属性
  - unstyled: 既定のボタンスタイルを使わない場合は true。未指定時は false
%>

<%
  label = local_assigns.fetch(:label)
  variant = local_assigns.fetch(:variant, :primary).to_sym
  size = local_assigns.fetch(:size, :md).to_sym
  weight = local_assigns.fetch(:weight, :medium).to_sym
  radius = local_assigns[:radius]&.to_sym
  type = local_assigns.fetch(:type, "button")
  as = local_assigns.fetch(:as, :button).to_sym
  content_only = (as == :content)
  href = local_assigns[:href]
  data_attributes = local_assigns[:data] || {}
  full_width = local_assigns.fetch(:full_width, false)
  disabled = local_assigns.fetch(:disabled, false)
  loading = local_assigns.fetch(:loading, false)
  icon = local_assigns[:icon]
  icon_position = local_assigns.fetch(:icon_position, :left).to_sym
  trailing_icon = local_assigns[:trailing_icon]
  trailing_icon_animated = local_assigns.fetch(:trailing_icon_animated, false)
  extra_classes = local_assigns[:class]
  disable_with = local_assigns[:disable_with]
  form = local_assigns[:form]
  html_options = local_assigns.fetch(:html_options, {})
  unstyled = local_assigns.fetch(:unstyled, false)

  # テーマトークンに基づくボタン種別
  variant_classes =
    case variant
    # 面を持つ補助ボタン
    when :secondary
      "btn-secondary border"
    # 透明背景のボタン
    when :ghost
      "btn-ghost border"
    # 危険操作用ボタン
    when :danger
      "btn-danger border border-transparent"
    # 主操作ボタン
    else
      "btn-primary border-none overflow-hidden"
    end

  size_classes =
    case size
    when :sm
      "px-4 py-2 text-sm rounded-lg"
    when :compact
      "px-6 py-2.5 text-sm rounded-lg"
    when :lg
      "px-6 py-4 text-base rounded-xl"
    else
      "px-6 py-3 text-sm rounded-lg"
    end
  radius_classes =
    case radius
    when :lg
      "rounded-lg"
    when :xl
      "rounded-xl"
    else
      nil
    end

  justify_classes = trailing_icon.present? ? "justify-between" : "justify-center"
  width_classes = full_width ? "w-full flex #{justify_classes}" : "inline-flex #{justify_classes}"
  weight_classes = weight == :bold ? "font-bold" : "font-medium"
  state_classes = "group ui-touch-control items-center gap-2 cursor-pointer transition-all active:scale-[0.98] disabled:opacity-60 disabled:cursor-not-allowed"
  button_classes =
    if unstyled
      extra_classes.to_s
    else
      [width_classes, state_classes, weight_classes, variant_classes, size_classes, radius_classes, extra_classes].compact.join(" ")
    end

  current_label = loading ? (disable_with.presence || label) : label
  trailing_icon_class = [
    "material-symbols-outlined text-[18px] shrink-0 transition-transform",
    (trailing_icon_animated ? "group-hover:translate-x-1" : nil)
  ].compact.join(" ")
%>

<% content = capture do %>
  <% if icon.present? && icon_position == :left %>
    <span class="material-symbols-outlined text-[18px]" aria-hidden="true"><%= icon %></span>
  <% end %>

  <span><%= current_label %></span>

  <% if trailing_icon.present? %>
    <span class="<%= trailing_icon_class %>" aria-hidden="true"><%= trailing_icon %></span>
  <% elsif icon.present? && icon_position == :right %>
    <span class="material-symbols-outlined text-[18px]" aria-hidden="true"><%= icon %></span>
  <% end %>
<% end %>

<% if content_only %>
  <span class="<%= button_classes %>">
    <%= content %>
  </span>
<% elsif as == :link %>
  <%= link_to href, class: button_classes, data: data_attributes do %>
    <%= content %>
  <% end %>
<% else %>
  <button
    type="<%= type %>"
    class="<%= button_classes %>"
    <% if form.present? %>
      form="<%= form %>"
    <% end %>
    <%= "disabled" if disabled || loading %>
    <% if disable_with.present? %> data-disable-with="<%= disable_with %>" data-turbo-submits-with="<%= disable_with %>"<% end %>
    <% data_attributes.each do |key, value| %> data-<%= key.to_s.dasherize %>="<%= value %>" <% end %>
    <%= tag.attributes(html_options) if html_options.present? %>>
    <%= content %>
  </button>
<% end %>
