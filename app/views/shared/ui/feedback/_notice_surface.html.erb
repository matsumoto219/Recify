<%#
  通知サーフェス

  必須:
  - なし

  任意:
  - notice_type: 通知種別。未指定時は :info
  - tone: 表示トーン設定Hash。指定時は notice_type からの自動設定より優先
  - surface_id: ルート要素の id
  - title: 見出し。未指定時は tone の title
  - message: 本文テキスト
  - body: 本文HTML。指定時は message より優先
  - dismissible: 閉じるボタンを表示する場合は true。未指定時は false
  - animated: 表示アニメーションを使う場合は true。未指定時は false
  - animation_name: アニメーション名。slide_down / slide_right。未指定時は "slide_down"
  - auto_dismiss: 自動で閉じる場合は true。未指定時は false
  - auto_dismiss_delay: 自動で閉じるまでのミリ秒
  - remove_before_cache: Turbo のページキャッシュ前にDOMから外す場合は true。未指定時は false
  - align: 内容の縦位置。:start / :center。未指定時は :start
  - class: 追加CSSクラス
%>

<%
  notice_type = local_assigns.fetch(:notice_type, :info).to_s

  tone = local_assigns[:tone] ||
    case notice_type
    when "notice", "success", "ai_notice", "ocr_notice", "success_box", "notice_box"
      {
        variant_class: "notice-surface-success",
        icon_class: "token-state-success-soft",
        icon: "check_circle",
        title: t("shared.notice_surface.titles.success")
      }
    when "caution", "ai_caution", "ocr_caution", "caution_box"
      {
        variant_class: "notice-surface-warning",
        icon_class: "token-state-warning-soft",
        icon: "info",
        title: t("shared.notice_surface.titles.caution")
      }
    when "warning", "ai_warning", "ocr_warning", "warning_box"
      {
        variant_class: "notice-surface-warning",
        icon_class: "token-state-warning-soft",
        icon: "warning",
        title: t("shared.notice_surface.titles.warning")
      }
    when "alert", "error", "ai_error", "ocr_error", "image_error", "error_box", "alert_box"
      {
        variant_class: "notice-surface-error",
        icon_class: "token-state-error-soft",
        icon: "error",
        title: t("shared.notice_surface.titles.error")
      }
    else
      {
        variant_class: "notice-surface-info",
        icon_class: "notice-icon-info",
        icon: "info",
        title: t("shared.notice_surface.titles.info")
      }
    end

  surface_id = local_assigns[:surface_id]
  title = local_assigns.fetch(:title, tone[:title])
  message = local_assigns[:message]
  body = local_assigns[:body]
  dismissible = local_assigns.fetch(:dismissible, false)
  animated = local_assigns.fetch(:animated, false)
  animation_name = local_assigns.fetch(:animation_name, "slide_down")
  auto_dismiss = local_assigns.fetch(:auto_dismiss, false)
  auto_dismiss_delay = local_assigns[:auto_dismiss_delay]
  remove_before_cache = local_assigns.fetch(:remove_before_cache, false)
  align = local_assigns.fetch(:align, :start).to_sym
  extra_classes = local_assigns[:class]

  default_auto_dismiss_delay =
    case notice_type
    when "alert", "error", "ai_error", "ocr_error", "image_error", "error_box", "alert_box"
      7000
    else
      4000
    end

  resolved_auto_dismiss_delay = auto_dismiss_delay || default_auto_dismiss_delay
  interruptive_notice = notice_type.in?(%w[
    alert error ai_error ocr_error image_error error_box alert_box
  ])
  aria_role = interruptive_notice ? "alert" : "status"
  aria_live = interruptive_notice ? "assertive" : "polite"

  animation_classes =
    if animated
      case animation_name
      when "slide_right"
        "opacity-0 translate-x-full transition-all duration-300 ease-out"
      when "slide_down"
        "opacity-0 -translate-y-4 transition-all duration-300 ease-out"
      else
        "opacity-0 transition-all duration-300 ease-out"
      end
    end

  align_classes =
    case align
    when :center
      "items-center"
    else
      "items-start"
    end

  surface_classes = [
    "pointer-events-auto",
    "notice-glass",
    "notice-surface",
    tone[:variant_class],
    "p-4 flex gap-3",
    align_classes,
    animation_classes,
    extra_classes
  ].compact.join(" ")
%>

<div
  <% if surface_id.present? %> id="<%= surface_id %>"<% end %>
  class="<%= surface_classes %>"
  role="<%= aria_role %>"
  aria-live="<%= aria_live %>"
  aria-atomic="true"
  data-controller="notice-surface"
  data-notice-surface-animation-value="<%= animation_name %>"
  data-notice-surface-auto-dismiss-value="<%= auto_dismiss %>"
  data-notice-surface-auto-dismiss-delay-value="<%= resolved_auto_dismiss_delay %>"
  data-notice-surface-remove-before-cache-value="<%= remove_before_cache %>">
  <div class="ui-no-select flex-shrink-0 w-8 h-8 rounded-lg <%= tone[:icon_class] %> flex items-center justify-center">
    <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;" aria-hidden="true"><%= tone[:icon] %></span>
  </div>

  <div class="flex-1 min-w-0">
    <% if title.present? %>
      <p class="text-base font-bold token-text-base leading-tight mb-1"><%= title %></p>
    <% end %>

    <% if body.present? %>
      <div class="min-w-0 max-w-full text-xs token-text-muted leading-relaxed break-words overflow-hidden">
        <%= body %>
      </div>
    <% elsif message.present? %>
      <p class="min-w-0 max-w-full text-xs token-text-muted leading-relaxed break-words whitespace-pre-wrap"><%= message %></p>
    <% end %>
  </div>

  <% if dismissible %>
    <button
      type="button"
      class="ui-touch-control material-symbols-outlined cursor-pointer text-[18px] opacity-70 hover:opacity-100"
      aria-label="<%= t("shared.notice_surface.close_label") %>"
      data-action="click->notice-surface#close">close</button>
  <% end %>
</div>
