<%#
  flash メッセージ表示

  必須:
  - なし

  任意:
  - flash_messages: 表示対象の flash Hash。未指定時は Rails の flash
  - auto_dismiss: 各メッセージのデフォルト自動消去。未指定時は true

  flash message は以下のどちらでも渡せる:
  - "保存しました"
  - { message: "確認メールを送信しました", auto_dismiss: false }
%>

<%
  flash_source = local_assigns.fetch(:flash_messages, flash.to_hash)
  default_auto_dismiss = local_assigns.fetch(:auto_dismiss, true)

  message_entries = flash_source.each_with_object([]) do |(type, value), result|
    raw_messages =
      if value.is_a?(Hash) && (value.key?("message") || value.key?(:message))
        [value]
      else
        Array(value)
      end

    raw_messages.each do |raw_message|
      message = raw_message
      auto_dismiss = default_auto_dismiss

      if raw_message.is_a?(Hash) && (raw_message.key?("message") || raw_message.key?(:message))
        message = raw_message["message"] || raw_message[:message]
        auto_dismiss_value =
          if raw_message.key?("auto_dismiss")
            raw_message["auto_dismiss"]
          elsif raw_message.key?(:auto_dismiss)
            raw_message[:auto_dismiss]
          else
            default_auto_dismiss
          end
        auto_dismiss = ActiveModel::Type::Boolean.new.cast(auto_dismiss_value)
      end

      next if message.blank?

      result << [type.to_s, auto_dismiss, message]
    end
  end

  grouped_messages =
    message_entries
      .group_by { |type, auto_dismiss, _message| [type, auto_dismiss] }
      .map { |(type, auto_dismiss), entries| [type, auto_dismiss, entries.map { |entry| entry[2] }] }
%>

<% if grouped_messages.any? %>
  <%# トーストコンテナ %>
  <div
    class="fixed top-4 md:top-20 left-1/2 -translate-x-1/2 md:left-auto md:right-4 md:translate-x-0 z-[9999] flex flex-col gap-3 pointer-events-none w-full max-w-[calc(100%-2rem)] md:max-w-sm"
    data-notice-surface-container
    data-notice-surface-max-visible="3">
    <% grouped_messages.each_with_index do |(type, auto_dismiss, messages), i| %>
      <% body_content = nil %>
      <% if messages.many? %>
        <% body_content = capture do %>
          <ul class="token-text-muted min-w-0 max-w-full space-y-2 text-xs leading-relaxed break-words">
            <% messages.each do |message| %>
              <li class="flex min-w-0 max-w-full items-start gap-2 break-words">
                <span class="ui-no-select mt-[6px] h-1.5 w-1.5 shrink-0 rounded-full bg-current opacity-70" aria-hidden="true"></span>
                <span class="min-w-0 max-w-full break-words"><%= message %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% end %>

      <%= render "shared/ui/feedback/notice_surface",
                 notice_type: type,
                 message: (messages.first if messages.one?),
                 body: body_content,
                 dismissible: true,
                 animated: true,
                 animation_name: "slide_right",
                 auto_dismiss: auto_dismiss,
                 remove_before_cache: true,
                 surface_id: "toast-#{i}",
                 align: :center %>
    <% end %>
  </div>
<% end %>
