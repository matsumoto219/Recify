<%#
  トースト通知

  必須:
  - なし

  任意:
  - notice_type: 通知種別。未指定時は :info
  - message: 本文テキスト
  - body: 本文HTML。指定時は message より優先
  - surface_id: ルート要素の id。未指定時はランダム生成
%>

<%
  notice_type = local_assigns.fetch(:notice_type, :info)
  message = local_assigns[:message]
  body = local_assigns[:body]
  surface_id = local_assigns.fetch(:surface_id, "toast-#{SecureRandom.hex(4)}")
%>

<%= render "shared/ui/feedback/notice_surface",
           notice_type: notice_type,
           message: message,
           body: body,
           dismissible: true,
           animated: true,
           animation_name: "slide_right",
           auto_dismiss: true,
           remove_before_cache: true,
           surface_id: surface_id,
           align: :center %>
