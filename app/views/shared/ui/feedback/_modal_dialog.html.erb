<%#
  汎用モーダルダイアログ

  必須:
  - id: dialog要素のID
  - name: controller内で識別する名前
  - title: dialog見出し

  任意:
  - close_label: 閉じるボタンのaria-label
  - width_class: dialog panelの最大幅
%>

<%
  dialog_id = local_assigns.fetch(:id)
  dialog_name = local_assigns.fetch(:name)
  title = local_assigns.fetch(:title)
  close_label = local_assigns.fetch(:close_label, t("legal.dialog.close"))
  width_class = local_assigns.fetch(:width_class, "max-w-xl")
  title_id = "#{dialog_id}-title"
%>

<dialog
  id="<%= dialog_id %>"
  class="legal-dialog-shell fixed inset-0 z-[100] m-0 w-full max-w-none overflow-y-auto bg-transparent p-0 text-left backdrop:bg-transparent"
  data-legal-dialog-target="dialog"
  data-legal-dialog-name="<%= dialog_name %>"
  aria-labelledby="<%= title_id %>"
  aria-modal="true"
  data-action="cancel->legal-dialog#handleCancel close->legal-dialog#handleClose keydown->legal-dialog#handleKeydown">
  <div
    class="legal-dialog-overlay fixed inset-0 modal-overlay"
    aria-hidden="true"
    data-action="click->legal-dialog#close"></div>

  <div
    class="legal-dialog-viewport relative z-10 flex items-center justify-center px-4 py-6 sm:py-10"
    data-action="click->legal-dialog#closeBackdrop">
    <div class="w-full <%= width_class %> rounded-2xl border token-border-soft token-bg-card p-5 shadow-2xl sm:p-6">
      <div class="flex items-start justify-between gap-4">
        <h2 id="<%= title_id %>" class="text-lg font-bold token-text-base">
          <%= title %>
        </h2>

        <button
          type="button"
          class="ui-touch-control floating-action-button inline-flex h-10 w-10 shrink-0 cursor-pointer items-center justify-center rounded-full transition-colors"
          aria-label="<%= close_label %>"
          data-action="legal-dialog#close">
          <span class="material-symbols-outlined text-[20px]" aria-hidden="true">close</span>
        </button>
      </div>

      <div class="mt-5 max-h-[min(68vh,32rem)] overflow-y-auto overscroll-contain pr-1 token-scrollbar-brand">
        <%= yield %>
      </div>
    </div>
  </div>
</dialog>
