<%#
  ユーザーアバター

  必須:
  - user: 表示対象ユーザー

  任意:
  - size: 表示サイズ(px)。未指定時は 40
  - class: 追加CSSクラス
  - background_class: 画像なし時の背景CSSクラス。未指定時は token-bg-elevated
  - preview: 画像プレビュー用 target を付ける場合は true。未指定時は false
  - alt: 画像の alt。未指定時は shared.avatar.default_alt
%>

<%
  user = local_assigns.fetch(:user)
  size = local_assigns.fetch(:size, 40).to_i
  extra_classes = local_assigns[:class]
  background_class = local_assigns.fetch(:background_class, "token-bg-elevated")
  preview = local_assigns.fetch(:preview, false)
  alt = local_assigns.fetch(:alt, t("shared.avatar.default_alt"))

  display_name = user.respond_to?(:display_name) ? user.display_name.to_s : user&.name.to_s
  fallback_text = display_name[0, 1]&.upcase || "U"
  avatar_attached = user.respond_to?(:avatar) && user.avatar.attached? && user.avatar.blob&.persisted?
  variant_size = size <= 64 ? 64 : 160
  avatar_source = avatar_attached ? user.avatar.variant(resize_to_fill: [ variant_size, variant_size ]) : nil
  avatar_url = avatar_source ? url_for(avatar_source) : ""

  font_size_class =
    if size <= 40
      "text-xs"
    elsif size <= 80
      "text-xl"
    else
      "text-3xl"
    end

  avatar_classes = [
    "rounded-full overflow-hidden flex items-center justify-center token-text-brand font-bold",
    background_class,
    font_size_class,
    extra_classes
  ].compact.join(" ")
%>

<div
  class="<%= avatar_classes %>"
  style="width: <%= size %>px; height: <%= size %>px;"
  data-avatar>
  <% if preview %>
    <img
      src="<%= avatar_url %>"
      alt="<%= alt %>"
      class="w-full h-full object-cover <%= avatar_url.present? ? '' : 'hidden' %>"
      data-avatar-preview-target="image"
      data-persisted-url="<%= avatar_url %>"
      data-avatar-image>
  <% elsif avatar_source.present? %>
    <%= image_tag avatar_source,
          alt: alt,
          class: "w-full h-full object-cover",
          data: { avatar_image: true } %>
  <% end %>

  <% if preview || avatar_source.blank? %>
    <span
      class="<%= avatar_source.present? ? 'hidden' : '' %>"
      data-avatar-fallback
      <% if preview %>data-avatar-preview-target="fallback" data-default-text="<%= fallback_text %>"<% end %>><%= fallback_text %></span>
  <% end %>
</div>
