<%#
  ユーザーアバター

  必須:
  - user: 表示対象ユーザー

  任意:
  - size: 表示サイズ(px)。未指定時は 40
  - class: 追加CSSクラス
  - background_class: 画像なし時の背景CSSクラス。未指定時は token-bg-elevated
  - preview: 画像プレビュー用 target を付ける場合は true。未指定時は false
  - alt: 画像の alt。未指定時は shared.avatar.default_alt
%>

<%
  user = local_assigns.fetch(:user)
  size = local_assigns.fetch(:size, 40).to_i
  extra_classes = local_assigns[:class]
  background_class = local_assigns.fetch(:background_class, "token-bg-elevated")
  preview = local_assigns.fetch(:preview, false)
  alt = local_assigns.fetch(:alt, t("shared.avatar.default_alt"))

  display_name = user.respond_to?(:display_name) ? user.display_name.to_s : user&.name.to_s
  fallback_text = display_name[0, 1]&.upcase || "U"
  avatar_attached = user.respond_to?(:avatar) && user.avatar.attached? && user.avatar.blob&.persisted?
  avatar_url = avatar_attached ? url_for(user.avatar) : ""

  font_size_class =
    if size <= 40
      "text-xs"
    elsif size <= 80
      "text-xl"
    else
      "text-3xl"
    end

  avatar_classes = [
    "rounded-full overflow-hidden flex items-center justify-center token-text-brand font-bold",
    background_class,
    font_size_class,
    extra_classes
  ].compact.join(" ")
  avatar_image_data = {
    image_load_state_target: "image",
    action: "load->image-load-state#imageLoaded error->image-load-state#imageFailed",
    avatar_image: true
  }
  avatar_fallback_data = {
    image_load_state_target: "fallback",
    avatar_fallback: true
  }
  if preview
    avatar_image_data.merge!(avatar_preview_target: "image", persisted_url: avatar_url)
    avatar_fallback_data.merge!(avatar_preview_target: "fallback", default_text: fallback_text)
  end
%>

<div
  class="<%= avatar_classes %>"
  style="width: <%= size %>px; height: <%= size %>px;"
  data-controller="image-load-state"
  data-image-load-state-fallback-while-loading-value="true"
  data-action="turbo:before-cache@document->image-load-state#beforeCache"
  aria-busy="<%= avatar_url.present? %>"
  data-avatar>
  <% if preview || avatar_attached %>
    <%= tag.img src: avatar_url,
          alt: alt,
          class: "hidden w-full h-full object-cover",
          data: avatar_image_data %>
  <% end %>

  <%= tag.span fallback_text,
        role: "img",
        aria: { label: alt },
        data: avatar_fallback_data %>
</div>
