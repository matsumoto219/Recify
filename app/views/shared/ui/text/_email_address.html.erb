<%
  email_text = local_assigns.fetch(:email).to_s
  mode = local_assigns.fetch(:mode, :one_line).to_sym
  tag_name = local_assigns.fetch(:tag, :span)
  extra_class = local_assigns[:class]
  copyable = local_assigns.fetch(:copyable, false)
  copy_label = local_assigns[:copy_label] || email_text
  full_width = local_assigns.fetch(:full_width, true)
  parts = email_display_parts(email_text)
  width_class = full_width ? "w-full" : nil

  wrapper_class =
    case mode
    when :two_line
      [ "inline-flex min-w-0", width_class, "max-w-full flex-wrap items-baseline overflow-hidden align-top" ].compact.join(" ")
    else
      [ "inline-flex min-w-0", width_class, "max-w-full items-baseline overflow-hidden whitespace-nowrap align-top" ].compact.join(" ")
    end

  local_class = "min-w-[1ch] max-w-full flex-[0_999_auto] truncate"
  domain_class = "min-w-0 max-w-full flex-[0_1_auto] truncate"

  display_segments =
    if parts[:domain].present?
      if mode == :one_line
        [
          content_tag(:span, parts[:local_part], class: local_class),
          content_tag(:span, "@", class: "shrink-0"),
          content_tag(:span, parts[:domain], class: domain_class)
        ]
      else
        [
          content_tag(:span, parts[:local_part], class: local_class),
          content_tag(:span, "@#{parts[:domain]}", class: domain_class)
        ]
      end
    else
      [ content_tag(:span, parts[:text], class: "min-w-0 max-w-full truncate") ]
    end

  display_content = safe_join(display_segments, "")
%>

<% if copyable %>
  <%= content_tag tag_name, class: [ "min-w-0 max-w-full", extra_class ].compact.join(" "), title: email_text, aria: { label: email_text } do %>
    <% display_markup = render "shared/ui/text/email_address",
          email: email_text,
          mode: mode,
          tag: :span %>
    <%= render "shared/ui/actions/copyable_value",
          value: email_text,
          display: display_markup,
          label: copy_label,
          wrapper_class: "relative flex min-w-0 w-full max-w-full items-center gap-1 overflow-hidden align-middle",
          value_class: "min-w-0 flex-1 overflow-hidden" %>
  <% end %>
<% else %>
  <%= content_tag tag_name,
        display_content,
        class: [ wrapper_class, extra_class ].compact.join(" "),
        title: email_text,
        aria: { label: email_text },
        data: { email_address_display: true, email_address_value: email_text } %>
<% end %>
