<%
  notice_type = local_assigns.fetch(:notice_type, :info).to_s

  tone = local_assigns[:tone] ||
    case notice_type
    when "notice", "success", "ai_notice", "ocr_notice", "success_box", "notice_box"
      {
        border: "border-[#4ade80]/20",
        bg: "bg-[#1C1B1B]/90",
        icon_bg: "bg-[#4ade80]/10",
        icon_color: "text-[#4ade80]",
        icon: "check_circle",
        title: "成功"
      }
    when "warning", "ai_warning", "ocr_warning", "warning_box"
      {
        border: "border-[#ffb695]/20",
        bg: "bg-[#1C1B1B]/90",
        icon_bg: "bg-[#ffb695]/10",
        icon_color: "text-[#ffb695]",
        icon: "warning",
        title: "警告"
      }
    when "alert", "error", "ai_error", "ocr_error", "image_error", "error_box", "alert_box"
      {
        border: "border-[#ffb4ab]/20",
        bg: "bg-[#1C1B1B]/90",
        icon_bg: "bg-[#ffb4ab]/10",
        icon_color: "text-[#ffb4ab]",
        icon: "error",
        title: "エラー"
      }
    else
      {
        border: "border-white/10",
        bg: "bg-[#1C1B1B]/90",
        icon_bg: "bg-white/10",
        icon_color: "text-[#C7C4D8]",
        icon: "info",
        title: "通知"
      }
    end

  surface_id = local_assigns[:surface_id]
  title = local_assigns.fetch(:title, tone[:title])
  message = local_assigns[:message]
  body = local_assigns[:body]
  dismissible = local_assigns.fetch(:dismissible, false)
  animated = local_assigns.fetch(:animated, false)
  animation_name = local_assigns.fetch(:animation_name, "slide_down")
  auto_dismiss = local_assigns.fetch(:auto_dismiss, false)
  auto_dismiss_delay = local_assigns[:auto_dismiss_delay]
  max_visible = local_assigns.fetch(:max_visible, 1)
  extra_classes = local_assigns[:class]

  default_auto_dismiss_delay =
    case notice_type
    when "alert", "error", "ai_error", "ocr_error", "image_error", "error_box", "alert_box"
      7000
    else
      4000
    end

  resolved_auto_dismiss_delay = auto_dismiss_delay || default_auto_dismiss_delay

  animation_classes =
    if animated
      case animation_name
      when "slide_right"
        "opacity-0 translate-x-full transition-all duration-300 ease-out"
      when "slide_down"
        "opacity-0 -translate-y-4 transition-all duration-300 ease-out"
      else
        "opacity-0 transition-all duration-300 ease-out"
      end
    end

  surface_classes = [
    "pointer-events-auto",
    tone[:bg],
    tone[:border],
    "border rounded-xl p-4 shadow-2xl backdrop-blur-md flex items-start gap-3",
    animation_classes,
    extra_classes
  ].compact.join(" ")
%>

<div
  <% if surface_id.present? %>id="<%= surface_id %>"<% end %>
  class="<%= surface_classes %>"
  role="alert"
  aria-live="polite"
  data-notice-surface
  data-notice-animation="<%= animation_name %>"
  data-notice-auto-dismiss="<%= auto_dismiss %>"
  data-notice-type="<%= notice_type %>"
  data-notice-auto-dismiss-delay="<%= resolved_auto_dismiss_delay %>"
  data-notice-max-visible="<%= max_visible %>"
>
  <div class="flex-shrink-0 w-8 h-8 rounded-lg <%= tone[:icon_bg] %> flex items-center justify-center <%= tone[:icon_color] %>">
    <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;" aria-hidden="true"><%= tone[:icon] %></span>
  </div>

  <div class="flex-1 min-w-0">
    <% if title.present? %>
      <p class="text-base font-bold text-[#E5E2E1] leading-tight mb-1"><%= title %></p>
    <% end %>

    <% if body.present? %>
      <div class="text-xs text-[#C7C4D8] leading-relaxed">
        <%= body %>
      </div>
    <% elsif message.present? %>
      <p class="text-xs text-[#C7C4D8] leading-relaxed"><%= message %></p>
    <% end %>
  </div>

  <% if dismissible %>
    <button
      type="button"
      class="material-symbols-outlined text-[18px] opacity-70 hover:opacity-100"
      aria-label="閉じる"
      onclick="(function(){const el=this.closest('[data-notice-surface]'); if(!el) return; const animation=el.dataset.noticeAnimation; el.classList.add('opacity-0'); if(animation==='slide_right'){el.classList.add('translate-x-full');} else {el.classList.add('-translate-y-2');} setTimeout(()=>el.remove(),250);}).call(this)"
    >close</button>
  <% end %>
</div>

<%# TODO: このscriptは将来 app/javascript/controllers/notice_surface_controller.js へ移動する %>
<%# TODO: notice_surface の出現 / 自動削除 / 上限制御 / 手動クローズを controller 側で管理する %>
<%# TODO: inline script は暫定実装。将来はこのパーツ専用の Stimulus からのみ呼び出す %>
<%# TODO: リアルタイム通知対応（将来） %>
<%# TODO: Turbo Stream / ActionCable / polling で非同期処理完了を即時反映する %>
<%# TODO: OCR完了 / AI補完完了 / OCR失敗 / AI失敗 / 画像エラー通知をその場で追加表示する %>
<%# TODO: 通知boxとは役割を分け、一時通知のみ toast で扱う %>

<script>
  (() => {
    const runNoticeSurface = () => {
      const nodes = Array.from(document.querySelectorAll("[data-notice-surface]"));

      nodes.forEach((el) => {
        if (el.dataset.noticeInitialized === "true") return;
        el.dataset.noticeInitialized = "true";

        const animation = el.dataset.noticeAnimation;
        const autoDismiss = el.dataset.noticeAutoDismiss === "true";
        const autoDismissDelay = Number(el.dataset.noticeAutoDismissDelay || 0);
        const maxVisible = Number(el.dataset.noticeMaxVisible || 0);

        if (maxVisible > 0) {
          const sameGroup = Array.from(
            document.querySelectorAll(
              `[data-notice-surface][data-notice-max-visible='${maxVisible}']`
            )
          );

          if (sameGroup.length > maxVisible && sameGroup[0] === el) {
            el.remove();
            return;
          }
        }

        requestAnimationFrame(() => {
          if (animation === "slide_right") {
            el.classList.remove("opacity-0", "translate-x-full");
          } else if (animation === "slide_down") {
            el.classList.remove("opacity-0", "-translate-y-4");
          } else {
            el.classList.remove("opacity-0");
          }
        });

        if (autoDismiss) {
          const timeout = autoDismissDelay > 0 ? autoDismissDelay : 4000;

          setTimeout(() => {
            if (!el.isConnected) return;
            el.classList.add("opacity-0", "-translate-y-2");
            setTimeout(() => el.remove(), 250);
          }, timeout);
        }
      });
    };

    document.addEventListener("turbo:load", runNoticeSurface);
    document.addEventListener("turbo:render", runNoticeSurface);
    document.addEventListener("DOMContentLoaded", runNoticeSurface);
  })();
</script>
