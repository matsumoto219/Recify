<%#
  セクションヘッダー

  必須:
  - title: 見出しテキスト

  任意:
  - subtitle: 補足テキスト
  - title_id: 見出しに付与する id
  - title_suffix: 見出し横に表示する補助ラベル
  - breadcrumb_label: パンくずの戻り先ラベル
  - breadcrumb_path: パンくずの戻り先パス
  - icon: 表示する Material Symbols アイコン名
  - variant: 表示トーン。:default / :danger。未指定時は :default
  - align: 水平方向の揃え。:left / :center。未指定時は :left
  - responsive_align: md 以上での揃え。:left / :center
  - center_breadcrumb: 中央揃え時にパンくずも中央寄せする場合は true。未指定時は false
  - class: 外側ラッパーに追加するCSSクラス
  - icon_class: アイコンに追加するCSSクラス
  - title_suffix_class: title_suffix に追加するCSSクラス
  - title_size: 見出しサイズのCSSクラス。未指定時は text-lg
  - subtitle_size: 補足テキストサイズのCSSクラス。未指定時は text-sm
  - spacing_class: 縦余白のCSSクラス。未指定時は space-y-1
%>

<%
  title = local_assigns.fetch(:title)
  subtitle = local_assigns[:subtitle]
  title_id = local_assigns[:title_id]
  title_suffix = local_assigns[:title_suffix]
  breadcrumb_label = local_assigns[:breadcrumb_label]
  breadcrumb_path = local_assigns[:breadcrumb_path]
  icon = local_assigns[:icon]
  variant = local_assigns.fetch(:variant, :default).to_sym
  align = local_assigns.fetch(:align, :left).to_sym
  responsive_align = local_assigns[:responsive_align]&.to_sym
  center_breadcrumb = local_assigns.fetch(:center_breadcrumb, false) && (align == :center || responsive_align == :center)
  wrapper_class = local_assigns[:class]
  icon_class = local_assigns[:icon_class]
  title_suffix_class = local_assigns[:title_suffix_class]
  title_size = local_assigns.fetch(:title_size, "text-lg")
  subtitle_size = local_assigns.fetch(:subtitle_size, "text-sm")
  spacing_class = local_assigns.fetch(:spacing_class, "space-y-1")
  breadcrumb_wrapper_class = [
    "flex min-w-0 max-w-full flex-wrap items-center text-sm token-text-muted mb-2 gap-x-2 gap-y-1",
    center_breadcrumb && align == :center ? "justify-center" : nil,
    center_breadcrumb && responsive_align == :center ? "md:justify-center" : nil,
    center_breadcrumb && responsive_align == :left ? "md:justify-start" : nil
  ].compact.join(" ")
  breadcrumb_link_class = "token-text-muted section-header-breadcrumb-link transition-colors"
  breadcrumb_current_class = "min-w-0 token-text-brand font-medium break-words [overflow-wrap:anywhere]"
  breadcrumb_separator_class = "text-xs token-text-muted"

  align_class = case align
                when :center
                  "text-center"
                else
                  nil
                end

  responsive_align_class = case responsive_align
                           when :center
                             "md:text-center"
                           when :left
                             "md:text-left"
                           else
                             nil
                           end

  title_row_align_class = case align
                          when :center
                            "justify-center"
                          else
                            nil
                          end

  responsive_title_row_align_class = case responsive_align
                                     when :center
                                       "md:justify-center"
                                     when :left
                                       "md:justify-start"
                                     else
                                       nil
                                     end

  tone = case variant
         when :danger
           {
             title: "token-text-error",
             subtitle: "section-header-danger-subtitle",
             icon: "token-text-error"
           }
         else
           {
             title: "section-header-title",
             subtitle: "token-text-muted",
             icon: "token-text-brand"
           }
         end

  resolved_icon_class = [tone[:icon], icon_class].compact.join(" ")
  title_class = [
    "min-w-0 max-w-full break-words [overflow-wrap:anywhere]",
    title_size,
    "font-extrabold",
    "tracking-tight",
    "leading-tight",
    tone[:title]
  ].join(" ")
  resolved_title_suffix_class = [
    "inline-flex items-center rounded-full section-header-title-suffix px-2.5 py-1 text-xs font-bold",
    title_suffix_class
  ].compact.join(" ")
  subtitle_class = [
    "min-w-0 max-w-full break-words [overflow-wrap:anywhere]",
    subtitle_size,
    "leading-relaxed",
    tone[:subtitle]
  ].join(" ")
  header_classes = ["min-w-0 max-w-full", spacing_class, align_class, responsive_align_class, wrapper_class].compact.join(" ")
  title_row_class = ["flex min-w-0 max-w-full flex-wrap items-center gap-2", title_row_align_class, responsive_title_row_align_class].compact.join(" ")
%>

<div class="<%= header_classes %>">
  <% if breadcrumb_label.present? %>
    <nav aria-label="<%= t("shared.section_header.breadcrumb_aria") %>" class="<%= breadcrumb_wrapper_class %>">
      <% if breadcrumb_path.present? %>
        <%= link_to breadcrumb_label, breadcrumb_path, class: breadcrumb_link_class %>
      <% else %>
        <span class="<%= breadcrumb_link_class %>"><%= breadcrumb_label %></span>
      <% end %>

      <span class="material-symbols-outlined <%= breadcrumb_separator_class %>" aria-hidden="true">chevron_right</span>
      <span class="<%= breadcrumb_current_class %>"><%= title %></span>
    </nav>
  <% end %>

  <div class="<%= title_row_class %>">
    <% if icon.present? %>
      <span class="material-symbols-outlined <%= resolved_icon_class %>" aria-hidden="true"><%= icon %></span>
    <% end %>

    <h2
      <% if title_id.present? %> id="<%= title_id %>"<% end %>
      class="<%= title_class %>">
      <%= title %>
    </h2>

    <% if title_suffix.present? %>
      <span class="<%= resolved_title_suffix_class %>"><%= title_suffix %></span>
    <% end %>
  </div>

  <% if subtitle.present? %>
    <p class="<%= subtitle_class %>"><%= subtitle %></p>
  <% end %>
</div>
