<%#
  共通カードパーツ

  必須:
  - なし

  任意:
  - variant: 状態の種類。:default / :danger / :warning。未指定時は :default
  - surface_variant: 背景の種類。:bg_card / :bg_elevated / :bg_card_subtle / :bg_input / :bg_floating / :glass
  - shadow_variant: 影の種類。:default / :indigo / :danger / :warning。未指定時は :default
  - hoverable: hover 表示を有効にする場合は true。未指定時は false
  - padding: 余白。:sm / :md / :lg / :responsive / :card
  - class: 追加CSSクラス
  - style: 追加 style 属性
  - accent: アクセント色。:brand / :warning / :error。未指定時は :brand
  - accent_width_class: アクセント幅判定に使うCSSクラス
  - accent_width: アクセント線幅。未指定時は accent_width_class から決定
  - accent_side: アクセントを表示する辺
  - accent_sides: アクセントを表示する辺の配列。:all も指定可能
  - id: section に付与する id
  - title_id: aria-labelledby に指定する id
%>
<%
  variant = local_assigns.fetch(:variant, :default).to_sym
  surface_variant = local_assigns[:surface_variant]&.to_sym
  shadow_variant = local_assigns.fetch(:shadow_variant, :default).to_sym
  hoverable = local_assigns.fetch(:hoverable, false)
  padding = local_assigns[:padding]&.to_sym
  extra_classes = local_assigns[:class]
  style = local_assigns[:style]

  accent = local_assigns.fetch(:accent, :brand).to_sym
  accent_width_class = local_assigns[:accent_width_class]
  accent_width = local_assigns[:accent_width] || (accent_width_class.to_s.include?("4") ? "4px" : "2px")
  accent_corner_radius = "0.75rem"
  accent_sides = Array(local_assigns[:accent_sides] || local_assigns[:accent_side]).map(&:to_sym)
  accent_sides = [:top, :right, :bottom, :left] if accent_sides.include?(:all)
  id = local_assigns[:id]
  title_id = local_assigns[:title_id]
  extra_class_tokens = extra_classes.to_s.split
  custom_background = extra_class_tokens.any? { |class_name| class_name.start_with?("bg-", "from-", "to-") }

  shadow_classes =
    case shadow_variant
    when :indigo
      "surface-card-shadow-indigo"
    when :danger
      "surface-card-shadow-danger"
    when :warning
      "surface-card-shadow-warning"
    else
      "surface-card-shadow"
    end

  base_classes = [
    "relative w-full rounded-xl overflow-hidden surface-card-blur transition-all",
    shadow_classes
  ].join(" ")

  surface_variant_class =
    case surface_variant
    when :bg_card
      "surface-card-bg-card"
    when :bg_elevated
      "token-bg-elevated"
    when :bg_card_subtle
      "surface-card-bg-card-subtle"
    when :bg_input
      "token-bg-input"
    when :bg_floating
      "token-bg-floating"
    when :glass
      "glass-panel"
    end

  accent_color =
    case accent
    when :error
      "var(--text-error)"
    when :warning
      "var(--text-warning)"
    else
      "var(--brand-primary)"
    end

  variant_classes =
    case variant
    when :danger
      "surface-card-danger border"
    when :warning
      "surface-card-warning border"
    else
      custom_background ? nil : (surface_variant_class || "surface-card-bg-card")
    end

  hover_classes =
    if hoverable
      case variant
      when :danger
        "surface-card-danger-hover"
      when :warning
        "surface-card-warning-hover"
      else
        "surface-card-hover"
      end
    end

  padding_classes =
    case padding
    when :sm
      "p-4"
    when :md
      "p-6"
    when :lg
      "p-8"
    when :responsive
      "p-6 lg:p-8"
    when :card
      "p-5"
    end

  accent_segments =
    if accent_color.present? && accent_sides.any?
      accent_sides.map do |side|
        case side
        when :top
          {
            class: "pointer-events-none absolute inset-x-0 top-0 rounded-t-xl",
            style: "height: calc(#{accent_corner_radius} + #{accent_width}); border-top: #{accent_width} solid #{accent_color};"
          }
        when :right
          {
            class: "pointer-events-none absolute inset-y-0 right-0 rounded-r-xl",
            style: "width: calc(#{accent_corner_radius} + #{accent_width}); border-right: #{accent_width} solid #{accent_color};"
          }
        when :bottom
          {
            class: "pointer-events-none absolute inset-x-0 bottom-0 rounded-b-xl",
            style: "height: calc(#{accent_corner_radius} + #{accent_width}); border-bottom: #{accent_width} solid #{accent_color};"
          }
        when :left
          {
            class: "pointer-events-none absolute inset-y-0 left-0 rounded-l-xl",
            style: "width: calc(#{accent_corner_radius} + #{accent_width}); border-left: #{accent_width} solid #{accent_color};"
          }
        end
      end.compact
    end

  surface_style = [style].flatten.compact.join(" ")

  surface_classes = [base_classes, variant_classes, hover_classes, padding_classes, extra_classes].compact.join(" ")
  surface_attributes = { class: surface_classes }
  surface_attributes[:id] = id if id.present?
  surface_attributes[:style] = surface_style if surface_style.present?
  surface_attributes[:aria] = { labelledby: title_id } if title_id.present?
%>

<section <%= tag.attributes(surface_attributes) %>>
  <% if accent_segments.present? %>
    <% accent_segments.each do |accent_segment| %>
      <span
        aria-hidden="true"
        class="<%= accent_segment[:class] %>"
        style="<%= accent_segment[:style] %>">
      </span>
    <% end %>
  <% end %>

  <%= yield %>
</section>
