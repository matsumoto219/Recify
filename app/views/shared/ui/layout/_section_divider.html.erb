<%#
  セクション区切り線

  必須:
  - なし

  任意:
  - label: 中央に表示するラベル
  - variant: 線の種類。:default / :gradient。未指定時は :default
  - class: 追加CSSクラス
%>

<%
  label = local_assigns[:label]
  extra_class = local_assigns[:class]
  variant = local_assigns.fetch(:variant, :default)

  wrapper_class = [
    "flex items-center gap-4",
    extra_class
  ].compact.join(" ")

  line_class = case variant
               when :gradient
                 "section-divider-line-gradient h-px flex-1"
               else
                 "section-divider-line h-px flex-1 border-t"
               end
  label_class = "section-divider-label text-[0.6875rem] tracking-[0.5em] uppercase font-bold whitespace-nowrap"
%>

<% if label.present? %>
  <div class="<%= wrapper_class %>">
    <div class="<%= line_class %>"></div>
    <p class="<%= label_class %>"><%= label %></p>
    <div class="<%= line_class %>"></div>
  </div>
<% else %>
  <div class="<%= wrapper_class %>">
    <div class="<%= line_class %>"></div>
  </div>
<% end %>
