<%#
  外部サービス状態バッジ

  必須:
  - label: サービス名または項目名
  - state: 状態。:ok / :degraded / :down

  任意:
  - text: 状態の表示テキスト。未指定時は state から翻訳文を表示
  - class: 追加CSSクラス
%>

<%
  label = local_assigns.fetch(:label)
  state = local_assigns.fetch(:state).to_sym
  text = local_assigns[:text]
  wrapper_class = local_assigns[:class]

  state_config =
    case state
    when :ok
      {
        dot: "receipt-status-dot-completed",
        text_color: "receipt-status-text-completed",
        border: "receipt-status-border-completed",
        bg: "token-state-success-soft"
      }
    when :degraded
      {
        dot: "receipt-status-dot-review-needed",
        text_color: "receipt-status-text-review-needed",
        border: "receipt-status-border-review-needed",
        bg: "token-state-warning-soft"
      }
    when :down
      {
        dot: "receipt-status-dot-failed",
        text_color: "receipt-status-text-failed",
        border: "receipt-status-border-failed",
        bg: "token-state-error-soft"
      }
    else
      {
        dot: "receipt-status-dot-default",
        text_color: "receipt-status-text-default",
        border: "token-border-glass",
        bg: "receipt-status-default"
      }
    end

  container_classes = [
    "flex items-center justify-between rounded-lg px-4 py-3 border",
    state_config[:bg],
    state_config[:border],
    wrapper_class
  ].compact.join(" ")

  state_text =
    case state
    when :ok
      t("shared.service_status.ok")
    when :degraded
      t("shared.service_status.degraded")
    when :down
      t("shared.service_status.down")
    else
      t("shared.service_status.unknown")
    end
%>

<div class="<%= container_classes %>">
  <div class="flex items-center gap-3">
    <div class="w-2.5 h-2.5 rounded-full <%= state_config[:dot] %>"></div>
    <span class="text-sm token-text-muted"><%= label %></span>
  </div>

  <% if text.present? %>
    <span class="text-sm font-medium field-text"><%= text %></span>
  <% else %>
    <span class="text-sm font-medium <%= state_config[:text_color] %>">
      <%= state_text %>
    </span>
  <% end %>
</div>
