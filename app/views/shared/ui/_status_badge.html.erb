<%
  label = local_assigns.fetch(:label)
  state = local_assigns.fetch(:state).to_sym
  text = local_assigns[:text]
  wrapper_class = local_assigns[:class]

  state_config = case state
                 when :ok
                   {
                     dot: "bg-green-400",
                     text_color: "text-green-300",
                     border: "border-green-400/20",
                     bg: "bg-green-400/10"
                   }
                 when :degraded
                   {
                     dot: "bg-orange-400",
                     text_color: "text-orange-300",
                     border: "border-orange-400/20",
                     bg: "bg-orange-400/10"
                   }
                 when :down
                   {
                     dot: "bg-red-400",
                     text_color: "text-red-300",
                     border: "border-red-400/20",
                     bg: "bg-red-400/10"
                   }
                 else
                   {
                     dot: "bg-gray-400",
                     text_color: "text-gray-300",
                     border: "border-white/10",
                     bg: "bg-[#201F1F]/50"
                   }
                 end

  container_classes = [
    "flex items-center justify-between rounded-lg px-4 py-3 border",
    state_config[:bg],
    state_config[:border],
    wrapper_class
  ].compact.join(" ")
%>

<div class="<%= container_classes %>">
  <div class="flex items-center gap-3">
    <div class="w-2.5 h-2.5 rounded-full <%= state_config[:dot] %>"></div>
    <span class="text-sm text-[#C7C4D8]"><%= label %></span>
  </div>

  <% if text.present? %>
    <span class="text-sm font-medium text-white"><%= text %></span>
  <% else %>
    <span class="text-sm font-medium <%= state_config[:text_color] %>">
      <%= case state
          when :ok then "利用可能"
          when :degraded then "不安定"
          when :down then "停止中"
          else "不明"
          end %>
    </span>
  <% end %>
</div>
