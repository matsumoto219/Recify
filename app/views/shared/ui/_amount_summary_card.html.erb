<%
  title = local_assigns.fetch(:title, "Total Amount")
  amount = local_assigns.fetch(:amount, 0)
  currency_prefix = local_assigns.fetch(:currency_prefix, "¥")
  icon = local_assigns.fetch(:icon, "payments")
  subtotal = local_assigns[:subtotal]
  tax_amount = local_assigns[:tax_amount]
  tax_rate = local_assigns[:tax_rate]
  tax_rate_summary = local_assigns[:tax_rate_summary]
  tax_rate_display = tax_rate_summary.presence || tax_rate.presence || "未設定"
  subtotal_target = local_assigns[:subtotal_target]
  tax_amount_target = local_assigns[:tax_amount_target]
  tax_rate_target = local_assigns[:tax_rate_target]
  tax_details = Array(local_assigns[:tax_details])
  wrapper_class = local_assigns[:class]
%>

<%= render "shared/ui/surface_card",
      shadow_variant: :indigo,
      class: ["p-8 relative overflow-hidden bg-gradient-to-br from-[#4B4DD8] to-[#2F2EBE] text-white", wrapper_class].compact.join(" ") do %>
  <div class="absolute -right-4 -top-4 opacity-10 pointer-events-none">
    <span class="material-symbols-outlined text-9xl" style="font-size: 120px;"><%= icon %></span>
  </div>

  <p class="truncate text-xs font-bold uppercase tracking-widest opacity-80 mb-2" title="<%= title %>"><%= title %></p>
  <h2 class="text-4xl font-black mb-6 truncate"
      data-receipt-form-target="totalAmount">
    <%= currency_prefix %><%= number_with_delimiter(amount.to_i) %>
  </h2>

  <%= render "shared/ui/section_divider", class: "mt-6 mb-4" %>
  <div class="space-y-3">
    <div class="flex min-w-0 justify-between text-sm gap-4">
      <span class="shrink-0 opacity-70">税抜金額</span>
      <span class="min-w-0 truncate font-medium text-right" title="<%= subtotal.present? ? subtotal : "未設定" %>" <%= %(data-receipt-form-target="#{subtotal_target}").html_safe if subtotal_target.present? %>><%= subtotal.present? ? subtotal : "未設定" %></span>
    </div>
    <div class="flex min-w-0 justify-between text-sm gap-4">
      <span class="shrink-0 opacity-70">税額</span>
      <span class="min-w-0 truncate font-medium text-right" title="<%= tax_amount.present? ? tax_amount : "未設定" %>" <%= %(data-receipt-form-target="#{tax_amount_target}").html_safe if tax_amount_target.present? %>><%= tax_amount.present? ? tax_amount : "未設定" %></span>
    </div>
    <div class="flex min-w-0 justify-between text-sm gap-4">
      <span class="shrink-0 opacity-70">税率</span>
      <span class="min-w-0 truncate font-medium text-right" title="<%= tax_rate_display %>" <%= %(data-receipt-form-target="#{tax_rate_target}").html_safe if tax_rate_target.present? %>><%= tax_rate_display %></span>
    </div>

    <% if tax_details.size > 1 %>
      <%= render "shared/ui/section_divider", class: "mt-4 mb-3" %>
      <div class="space-y-2">
        <p class="truncate text-xs font-bold uppercase tracking-widest opacity-70" title="税率別内訳">税率別内訳</p>
        <% tax_details.each do |tax_detail| %>
          <% rate = tax_detail.respond_to?(:rate) ? tax_detail.rate : tax_detail[:rate] || tax_detail["rate"] %>
          <% net_amount = tax_detail.respond_to?(:net_amount) ? tax_detail.net_amount : tax_detail[:net_amount] || tax_detail["net_amount"] %>
          <% amount = tax_detail.respond_to?(:amount) ? tax_detail.amount : tax_detail[:amount] || tax_detail["amount"] %>
          <% rate_label = rate.present? ? "#{number_with_precision(rate.to_d * 100, precision: 1, strip_insignificant_zeros: true)}%" : "税率未設定" %>

          <div class="rounded-lg bg-white/10 px-3 py-2 text-xs space-y-1">
            <div class="flex min-w-0 justify-between gap-4 font-medium">
              <span class="min-w-0 truncate" title="<%= rate_label %>対象"><%= rate_label %>対象</span>
              <span class="shrink-0 truncate text-right" title="税額 <%= currency_prefix %><%= number_with_delimiter(amount.to_i) %>">税額 <%= currency_prefix %><%= number_with_delimiter(amount.to_i) %></span>
            </div>
            <div class="flex min-w-0 justify-between gap-4 opacity-70">
              <span class="min-w-0 truncate" title="税抜 <%= currency_prefix %><%= number_with_delimiter(net_amount.to_i) %>">税抜 <%= currency_prefix %><%= number_with_delimiter(net_amount.to_i) %></span>
              <span class="shrink-0 truncate text-right" title="税込 <%= currency_prefix %><%= number_with_delimiter(net_amount.to_i + amount.to_i) %>">税込 <%= currency_prefix %><%= number_with_delimiter(net_amount.to_i + amount.to_i) %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
