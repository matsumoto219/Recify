<%
  title = local_assigns.fetch(:title, "Total Amount")
  amount = local_assigns.fetch(:amount, 0)
  currency_prefix = local_assigns.fetch(:currency_prefix, "¥")
  icon = local_assigns.fetch(:icon, "payments")
  subtotal = local_assigns[:subtotal]
  tax_amount = local_assigns[:tax_amount]
  tax_rate = local_assigns[:tax_rate]
  tax_rate_summary = local_assigns[:tax_rate_summary]
  tax_rate_display = tax_rate_summary.presence || tax_rate.presence || "未設定"
  subtotal_target = local_assigns[:subtotal_target]
  tax_amount_target = local_assigns[:tax_amount_target]
  tax_rate_target = local_assigns[:tax_rate_target]
  tax_details = Array(local_assigns[:tax_details])
  wrapper_class = local_assigns[:class]
%>

<%= render "shared/ui/surface_card",
      shadow_variant: :indigo,
      class: ["p-8 relative overflow-hidden bg-gradient-to-br from-[#4B4DD8] to-[#2F2EBE] text-white", wrapper_class].compact.join(" ") do %>
  <div class="absolute -right-4 -top-4 opacity-10 pointer-events-none">
    <span class="material-symbols-outlined text-9xl" style="font-size: 120px;"><%= icon %></span>
  </div>

  <p class="text-xs font-bold uppercase tracking-widest opacity-80 mb-2"><%= title %></p>
  <h2 class="text-4xl font-black mb-6 truncate"
      data-receipt-form-target="totalAmount"
      title="<%= number_with_delimiter(amount.to_i) %>">
    <%= currency_prefix %><%= number_with_delimiter(amount.to_i) %>
  </h2>

  <div class="space-y-3 pt-6 border-t border-white/20">
    <div class="flex justify-between text-sm gap-4">
      <span class="opacity-70">税抜金額</span>
      <span class="font-medium text-right" <%= %(data-receipt-form-target="#{subtotal_target}").html_safe if subtotal_target.present? %>><%= subtotal.present? ? subtotal : "未設定" %></span>
    </div>
    <div class="flex justify-between text-sm gap-4">
      <span class="opacity-70">税額</span>
      <span class="font-medium text-right" <%= %(data-receipt-form-target="#{tax_amount_target}").html_safe if tax_amount_target.present? %>><%= tax_amount.present? ? tax_amount : "未設定" %></span>
    </div>
    <div class="flex justify-between text-sm gap-4">
      <span class="opacity-70">税率</span>
      <span class="font-medium text-right" <%= %(data-receipt-form-target="#{tax_rate_target}").html_safe if tax_rate_target.present? %>><%= tax_rate_display %></span>
    </div>

    <% if tax_details.size > 1 %>
      <div class="pt-3 mt-3 border-t border-white/15 space-y-2">
        <p class="text-xs font-bold uppercase tracking-widest opacity-70">税率別内訳</p>
        <% tax_details.each do |tax_detail| %>
          <% rate = tax_detail.respond_to?(:rate) ? tax_detail.rate : tax_detail[:rate] || tax_detail["rate"] %>
          <% net_amount = tax_detail.respond_to?(:net_amount) ? tax_detail.net_amount : tax_detail[:net_amount] || tax_detail["net_amount"] %>
          <% amount = tax_detail.respond_to?(:amount) ? tax_detail.amount : tax_detail[:amount] || tax_detail["amount"] %>
          <% rate_label = rate.present? ? "#{number_with_precision(rate.to_d * 100, precision: 1, strip_insignificant_zeros: true)}%" : "税率未設定" %>

          <div class="rounded-lg bg-white/10 px-3 py-2 text-xs space-y-1">
            <div class="flex justify-between gap-4 font-medium">
              <span><%= rate_label %>対象</span>
              <span>税額 <%= currency_prefix %><%= number_with_delimiter(amount.to_i) %></span>
            </div>
            <div class="flex justify-between gap-4 opacity-70">
              <span>税抜 <%= currency_prefix %><%= number_with_delimiter(net_amount.to_i) %></span>
              <span>税込 <%= currency_prefix %><%= number_with_delimiter(net_amount.to_i + amount.to_i) %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
