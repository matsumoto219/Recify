<%
  receipt = local_assigns.fetch(:receipt)
  title = local_assigns.fetch(:title, t("shared.receipt_image_card.default_title"))
  form_builder = local_assigns[:form_builder]
  show_toggle = local_assigns.fetch(:show_toggle, false)
  show_modal = local_assigns.fetch(:show_modal, false)
  show_download = local_assigns.fetch(:show_download, false)
  show_upload = local_assigns.fetch(:show_upload, false)
  initially_open = local_assigns.fetch(:initially_open, false)
  keep_image_enabled = local_assigns.fetch(:keep_image_enabled, true)
  empty_message = local_assigns.fetch(:empty_message, t("shared.receipt_image_card.empty"))
  helper_text = local_assigns[:helper_text]
  accept = local_assigns[:accept]
  preview_width_class = local_assigns.fetch(:preview_width_class, "w-[220px]")
  preview_height_class = local_assigns.fetch(:preview_height_class, "h-[320px]")
  has_image = receipt.image.attached?
  enable_controller = show_toggle || show_modal || show_upload
%>

<div <%= enable_controller ? %(data-controller="receipt-image-card" data-receipt-image-card-initially-open-value="#{initially_open}" data-receipt-image-card-unselected-label-value="#{ERB::Util.html_escape(t("shared.receipt_image_card.js.unselected"))}" data-receipt-image-card-empty-file-label-value="#{ERB::Util.html_escape(t("shared.receipt_image_card.js.empty_file"))}").html_safe : "" %>>
  <%= render "shared/ui/surface_card", padding: :sm do %>
    <p class="text-xs font-bold token-text-muted uppercase tracking-widest mb-3 px-2">
      <%= title %>
    </p>

    <% if has_image %>
      <% if show_toggle %>
        <button
          type="button"
          class="w-full rounded-lg border image-preview-surface image-preview-surface-hover px-4 py-3 flex items-center justify-between transition-colors text-left"
          data-action="click->receipt-image-card#toggle"
          aria-expanded="false"
          data-receipt-image-card-target="toggleButton">
          <div>
            <p class="text-sm font-semibold field-text"><%= t("shared.receipt_image_card.show_image") %></p>
            <p class="text-xs token-text-muted mt-1"><%= t("shared.receipt_image_card.show_image_hint") %></p>
          </div>
          <span
            class="material-symbols-outlined navigation-link transition-transform"
            data-receipt-image-card-target="chevron">
            expand_more
          </span>
        </button>
      <% end %>

      <div <%= show_toggle ? ' class="hidden" data-receipt-image-card-target="content"'.html_safe : ' class=""'.html_safe %>>
        <div class="mt-4 w-full flex justify-center">
          <% preview_tag = show_modal ? :button : :div %>
          <% preview_options = {
            class: "group relative #{preview_width_class} #{preview_height_class} rounded-xl overflow-hidden image-preview-surface border #{show_modal ? 'cursor-zoom-in text-left' : ''}"
          } %>
          <% if show_modal %>
            <% preview_options[:type] = "button" %>
            <% preview_options[:data] = { action: "click->receipt-image-card#openModal" } %>
            <% preview_options[:aria] = { label: t("shared.receipt_image_card.full_preview_aria") } %>
          <% end %>
          <%= content_tag preview_tag, **preview_options do %>
            <%= image_tag receipt.image,
                  class: "w-full h-full object-contain object-center transition-transform duration-500 group-hover:scale-105",
                  data: { receipt_image_card_target: "previewImage" } %>

            <div class="absolute inset-0 image-preview-overlay opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center pointer-events-none">
              <div class="floating-action-button p-3 rounded-full flex items-center justify-center backdrop-blur-md">
                <span class="material-symbols-outlined field-text">zoom_in</span>
              </div>
            </div>
          <% end %>
        </div>

        <% if show_download %>
          <!-- アクション（ダウンロード） -->
          <!-- TODO ファイル名や拡張子の仕様を決める -->
          <div class="mt-3 flex justify-end">
            <%= link_to url_for(receipt.image),
                  download: receipt.image.filename.to_s,
                  class: "inline-flex items-center gap-2 px-3 py-2 text-sm navigation-link image-preview-surface-hover rounded-lg transition-colors" do %>
              <span class="material-symbols-outlined text-sm">download</span>
              <%= t("shared.receipt_image_card.download") %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <% if keep_image_enabled %>
        <div class="rounded-lg border border-dashed token-border-glass p-10 text-center token-text-muted surface-card-bg-card-subtle relative overflow-hidden">
          <span class="material-symbols-outlined text-4xl mb-2">image</span>
          <p><%= empty_message %></p>

          <%= image_tag "",
                class: "hidden absolute inset-0 w-full h-full object-contain token-bg-input",
                data: { receipt_image_card_target: "previewImage" } %>
        </div>
      <% else %>
        <%# TODO: keep_image 設定に応じた画像なしUIは専用カメラUI仕様確定後に再調整する %>
        <div class="rounded-lg border border-dashed token-border-glass p-10 text-center token-text-muted surface-card-bg-card-subtle">
          <span class="material-symbols-outlined text-4xl mb-2">image</span>
          <p><%= t("shared.receipt_image_card.unsaved_empty") %></p>
          <p class="mt-2 text-xs token-text-muted"><%= t("shared.receipt_image_card.unsaved_hint") %></p>
        </div>
      <% end %>
    <% end %>

    <% if show_upload && form_builder.present? %>
      <div class="mt-4 space-y-3">
        <%= form_builder.file_field :image,
              accept: accept,
              class: "sr-only",
              data: {
                receipt_image_card_target: "fileInput",
                action: "change->receipt-image-card#previewSelectedImage"
              } %>

        <div class="relative overflow-hidden rounded-xl border border-dashed upload-dropzone p-4 transition-colors"
             data-action="dragenter->receipt-image-card#handleDragEnter dragover->receipt-image-card#handleDragOver dragleave->receipt-image-card#handleDragLeave drop->receipt-image-card#handleDrop">
          <div class="pointer-events-none absolute inset-0 z-10 hidden items-center justify-center rounded-xl drop-overlay-surface"
               data-receipt-image-card-target="dropOverlay">
            <div class="rounded-full border drop-overlay-chip px-4 py-2 text-sm font-semibold">
              <%= t("shared.receipt_image_card.drop_upload") %>
            </div>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0">
              <p class="text-sm font-semibold field-text"><%= t("shared.receipt_image_card.upload_title") %></p>
              <p class="mt-1 text-xs token-text-muted"><%= t("shared.receipt_image_card.upload_hint") %></p>
              <p class="mt-2 truncate text-xs token-text-muted"
                 data-receipt-image-card-target="fileName"
                 data-initial-label="<%= has_image ? t("shared.receipt_image_card.current_image") : t("shared.receipt_image_card.file_not_selected") %>">
                <%= has_image ? t("shared.receipt_image_card.current_image") : t("shared.receipt_image_card.file_not_selected") %>
              </p>
            </div>

            <%= form_builder.label :image, class: "shrink-0 cursor-pointer" do %>
              <%= render "shared/ui/button",
                         as: :content,
                         label: t("shared.receipt_image_card.select_image"),
                         icon: "upload_file",
                         size: :sm %>
            <% end %>
          </div>
        </div>

        <p class="hidden text-xs token-text-error"
           data-receipt-image-card-target="uploadError">
          <%= t("shared.receipt_image_card.invalid_image") %>
        </p>

        <% if helper_text.present? %>
          <p class="text-xs token-text-muted whitespace-pre-line">
            <%= helper_text %>
          </p>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if has_image && show_modal %>
    <div
      class="fixed inset-0 z-[100] hidden receipt-image-modal-root"
      data-receipt-image-card-target="modal"
      aria-hidden="true"
      tabindex="-1">
      <div
        class="absolute inset-0 modal-overlay"
        data-receipt-image-card-modal-part="overlay"
        data-action="click->receipt-image-card#closeModal"></div>

      <div class="relative z-10 flex min-h-full items-center justify-center p-4 md:p-8"
           data-receipt-image-card-modal-part="container"
           data-action="click->receipt-image-card#closeModal">
        <div class="relative w-full max-w-5xl"
             data-receipt-image-card-modal-part="panel"
             data-action="click->receipt-image-card#stopPropagation">
          <div class="rounded-2xl overflow-hidden border image-modal-surface relative">
            <button
              type="button"
              class="absolute right-3 top-3 z-20 inline-flex items-center justify-center w-10 h-10 rounded-full floating-action-button transition-colors"
              data-receipt-image-card-modal-part="close"
              data-action="click->receipt-image-card#closeModal"
              aria-label="<%= t("shared.receipt_image_card.close_preview_aria") %>">
              <span class="material-symbols-outlined">close</span>
            </button>
            <%= image_tag receipt.image,
                  class: "block w-full max-h-[85vh] object-contain token-bg-input",
                  data: { receipt_image_card_target: "modalImage" } %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
