<div data-controller="receipt-image-card">
  <%= render "shared/ui/surface_card", class: "p-4 shadow-sm" do %>
    <p class="text-xs font-bold text-[#C7C4D8] uppercase tracking-widest mb-3 px-2">
      Original Scan
    </p>

    <% if receipt.image.attached? %>
      <button
        type="button"
        class="w-full rounded-lg border border-white/10 bg-[#1C1B1B] px-4 py-3 flex items-center justify-between hover:bg-[#2A2A2A] transition-colors text-left"
        data-action="click->receipt-image-card#toggle"
        aria-expanded="false"
        data-receipt-image-card-target="toggleButton"
      >
        <div>
          <p class="text-sm font-semibold text-white">画像を表示</p>
          <p class="text-xs text-[#C7C4D8] mt-1">コンパクト表示で確認できます</p>
        </div>
        <span
          class="material-symbols-outlined text-[#C0C1FF] transition-transform"
          data-receipt-image-card-target="chevron"
        >
          expand_more
        </span>
      </button>

      <div class="hidden" data-receipt-image-card-target="content">
        <!-- 画像プレビュー -->
        <div class="mt-4 w-full flex justify-center">
          <button
            type="button"
            class="group relative w-[240px] h-[320px] rounded-xl overflow-hidden bg-[#0E0E0E] border border-white/10 cursor-zoom-in text-left"
            data-action="click->receipt-image-card#openModal"
            aria-label="画像を全体表示"
          >
            <%= image_tag receipt.image,
                  class: "w-full h-full object-contain object-center transition-transform duration-500 group-hover:scale-105" %>

            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center pointer-events-none">
              <div class="bg-[#353534]/90 p-3 rounded-full flex items-center justify-center backdrop-blur-md">
                <span class="material-symbols-outlined text-[#E5E2E1]">zoom_in</span>
              </div>
            </div>
          </button>
        </div>

        <!-- アクション（ダウンロード） -->
        <!-- TODO ファイル名や拡張子の仕様を決める -->
        <div class="mt-3 flex justify-end">
          <%= link_to url_for(receipt.image),
                download: true,
                class: "inline-flex items-center gap-2 px-3 py-2 text-sm text-[#C0C1FF] hover:text-white hover:bg-[#1C1B1B] rounded-lg transition-colors" do %>
            <span class="material-symbols-outlined text-sm">download</span>
            ダウンロード
          <% end %>
        </div>
      </div>

    <% else %>
      <%# TODO: 画像なし状態の本実装 (未確認) %>
      <div class="rounded-lg border border-dashed border-white/10 p-10 text-center text-[#C7C4D8] bg-[#1C1B1B]">
        <span class="material-symbols-outlined text-4xl mb-2">image</span>
        <p>画像なし</p>
      </div>
    <% end %>
  <% end %>

  <% if receipt.image.attached? %>
    <div
      class="fixed inset-0 z-50 hidden"
      data-receipt-image-card-target="modal"
      data-action="click->receipt-image-card#closeModal"
      aria-hidden="true"
    >
      <div
        class="absolute inset-0 bg-black/80 backdrop-blur-sm"
        data-action="click->receipt-image-card#closeModal"
      ></div>

      <div class="relative z-10 flex min-h-full items-center justify-center p-4 md:p-8">
        <div class="relative w-full max-w-5xl"
             data-action="click->receipt-image-card#stopPropagation">
          <button
            type="button"
            class="absolute right-0 top-0 -translate-y-12 md:-translate-y-14 inline-flex items-center justify-center w-10 h-10 rounded-full bg-[#353534]/90 text-white hover:bg-[#4A4A4A] transition-colors"
            data-action="click->receipt-image-card#closeModal"
            aria-label="全体プレビューを閉じる"
          >
            <span class="material-symbols-outlined">close</span>
          </button>

          <div class="rounded-2xl overflow-hidden border border-white/10 bg-[#0E0E0E] shadow-2xl">
            <%= image_tag receipt.image,
                  class: "block w-full max-h-[85vh] object-contain bg-[#0E0E0E]" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
