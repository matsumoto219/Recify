<%#
  金額サマリーカード

  必須:
  - なし

  任意:
  - title: カード見出し。未指定時は shared.amount_summary_card.default_title
  - amount: 合計金額
  - currency_prefix: 金額の接頭辞。未指定時は "¥"
  - icon: 背景に表示する Material Symbols アイコン名。未指定時は "payments"
  - subtotal: 小計
  - tax_amount: 税額
  - tax_rate: 税率
  - tax_rate_summary: 税率の表示文言。指定時は tax_rate より優先
  - payment_adjustment_total: 支払調整額
  - final_payment_total: 実支払額
  - subtotal_target: 小計表示へ付与する receipt-form target 名
  - tax_amount_target: 税額表示へ付与する receipt-form target 名
  - tax_rate_target: 税率表示へ付与する receipt-form target 名
  - payment_adjustment_row_target: 支払調整行へ付与する receipt-form target 名
  - payment_adjustment_total_target: 支払調整額表示へ付与する receipt-form target 名
  - final_payment_row_target: 実支払額行へ付与する receipt-form target 名
  - final_payment_total_target: 実支払額表示へ付与する receipt-form target 名
  - tax_details: 税率別内訳の配列
  - class: カードに追加するCSSクラス
%>

<%
  title = local_assigns.fetch(:title, t("shared.amount_summary_card.default_title"))
  amount = local_assigns[:amount]
  currency_prefix = local_assigns.fetch(:currency_prefix, "¥")
  icon = local_assigns.fetch(:icon, "payments")
  subtotal = local_assigns[:subtotal]
  tax_amount = local_assigns[:tax_amount]
  tax_rate = local_assigns[:tax_rate]
  tax_rate_summary = local_assigns[:tax_rate_summary]
  payment_adjustment_total = local_assigns[:payment_adjustment_total]
  final_payment_total = local_assigns[:final_payment_total]
  amount_display = receipt_total_amount_display(amount, currency_prefix: currency_prefix)
  subtotal_display = receipt_detail_amount_display(subtotal, currency_prefix: currency_prefix)
  tax_amount_display = receipt_detail_amount_display(tax_amount, currency_prefix: currency_prefix)
  tax_rate_display = tax_rate_summary.presence || receipt_rate_display(tax_rate)
  payment_adjustment_display = receipt_signed_amount_display(payment_adjustment_total, currency_prefix: currency_prefix)
  final_payment_total_display = receipt_detail_amount_display(final_payment_total, currency_prefix: currency_prefix)
  subtotal_target = local_assigns[:subtotal_target]
  tax_amount_target = local_assigns[:tax_amount_target]
  tax_rate_target = local_assigns[:tax_rate_target]
  payment_adjustment_row_target = local_assigns[:payment_adjustment_row_target]
  payment_adjustment_total_target = local_assigns[:payment_adjustment_total_target]
  final_payment_row_target = local_assigns[:final_payment_row_target]
  final_payment_total_target = local_assigns[:final_payment_total_target]
  subtotal_target_attributes = tag.attributes(data: { receipt_form_target: subtotal_target }) if subtotal_target.present?
  tax_amount_target_attributes = tag.attributes(data: { receipt_form_target: tax_amount_target }) if tax_amount_target.present?
  tax_rate_target_attributes = tag.attributes(data: { receipt_form_target: tax_rate_target }) if tax_rate_target.present?
  payment_adjustment_row_target_attributes = tag.attributes(data: { receipt_form_target: payment_adjustment_row_target }) if payment_adjustment_row_target.present?
  payment_adjustment_total_target_attributes = tag.attributes(data: { receipt_form_target: payment_adjustment_total_target }) if payment_adjustment_total_target.present?
  final_payment_row_target_attributes = tag.attributes(data: { receipt_form_target: final_payment_row_target }) if final_payment_row_target.present?
  final_payment_total_target_attributes = tag.attributes(data: { receipt_form_target: final_payment_total_target }) if final_payment_total_target.present?
  tax_details = Array(local_assigns[:tax_details])
  tax_detail_rows = receipt_amount_summary_tax_detail_rows(tax_details, currency_prefix: currency_prefix)
  show_payment_adjustment = payment_adjustment_total.to_i.nonzero? && !final_payment_total.nil?
  wrapper_class = local_assigns[:class]
%>

<%= render "shared/ui/layout/surface_card",
      shadow_variant: :indigo,
      padding: :lg,
      class: ["relative overflow-hidden amount-summary-surface", wrapper_class].compact.join(" ") do %>
  <div class="absolute -right-4 -top-4 opacity-10 pointer-events-none">
    <span class="material-symbols-outlined text-9xl" style="font-size: 120px;"><%= icon %></span>
  </div>

  <p class="truncate text-xs font-bold uppercase tracking-widest opacity-80 mb-2" title="<%= title %>"><%= title %></p>
  <h2 class="text-4xl font-black mb-6 truncate"
      title="<%= amount_display %>"
      data-receipt-form-target="totalAmount">
    <%= amount_display %>
  </h2>

  <%= render "shared/ui/layout/section_divider", class: "mt-6 mb-4" %>
  <div class="space-y-3">
    <div class="flex min-w-0 justify-between text-sm gap-4">
      <span class="shrink-0 opacity-70"><%= t("shared.amount_summary_card.subtotal") %></span>
      <span class="min-w-0 truncate font-medium text-right" title="<%= subtotal_display %>" <%= subtotal_target_attributes %>><%= subtotal_display %></span>
    </div>
    <div class="flex min-w-0 justify-between text-sm gap-4">
      <span class="shrink-0 opacity-70"><%= t("shared.amount_summary_card.tax_amount") %></span>
      <span class="min-w-0 truncate font-medium text-right" title="<%= tax_amount_display %>" <%= tax_amount_target_attributes %>><%= tax_amount_display %></span>
    </div>
    <div class="flex min-w-0 justify-between text-sm gap-4">
      <span class="shrink-0 opacity-70"><%= t("shared.amount_summary_card.tax_rate") %></span>
      <span class="min-w-0 truncate font-medium text-right" title="<%= tax_rate_display %>" <%= tax_rate_target_attributes %>><%= tax_rate_display %></span>
    </div>

    <% if show_payment_adjustment %>
      <%= render "shared/ui/layout/section_divider", class: "mt-4 mb-3" %>
      <div class="flex min-w-0 justify-between text-sm gap-4"
           <%= payment_adjustment_row_target_attributes %>>
        <span class="shrink-0 opacity-70"><%= t("shared.amount_summary_card.payment_adjustment") %></span>
        <span class="min-w-0 truncate font-medium text-right" title="<%= payment_adjustment_display %>" <%= payment_adjustment_total_target_attributes %>><%= payment_adjustment_display %></span>
      </div>
      <div class="flex min-w-0 justify-between text-sm gap-4"
           <%= final_payment_row_target_attributes %>>
        <span class="shrink-0 opacity-70"><%= t("shared.amount_summary_card.final_payment_total") %></span>
        <span class="min-w-0 truncate font-bold text-right" title="<%= final_payment_total_display %>" <%= final_payment_total_target_attributes %>><%= final_payment_total_display %></span>
      </div>
    <% end %>

    <% if tax_detail_rows.size > 1 %>
      <%= render "shared/ui/layout/section_divider", class: "mt-4 mb-3" %>
      <div class="space-y-2">
        <p class="truncate text-xs font-bold uppercase tracking-widest opacity-70" title="<%= t("shared.amount_summary_card.tax_details") %>"><%= t("shared.amount_summary_card.tax_details") %></p>
        <% tax_detail_rows.each do |tax_detail_row| %>
          <div class="rounded-lg amount-summary-detail-surface px-3 py-2 text-xs space-y-1">
            <div class="flex min-w-0 justify-between gap-4 font-medium">
              <span class="min-w-0 truncate" title="<%= tax_detail_row.rate_label %><%= t("shared.amount_summary_card.target") %>"><%= tax_detail_row.rate_label %><%= t("shared.amount_summary_card.target") %></span>
              <span class="shrink-0 truncate text-right" title="<%= t("shared.amount_summary_card.tax_amount") %> <%= tax_detail_row.amount_display %>"><%= t("shared.amount_summary_card.tax_amount") %> <%= tax_detail_row.amount_display %></span>
            </div>
            <div class="flex min-w-0 justify-between gap-4 opacity-70">
              <span class="min-w-0 truncate" title="<%= t("shared.amount_summary_card.subtotal") %> <%= tax_detail_row.net_amount_display %>"><%= t("shared.amount_summary_card.subtotal") %> <%= tax_detail_row.net_amount_display %></span>
              <span class="shrink-0 truncate text-right" title="<%= t("shared.amount_summary_card.tax_included") %> <%= tax_detail_row.total_display %>"><%= t("shared.amount_summary_card.tax_included") %> <%= tax_detail_row.total_display %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
