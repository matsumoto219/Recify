<%#
  Shared UI select field

  Required locals:
  - f
  - attribute
  - label
  - options

  Optional locals:
  - selected
  - include_blank
  - required
  - show_label
  - with_icon
  - icon
  - highlight_variant
  - show_error_message
  - select_class
  - select_wrapper_class
  - label_class
  - error_message_class
%>

<%
  selected = local_assigns.fetch(:selected, f.object.public_send(attribute))
  include_blank = local_assigns.fetch(:include_blank, nil)
  required = local_assigns.fetch(:required, false)
  show_label = local_assigns.fetch(:show_label, true)
  with_icon = local_assigns.fetch(:with_icon, local_assigns[:icon].present?)
  icon = local_assigns.fetch(:icon, nil)
  highlight_variant = local_assigns.fetch(:highlight_variant, nil)
  show_error_message = local_assigns.fetch(:show_error_message, true)
  select_class = local_assigns.fetch(:select_class, nil)
  select_wrapper_class = local_assigns.fetch(:select_wrapper_class, nil)
  label_class = local_assigns.fetch(:label_class, nil)
  error_message_class = local_assigns.fetch(:error_message_class, nil)

  has_error = f.object.respond_to?(:errors) && f.object.errors[attribute].present?

  base_wrapper_class = "space-y-2"
  base_label_class = "text-xs font-bold uppercase tracking-wider text-[#C7C4D8]"
  base_select_class = "w-full rounded-lg bg-[#0E0E0E] text-[#E5E2E1] appearance-none outline-none transition-all"
  highlight_classes = if has_error || highlight_variant == :error
                        "border border-[#FFB4AB] focus:ring-2 focus:ring-[#FFB4AB]/30"
                      else
                        "border border-transparent focus:ring-2 focus:ring-[#C0C1FF]/50"
                      end
  select_spacing_class = with_icon ? "pl-11 pr-10" : "px-4 pr-10"
  merged_wrapper_class = [base_wrapper_class, select_wrapper_class].compact.join(" ")
  merged_label_class = [base_label_class, label_class].compact.join(" ")
  merged_select_class = [base_select_class, highlight_classes, select_spacing_class, select_class].compact.join(" ")
  merged_error_class = ["text-xs text-[#FFB4AB]", error_message_class].compact.join(" ")
%>

<div class="<%= merged_wrapper_class %>">
  <% if show_label %>
    <%= f.label attribute, label, class: merged_label_class %>
  <% end %>

  <div class="group relative">
    <% if with_icon && icon.present? %>
      <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-sm pointer-events-none transition-colors <%= has_error || highlight_variant == :error ? 'text-[#FFB4AB] group-focus-within:text-[#FFB4AB]' : 'text-[#C7C4D8] group-focus-within:text-[#C0C1FF]' %>"><%= icon %></span>
    <% end %>

    <%= f.select attribute,
                 options_for_select(options, selected),
                 { include_blank: include_blank },
                 class: merged_select_class,
                 required: required %>

    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-base pointer-events-none transition-colors <%= has_error || highlight_variant == :error ? 'text-[#FFB4AB] group-focus-within:text-[#FFB4AB]' : 'text-[#C7C4D8] group-focus-within:text-[#C0C1FF]' %>">expand_more</span>
  </div>

  <% if show_error_message && has_error %>
    <p class="<%= merged_error_class %>"><%= f.object.errors[attribute].first %></p>
  <% end %>
</div>
