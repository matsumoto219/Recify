<%
  path = local_assigns.fetch(:path)
  icon = local_assigns.fetch(:icon)
  label = local_assigns.fetch(:label)
  active = local_assigns.fetch(:active, false)
  show_label = local_assigns.fetch(:show_label, true)
  extra_classes = local_assigns[:class]

  active_classes = "sidebar-nav-active-bg token-text-brand border-l-4 sidebar-nav-active-border rounded-none md:sidebar-nav-active-shadow xl:shadow-none"
  inactive_classes = "sidebar-nav-muted sidebar-nav-hover sidebar-nav-text-hover"

  link_class = [
    "group relative flex items-center justify-center xl:justify-start gap-0 xl:gap-3 px-2 xl:px-4 py-3 font-medium transition-all duration-200 md:hover:scale-[1.03] xl:hover:scale-100",
    active ? active_classes : inactive_classes,
    extra_classes
  ].compact.join(" ")
%>

<%= link_to path, class: link_class, title: label do %>
  <% if active %>
    <span class="absolute right-2 top-1/2 hidden h-1.5 w-1.5 -translate-y-1/2 rounded-full sidebar-nav-indicator sidebar-nav-indicator-shadow md:block xl:hidden"></span>
  <% end %>
  <span class="material-symbols-outlined"><%= icon %></span>

  <% if show_label %>
    <span class="hidden xl:inline tracking-wide"><%= label %></span>
  <% end %>
  <span class="pointer-events-none absolute left-full top-1/2 z-50 ml-3 hidden -translate-y-1/2 whitespace-nowrap rounded-lg border token-border-glass sidebar-tooltip-surface px-3 py-1.5 text-xs font-bold token-text-base opacity-0 shadow-lg shadow-black/30 transition-opacity duration-150 group-hover:opacity-100 md:block xl:hidden">
    <%= label %>
  </span>
<% end %>
