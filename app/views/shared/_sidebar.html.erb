<aside id="desktop-sidebar" data-component="sidebar" class="hidden md:flex flex-col md:w-20 xl:w-64 fixed left-0 top-0 bottom-0 sidebar-surface py-6 z-50">
  <div class="px-6 mb-10">
    <%= link_to root_path, class: "inline-block" do %>
      <%# TODO: ロゴは仮。タブレット用（md表示時）の簡易ロゴやアイコンロゴを別途用意する可能性あり %>
      <h1 class="hidden xl:block text-xl font-bold token-brand-gradient bg-clip-text text-transparent">Recify</h1>
      <p class="hidden xl:block text-[0.6875rem] token-text-muted tracking-widest font-semibold uppercase mt-1">Receipt Management</p>
    <% end %>
  </div>

  <nav class="flex-1 space-y-1 px-0">
    <%= render "shared/sidebar_nav_item",
      path: receipts_path,
      icon: "receipt_long",
      label: t("dashboard.nav.receipts"),
      active: current_page?(receipts_path) %>

    <%= render "shared/sidebar_nav_item",
      path: select_input_method_receipts_path,
      icon: "add_circle",
      label: t("dashboard.nav.new_receipt"),
      active: current_page?(select_input_method_receipts_path) %>
  </nav>

  <div class="mt-auto">
    <div class="flex flex-col gap-1 mb-4">
      <%= render "shared/sidebar_nav_item",
        path: settings_path,
        icon: "settings",
        label: t("dashboard.nav.settings"),
        active: current_page?(settings_path) %>

      <%# TODO: 問い合わせ導線をここに追加（設定と同グループに配置） %>
    </div>

    <div class="px-4">
      <div class="hidden xl:block token-bg-elevated rounded-xl p-4 border token-border-soft">
        <%= render "shared/ui/status/storage_usage_meter",
              usage: current_user.storage_usage,
              title: t("dashboard.nav.storage_usage"),
              context: "sidebar",
              compact: true %>
      </div>
    </div>
  </div>
</aside>
