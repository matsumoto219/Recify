<footer id="public-footer" class="public-footer-shell">
  <div class="mx-auto grid w-full max-w-7xl grid-cols-[minmax(0,1fr)_auto] items-start gap-x-4 gap-y-6 px-4 pb-[calc(env(safe-area-inset-bottom)+2rem)] pt-12 sm:px-6 md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] md:items-center lg:px-8">
    <div class="col-span-2 flex flex-col items-start gap-2 md:col-span-1 md:justify-self-start">
      <%= render "shared/brand/logo",
            href: root_path,
            variant: :compact,
            size: :sm %>
      <p class="max-w-sm text-sm leading-6 token-text-muted"><%= t("shared.footer.tagline") %></p>
    </div>

    <nav class="min-w-0 justify-self-start md:justify-self-center" aria-label="<%= t("shared.footer.navigation_aria") %>">
      <ul class="flex flex-nowrap items-center gap-x-2 text-[0.6875rem] font-medium leading-5 token-text-muted sm:gap-x-5 sm:text-sm">
        <li><%= link_to t("shared.footer.contact"), contact_path, class: "public-footer-link transition-colors" %></li>
        <li><%= link_to t("shared.footer.terms"), terms_path, class: "public-footer-link transition-colors" %></li>
        <li><%= link_to t("shared.footer.privacy"), privacy_path, class: "public-footer-link transition-colors" %></li>
      </ul>
    </nav>

    <p class="justify-self-end whitespace-nowrap text-right text-[0.6875rem] leading-5 token-text-muted sm:text-sm md:justify-self-end"><%= t("shared.footer.copyright", year: Time.current.year) %></p>
  </div>
</footer>
