<header>
  <%= link_to t("common.app_name"), root_path %>

  <% if user_signed_in? %>
    <%= link_to t("common.logout"), destroy_user_session_path, data: { turbo_method: :delete } %>
  <% else %>
    <%= link_to t("common.login"), new_user_session_path %>
    <%= link_to t("common.sign_up"), new_user_registration_path %>
  <% end %>
</header>
