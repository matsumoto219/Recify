<header id="dashboard-header" data-component="header" data-controller="search" class="fixed top-0 right-0 w-full md:w-[calc(100%-5rem)] xl:w-[calc(100%-16rem)] h-[calc(4rem+env(safe-area-inset-top))] z-40 bg-[#131313]/80 backdrop-blur-md flex justify-between items-center px-4 md:px-8 pt-[env(safe-area-inset-top)]">
  <div class="flex items-center gap-4 flex-1 min-w-0">
    <div class="hidden sm:block max-w-md w-full">
      <%= render "shared/search_box",
        placeholder: "レシートを検索..." %>
    </div>
  </div>

  <div class="flex items-center gap-4 md:gap-6 shrink-0">
    <button type="button"
      class="sm:hidden text-[#C7C4D8] hover:text-white transition-colors"
      data-action="search#toggle"
      aria-label="検索">
      <span class="material-symbols-outlined">search</span>
    </button>
    <%# TODO: 通知機能（未実装）
        想定ユースケース:
        - OCR処理完了通知
        - 要確認レシートの発生通知
        - エラー（読み取り失敗）通知
        - ストレージ上限に近づいた警告
        - 未読件数のバッジ表示（赤丸）
        実装時はNotificationモデル + 既読管理 + バッジ表示を追加 %>
    <button type="button" class="text-[#C7C4D8] hover:text-white transition-colors" aria-label="通知">
      <span class="material-symbols-outlined">notifications</span>
    </button>

    <% if user_signed_in? %>
      <div class="flex items-center gap-3 border-l border-white/10 pl-4 md:pl-6">
        <div class="text-right hidden sm:block">
          <p class="text-xs font-bold text-[#E5E2E1]"><%= current_user.name.presence || current_user.email %></p>
        </div>

        <div class="w-8 h-8 rounded-full overflow-hidden border border-[#C0C1FF]/20 bg-[#2A2A2A] flex items-center justify-center text-[#C0C1FF] text-xs font-bold">
          <% if current_user.respond_to?(:avatar) && current_user.avatar.attached? && current_user.avatar.blob&.persisted? %>
            <%= image_tag current_user.avatar, class: "w-full h-full object-cover" %>
          <% else %>
            <% display_name = (current_user.name.presence || current_user.email).to_s %>
            <%= display_name[0,1]&.upcase || "U" %>
          <% end %>
        </div>

        <%= link_to destroy_user_session_path,
          data: {
            turbo_method: :delete,
            turbo_confirm: "ログアウトしますか？"
          },
          class: "flex items-center gap-1 px-2 py-1 text-[0.75rem] text-[#C7C4D8] hover:text-[#FFB4AB] transition-colors ml-1 rounded-md" do %>
          <span class="material-symbols-outlined text-[16px]">logout</span>
          ログアウト
        <% end %>
      </div>
    <% else %>
      <div class="flex items-center gap-3">
        <%= link_to t("common.login"), new_user_session_path, class: "text-sm text-[#C7C4D8] hover:text-white transition-colors" %>
        <%= link_to t("common.sign_up"), new_user_registration_path, class: "inline-flex items-center rounded-lg bg-[#C0C1FF] text-black px-4 py-2 text-sm font-semibold hover:opacity-90 transition-opacity" %>
      </div>
    <% end %>
  </div>

  <div class="absolute left-4 right-4 top-full mt-3 sm:hidden">
    <%= render "shared/search_box",
      variant: :mobile,
      placeholder: "レシートを検索...",
      panel_data: { search_target: "panel" },
      input_data: { search_target: "input" },
      close_action: "search#close" %>
  </div>
</header>
