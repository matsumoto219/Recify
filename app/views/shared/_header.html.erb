<header id="dashboard-header" data-component="header" data-controller="search" class="fixed top-0 right-0 w-full md:w-[calc(100%-5rem)] xl:w-[calc(100%-16rem)] h-[calc(4rem+env(safe-area-inset-top))] z-40 header-glass flex justify-between items-center px-4 md:px-8 pt-[env(safe-area-inset-top)]">
  <div class="flex items-center gap-4 flex-1 min-w-0">
    <div class="hidden sm:block max-w-md w-full">
      <%= render "shared/search_box",
        placeholder: "レシートを検索..." %>
    </div>
  </div>

  <div class="flex items-center gap-3 md:gap-5 lg:gap-6 shrink-0 ml-2 md:ml-4">
    <button type="button"
      class="sm:hidden token-text-muted header-text-hover transition-colors"
      data-action="search#toggle"
      aria-label="検索">
      <span class="material-symbols-outlined">search</span>
    </button>
    <% if user_signed_in? %>
      <%= turbo_stream_from [current_user, :notifications] %>

      <div class="relative" data-controller="notification-dropdown">
        <button type="button"
          class="relative inline-flex token-text-muted header-text-hover transition-colors"
          aria-label="通知"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="notifications-dropdown"
          data-notification-dropdown-target="button"
          data-action="notification-dropdown#toggle">
          <span class="material-symbols-outlined">notifications</span>
          <%= render "shared/notifications/badge",
            unread_count: current_user.notifications.unread.count %>
        </button>

        <div id="notifications-dropdown"
          class="hidden fixed left-4 right-4 top-[calc(4rem+env(safe-area-inset-top)+0.75rem)] z-50 sm:absolute sm:left-auto sm:right-0 sm:top-full sm:mt-3 sm:w-96 sm:max-w-[calc(100vw-2rem)]"
          role="dialog"
          aria-label="通知"
          data-notification-dropdown-target="panel">
          <%= render "shared/notifications/dropdown",
            notifications: current_user.notifications.recent.limit(5) %>
        </div>
      </div>

      <div class="flex items-center gap-3 border-l token-border-glass pl-4 md:pl-6">
        <div class="text-right hidden sm:block min-w-0 max-w-[160px]">
          <p class="truncate text-xs font-bold token-text-base" title="<%= current_user.name.presence || current_user.email %>">
            <%= current_user.name.presence || current_user.email %>
          </p>
        </div>

        <%= render "shared/ui/avatar",
              user: current_user,
              size: 32,
              class: "border token-border-brand-soft" %>

        <%= link_to destroy_user_session_path,
          data: {
            turbo_method: :delete,
            turbo_confirm: "ログアウトしますか？"
          },
          class: "flex items-center gap-1 px-2 py-1 text-[0.75rem] token-text-muted header-text-error-hover transition-colors ml-1 rounded-md" do %>
          <span class="material-symbols-outlined text-[16px]">logout</span>
          <span class="hidden sm:inline">ログアウト</span>
        <% end %>
      </div>
    <% else %>
      <%# TODO: public_header 分離時に移行予定
          現在の header は dashboard 専用のため、
          未ログイン用ヘッダーは home/index 用の
          public_header へ移行する %>
      <%#
      <div class="flex items-center gap-3">
        <%= link_to t("common.login"), new_user_session_path, class: "text-sm token-text-muted header-text-hover transition-colors"
      %>
        <%= link_to t("common.sign_up"), new_user_registration_path, class: "inline-flex items-center rounded-lg header-brand-bg token-text-on-brand px-4 py-2 text-sm font-semibold hover:opacity-90 transition-opacity" %>
      </div>
      %>
    <% end %>
  </div>

  <div class="absolute left-4 right-4 top-full mt-3 sm:hidden">
    <%= render "shared/search_box",
      variant: :mobile,
      placeholder: "レシートを検索...",
      panel_data: { search_target: "panel" },
      input_data: { search_target: "input" },
      close_action: "search#close" %>
  </div>
</header>
