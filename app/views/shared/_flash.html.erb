<% messages = flash.to_hash.flat_map { |type, v| Array(v).map { |m| [type.to_s, m] } }.reject { |_, m| m.blank? } %>

<% if messages.any? %>
  <!-- Toast Container -->
  <div class="fixed top-4 md:top-20 left-1/2 -translate-x-1/2 md:left-auto md:right-4 md:translate-x-0 z-[9999] flex flex-col gap-3 pointer-events-none w-full max-w-[calc(100%-2rem)] md:max-w-sm">
    <% messages.each_with_index do |(type, message), i| %>
      <%= render "shared/ui/notice_surface",
                 notice_type: type,
                 message: message,
                 dismissible: true,
                 animated: true,
                 animation_name: "slide_right",
                 auto_dismiss: true,
                 max_visible: 3,
                 surface_id: "toast-#{i}",
                 class: "flex items-center gap-3" %>
    <% end %>
  </div>
<% end %>
