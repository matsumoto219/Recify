<%# backdrop-filter のサンプリングが重ならないよう、ガラス風オーバーレイは header-glass の外側に置く %>
<div
  id="mobile-search-panel"
  class="hidden fixed left-4 right-4 top-[calc(4rem+env(safe-area-inset-top)+0.75rem)] z-50 sm:hidden mobile-search-panel-motion"
  data-search-target="panel">
  <%= render "shared/search/search_box",
    variant: :mobile,
    placeholder: t("dashboard.search.placeholder"),
    input_data: { search_target: "input" },
    close_action: "search#close" %>
</div>
