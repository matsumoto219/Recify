<nav id="mobile-bottom-nav" data-component="mobile-bottom-nav" class="md:hidden fixed bottom-0 left-0 w-full z-50">
  <% if content_for?(:mobile_bottom_actions) %>
    <div class="bg-[#131313]/95 backdrop-blur-md border-t border-white/10 px-4 pt-4 pb-3">
      <div class="space-y-3">
        <%= yield :mobile_bottom_actions %>
      </div>
    </div>
  <% end %>

  <div class="glass-panel flex justify-around items-center h-[calc(5rem+env(safe-area-inset-bottom))] border-t border-white/10 px-4 pt-2 pb-[calc(0.5rem+env(safe-area-inset-bottom))]">
    <%= link_to receipts_path,
      class: "flex flex-col items-center gap-2 #{current_page?(receipts_path) ? 'text-[#C0C1FF]' : 'text-[#C7C4D8]'}" do %>
      <span class="material-symbols-outlined">receipt_long</span>
      <span class="text-xs">一覧</span>
    <% end %>

    <%= link_to select_input_method_receipts_path,
      class: "flex flex-col items-center gap-2 #{current_page?(select_input_method_receipts_path) ? 'text-[#C0C1FF]' : 'text-[#C7C4D8]'}" do %>
      <span class="material-symbols-outlined">add_circle</span>
      <span class="text-xs">登録</span>
    <% end %>

    <%= link_to settings_path,
      class: "flex flex-col items-center gap-2 #{current_page?(settings_path) ? 'text-[#C0C1FF]' : 'text-[#C7C4D8]'}" do %>
      <span class="material-symbols-outlined">settings</span>
      <span class="text-xs">設定</span>
    <% end %>
  </div>
