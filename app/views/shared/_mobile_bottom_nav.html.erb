<nav id="mobile-bottom-nav" data-component="mobile-bottom-nav" data-controller="mobile-ui" class="md:hidden fixed bottom-0 left-0 w-full z-50">
  <% if content_for?(:mobile_bottom_actions) %>
    <div
      data-mobile-ui-target="actions"
      class="glass-panel border-t token-border-glass px-4 pt-4 pb-3 transition-transform transition-opacity duration-300 ease-out translate-y-0 will-change-transform">
      <div class="space-y-3">
        <%= yield :mobile_bottom_actions %>
      </div>
    </div>
  <% end %>

  <div data-mobile-ui-target="nav" class="glass-panel border-t token-border-glass flex justify-around items-center h-[calc(5rem+env(safe-area-inset-bottom))] px-4 pt-1 pb-[calc(env(safe-area-inset-bottom))] transition-transform transition-opacity duration-300 ease-out translate-y-0 will-change-transform">
    <%= link_to receipts_path,
      class: "flex flex-col items-center gap-2 #{current_page?(receipts_path) ? 'token-text-brand' : 'token-text-muted'}" do %>
      <span class="material-symbols-outlined">receipt_long</span>
      <span class="text-xs">一覧</span>
    <% end %>

    <%= link_to select_input_method_receipts_path,
      class: "flex flex-col items-center gap-2 #{current_page?(select_input_method_receipts_path) ? 'token-text-brand' : 'token-text-muted'}" do %>
      <span class="material-symbols-outlined">add_circle</span>
      <span class="text-xs">登録</span>
    <% end %>

    <%= link_to settings_path,
      class: "flex flex-col items-center gap-2 #{current_page?(settings_path) ? 'token-text-brand' : 'token-text-muted'}" do %>
      <span class="material-symbols-outlined">settings</span>
      <span class="text-xs">設定</span>
    <% end %>
  </div>
</nav>
