<aside id="desktop-sidebar" data-component="sidebar" class="hidden md:flex flex-col md:w-20 xl:w-64 fixed left-0 top-0 bottom-0 sidebar-surface py-6 z-50">
  <div class="px-0 xl:px-6 mb-10 flex justify-center xl:block">
    <div class="xl:hidden" data-brand-logo-slot="sidebar-narrow">
      <%= render "shared/brand/logo",
            href: root_path,
            variant: :icon,
            size: :lg %>
    </div>

    <div class="hidden xl:block" data-brand-logo-slot="sidebar-full">
      <%= render "shared/brand/logo",
            href: root_path,
            variant: :full,
            size: :md %>
      <p class="text-[0.6875rem] token-text-muted tracking-widest font-semibold uppercase mt-1">Receipt Management</p>
    </div>
  </div>

  <nav class="flex-1 space-y-1 px-0">
    <%= render "shared/navigation/sidebar_nav_item",
      path: receipts_path,
      icon: "receipt_long",
      label: t("dashboard.nav.receipts"),
      active: current_page?(receipts_path) %>

    <%= render "shared/navigation/sidebar_nav_item",
      path: select_input_method_receipts_path,
      icon: "add_circle",
      label: t("dashboard.nav.new_receipt"),
      active: current_page?(select_input_method_receipts_path) %>
  </nav>

  <div class="mt-auto">
    <div class="flex flex-col gap-1 mb-4">
      <%= render "shared/navigation/sidebar_nav_item",
        path: contact_path,
        icon: "mail",
        label: t("dashboard.nav.contact"),
        active: current_page?(contact_path) %>

      <%= render "shared/navigation/sidebar_nav_item",
        path: settings_path,
        icon: "settings",
        label: t("dashboard.nav.settings"),
        active: current_page?(settings_path) %>
    </div>

    <div class="px-4">
      <div class="hidden xl:block token-bg-elevated rounded-xl p-4 border token-border-soft">
        <%= render "shared/ui/status/storage_usage_meter",
              usage: current_user.storage_usage,
              title: t("dashboard.nav.storage_usage"),
              context: "sidebar",
              compact: true %>
      </div>
    </div>
  </div>
</aside>
