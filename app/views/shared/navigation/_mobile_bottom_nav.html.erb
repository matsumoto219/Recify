<%
  mobile_nav_items = [
    {
      path: receipts_path,
      icon: "receipt_long",
      label: t("dashboard.nav.mobile_receipts"),
      active: current_page?(receipts_path)
    },
    {
      path: select_input_method_receipts_path,
      icon: "add_circle",
      label: t("dashboard.nav.mobile_new_receipt"),
      active: current_page?(select_input_method_receipts_path)
    },
    {
      path: settings_path,
      icon: "settings",
      label: t("dashboard.nav.mobile_settings"),
      active: current_page?(settings_path)
    }
  ]
%>

<nav id="mobile-bottom-nav" data-component="mobile-bottom-nav" data-controller="mobile-ui" class="md:hidden fixed bottom-0 left-0 w-full z-50">
  <% if content_for?(:mobile_bottom_actions) %>
    <div
      data-mobile-ui-target="actions"
      class="glass-panel border-t token-border-glass px-4 pt-4 pb-3 transition-transform transition-opacity duration-300 ease-out translate-y-0 will-change-transform">
      <div class="space-y-3">
        <%= yield :mobile_bottom_actions %>
      </div>
    </div>
  <% end %>

  <div data-mobile-ui-target="nav" class="mobile-bottom-nav glass-panel border-t token-border-glass flex justify-around items-center h-[calc(5rem+env(safe-area-inset-bottom))] px-4 pt-1 pb-[calc(env(safe-area-inset-bottom))] transition-transform transition-opacity duration-300 ease-out translate-y-0 will-change-transform">
    <% mobile_nav_items.each do |item| %>
      <%
        aria_options = { label: item[:label] }
        aria_options[:current] = "page" if item[:active]
      %>
      <%= link_to item[:path],
        class: "mobile-bottom-nav-link flex flex-col items-center gap-2 #{item[:active] ? 'token-text-brand' : 'token-text-muted'}",
        aria: aria_options do %>
        <span class="material-symbols-outlined mobile-bottom-nav-icon" aria-hidden="true"><%= item[:icon] %></span>
        <span class="mobile-bottom-nav-label text-xs"><%= item[:label] %></span>
      <% end %>
    <% end %>
  </div>
</nav>
