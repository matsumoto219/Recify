<%
  unread = notification.unread?
  stale_notifiable = notification.stale_notifiable?
  delete_confirm_data = notification.user.delete_confirmation_enabled? ? { turbo_confirm: t("notifications.item.delete_confirm") } : {}
  action_button_classes = "inline-flex h-9 items-center justify-center gap-1.5 whitespace-nowrap rounded-lg token-border-soft token-bg-card token-hover-bg-card-subtle px-3 text-xs font-semibold transition-colors"
  item_classes = [
    "token-bg-card",
    "token-border-soft",
    "rounded-lg border p-4 transition-colors",
    ("token-brand-soft-bg" if unread)
  ].compact.join(" ")
%>

<article id="<%= dom_id(notification) %>" class="<%= item_classes %>">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2">
        <% if unread %>
          <span class="h-2 w-2 rounded-full token-state-error-soft" aria-hidden="true"></span>
        <% end %>
        <h2 class="truncate text-sm font-bold token-text-base"><%= notification.title %></h2>
      </div>

      <% if notification.body.present? %>
        <p class="mt-2 text-sm token-text-muted"><%= notification.body %></p>
      <% end %>

      <% if stale_notifiable %>
        <p class="mt-2 text-sm token-text-subtle"><%= t("notifications.item.deleted_target") %></p>
      <% end %>

      <p class="mt-3 text-xs token-text-subtle">
        <%= l(notification.created_at, format: :short) %>
      </p>
    </div>

    <div class="flex shrink-0 items-center gap-2">
      <% if unread %>
        <%= button_to t("notifications.item.mark_as_read"),
          read_notification_path(notification),
          method: :patch,
          form: { class: "contents" },
          class: "#{action_button_classes} token-text-base cursor-pointer" %>
      <% elsif notification.action_available? %>
        <%= link_to t("notifications.item.open"),
          notification.action_path,
          class: "#{action_button_classes} token-text-base" %>
      <% end %>

      <%= button_to notification_path(notification),
        method: :delete,
        form: { class: "contents" },
        data: delete_confirm_data,
        class: "#{action_button_classes} token-text-error cursor-pointer",
        aria: { label: t("notifications.item.delete_aria", title: notification.title) },
        title: t("notifications.item.delete_aria", title: notification.title) do %>
        <span class="material-symbols-outlined text-[16px] leading-none" aria-hidden="true">close</span>
        <span><%= t("notifications.item.delete") %></span>
      <% end %>
    </div>
  </div>
</article>
