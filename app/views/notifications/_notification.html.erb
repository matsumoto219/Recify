<%#
  通知一覧の通知行

  必須:
  - notification: 表示する通知オブジェクト

  任意:
  - なし
%>

<%
  item_state = notification_list_item_state(notification)
%>

<article id="<%= dom_id(notification) %>" class="<%= item_state.item_classes %>">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2">
        <% if item_state.unread? %>
          <span class="h-2 w-2 rounded-full token-state-error-soft" aria-hidden="true"></span>
        <% end %>
        <h2 class="truncate text-sm font-bold token-text-base"><%= notification.title %></h2>
      </div>

      <% if notification.body.present? %>
        <p class="mt-2 break-words text-sm token-text-muted [overflow-wrap:anywhere]"><%= notification.body %></p>
      <% end %>

      <% if item_state.stale_notifiable? %>
        <p class="mt-2 text-sm token-text-subtle"><%= t("notifications.item.deleted_target") %></p>
      <% end %>

      <p class="mt-3 text-xs token-text-subtle">
        <%= l(notification.created_at, format: :short) %>
      </p>
    </div>

    <div class="flex shrink-0 items-center gap-2">
      <% if item_state.unread? %>
        <%= form_with url: item_state.read_path, method: :patch, local: true, class: "contents" do %>
          <%= render "shared/ui/actions/button",
                label: t("notifications.item.mark_as_read"),
                variant: :secondary,
                size: :sm,
                type: "submit",
                class: "h-9 whitespace-nowrap px-3 text-xs" %>
        <% end %>
      <% elsif item_state.action_available? %>
        <%= render "shared/ui/actions/button",
              as: :link,
              href: item_state.action_path,
              label: t("notifications.item.open"),
              variant: :secondary,
              size: :sm,
              class: "h-9 whitespace-nowrap px-3 text-xs" %>
      <% end %>

      <%= form_with url: notification_path(notification),
        method: :delete,
        local: true,
        class: "contents" do %>
        <%= render "shared/ui/actions/button",
              label: t("notifications.item.delete"),
              variant: :danger,
              size: :sm,
              type: "submit",
              icon: "close",
              data: item_state.delete_confirm_data,
              class: "h-9 whitespace-nowrap px-3 text-xs",
              html_options: {
                "aria-label": t("notifications.item.delete_aria", title: notification.title),
                title: t("notifications.item.delete_aria", title: notification.title)
              } %>
      <% end %>
    </div>
  </div>
</article>
