<section
  class="max-w-3xl mx-auto space-y-12 px-0 md:px-2 py-2 pb-28 md:pb-2"
  data-controller="settings"
  data-action="segmented-control:success->settings#applySegmentedControlSetting">
  <%= render "shared/ui/section_header",
        title: "設定",
        subtitle: "アカウント情報やセキュリティ設定を管理できます",
        title_size: "text-3xl",
        subtitle_size: "text-base" %>

  <div class="space-y-6">
    <%= render "shared/ui/surface_card", hoverable: true, padding: :md do %>
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 min-w-0">
        <div class="flex min-w-0 w-full max-w-full items-center gap-5 overflow-hidden md:w-0 md:flex-1">
          <div class="relative flex shrink-0 flex-col items-center gap-2">
            <div class="w-20 h-20 rounded-full overflow-hidden border-2 token-border-brand-soft token-bg-elevated flex items-center justify-center token-text-brand text-xl font-bold">
              <% if current_user.respond_to?(:avatar) && current_user.avatar.attached? && current_user.avatar.blob&.persisted? %>
                <%= image_tag current_user.avatar, class: "w-full h-full object-cover" %>
              <% else %>
                <% display_name = (current_user.name.presence || current_user.email).to_s %>
                <%= display_name[0,1]&.upcase || "U" %>
              <% end %>
            </div>
            <span class="inline-flex w-fit shrink-0 token-brand-soft-bg token-text-brand text-[10px] font-bold px-2 py-0.5 rounded-full border token-border-brand-soft md:hidden">
              <%= current_user.guest? ? "ゲストユーザー" : "本登録ユーザー" %>
            </span>
          </div>

          <div class="min-w-0 w-0 flex-1 overflow-hidden space-y-1">
            <div class="grid min-w-0 max-w-full grid-cols-1 gap-1 overflow-hidden md:grid-cols-[minmax(0,1fr)_auto] md:items-center md:gap-3">
              <div class="min-w-0 flex-1 overflow-hidden">
                <h2 class="block max-w-full truncate text-lg font-semibold token-text-base" title="<%= current_user.name.presence || "ユーザー名未設定" %>"><%= current_user.name.presence || "ユーザー名未設定" %></h2>
              </div>
              <span class="hidden w-fit self-start shrink-0 token-brand-soft-bg token-text-brand text-[10px] font-bold px-2 py-0.5 rounded-full border token-border-brand-soft md:inline-flex md:self-auto">
                <%= current_user.guest? ? "ゲストユーザー" : "本登録ユーザー" %>
              </span>
            </div>
            <p class="text-sm token-text-muted truncate min-w-0" title="<%= current_user.email %>"><%= masked_email_with_domain(current_user.email, local_max_length: 10, local_max_length_mobile: 6, domain_max_length_mobile: 14) %></p>
          </div>
        </div>

        <div class="w-full mt-2 md:mt-0 md:w-auto md:shrink-0">
          <%= render "shared/ui/button",
                as: :link,
                href: settings_account_path,
                label: "プロフィールを編集",
                variant: :secondary,
                size: :compact,
                full_width: true,
                class: "md:w-auto" %>
        </div>
      </div>
    <% end %>

    <%= render "shared/ui/surface_card", padding: :md do %>
      <%= render "shared/ui/section_header",
            icon: "monitoring",
            title: "システム状態",
            class: "mb-6" %>

      <div class="space-y-3">
        <%# TODO: 本実装では ExternalServiceStatus から状態を取得する %>
        <%# v0.5: 監視ジョブ（ExternalServiceStatus + 定期APIチェック）と連携し、状態を自動更新する %>
        <%# 表示更新は Turbo Streams または polling でリアルタイム反映する想定 %>
        <%# 例: state: @ocr_service_status.state.to_sym %>
        <%= render "shared/ui/service_status_badge",
              label: "OCRサービス",
              state: @ocr_state %>

        <%= render "shared/ui/service_status_badge",
              label: "AIサービス",
              state: @ai_state %>
      </div>
    <% end %>

    <%= render "shared/ui/surface_card", padding: :md do %>
      <%= render "shared/ui/section_header",
            icon: "shield",
            title: "セキュリティ",
            class: "mb-6" %>

      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row gap-3">
          <%= render "shared/ui/button",
                as: :link,
                href: settings_security_path(anchor: "email"),
                label: "メールアドレス変更",
                variant: :secondary,
                full_width: true,
                class: "px-4 text-left",
                trailing_icon: "chevron_right",
                trailing_icon_animated: true %>

          <%= render "shared/ui/button",
                as: :link,
                href: settings_security_path(anchor: "password"),
                label: "パスワード変更",
                variant: :secondary,
                full_width: true,
                class: "px-4 text-left",
                trailing_icon: "chevron_right",
                trailing_icon_animated: true %>
        </div>

        <%= render "shared/ui/section_divider" %>
        <div class="space-y-3">
          <%# TODO: 2要素認証（2FA）を実装する。現状はダミー表示 %>
          <div class="flex items-center justify-between text-sm">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined token-text-muted text-sm">info</span>
              <span class="token-text-muted">2要素認証 (2FA)</span>
            </div>
            <%= render "shared/ui/setting_status_badge",
                  state: :inactive,
                  variant: :text,
                  size: :lg %>
          </div>

          <%# TODO: Passkey 設定機能を実装する。現状はダミー表示 %>
          <div class="flex items-center justify-between text-sm">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined token-text-muted text-sm">info</span>
              <span class="token-text-muted">Passkey 設定</span>
            </div>
            <%= render "shared/ui/setting_status_badge",
                  state: :inactive,
                  variant: :text,
                  size: :lg %>
          </div>

          <p class="text-[11px] token-text-subtle leading-relaxed">
            ※ アカウントの安全性を高めるために、定期的なパスワード変更と追加認証機能の利用を推奨します。
          </p>
        </div>
      </div>
    <% end %>

    <%= render "shared/ui/surface_card", padding: :md do %>
      <%= render "shared/ui/section_header",
            icon: "palette",
            title: "外観",
            class: "mb-6" %>

      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div class="space-y-1">
          <h3 class="text-sm font-semibold token-text-base">表示テーマ</h3>
          <p class="text-xs token-text-muted leading-relaxed">
            アプリケーションの見た目を設定します
          </p>
        </div>

        <%= render "shared/ui/segmented_control",
              name: "theme_preference",
              value: current_user.theme_preference,
              url: settings_path,
              method: :patch,
              remote: true,
              size: :sm,
              options: [
                { label: "自動", value: "system", icon: "brightness_auto" },
                { label: "ライト", value: "light", icon: "light_mode" },
                { label: "ダーク", value: "dark", icon: "dark_mode" }
              ] %>
      </div>

      <p class="text-[11px] token-text-subtle leading-relaxed mt-3">
        ※ 「自動」を選択すると、OSのシステム設定に応じてテーマが切り替わります。
      </p>
    <% end %>

    <%= render "shared/ui/surface_card", padding: :md do %>
      <%= render "shared/ui/section_header",
            icon: "settings",
            title: "利用設定",
            class: "mb-6" %>

      <div class="space-y-6">
        <%# TODO: 通知配信そのものは未実装。ここでは利用設定トグルの保存動作のみ提供する %>
        <%= render "shared/ui/toggle_switch",
              label: "プッシュ通知",
              description: "レシート処理の完了や要確認項目を通知します",
              checked: current_user.push_notification_enabled,
              name: "push_notification_enabled",
              url: settings_path,
              remote: true %>

        <%= render "shared/ui/toggle_switch",
              label: "明細削除の確認",
              description: "レシート明細を削除する前に確認ダイアログを表示します",
              checked: current_user.receipt_item_delete_confirmation_enabled,
              name: "receipt_item_delete_confirmation_enabled",
              url: settings_path,
              remote: true %>

        <%= render "shared/ui/toggle_switch",
              label: "AI補完",
              description: "商品名をAIが補完します<br>補完内容は正確でない可能性があるため、必ず内容を確認してください".html_safe,
              checked: current_user.product_name_ai_completion_enabled,
              name: "product_name_ai_completion_enabled",
              url: settings_path,
              remote: true %>

        <%# TODO: レシート画像最適化設定は v1.0以降で再検討する %>
      </div>
    <% end %>

    <%= render "shared/ui/surface_card",
          variant: :danger,
          shadow_variant: :danger,
          padding: :md do %>
      <%= render "shared/ui/section_header",
            icon: "delete",
            title: "アカウント操作",
            variant: :danger,
            class: "mb-6" %>

      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row gap-4">
          <%= button_to user_registration_path,
                        method: :delete,
                        data: { turbo_confirm: "退会すると、アカウントに紐づくすべてのデータが削除されます。\nこの操作は取り消すことができませんのでご注意ください。\n必要なレシートは事前にダウンロードすることをおすすめします。\n\n本当にアカウントを削除してもよろしいですか？" },
                        class: "contents" do %>
            <%= render "shared/ui/button",
                  as: :content,
                  label: "退会",
                  variant: :danger,
                  size: :compact %>
          <% end %>
        </div>

        <div class="flex items-start gap-2 pt-2">
          <span class="material-symbols-outlined token-text-error text-sm mt-0.5">warning</span>
          <p class="text-xs token-text-error-muted leading-relaxed">
            退会するとアカウントに紐づくデータが削除されます。この操作は取り消すことができませんのでご注意ください。
          </p>
        </div>
      </div>
    <% end %>
  </div>
</section>
