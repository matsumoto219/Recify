<% content_for :title, t("meta.title_format", title: t("settings.index.title"), site: t("meta.site_name")) %>

<section
  class="max-w-3xl mx-auto space-y-12 px-0 md:px-2 py-2 pb-28 md:pb-2"
  data-controller="settings service-status-polling"
  data-service-status-polling-status-url-value="<%= external_services_status_path %>"
  data-service-status-polling-interval-value="30000"
  data-action="segmented-control:success->settings#applySegmentedControlSetting">
  <% settings_presenter = @settings_index_presenter %>
  <%= render "shared/ui/layout/section_header",
        title: t("settings.index.title"),
        subtitle: t("settings.index.subtitle"),
        title_size: "text-2xl md:text-3xl",
        subtitle_size: "text-sm md:text-base" %>

  <div class="space-y-6">
    <%= render "shared/ui/layout/surface_card", hoverable: true, padding: :md do %>
      <%
        user_status_label = settings_presenter.user_status_label
        user_name_label = settings_presenter.user_name_label
        user_email_label = settings_presenter.user_email_label
      %>
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 min-w-0">
        <div class="flex min-w-0 w-full max-w-full items-center gap-5 overflow-hidden md:w-0 md:flex-1">
          <div class="relative flex shrink-0 flex-col items-center gap-2">
            <%= render "shared/ui/miscellaneous/avatar",
                  user: current_user,
                  size: 80,
                  class: "border-2 token-border-brand-soft" %>
            <span class="inline-flex w-fit shrink-0 token-brand-soft-bg token-text-brand text-[10px] font-bold px-2 py-0.5 rounded-full border token-border-brand-soft md:hidden">
              <%= user_status_label %>
            </span>
          </div>

          <div class="min-w-0 w-0 flex-1 overflow-hidden space-y-1">
            <div class="grid min-w-0 max-w-full grid-cols-1 gap-1 overflow-hidden md:grid-cols-[minmax(0,1fr)_auto] md:items-center md:gap-3">
              <div class="min-w-0 flex-1 overflow-hidden">
                <h2 class="block max-w-full truncate text-lg font-semibold token-text-base" title="<%= user_name_label %>"><%= user_name_label %></h2>
              </div>
              <span class="hidden w-fit self-start shrink-0 token-brand-soft-bg token-text-brand text-[10px] font-bold px-2 py-0.5 rounded-full border token-border-brand-soft md:inline-flex md:self-auto">
                <%= user_status_label %>
              </span>
            </div>
            <p class="text-sm token-text-muted truncate min-w-0" title="<%= user_email_label %>"><%= user_email_label %></p>
          </div>
        </div>

        <div class="w-full mt-2 md:mt-0 md:w-auto md:shrink-0">
          <%= render "shared/ui/actions/button",
                as: :link,
                href: settings_account_path,
                label: t("settings.index.user.edit_profile"),
                variant: :secondary,
                size: :compact,
                full_width: true,
                class: "md:w-auto" %>
        </div>
      </div>
    <% end %>

    <%= render "shared/ui/layout/surface_card", padding: :md do %>
      <%= render "shared/ui/layout/section_header",
            icon: "shield",
            title: t("settings.index.sections.security"),
            class: "mb-6" %>

      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row gap-3">
          <% if settings_presenter.guest? %>
            <%= render "shared/ui/actions/button",
                  as: :link,
                  href: settings_security_path(anchor: "guest-registration"),
                  label: t("settings.index.security.guest_registration"),
                  variant: :secondary,
                  full_width: true,
                  class: "px-4 text-left",
                  trailing_icon: "chevron_right",
                  trailing_icon_animated: true %>
          <% else %>
            <%= render "shared/ui/actions/button",
                  as: :link,
                  href: settings_security_path(anchor: "email"),
                  label: t("settings.index.security.email"),
                  variant: :secondary,
                  full_width: true,
                  class: "px-4 text-left",
                  trailing_icon: "chevron_right",
                  trailing_icon_animated: true %>

            <%= render "shared/ui/actions/button",
                  as: :link,
                  href: settings_security_path(anchor: "password"),
                  label: t("settings.index.security.password"),
                  variant: :secondary,
                  full_width: true,
                  class: "px-4 text-left",
                  trailing_icon: "chevron_right",
                  trailing_icon_animated: true %>
          <% end %>
        </div>

        <% unless settings_presenter.guest? %>
          <%= render "shared/ui/layout/section_divider" %>
          <div class="space-y-3">
            <div class="flex items-center justify-between text-sm">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined token-text-muted text-sm">info</span>
                <span class="token-text-muted"><%= t("settings.index.security.two_factor") %></span>
              </div>
              <%= render "shared/ui/badge/setting_status_badge",
                    state: settings_presenter.totp_state,
                    variant: :text,
                    size: :lg %>
            </div>

            <div class="flex items-center justify-between text-sm">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined token-text-muted text-sm">info</span>
                <span class="token-text-muted"><%= t("settings.index.security.passkey") %></span>
              </div>
              <%= render "shared/ui/badge/setting_status_badge",
                    state: settings_presenter.passkey_state,
                    variant: :text,
                    size: :lg %>
            </div>

            <p class="text-[11px] token-text-subtle leading-relaxed">
              <%= t("settings.index.security.hint") %>
            </p>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= render "shared/ui/layout/surface_card", padding: :md do %>
      <%= render "shared/ui/layout/section_header",
            icon: "monitoring",
            title: t("settings.index.sections.system_status"),
            class: "mb-6" %>

      <div class="space-y-3">
        <div data-service-status-polling-target="serviceBadge" data-service="ocr">
          <%= render "shared/ui/badge/service_status_badge",
                label: t("settings.index.services.ocr"),
                state: @ocr_state %>
        </div>

        <div data-service-status-polling-target="serviceBadge" data-service="ai">
          <%= render "shared/ui/badge/service_status_badge",
                label: t("settings.index.services.ai"),
                state: @ai_state %>
        </div>
      </div>
    <% end %>

    <%= render "shared/ui/layout/surface_card", padding: :md do %>
      <%= render "shared/ui/layout/section_header",
            icon: "database",
            title: t("settings.index.sections.storage"),
            class: "mb-6" %>

      <%= render "shared/ui/status/storage_usage_meter",
            usage: settings_presenter.storage_usage,
            context: "settings",
            compact: false %>
    <% end %>

    <%= render "shared/ui/layout/surface_card", padding: :md do %>
      <%= render "shared/ui/layout/section_header",
            icon: "palette",
            title: t("settings.index.sections.appearance"),
            class: "mb-6" %>

      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div class="space-y-1">
          <h3 class="text-sm font-semibold token-text-base"><%= t("settings.index.appearance.theme_label") %></h3>
          <p class="text-xs token-text-muted leading-relaxed">
            <%= t("settings.index.appearance.theme_description") %>
          </p>
        </div>

        <%= render "shared/ui/form/segmented_control",
              name: "theme_preference",
              value: current_user.theme_preference,
              url: settings_path,
              method: :patch,
              remote: true,
              size: :sm,
              options: settings_presenter.theme_options %>
      </div>

      <p class="text-[11px] token-text-subtle leading-relaxed mt-3">
        <%= t("settings.index.appearance.theme_hint") %>
      </p>
    <% end %>

    <%= render "shared/ui/layout/surface_card", padding: :md do %>
      <%= render "shared/ui/layout/section_header",
            icon: "calculate",
            title: t("settings.index.sections.calculation"),
            subtitle: t("settings.index.calculation.description"),
            class: "mb-6" %>

      <div class="space-y-6">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <div class="space-y-1">
            <h3 class="text-sm font-semibold token-text-base"><%= t("settings.index.calculation.tax_rounding.label") %></h3>
            <p class="text-xs token-text-muted leading-relaxed">
              <%= t("settings.index.calculation.tax_rounding.description") %>
            </p>
          </div>

          <%= render "shared/ui/form/segmented_control",
                name: "tax_rounding_mode",
                value: current_user.tax_rounding_mode,
                url: settings_path,
                method: :patch,
                remote: true,
                size: :sm,
                full_width: true,
                wrapper_class: "md:w-auto",
                options: settings_presenter.rounding_mode_options %>
        </div>

        <%= render "shared/ui/layout/section_divider" %>

        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <div class="space-y-1">
            <h3 class="text-sm font-semibold token-text-base"><%= t("settings.index.calculation.discount_rounding.label") %></h3>
            <p class="text-xs token-text-muted leading-relaxed">
              <%= t("settings.index.calculation.discount_rounding.description") %>
            </p>
          </div>

          <%= render "shared/ui/form/segmented_control",
                name: "discount_rounding_mode",
                value: current_user.discount_rounding_mode,
                url: settings_path,
                method: :patch,
                remote: true,
                size: :sm,
                full_width: true,
                wrapper_class: "md:w-auto",
                options: settings_presenter.rounding_mode_options %>
        </div>
      </div>

      <p class="text-[11px] token-text-subtle leading-relaxed mt-4">
        <%= t("settings.index.calculation.hint") %>
      </p>
    <% end %>

    <%= render "shared/ui/layout/surface_card", padding: :md do %>
      <%= render "shared/ui/layout/section_header",
            icon: "settings",
            title: t("settings.index.sections.usage"),
            class: "mb-6" %>

      <div class="space-y-6">
        <%= render "shared/ui/form/toggle_switch",
              label: t("settings.index.usage.push_notification.label"),
              description: t("settings.index.usage.push_notification.description"),
              checked: current_user.push_notification_enabled,
              name: "push_notification_enabled",
              url: settings_path,
              remote: true %>

        <%= render "shared/ui/form/toggle_switch",
              label: t("settings.index.usage.delete_confirmation.label"),
              description: t("settings.index.usage.delete_confirmation.description"),
              checked: current_user.delete_confirmation_enabled,
              name: "delete_confirmation_enabled",
              url: settings_path,
              remote: true %>

        <%= render "shared/ui/form/toggle_switch",
              label: t("settings.index.usage.product_name_ai_completion.label"),
              description: t("settings.index.usage.product_name_ai_completion.description"),
              description_class: "whitespace-pre-line",
              checked: current_user.product_name_ai_completion_enabled,
              name: "product_name_ai_completion_enabled",
              url: settings_path,
              remote: true %>

        <%= render "shared/ui/form/toggle_switch",
              label: t("settings.index.usage.keep_receipt_images.label"),
              description: t("settings.index.usage.keep_receipt_images.description"),
              description_class: "whitespace-pre-line",
              checked: settings_presenter.keep_receipt_images_enabled?,
              name: "keep_receipt_images",
              url: settings_path,
              remote: true %>

      </div>
    <% end %>

    <%= render "shared/ui/layout/surface_card", padding: :md do %>
      <%= render "shared/ui/layout/section_header",
            icon: "contact_support",
            title: t("settings.index.sections.support"),
            subtitle: t("settings.index.support.description"),
            class: "mb-6" %>

      <div class="grid gap-3 sm:grid-cols-2">
        <%= render "shared/ui/actions/button",
              as: :link,
              href: announcements_path,
              label: t("settings.index.support.announcements"),
              variant: :secondary,
              full_width: true,
              class: "px-4 text-left",
              trailing_icon: "chevron_right",
              trailing_icon_animated: true %>

        <%= render "shared/ui/actions/button",
              as: :link,
              href: contact_path,
              label: t("settings.index.support.contact"),
              variant: :secondary,
              full_width: true,
              class: "px-4 text-left",
              trailing_icon: "chevron_right",
              trailing_icon_animated: true %>
      </div>
    <% end %>

    <%= render "shared/ui/layout/surface_card", padding: :md do %>
      <%= render "shared/ui/layout/section_header",
            icon: "policy",
            title: t("settings.index.sections.legal"),
            subtitle: t("settings.index.legal.description"),
            class: "mb-6" %>

      <div class="grid gap-3 sm:grid-cols-2">
        <%= render "shared/ui/actions/button",
              as: :link,
              href: terms_path,
              label: t("settings.index.legal.terms"),
              variant: :secondary,
              full_width: true,
              class: "px-4 text-left",
              trailing_icon: "chevron_right",
              trailing_icon_animated: true %>

        <%= render "shared/ui/actions/button",
              as: :link,
              href: privacy_path,
              label: t("settings.index.legal.privacy"),
              variant: :secondary,
              full_width: true,
              class: "px-4 text-left",
              trailing_icon: "chevron_right",
              trailing_icon_animated: true %>
      </div>
    <% end %>

    <%= render "shared/ui/layout/surface_card",
          variant: :danger,
          shadow_variant: :danger,
          padding: :md do %>
      <%= render "shared/ui/layout/section_header",
            icon: "person_off",
            title: t("settings.index.sections.account_actions"),
            variant: :danger,
            class: "mb-6" %>

      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row gap-4">
          <%= form_with url: user_registration_path,
                        method: :delete,
                        local: true,
                        data: confirm_dialog_data(
                          t("settings.index.danger.confirm"),
                          variant: :danger,
                          icon: :delete,
                          confirm_label: t("settings.index.danger.delete_account")
                        ),
                        class: "contents" do %>
            <%= render "shared/ui/actions/button",
                  label: t("settings.index.danger.delete_account"),
                  variant: :danger,
                  type: "submit",
                  size: :compact %>
          <% end %>
        </div>

        <div class="flex items-start gap-2 pt-2">
          <span class="material-symbols-outlined token-text-error text-sm mt-0.5">warning</span>
          <p class="text-xs token-text-error-muted leading-relaxed">
            <%= t("settings.index.danger.hint") %>
          </p>
        </div>
      </div>
    <% end %>
  </div>
</section>
