<section
  class="max-w-3xl mx-auto space-y-12 px-0 md:px-2 py-2 pb-28 md:pb-2"
  data-controller="settings"
  data-action="segmented-control:success->settings#applySegmentedControlSetting">
  <%= render "shared/ui/section_header",
        title: t("settings.index.title"),
        subtitle: t("settings.index.subtitle"),
        title_size: "text-3xl",
        subtitle_size: "text-base" %>

  <div class="space-y-6">
    <%= render "shared/ui/surface_card", hoverable: true, padding: :md do %>
      <%
        user_status_label = current_user.guest? ? t("settings.index.user.guest") : t("settings.index.user.registered")
        user_name_label = current_user.name.presence || t("settings.index.user.name_missing")
      %>
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 min-w-0">
        <div class="flex min-w-0 w-full max-w-full items-center gap-5 overflow-hidden md:w-0 md:flex-1">
          <div class="relative flex shrink-0 flex-col items-center gap-2">
            <%= render "shared/ui/avatar",
                  user: current_user,
                  size: 80,
                  class: "border-2 token-border-brand-soft" %>
            <span class="inline-flex w-fit shrink-0 token-brand-soft-bg token-text-brand text-[10px] font-bold px-2 py-0.5 rounded-full border token-border-brand-soft md:hidden">
              <%= user_status_label %>
            </span>
          </div>

          <div class="min-w-0 w-0 flex-1 overflow-hidden space-y-1">
            <div class="grid min-w-0 max-w-full grid-cols-1 gap-1 overflow-hidden md:grid-cols-[minmax(0,1fr)_auto] md:items-center md:gap-3">
              <div class="min-w-0 flex-1 overflow-hidden">
                <h2 class="block max-w-full truncate text-lg font-semibold token-text-base" title="<%= user_name_label %>"><%= user_name_label %></h2>
              </div>
              <span class="hidden w-fit self-start shrink-0 token-brand-soft-bg token-text-brand text-[10px] font-bold px-2 py-0.5 rounded-full border token-border-brand-soft md:inline-flex md:self-auto">
                <%= user_status_label %>
              </span>
            </div>
            <p class="text-sm token-text-muted truncate min-w-0" title="<%= current_user.email %>"><%= masked_email_with_domain(current_user.email, local_max_length: 10, local_max_length_mobile: 6, domain_max_length_mobile: 14) %></p>
          </div>
        </div>

        <div class="w-full mt-2 md:mt-0 md:w-auto md:shrink-0">
          <%= render "shared/ui/button",
                as: :link,
                href: settings_account_path,
                label: t("settings.index.user.edit_profile"),
                variant: :secondary,
                size: :compact,
                full_width: true,
                class: "md:w-auto" %>
        </div>
      </div>
    <% end %>

    <%= render "shared/ui/surface_card", padding: :md do %>
      <%= render "shared/ui/section_header",
            icon: "shield",
            title: t("settings.index.sections.security"),
            class: "mb-6" %>

      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row gap-3">
          <%= render "shared/ui/button",
                as: :link,
                href: settings_security_path(anchor: "email"),
                label: t("settings.index.security.email"),
                variant: :secondary,
                full_width: true,
                class: "px-4 text-left",
                trailing_icon: "chevron_right",
                trailing_icon_animated: true %>

          <%= render "shared/ui/button",
                as: :link,
                href: settings_security_path(anchor: "password"),
                label: t("settings.index.security.password"),
                variant: :secondary,
                full_width: true,
                class: "px-4 text-left",
                trailing_icon: "chevron_right",
                trailing_icon_animated: true %>
        </div>

        <%= render "shared/ui/section_divider" %>
        <div class="space-y-3">
          <%# TODO: 2要素認証（2FA）を実装する。現状はダミー表示 %>
          <div class="flex items-center justify-between text-sm">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined token-text-muted text-sm">info</span>
              <span class="token-text-muted"><%= t("settings.index.security.two_factor") %></span>
            </div>
            <%= render "shared/ui/setting_status_badge",
                  state: :inactive,
                  variant: :text,
                  size: :lg %>
          </div>

          <%# TODO: Passkey 設定機能を実装する。現状はダミー表示 %>
          <div class="flex items-center justify-between text-sm">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined token-text-muted text-sm">info</span>
              <span class="token-text-muted"><%= t("settings.index.security.passkey") %></span>
            </div>
            <%= render "shared/ui/setting_status_badge",
                  state: :inactive,
                  variant: :text,
                  size: :lg %>
          </div>

          <p class="text-[11px] token-text-subtle leading-relaxed">
            <%= t("settings.index.security.hint") %>
          </p>
        </div>
      </div>
    <% end %>

    <%= render "shared/ui/surface_card", padding: :md do %>
      <%= render "shared/ui/section_header",
            icon: "monitoring",
            title: t("settings.index.sections.system_status"),
            class: "mb-6" %>

      <div class="space-y-3">
        <%# TODO: 本実装では ExternalServiceStatus から状態を取得する %>
        <%# v0.5: 監視ジョブ（ExternalServiceStatus + 定期APIチェック）と連携し、状態を自動更新する %>
        <%# 表示更新は Turbo Streams または polling でリアルタイム反映する想定 %>
        <%# 例: state: @ocr_service_status.state.to_sym %>
        <%= render "shared/ui/service_status_badge",
              label: t("settings.index.services.ocr"),
              state: @ocr_state %>

        <%= render "shared/ui/service_status_badge",
              label: t("settings.index.services.ai"),
              state: @ai_state %>
      </div>
    <% end %>

    <%= render "shared/ui/surface_card", padding: :md do %>
      <%= render "shared/ui/section_header",
            icon: "database",
            title: t("settings.index.sections.storage"),
            class: "mb-6" %>

      <%= render "shared/ui/storage_usage_meter",
            usage: current_user.storage_usage,
            context: "settings",
            compact: false %>
    <% end %>

    <%= render "shared/ui/surface_card", padding: :md do %>
      <%= render "shared/ui/section_header",
            icon: "palette",
            title: t("settings.index.sections.appearance"),
            class: "mb-6" %>

      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div class="space-y-1">
          <h3 class="text-sm font-semibold token-text-base"><%= t("settings.index.appearance.theme_label") %></h3>
          <p class="text-xs token-text-muted leading-relaxed">
            <%= t("settings.index.appearance.theme_description") %>
          </p>
        </div>

        <%= render "shared/ui/segmented_control",
              name: "theme_preference",
              value: current_user.theme_preference,
              url: settings_path,
              method: :patch,
              remote: true,
              size: :sm,
              options: [
                { label: t("settings.index.appearance.theme_options.system"), value: "system", icon: "brightness_auto" },
                { label: t("settings.index.appearance.theme_options.light"), value: "light", icon: "light_mode" },
                { label: t("settings.index.appearance.theme_options.dark"), value: "dark", icon: "dark_mode" }
              ] %>
      </div>

      <p class="text-[11px] token-text-subtle leading-relaxed mt-3">
        <%= t("settings.index.appearance.theme_hint") %>
      </p>
    <% end %>

    <%= render "shared/ui/surface_card", padding: :md do %>
      <%= render "shared/ui/section_header",
            icon: "settings",
            title: t("settings.index.sections.usage"),
            class: "mb-6" %>

      <div class="space-y-6">
        <%# TODO: 通知配信そのものは未実装。ここでは利用設定トグルの保存動作のみ提供する %>
        <%= render "shared/ui/toggle_switch",
              label: t("settings.index.usage.push_notification.label"),
              description: t("settings.index.usage.push_notification.description"),
              checked: current_user.push_notification_enabled,
              name: "push_notification_enabled",
              url: settings_path,
              remote: true %>

        <%= render "shared/ui/toggle_switch",
              label: t("settings.index.usage.receipt_item_delete_confirmation.label"),
              description: t("settings.index.usage.receipt_item_delete_confirmation.description"),
              checked: current_user.receipt_item_delete_confirmation_enabled,
              name: "receipt_item_delete_confirmation_enabled",
              url: settings_path,
              remote: true %>

        <%= render "shared/ui/toggle_switch",
              label: t("settings.index.usage.product_name_ai_completion.label"),
              description: t("settings.index.usage.product_name_ai_completion.description_html").html_safe,
              checked: current_user.product_name_ai_completion_enabled,
              name: "product_name_ai_completion_enabled",
              url: settings_path,
              remote: true %>

        <%# TODO: レシート画像最適化設定は v1.0以降で再検討する %>
      </div>
    <% end %>

    <%= render "shared/ui/surface_card",
          variant: :danger,
          shadow_variant: :danger,
          padding: :md do %>
      <%= render "shared/ui/section_header",
            icon: "delete",
            title: t("settings.index.sections.account_actions"),
            variant: :danger,
            class: "mb-6" %>

      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row gap-4">
          <%= button_to user_registration_path,
                        method: :delete,
                        data: { turbo_confirm: t("settings.index.danger.confirm") },
                        class: "contents" do %>
            <%= render "shared/ui/button",
                  as: :content,
                  label: t("settings.index.danger.delete_account"),
                  variant: :danger,
                  size: :compact %>
          <% end %>
        </div>

        <div class="flex items-start gap-2 pt-2">
          <span class="material-symbols-outlined token-text-error text-sm mt-0.5">warning</span>
          <p class="text-xs token-text-error-muted leading-relaxed">
            <%= t("settings.index.danger.hint") %>
          </p>
        </div>
      </div>
    <% end %>
  </div>
</section>
