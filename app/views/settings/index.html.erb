<section class="max-w-3xl mx-auto space-y-12 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "shared/ui/section_header",
        title: "設定",
        subtitle: "アカウント情報やセキュリティ設定を管理できます",
        title_size: "text-3xl",
        subtitle_size: "text-base",
        class: "px-4 md:px-0" %>

  <div class="space-y-6">
    <%= render "shared/ui/surface_card", hoverable: true, class: "p-6" do %>
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-center gap-5">
          <div class="relative">
            <div class="w-20 h-20 rounded-full overflow-hidden border-2 border-[#C0C1FF]/20 bg-[#2A2A2A] flex items-center justify-center text-[#C0C1FF] text-xl font-bold">
              <% if current_user.respond_to?(:avatar) && current_user.avatar.attached? && current_user.avatar.blob&.persisted? %>
                <%= image_tag current_user.avatar, class: "w-full h-full object-cover" %>
              <% else %>
                <% display_name = (current_user.name.presence || current_user.email).to_s %>
                <%= display_name[0,1]&.upcase || "U" %>
              <% end %>
            </div>
          </div>

          <div class="space-y-1 min-w-0">
            <div class="flex items-center gap-3 flex-wrap">
              <h2 class="text-lg font-semibold text-white"><%= current_user.name.presence || "ユーザー名未設定" %></h2>
              <span class="bg-[#C0C1FF]/10 text-[#C0C1FF] text-[10px] font-bold px-2 py-0.5 rounded-full border border-[#C0C1FF]/20">
                <%= current_user.guest? ? "ゲストユーザー" : "本登録ユーザー" %>
              </span>
            </div>
            <p class="text-sm text-[#C7C4D8] break-all"><%= current_user.email %></p>
          </div>
        </div>

        <%= render "shared/ui/button",
              as: :link,
              href: settings_account_path,
              label: "プロフィールを編集",
              variant: :secondary,
              size: :md,
              text_color: "text-[#C0C1FF]",
              class: "py-2.5 hover:bg-[#C0C1FF]/10" %>
      </div>
    <% end %>

    <%= render "shared/ui/surface_card", class: "p-6" do %>
      <%= render "shared/ui/section_header",
            icon: "monitoring",
            title: "システム状態",
            class: "mb-6" %>

      <div class="space-y-3">
        <%# TODO: 本実装では ExternalServiceStatus から状態を取得する %>
        <%# v0.5: 監視ジョブ（ExternalServiceStatus + 定期APIチェック）と連携し、状態を自動更新する %>
        <%# 表示更新は Turbo Streams または polling でリアルタイム反映する想定 %>
        <%# 例: state: @ocr_service_status.state.to_sym %>
        <%= render "shared/ui/status_badge",
              label: "OCRサービス",
              state: @ocr_state %>

        <%= render "shared/ui/status_badge",
              label: "AIサービス",
              state: @ai_state %>
      </div>
    <% end %>

    <%= render "shared/ui/surface_card", class: "p-6" do %>
      <%= render "shared/ui/section_header",
            icon: "shield",
            title: "セキュリティ",
            class: "mb-6" %>

      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row gap-3">
          <%= render "shared/ui/button",
                as: :link,
                href: settings_security_path(anchor: "email"),
                label: "メールアドレス変更",
                variant: :secondary,
                full_width: true,
                class: "px-4 text-left",
                trailing_icon: "chevron_right",
                trailing_icon_animated: true,
                border_hover: true %>

          <%= render "shared/ui/button",
                as: :link,
                href: settings_security_path(anchor: "password"),
                label: "パスワード変更",
                variant: :secondary,
                full_width: true,
                class: "px-4 text-left",
                trailing_icon: "chevron_right",
                trailing_icon_animated: true,
                border_hover: true %>
        </div>

        <div class="pt-4 border-t border-white/10 space-y-3">
          <%# TODO: 2要素認証（2FA）を実装する。現状はダミー表示 %>
          <div class="flex items-center justify-between text-sm">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[#C7C4D8] text-sm">info</span>
              <span class="text-[#C7C4D8]">2要素認証 (2FA)</span>
            </div>
            <span class="text-xs text-[#C7C4D8]">未設定</span>
          </div>

          <%# TODO: Passkey 設定機能を実装する。現状はダミー表示 %>
          <div class="flex items-center justify-between text-sm">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[#C7C4D8] text-sm">info</span>
              <span class="text-[#C7C4D8]">Passkey 設定</span>
            </div>
            <span class="text-xs text-[#C7C4D8]">未設定</span>
          </div>

          <p class="text-[11px] text-[#C7C4D8]/60 leading-relaxed">
            ※ アカウントの安全性を高めるために、定期的なパスワード変更と追加認証機能の利用を推奨しています。
          </p>
        </div>
      </div>
    <% end %>

    <%= render "shared/ui/surface_card", class: "p-6" do %>
      <%= render "shared/ui/section_header",
            icon: "settings",
            title: "利用設定",
            class: "mb-6" %>

      <div class="space-y-6">
        <%# TODO: 通知配信そのものは未実装。ここでは利用設定トグルの保存動作のみ提供する %>
        <%= render "shared/ui/toggle_switch",
              label: "プッシュ通知",
              description: "レシート処理の完了や要確認項目を通知します",
              checked: current_user.push_notification_enabled,
              name: "push_notification_enabled",
              url: settings_path,
              remote: true %>

        <%# TODO: レシート画像最適化設定は v1.0以降で再検討する %>
      </div>
    <% end %>

    <%= render "shared/ui/surface_card", variant: :danger, class: "p-6" do %>
      <%= render "shared/ui/section_header",
            icon: "delete",
            title: "アカウント操作",
            variant: :danger,
            class: "mb-6" %>

      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row gap-4">
          <%= button_to user_registration_path,
                        method: :delete,
                        data: { turbo_confirm: "退会するとアカウントに紐づくデータが削除されます。よろしいですか？" },
                        class: "contents" do %>
            <%= render "shared/ui/button",
                  as: :content,
                  label: "退会",
                  variant: :danger,
                  class: "py-2.5" %>
          <% end %>
        </div>

        <div class="flex items-start gap-2 pt-2">
          <span class="material-symbols-outlined text-[#FFB4AB] text-sm mt-0.5">warning</span>
          <p class="text-xs text-[#FFB4AB]/80 leading-relaxed">
            退会するとアカウントに紐づくデータが削除されます。この操作は取り消すことができませんのでご注意ください。
          </p>
        </div>
      </div>
    <% end %>
  </div>
</section>
