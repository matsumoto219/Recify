<h1>アカウント設定</h1>

<section>
  <h2>現在の登録情報</h2>

  <p>名前: <%= current_user.name.presence || "未設定" %></p>
  <p>メールアドレス: <%= current_user.email %></p>
</section>

<section>
  <h2>今後追加する機能</h2>

  <ul>
    <li>名前変更</li>
    <li>メールアドレス変更</li>
    <li>退会</li>
  </ul>
</section>

<p><%= link_to "設定トップへ戻る", settings_path %></p>
