<section class="max-w-3xl mx-auto space-y-12 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "shared/ui/section_header",
        title: "プロフィール",
        subtitle: "ユーザー情報を編集できます",
        title_size: "text-3xl",
        subtitle_size: "text-base",
        class: "px-4 md:px-0" %>

  <%= render "shared/ui/surface_card", padding: :responsive do %>
    <%
      form_resource = defined?(resource) && resource.present? ? resource : current_user
      form_resource_name = defined?(resource_name) && resource_name.present? ? resource_name : :user
    %>
    <%= form_with model: form_resource, as: form_resource_name, url: registration_path(form_resource_name), method: :patch, html: { multipart: true } do |f| %>
      <%= hidden_field_tag :update_context, "account" %>
      <div class="space-y-6 p-8">
        <div
          class="flex flex-col md:flex-row items-center gap-6 min-w-0"
          data-controller="avatar-preview"
          data-avatar-preview-invalid-type-message-value="<%= t("settings.account.avatar.validation.invalid_type") %>"
          data-avatar-preview-file-too-large-message-value="<%= t("settings.account.avatar.validation.file_too_large") %>">
          <div class="relative group">
            <%= render "shared/ui/avatar",
                  user: form_resource,
                  size: 96,
                  preview: true,
                  alt: "プロフィール画像プレビュー",
                  background_class: "token-bg-floating",
                  class: "border-2 token-border-brand-soft avatar-preview-surface transition-transform duration-300 group-hover:scale-105" %>
          </div>

          <div class="text-center md:text-left w-full min-w-0">
            <h2 class="truncate text-lg font-semibold token-text-base mb-1" title="プロフィール写真">プロフィール写真</h2>
            <p class="text-xs token-text-muted mb-4 break-words">PNG / JPG / WebP を設定できます(5MB以下)</p>
            <%= f.file_field :avatar,
                  class: "block w-full text-sm avatar-file-input file:mr-4 file:rounded-lg file:border-0 file:px-4 file:py-2 file:text-sm file:font-semibold",
                  accept: "image/png,image/jpeg,image/webp",
                  data: {
                    avatar_preview_target: "input",
                    action: "change->avatar-preview#preview"
                  } %>
            <p class="mt-2 hidden text-xs token-text-error leading-relaxed break-words" data-avatar-preview-target="error">
              <span data-avatar-preview-target="errorText"></span>
            </p>

            <% if form_resource.respond_to?(:avatar) && form_resource.avatar.attached? && form_resource.avatar.blob&.persisted? %>
              <label class="mt-4 flex items-start gap-3 text-left cursor-pointer select-none min-w-0">
                <%= check_box_tag :remove_avatar, "1", false,
                      class: "mt-0.5 h-4 w-4 rounded border token-border-strong token-bg-input token-text-brand focus:ring-2 token-focus-ring-brand",
                      data: {
                        avatar_preview_target: "removeCheckbox",
                        action: "change->avatar-preview#toggleRemove"
                      } %>
                <span class="space-y-1 min-w-0">
                  <span class="block text-sm font-medium token-text-base">現在のプロフィール画像を削除する</span>
                  <span class="block text-xs token-text-muted leading-relaxed">保存すると画像は削除され、初期アイコン表示に戻ります。</span>
                </span>
              </label>
            <% end %>

            <% if form_resource.errors[:avatar].any? %>
              <p class="mt-2 text-xs token-text-error leading-relaxed break-words">
                <%= form_resource.errors.full_messages_for(:avatar).first %>
              </p>
            <% end %>
          </div>
        </div>
      </div>

      <%= render "shared/ui/section_divider" %>
      <div class="space-y-6 -mx-8 px-8 py-8 min-w-0">
        <%# TODO: ユーザー名更新を有効化
            - devise_parameter_sanitizerで :name を許可
            - バリデーション（任意：文字数制限など）を追加 %>
        <%= render "shared/ui/text_field",
              f: f,
              attribute: :name,
              label: "ユーザー名",
              icon: "person",
              field_type: :text_field,
              placeholder: "任意のユーザー名を入力",
              autocomplete: "name",
              with_icon: true,
              highlight_variant: :default,
              show_error_message: true,
              size: :comfortable,
              label_class: "text-sm font-medium normal-case tracking-normal px-0",
              error_message_class: "px-0",
              input_wrapper_class: "" %>
      </div>

      <div class="account-form-footer -mx-8 -mb-8 px-8 py-6 flex flex-col-reverse md:flex-row justify-end gap-3">
        <%= render "shared/ui/button",
              as: :link,
              href: settings_path,
              label: "キャンセル",
              variant: :secondary,
              class: "px-8 py-3" %>

        <%# TODO: 更新後の挙動
            - 更新成功時：settingsページへリダイレクト
            - 更新失敗時：エラーメッセージ表示 %>
        <%= render "shared/ui/button",
              label: "変更を保存",
              variant: :primary,
              type: "submit",
              disable_with: "保存中...",
              class: "px-10 py-3 font-bold" %>
      </div>
    <% end %>
  <% end %>
</section>
