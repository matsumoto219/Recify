<h1>アカウント設定</h1>

<section>
  <h2>現在の登録情報</h2>

  <p>名前: <%= current_user.name.presence || "未設定" %></p>
  <p>メールアドレス: <%= current_user.email %></p>
</section>

<section>
  <ul>
    <li>名前変更</li>
    <li>メールアドレス変更</li>
    <li>
      <%= button_to "退会する", registration_path(current_user), method: :delete, data: { confirm: "本当に退会しますか？" } %>
    </li>
  </ul>
</section>

<p><%= link_to "設定トップへ戻る", settings_path %></p>
