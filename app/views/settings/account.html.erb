<% content_for :title, t("meta.title_format", title: t("settings.account.meta_title"), site: t("meta.site_name")) %>

<section class="w-full min-w-0 max-w-3xl mx-auto space-y-12 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "shared/ui/layout/section_header",
        title: t("settings.account.title"),
        subtitle: t("settings.account.subtitle"),
        title_size: "text-2xl md:text-3xl",
        subtitle_size: "text-sm md:text-base",
        class: "px-4 md:px-0" %>

  <%= render "shared/ui/layout/surface_card", padding: :responsive do %>
    <%
      form_resource = defined?(resource) && resource.present? ? resource : current_user
      form_resource_name = defined?(resource_name) && resource_name.present? ? resource_name : :user
      avatar_max_file_size = User.avatar_max_file_size
      avatar_max_file_size_label = number_to_human_size(avatar_max_file_size)
    %>
    <%= form_with model: form_resource, as: form_resource_name, url: registration_path(form_resource_name), method: :patch, html: { multipart: true } do |f| %>
      <%= hidden_field_tag :update_context, "account" %>
      <div class="space-y-6 p-8">
        <div
          class="flex flex-col md:flex-row items-center gap-6 min-w-0"
          data-controller="avatar-preview"
          data-avatar-preview-invalid-type-message-value="<%= t("settings.account.avatar.validation.invalid_type") %>"
          data-avatar-preview-file-too-large-message-value="<%= t("settings.account.avatar.validation.file_too_large", max_size: avatar_max_file_size_label) %>"
          data-avatar-preview-max-file-size-bytes-value="<%= avatar_max_file_size %>">
          <div class="relative group">
            <%= render "shared/ui/miscellaneous/avatar",
                  user: form_resource,
                  size: 96,
                  preview: true,
                  alt: t("settings.account.avatar.preview_alt"),
                  background_class: "token-bg-floating",
                  class: "border-2 token-border-brand-soft avatar-preview-surface transition-transform duration-300 group-hover:scale-105" %>
          </div>

          <div class="text-center md:text-left w-full min-w-0">
            <h2 class="truncate text-lg font-semibold token-text-base mb-1" title="<%= t("settings.account.avatar.title") %>"><%= t("settings.account.avatar.title") %></h2>
            <p class="text-xs token-text-muted mb-4 break-words"><%= t("settings.account.avatar.description", max_size: avatar_max_file_size_label) %></p>
            <%= f.file_field :avatar,
                  class: "ui-touch-control block w-full text-sm avatar-file-input file:mr-4 file:rounded-lg file:border-0 file:px-4 file:py-2 file:text-sm file:font-semibold",
                  accept: "image/png,image/jpeg,image/webp",
                  data: {
                    avatar_preview_target: "input",
                    action: "change->avatar-preview#preview"
                  } %>
            <p class="mt-2 hidden text-xs token-text-error leading-relaxed break-words" data-avatar-preview-target="error">
              <span data-avatar-preview-target="errorText"></span>
            </p>

            <% if form_resource.respond_to?(:avatar) && form_resource.avatar.attached? && form_resource.avatar.blob&.persisted? %>
              <%= render "shared/ui/form/checkbox_field",
                    name: :remove_avatar,
                    value: "1",
                    checked: false,
                    label: t("settings.account.avatar.remove_label"),
                    hint: t("settings.account.avatar.remove_description"),
                    wrapper_class: "mt-4 text-left cursor-pointer select-none min-w-0",
                    content_class: "space-y-1",
                    label_class: "text-sm font-medium token-text-base",
                    html_options: {
                      data: {
                        avatar_preview_target: "removeCheckbox",
                        action: "change->avatar-preview#toggleRemove"
                      }
                    } %>
            <% end %>

            <% if form_resource.errors[:avatar].any? %>
              <p class="mt-2 text-xs token-text-error leading-relaxed break-words">
                <%= form_resource.errors.full_messages_for(:avatar).first %>
              </p>
            <% end %>
          </div>
        </div>
      </div>

      <%= render "shared/ui/layout/section_divider" %>
      <div class="space-y-6 -mx-8 px-8 py-8 min-w-0">
        <%= render "shared/ui/form/text_field",
              f: f,
              attribute: :name,
              label: t("settings.account.fields.name"),
              icon: "person",
              field_type: :text_field,
              placeholder: t("settings.account.fields.name_placeholder"),
              autocomplete: "name",
              with_icon: true,
              highlight_variant: :default,
              show_error_message: true,
              size: :comfortable,
              label_class: "text-sm font-medium normal-case tracking-normal px-0",
              error_message_class: "px-0",
              input_wrapper_class: "" %>
      </div>

      <div class="account-form-footer -mx-8 -mb-8 px-8 py-6 flex flex-col-reverse md:flex-row justify-end gap-3">
        <%= render "shared/ui/actions/button",
              as: :link,
              href: settings_path,
              label: t("settings.account.buttons.cancel"),
              variant: :secondary,
              class: "px-8 py-3" %>

        <%= render "shared/ui/actions/button",
              label: t("settings.account.buttons.save"),
              variant: :primary,
              type: "submit",
              disable_with: t("settings.account.buttons.saving"),
              class: "px-10 py-3 font-bold" %>
      </div>
    <% end %>
  <% end %>
</section>
