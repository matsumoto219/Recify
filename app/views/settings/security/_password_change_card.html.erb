<%#
  パスワード変更カード

  必須:
  - resource: Devise のフォーム対象リソース
  - resource_name: Devise のフォーム対象名

  任意:
  - update_context: パスワード変更フォームの再表示判定に使う文脈。未指定時は空文字
  - security_form_error: 現在のパスワード入力欄へ autofocus する場合は true。未指定時は false
%>

<%
  form_resource = local_assigns.fetch(:resource)
  form_resource_name = local_assigns.fetch(:resource_name)
  update_context = local_assigns.fetch(:update_context, "")
  show_form_errors = %w[security password].include?(update_context)
  security_form_error = local_assigns.fetch(:security_form_error, false)
%>

<div id="password" class="scroll-mt-24">
  <%= render "shared/ui/layout/surface_card", padding: :responsive do %>
    <%= render "shared/ui/layout/section_header",
          icon: "lock",
          title: t("settings.security.password.title"),
          title_size: "text-xl",
          class: "mb-6" %>

    <%= form_with model: form_resource, as: form_resource_name, url: registration_path(form_resource_name), method: :patch, local: true do |f| %>
      <%= hidden_field_tag :update_context, "security" %>

      <div class="space-y-6">
        <%= render "shared/ui/form/text_field",
              f: f,
              attribute: :current_password,
              label: t("settings.security.password.current"),
              icon: "lock",
              field_type: :password_field,
              placeholder: "••••••••",
              autocomplete: "current-password",
              autofocus: security_form_error,
              required: true,
              with_icon: true,
              highlight_variant: :default,
              show_error_state: show_form_errors,
              show_error_message: true,
              size: :comfortable,
              label_class: "text-sm font-medium normal-case tracking-normal px-0",
              error_message_class: "px-0",
              input_wrapper_class: "" %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <%= render "shared/ui/form/text_field",
                f: f,
                attribute: :password,
                label: t("settings.security.password.new"),
                icon: "password",
                field_type: :password_field,
                placeholder: "••••••••",
                autocomplete: "new-password",
                required: true,
                with_icon: true,
                highlight_variant: :default,
                show_error_state: show_form_errors,
                show_error_message: true,
                size: :comfortable,
                label_class: "text-sm font-medium normal-case tracking-normal px-0",
                error_message_class: "px-0",
                input_wrapper_class: "" %>

          <%= render "shared/ui/form/text_field",
                f: f,
                attribute: :password_confirmation,
                label: t("settings.security.password.confirmation"),
                icon: "password",
                field_type: :password_field,
                placeholder: "••••••••",
                autocomplete: "new-password",
                required: true,
                with_icon: true,
                highlight_variant: :default,
                show_error_state: show_form_errors,
                show_error_message: true,
                size: :comfortable,
                label_class: "text-sm font-medium normal-case tracking-normal px-0",
                error_message_class: "px-0",
                input_wrapper_class: "" %>
        </div>

        <p class="text-sm token-text-subtle"><%= t("settings.security.password.hint") %></p>
        <div class="pt-2 flex justify-end">
          <%= render "shared/ui/actions/button",
                label: t("settings.security.password.save"),
                variant: :primary,
                size: :compact,
                weight: :bold,
                type: "submit",
                disable_with: t("settings.security.password.saving") %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
