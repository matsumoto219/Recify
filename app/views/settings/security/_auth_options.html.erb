<div id="two-factor" class="grid grid-cols-1 md:grid-cols-2 gap-6 scroll-mt-24">
  <%= render "shared/ui/layout/surface_card", padding: :md, class: "flex flex-col justify-between border token-border-soft" do %>
    <% totp_credential = current_user.totp_credential %>
    <% totp_enabled = totp_credential&.confirmed? %>
    <% recovery_codes_status = TwoFactor.recovery_codes_status(user: current_user) if totp_enabled %>
    <div class="space-y-5">
      <div class="flex items-center justify-between mb-4">
        <span class="material-symbols-outlined token-text-brand text-3xl">vibration</span>
        <%= render "shared/ui/badge/setting_status_badge", state: totp_enabled ? :active : :inactive %>
      </div>
      <%= render "shared/ui/layout/section_header",
            title: t("settings.security.auth.two_factor.title"),
            subtitle: t("settings.security.auth.two_factor.subtitle"),
            title_size: "text-lg",
            subtitle_size: "text-sm",
            class: "mb-6" %>

      <% if totp_enabled %>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3 text-sm token-text-muted">
          <p>
            <%= t("settings.security.auth.two_factor.enabled_at", datetime: l(totp_credential.confirmed_at, format: :short)) %>
          </p>
          <p>
            <%= t(
                  "settings.security.auth.two_factor.last_used_at",
                  datetime: totp_credential.last_used_at.present? ? l(totp_credential.last_used_at, format: :short) : t("settings.security.auth.two_factor.unused")
                ) %>
          </p>
        </div>

        <%
          recovery_status_classes = case recovery_codes_status.status
                                    when :empty
                                      "token-state-error-soft token-text-error"
                                    when :low, :missing
                                      "token-state-warning-soft token-text-warning"
                                    else
                                      "token-bg-card-subtle token-text-muted"
                                    end
        %>
        <div class="rounded-lg border token-border-soft p-3 text-sm <%= recovery_status_classes %>">
          <p class="font-semibold token-text-base">
            <%= t("settings.security.auth.recovery_codes.status.#{recovery_codes_status.status}.title") %>
          </p>
          <p class="mt-1">
            <%= t(
                  "settings.security.auth.recovery_codes.status.#{recovery_codes_status.status}.body",
                  count: recovery_codes_status.unused_count
                ) %>
          </p>
        </div>
      <% else %>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3 text-sm token-text-muted">
          <%= t("settings.security.auth.two_factor.empty") %>
        </div>
      <% end %>
    </div>

    <div class="mt-5 space-y-3">
      <% if totp_enabled %>
        <%= button_to t("settings.security.auth.two_factor.regenerate_recovery_codes"),
              settings_security_recovery_codes_regenerate_path,
              method: :post,
              form: { data: { turbo_confirm: t("settings.security.auth.recovery_codes.regenerate_confirm") } },
              class: "btn-secondary border w-full flex justify-center items-center gap-2 cursor-pointer transition-all active:scale-[0.98] px-6 py-2.5 text-sm rounded-lg font-medium token-border-brand-soft" %>
        <%= button_to t("settings.security.auth.two_factor.disable"),
              settings_security_totp_path,
              method: :delete,
              form: { data: { turbo_confirm: t("settings.security.auth.two_factor.disable_confirm") } },
              class: "btn-ghost border w-full flex justify-center items-center gap-2 cursor-pointer transition-all active:scale-[0.98] px-6 py-2.5 text-sm rounded-lg font-medium" %>
      <% else %>
        <%= render "shared/ui/actions/button",
              as: :link,
              href: new_settings_security_totp_path,
              label: t("settings.security.auth.two_factor.action"),
              variant: :secondary,
              size: :compact,
              full_width: true,
              icon: "security",
              class: "token-border-brand-soft" %>
      <% end %>
    </div>
  <% end %>

  <div id="passkeys" class="scroll-mt-24">
  <%= render "shared/ui/layout/surface_card", padding: :md, class: "flex flex-col justify-between border token-border-soft" do %>
    <div
      class="space-y-5"
      data-controller="passkey"
      data-passkey-options-url-value="<%= settings_passkeys_options_path %>"
      data-passkey-create-url-value="<%= settings_passkeys_path %>"
      data-passkey-unsupported-message-value="<%= t("settings.security.auth.passkey.messages.unsupported") %>"
      data-passkey-canceled-message-value="<%= t("settings.security.auth.passkey.messages.canceled") %>"
      data-passkey-success-message-value="<%= t("settings.security.auth.passkey.messages.success") %>"
      data-passkey-failure-message-value="<%= t("settings.security.auth.passkey.messages.failure") %>"
      data-passkey-request-failed-message-value="<%= t("settings.security.auth.passkey.messages.request_failed") %>">
      <div class="flex items-center justify-between mb-4">
        <span class="material-symbols-outlined token-text-brand text-3xl">passkey</span>
        <%= render "shared/ui/badge/setting_status_badge", state: current_user.passkeys.exists? ? :active : :inactive %>
      </div>
      <%= render "shared/ui/layout/section_header",
            title: t("settings.security.auth.passkey.title"),
            subtitle: t("settings.security.auth.passkey.subtitle"),
            title_size: "text-lg",
            subtitle_size: "text-sm",
            class: "mb-6" %>

      <div class="space-y-3">
        <% if current_user.passkeys.exists? %>
          <% current_user.passkeys.order(created_at: :desc).each do |passkey| %>
            <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3 space-y-3">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <% passkey_label = passkey.label.presence || t("settings.security.auth.passkey.default_label") %>
                  <p class="text-sm font-semibold token-text-base truncate" title="<%= passkey_label %>">
                    <%= passkey_label %>
                  </p>
                  <p class="text-xs token-text-muted">
                    <%= t("settings.security.auth.passkey.registered_at", datetime: l(passkey.created_at, format: :short)) %>
                  </p>
                  <p class="text-xs token-text-muted">
                    <%= t(
                          "settings.security.auth.passkey.last_used_at",
                          datetime: passkey.last_used_at.present? ? l(passkey.last_used_at, format: :short) : t("settings.security.auth.passkey.unused")
                        ) %>
                  </p>
                </div>

                <%= button_to t("settings.security.auth.passkey.delete"),
                      settings_passkey_path(passkey),
                      method: :delete,
                      form: { data: { turbo_confirm: t("settings.security.auth.passkey.delete_confirm") } },
                      class: "btn-ghost border px-3 py-1.5 text-xs rounded-lg font-medium transition-all" %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3 text-sm token-text-muted">
            <%= t("settings.security.auth.passkey.empty") %>
          </div>
        <% end %>
      </div>

      <div class="space-y-3">
        <label class="block text-sm font-medium token-text-base" for="passkey-label-input">
          <%= t("settings.security.auth.passkey.label") %>
        </label>
        <input
          id="passkey-label-input"
          type="text"
          maxlength="80"
          placeholder="<%= t("settings.security.auth.passkey.label_placeholder") %>"
          class="w-full rounded-lg border token-border-soft token-bg-input px-3 py-2 text-sm token-text-base"
          data-passkey-target="label">

        <p class="hidden text-sm token-text-error" data-passkey-target="error"></p>
        <p class="hidden text-sm token-text-success" data-passkey-target="success"></p>

        <%= render "shared/ui/actions/button",
              label: t("settings.security.auth.passkey.action"),
              variant: :secondary,
              size: :compact,
              full_width: true,
              icon: "passkey",
              class: "token-border-brand-soft",
              data: {
                action: "click->passkey#register",
                passkey_target: "button"
              } %>
      </div>
    </div>
  <% end %>
  </div>
</div>
