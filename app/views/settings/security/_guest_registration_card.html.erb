<%#
  ゲスト登録カード

  必須:
  - resource: Devise のフォーム対象リソース
  - resource_name: Devise のフォーム対象名

  任意:
  - update_context: ゲスト登録フォームの再表示判定に使う文脈。未指定時は空文字
%>

<%
  form_resource = local_assigns.fetch(:resource)
  form_resource_name = local_assigns.fetch(:resource_name)
  update_context = local_assigns.fetch(:update_context, "")
  attempted_email = update_context == "guest_registration" ? params.dig(:user, :email).to_s : ""
%>

<div id="guest-registration" class="scroll-mt-24">
  <%= render "shared/ui/layout/surface_card", padding: :responsive do %>
    <%= render "shared/ui/layout/section_header",
          icon: "how_to_reg",
          title: t("settings.security.guest_registration.title"),
          subtitle: t("settings.security.guest_registration.description"),
          title_size: "text-xl",
          subtitle_size: "text-sm",
          subtitle_class: "whitespace-pre-line",
          class: "mb-6" %>

    <% if current_user.guest_registration_pending? %>
      <div class="mb-6 rounded-lg border token-border-soft token-state-warning-soft px-4 py-3 text-sm min-w-0">
        <p class="font-semibold token-text-base"><%= t("settings.security.guest_registration.pending.title") %></p>
        <p class="mt-1 token-text-muted break-words">
          <%= t("settings.security.guest_registration.pending.sent_to", email: current_user.unconfirmed_email) %>
        </p>
        <div class="mt-3">
          <%= render "shared/ui/actions/button",
                as: :link,
                href: new_user_confirmation_path,
                label: t("settings.security.guest_registration.pending.resend"),
                variant: :secondary,
                size: :compact,
                icon: "mark_email_unread",
                class: "token-border-brand-soft" %>
        </div>
      </div>
    <% end %>

    <div class="mb-6 rounded-lg border token-border-soft token-bg-card-subtle px-4 py-3 text-sm token-text-muted">
      <%= t("settings.security.auth.passkey.guest_unavailable") %>
    </div>

    <%= form_with model: form_resource, as: form_resource_name, url: registration_path(form_resource_name), method: :patch, local: true do |f| %>
      <%= hidden_field_tag :update_context, "guest_registration" %>

      <div class="space-y-6">
        <%= render "shared/ui/form/text_field",
              f: f,
              attribute: :email,
              label: t("settings.security.guest_registration.fields.email"),
              icon: "mail",
              field_type: :email_field,
              value: attempted_email,
              placeholder: t("settings.security.guest_registration.fields.email_placeholder"),
              autocomplete: "email",
              required: true,
              with_icon: true,
              show_error_message: true,
              size: :comfortable,
              label_class: "text-sm font-medium normal-case tracking-normal px-0",
              error_message_class: "px-0",
              input_wrapper_class: "" %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <%= render "shared/ui/form/text_field",
                f: f,
                attribute: :password,
                label: t("settings.security.guest_registration.fields.password"),
                icon: "password",
                field_type: :password_field,
                placeholder: "••••••••",
                autocomplete: "new-password",
                required: true,
                with_icon: true,
                show_error_message: true,
                size: :comfortable,
                label_class: "text-sm font-medium normal-case tracking-normal px-0",
                error_message_class: "px-0",
                input_wrapper_class: "" %>

          <%= render "shared/ui/form/text_field",
                f: f,
                attribute: :password_confirmation,
                label: t("settings.security.guest_registration.fields.password_confirmation"),
                icon: "password",
                field_type: :password_field,
                placeholder: "••••••••",
                autocomplete: "new-password",
                required: true,
                with_icon: true,
                show_error_message: true,
                size: :comfortable,
                label_class: "text-sm font-medium normal-case tracking-normal px-0",
                error_message_class: "px-0",
                input_wrapper_class: "" %>
        </div>

        <%
          legal_agreement_errors = form_resource.errors.full_messages_for(:legal_agreement)
          legal_agreement_error = legal_agreement_errors.first
        %>
        <section aria-label="<%= t("settings.security.guest_registration.legal_agreement.aria_label") %>" class="space-y-2">
          <%
            legal_agreement_input_id = "guest_registration_legal_agreement"
            legal_agreement_label = [
              t("settings.security.guest_registration.legal_agreement.prefix"),
              t("settings.security.guest_registration.legal_agreement.terms"),
              t("settings.security.guest_registration.legal_agreement.connector"),
              t("settings.security.guest_registration.legal_agreement.privacy"),
              t("settings.security.guest_registration.legal_agreement.suffix")
            ].join.squish
            legal_agreement_description_id = "guest-registration-legal-agreement-description"
          %>
          <div class="flex items-start gap-3 rounded-lg border token-border-soft px-4 py-3 text-sm token-text-muted">
            <%= f.check_box :legal_agreement,
                  {
                    id: legal_agreement_input_id,
                    class: "mt-0.5 h-4 w-4 rounded token-checkbox",
                    required: true,
                    aria: {
                      label: legal_agreement_label,
                      describedby: legal_agreement_description_id
                    }
                  },
                  "1",
                  "0" %>
            <p id="<%= legal_agreement_description_id %>" class="min-w-0 leading-relaxed">
              <%= label_tag legal_agreement_input_id,
                    t("settings.security.guest_registration.legal_agreement.prefix"),
                    class: "cursor-pointer" %>
              <%= link_to t("settings.security.guest_registration.legal_agreement.terms"),
                    terms_path,
                    class: "inline-block whitespace-nowrap underline token-hover-text-brand" %>
              <%= t("settings.security.guest_registration.legal_agreement.connector") %>
              <%= link_to t("settings.security.guest_registration.legal_agreement.privacy"),
                    privacy_path,
                    class: "inline-block whitespace-nowrap underline token-hover-text-brand" %>
              <%= label_tag legal_agreement_input_id,
                    t("settings.security.guest_registration.legal_agreement.suffix"),
                    class: "cursor-pointer" %>
            </p>
          </div>
          <% if legal_agreement_error.present? %>
            <p class="px-1 text-xs token-text-error leading-relaxed"><%= legal_agreement_error %></p>
          <% end %>
        </section>

        <p class="text-sm token-text-subtle"><%= t("settings.security.guest_registration.hint") %></p>

        <div class="pt-2 flex justify-end">
          <%= render "shared/ui/actions/button",
                label: t("settings.security.guest_registration.submit"),
                variant: :primary,
                size: :compact,
                weight: :bold,
                type: "submit",
                disable_with: t("settings.security.guest_registration.submitting") %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
