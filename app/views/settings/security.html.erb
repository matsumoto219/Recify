<section class="max-w-3xl mx-auto px-4 md:px-2 py-6 pb-28 md:pb-6 space-y-8">
  <!-- START: settings/security page header -->
  <header class="mb-6">
    <h1 class="text-3xl font-bold tracking-tight text-[#E5E2E1] mb-2">セキュリティ</h1>
    <p class="text-[#C7C4D8]">アカウントの安全性を管理します</p>
  </header>
  <!-- END: settings/security page header -->

  <%# TODO: フラッシュメッセージ表示（成功/失敗）
      - flash[:notice] / flash[:alert] を表示
      - 成功時: 「パスワードを更新しました」
      - エラー時: エラーメッセージ一覧 %>

  <!-- START: settings/security email card -->
  <section class="bg-[#201F1F] rounded-xl p-6 lg:p-8 shadow-sm">
    <div class="flex items-center gap-3 mb-4">
      <span class="material-symbols-outlined text-[#C0C1FF]">mail</span>
      <h3 class="text-xl font-semibold text-white">メールアドレス</h3>
    </div>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-[#1C1B1B] p-4 rounded-lg">
      <div>
        <p class="text-xs text-[#C7C4D8] mb-1">現在のメールアドレス</p>
        <p class="text-white font-medium"><%= current_user.email %></p>
      </div>

      <%# TODO: メールアドレス変更機能を実装
          - Deviseのconfirmableを利用
          - 再認証（current_password）を必須化
          - 変更確認メール送信 %>
      <button type="button" class="bg-[#353534] text-[#918FA1] border border-white/10 px-5 py-2 rounded-lg text-sm font-semibold opacity-50 cursor-not-allowed">
        変更する（未対応）
      </button>
    </div>

    <p class="mt-4 text-sm text-[#C7C4D8]/80">メールアドレスを変更すると、新しいアドレスに確認用のリンクが送信されます。</p>
  </section>
  <!-- END: settings/security email card -->

  <!-- START: settings/security password card -->
  <section class="bg-[#201F1F] rounded-xl p-6 lg:p-8 shadow-sm">
    <div class="flex items-center gap-3 mb-6">
      <span class="material-symbols-outlined text-[#C0C1FF]">lock</span>
      <h3 class="text-xl font-semibold text-white">パスワード変更</h3>
    </div>

    <%= form_with model: current_user, url: user_registration_path, method: :patch, local: true do |f| %>
      <%# TODO: 入力クリア
          - 更新成功後にフォームをリセット（Turbo or Stimulusで form.reset()）
          - パスワードが画面に残らないようにする %>
      <div class="space-y-6">
        <div class="space-y-2">
          <%= f.label :current_password, "現在のパスワード", class: "text-sm font-medium text-[#C7C4D8] block" %>
          <%= f.password_field :current_password,
                placeholder: "••••••••",
                class: "w-full bg-[#0E0E0E] border-none ring-1 ring-white/10 rounded-lg px-4 py-3 focus:ring-2 focus:ring-[#C0C1FF] transition-all text-[#E5E2E1]" %>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <%= f.label :password, "新しいパスワード", class: "text-sm font-medium text-[#C7C4D8] block" %>
            <%= f.password_field :password,
                  placeholder: "••••••••",
                  class: "w-full bg-[#0E0E0E] border-none ring-1 ring-white/10 rounded-lg px-4 py-3 focus:ring-2 focus:ring-[#C0C1FF] transition-all text-[#E5E2E1]" %>
          </div>

          <div class="space-y-2">
            <%= f.label :password_confirmation, "確認用パスワード", class: "text-sm font-medium text-[#C7C4D8] block" %>
            <%= f.password_field :password_confirmation,
                  placeholder: "••••••••",
                  class: "w-full bg-[#0E0E0E] border-none ring-1 ring-white/10 rounded-lg px-4 py-3 focus:ring-2 focus:ring-[#C0C1FF] transition-all text-[#E5E2E1]" %>
          </div>
        </div>

        <%# TODO: エラーメッセージ表示
            - resource.errors.full_messages を表示
            - current_password不一致やバリデーションエラーを表示 %>

        <%# TODO: パスワード強度表示（後で実装）
            - 強度バー（弱/中/強）
            - 最低文字数や記号チェック %>

        <div class="pt-2">
          <%= f.submit "パスワードを保存", class: "bg-gradient-to-br from-[#C0C1FF] to-[#4B4DD8] text-black font-bold px-6 py-2.5 rounded-lg hover:brightness-110 transition-all active:scale-95 cursor-pointer" %>
        </div>
      </div>
    <% end %>

    <p class="mt-4 text-sm text-[#C7C4D8]/80">安全のため、定期的にパスワードを変更してください。</p>
  </section>
  <!-- END: settings/security password card -->

  <!-- START: settings/security auth options grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- START: settings/security 2fa card -->
    <section class="bg-[#201F1F] rounded-xl p-6 shadow-sm flex flex-col justify-between border border-white/5">
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="material-symbols-outlined text-[#C0C1FF] text-3xl">vibration</span>
          <span class="px-2 py-1 bg-[#353534] text-[#FFB4AB] text-[10px] font-bold rounded uppercase">未設定</span>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">2要素認証 (2FA)</h3>
        <p class="text-sm text-[#C7C4D8] mb-6">認証アプリを使用して、セキュリティを強化します。</p>
      </div>

      <%# TODO: 2FA実装（TOTP）
          - QRコード生成
          - シークレット保存
          - 有効/無効切り替え %>
      <button type="button" class="w-full bg-[#353534] text-[#C0C1FF] font-semibold py-2.5 rounded-lg border border-[#C0C1FF]/20 opacity-50 cursor-not-allowed">
        有効化する（未対応）
      </button>
    </section>
    <!-- END: settings/security 2fa card -->

    <!-- START: settings/security passkey card -->
    <section class="bg-[#201F1F] rounded-xl p-6 shadow-sm flex flex-col justify-between border border-white/5">
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="material-symbols-outlined text-[#C0C1FF] text-3xl">passkey</span>
          <span class="px-2 py-1 bg-[#353534] text-[#FFB4AB] text-[10px] font-bold rounded uppercase">未設定</span>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">パスキー</h3>
        <p class="text-sm text-[#C7C4D8] mb-6">指紋や顔認証で安全にログインできます。</p>
      </div>

      <%# TODO: Passkey実装（WebAuthn）
          - credential登録
          - デバイス管理
          - ログイン連携 %>
      <button type="button" class="w-full bg-[#353534] text-[#C0C1FF] font-semibold py-2.5 rounded-lg border border-[#C0C1FF]/20 opacity-50 cursor-not-allowed">
        登録する（未対応）
      </button>
    </section>
    <!-- END: settings/security passkey card -->
  </div>
  <!-- END: settings/security auth options grid -->

  <!-- START: settings/security notice -->
  <footer class="pt-4 border-t border-white/10">
    <div class="flex items-start gap-3 text-[#C7C4D8]/60 text-xs">
      <span class="material-symbols-outlined text-sm mt-0.5">info</span>
      <p>
        セキュリティ設定を変更した際、確認メールが送信される場合があります。不審な操作があれば速やかにパスワードを変更してください。
      </p>
    </div>
  </footer>
  <!-- END: settings/security notice -->
</section>
