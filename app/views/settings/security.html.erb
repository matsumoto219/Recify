<%
  form_resource = defined?(resource) && resource.present? ? resource : current_user
  form_resource_name = defined?(resource_name) && resource_name.present? ? resource_name : :user
  update_context = params[:update_context].to_s
  security_form_error = update_context == "security" && form_resource.errors.any?
%>
<section
  class="max-w-3xl mx-auto space-y-12 px-0 md:px-2 py-2 pb-28 md:pb-2"
  data-controller="security-scroll"
  data-security-scroll-scroll-to-password-value="<%= security_form_error %>">
  <%= render "shared/ui/layout/section_header",
        title: t("settings.security.title"),
        subtitle: t("settings.security.subtitle"),
        title_size: "text-3xl",
        subtitle_size: "text-base",
        class: "px-4 md:px-0" %>

  <div class="space-y-6">
    <% if current_user.guest? %>
      <%= render "settings/security/guest_registration_card",
            resource: form_resource,
            resource_name: form_resource_name,
            update_context: update_context %>
    <% else %>
      <%= render "settings/security/email_change_card",
            resource: form_resource,
            resource_name: form_resource_name,
            update_context: update_context %>

      <%= render "settings/security/password_change_card",
            resource: form_resource,
            resource_name: form_resource_name,
            update_context: update_context,
            security_form_error: security_form_error %>

      <%= render "settings/security/auth_options" %>
    <% end %>
  </div>

  <%= render "shared/ui/layout/section_divider", variant: :gradient, class: "mt-6 mb-4" %>
  <footer>
    <div class="flex items-start gap-3 token-text-subtle text-xs">
      <span class="material-symbols-outlined text-sm mt-0.5">info</span>
      <p class="break-words">
        <%= t("settings.security.footer") %>
      </p>
    </div>
  </footer>
</section>
