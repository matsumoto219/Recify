<div
  class="overflow-hidden rounded-2xl border token-border-soft token-bg-input"
  data-controller="image-load-state"
  data-image-load-state-fallback-while-loading-value="true"
  data-action="turbo:before-cache@document->image-load-state#beforeCache">
  <div class="<%= aspect_class %> flex items-center justify-center p-2 sm:p-3">
    <%= image_tag announcement.image,
          alt: alt_text,
          loading: local_assigns.fetch(:loading, nil),
          class: "hidden max-h-full max-w-full #{image_class} object-contain",
          data: {
            image_load_state_target: "image",
            action: "load->image-load-state#imageLoaded error->image-load-state#imageFailed"
          } %>

    <div
      class="hidden min-w-0 flex-col items-center justify-center text-center"
      data-image-load-state-target="fallback"
      role="status"
      aria-live="polite">
      <span class="material-symbols-outlined text-4xl token-text-muted" aria-hidden="true">broken_image</span>
      <p class="mt-2 break-words text-sm font-semibold token-text-base [overflow-wrap:anywhere]">
        <%= t("announcements.image.unavailable") %>
      </p>
      <p class="mt-1 break-words text-xs token-text-muted [overflow-wrap:anywhere]">
        <%= t("announcements.image.unavailable_hint") %>
      </p>
    </div>
  </div>
</div>
