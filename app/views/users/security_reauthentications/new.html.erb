<% content_for :title, t("meta.title_format", title: t("settings.security.reauthentication.meta_title"), site: t("meta.site_name")) %>

<section class="w-full min-w-0 max-w-xl mx-auto space-y-8 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "shared/ui/layout/section_header",
        title: t("settings.security.reauthentication.title"),
        subtitle: t("settings.security.reauthentication.subtitle"),
        title_size: "text-2xl md:text-3xl",
        subtitle_size: "text-sm md:text-base",
        class: "px-4 md:px-0" %>

  <%= render "shared/ui/layout/surface_card", padding: :responsive do %>
    <%= form_with url: settings_security_reauthentication_path,
          method: :post,
          local: true,
          class: "space-y-5",
          data: { turbo: false } do |form| %>
      <div class="space-y-2">
        <%= form.label :password,
              t("settings.security.reauthentication.password_label"),
              class: "block text-sm font-medium token-text-base" %>
        <%= form.password_field :password,
              required: true,
              autocomplete: "current-password",
              class: "w-full rounded-lg border token-border-soft token-bg-input px-3 py-2 text-sm token-text-base" %>
        <p class="text-xs token-text-muted"><%= t(
          "settings.security.reauthentication.password_hint",
          count: @security_reauthentication_window_minutes
        ) %></p>
      </div>

      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <%= render "shared/ui/actions/button",
              as: :link,
              href: settings_security_path,
              label: t("settings.security.reauthentication.cancel"),
              variant: :ghost,
              size: :compact %>
        <%= render "shared/ui/actions/button",
              label: t("settings.security.reauthentication.submit"),
              variant: :primary,
              size: :compact,
              type: "submit",
              icon: "verified_user",
              disable_with: t("settings.security.reauthentication.submitting") %>
      </div>
    <% end %>
  <% end %>
</section>
