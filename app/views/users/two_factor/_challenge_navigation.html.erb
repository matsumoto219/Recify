<%
  known_methods = [
    {
      name: "passkey",
      label: t("auth.two_factor.links.passkey"),
      href: users_two_factor_passkey_path
    },
    {
      name: "totp",
      label: t("auth.two_factor.links.totp"),
      href: users_two_factor_totp_path
    },
    {
      name: "recovery_code",
      label: t("auth.two_factor.links.recovery_code"),
      href: users_two_factor_recovery_code_path
    }
  ]
  allowed_method_names = Array(allowed_methods).map(&:to_s).uniq
  fallback_methods = known_methods.select do |method|
    method[:name] != current_method.to_s && allowed_method_names.include?(method[:name])
  end
%>

<% if fallback_methods.any? %>
  <div class="space-y-2 text-center">
    <p class="text-xs token-text-muted"><%= t("auth.two_factor.links.heading") %></p>
    <div class="flex flex-wrap justify-center gap-x-4 gap-y-2">
      <% fallback_methods.each do |method| %>
        <%= link_to method[:label],
              method[:href],
              class: "text-sm token-text-brand font-medium hover:underline underline-offset-4" %>
      <% end %>
    </div>
  </div>
<% end %>

<div class="text-center">
  <%= link_to back_label,
        new_user_session_path,
        class: "text-sm token-text-brand font-medium hover:underline underline-offset-4" %>
</div>
