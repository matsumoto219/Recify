<% content_for :title, t("errors.not_found.page_title") %>

<%
  action_locals =
    if user_signed_in?
      {
        primary_label: error_primary_label,
        primary_path: error_primary_path
      }
    else
      {}
    end
%>

<%= render "errors/error_page",
  status_code: 404,
  icon: "travel_explore",
  title: t("errors.not_found.title"),
  description: t("errors.not_found.description"),
  **action_locals %>
