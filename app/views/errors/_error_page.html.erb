<%#
  エラーページ共通パーシャル

  必須:
  - status_code: 表示するHTTPステータスコード
  - icon: 表示する Material Symbols アイコン名
  - title: 見出しテキスト
  - description: 説明文

  任意:
  - primary_label: 主ボタンのラベル
  - primary_path: 主ボタンの遷移先
  - primary_data: 主ボタンに付与するdata属性
  - secondary_label: 補助ボタンのラベル
  - secondary_path: 補助ボタンの遷移先
  - support_message: サポート案内文
  - support_id: 問い合わせ用の識別子
%>

<%
  status_code = local_assigns.fetch(:status_code)
  icon = local_assigns.fetch(:icon)
  title = local_assigns.fetch(:title)
  description = local_assigns.fetch(:description)
  primary_label = local_assigns[:primary_label]
  primary_path = local_assigns[:primary_path]
  primary_data = local_assigns[:primary_data] || {}
  secondary_label = local_assigns[:secondary_label]
  secondary_path = local_assigns[:secondary_path]
  support_message = local_assigns[:support_message]
  support_id = local_assigns[:support_id]
  has_primary_action = primary_label.present? && primary_path.present?
  has_secondary_action = secondary_label.present? && secondary_path.present?
  has_actions = has_primary_action || has_secondary_action
%>

<main class="flex flex-1 items-center justify-center px-6 py-12 md:py-16">
  <div class="w-full max-w-lg">
    <%= render "shared/ui/layout/surface_card",
      padding: :responsive,
      shadow_variant: :indigo,
      class: "text-center glass-panel token-border-glass border" do %>
      <div class="mx-auto mb-8 flex h-20 w-20 items-center justify-center rounded-full token-bg-card-subtle token-border-soft border surface-card-shadow">
        <span class="material-symbols-outlined text-4xl token-text-brand" aria-hidden="true">
          <%= icon %>
        </span>
      </div>

      <div class="space-y-4">
        <h1 class="text-2xl tracking-normal token-text-base md:text-[1.625rem] md:leading-[2.125rem]">
          <%= title %>
        </h1>

        <p class="mx-auto max-w-sm text-sm leading-7 token-text-muted md:text-base">
          <%= description %>
        </p>
      </div>

      <% if has_actions %>
        <div class="mt-10 flex flex-col gap-3">
          <% if has_primary_action %>
            <%= render "shared/ui/actions/button",
              as: :link,
              href: primary_path,
              label: primary_label,
              variant: :primary,
              size: :lg,
              full_width: true,
              icon: "arrow_back",
              data: primary_data %>
          <% end %>

          <% if has_secondary_action %>
            <%= render "shared/ui/actions/button",
              as: :link,
              href: secondary_path,
              label: secondary_label,
              variant: :secondary,
              size: :lg,
              full_width: true,
              icon: "refresh",
              data: { turbo: false } %>
          <% end %>
        </div>
      <% end %>

      <p class="<%= has_actions ? "mt-8" : "mt-10" %> font-mono text-xs token-text-muted">
        <%= t("errors.error_code", status_code: status_code) %>
      </p>

      <% if support_message.present? || support_id.present? %>
        <div class="mt-3 text-center">
          <% if support_message.present? %>
            <p class="mx-auto max-w-sm text-xs leading-6 token-text-muted">
              <%= support_message %>
            </p>
          <% end %>

          <% if support_id.present? %>
            <p class="mt-2 font-mono text-[0.6875rem] leading-5 token-text-muted break-all" data-error-support-id>
              <%= t("errors.internal_server_error.support_id_label") %>: <%= support_id %>
            </p>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</main>
