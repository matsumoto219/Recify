<% content_for :title, t("errors.too_many_requests.title") %>

<%
  retry_after = local_assigns[:retry_after].to_i
  description =
    if retry_after.positive?
      minutes = (retry_after / 60.0).ceil
      safe_join(
        [
          tag.span(t("errors.too_many_requests.description")),
          tag.span(t("errors.too_many_requests.retry_after", minutes: minutes), class: "font-bold token-text-base")
        ],
        tag.br
      )
    else
      t("errors.too_many_requests.description")
    end
%>

<%= render "errors/error_page",
  status_code: 429,
  icon: "timer",
  title: t("errors.too_many_requests.title"),
  description: description,
  primary_label: t("errors.too_many_requests.back_link"),
  primary_path: root_path,
  primary_data: {
    controller: "history-back",
    action: "history-back#go"
  } %>
