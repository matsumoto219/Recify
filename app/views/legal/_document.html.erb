<%
  versions_path = local_assigns[:versions_path]
  current_document_path = local_assigns[:current_document_path]
  show_version_notice = local_assigns.fetch(:show_version_notice, false)
  document_is_current = local_assigns.fetch(:document_is_current, legal_document.current?)
%>

<%= render "shared/ui/layout/ambient_background" %>

<section class="mx-auto max-w-4xl space-y-8 px-4 py-10 pb-28 md:px-2 md:py-14 md:pb-12">
  <%= render "shared/ui/layout/section_header",
        title: file_document.title,
        subtitle: file_document.lead,
        title_size: "text-2xl md:text-3xl",
        subtitle_size: "text-sm md:text-base",
        align: :center %>

  <p class="text-center text-xs font-semibold uppercase tracking-wider token-text-muted">
    <%= legal_document_last_updated_text(legal_document) %>
  </p>

  <% if show_version_notice || versions_path.present? || current_document_path.present? %>
    <div class="space-y-4">
      <% if show_version_notice %>
        <%= render "shared/ui/layout/surface_card",
              padding: :sm,
              surface_variant: :bg_elevated,
              class: "border token-border-soft" do %>
          <div class="flex flex-col gap-3 text-sm leading-7 token-text-muted sm:flex-row sm:items-center sm:justify-between">
            <p>
              <%= document_is_current ? t("legal.version_navigation.current_notice") :
                    t("legal.version_navigation.past_notice") %>
            </p>

            <% if current_document_path.present? && !document_is_current %>
              <%= link_to legal_document_current_link_text(legal_document.document_type),
                    current_document_path,
                    class: "inline-flex items-center justify-center rounded-lg border token-border-soft px-3 py-2 text-sm font-bold token-text-brand transition-opacity hover:opacity-80" %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <% if versions_path.present? %>
        <div class="flex justify-center">
          <%= link_to t("legal.version_navigation.view_versions"),
                versions_path,
                class: "inline-flex items-center justify-center rounded-lg border token-border-soft px-4 py-2 text-sm font-bold token-text-brand transition-opacity hover:opacity-80" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="space-y-4">
    <% file_document.sections.each do |section| %>
      <%= render "shared/ui/layout/surface_card", padding: :md do %>
        <section class="space-y-4">
          <h2 class="text-lg font-bold token-text-base"><%= section.fetch("title") %></h2>

          <% Array(section["paragraphs"]).each do |paragraph| %>
            <p class="text-sm leading-7 token-text-muted"><%= paragraph %></p>
          <% end %>

          <% if section["items"].present? %>
            <ul class="space-y-2 pl-5 text-sm leading-7 token-text-muted">
              <% section.fetch("items").each do |item| %>
                <li class="list-disc"><%= item %></li>
              <% end %>
            </ul>
          <% end %>

          <% if section["table"].present? %>
            <% table = section.fetch("table") %>
            <div class="overflow-x-auto rounded-lg border token-border-soft">
              <table class="min-w-[640px] w-full text-left text-sm token-text-muted">
                <thead class="token-bg-elevated token-text-base">
                  <tr>
                    <% table.fetch("headers").each do |header| %>
                      <th scope="col" class="px-4 py-3 font-bold"><%= header %></th>
                    <% end %>
                  </tr>
                </thead>
                <tbody class="divide-y token-divide-soft">
                  <% table.fetch("rows").each do |row| %>
                    <tr>
                      <% row.each do |cell| %>
                        <td class="px-4 py-3 align-top leading-7"><%= cell %></td>
                      <% end %>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>

          <% Array(section["paragraphs_after"]).each do |paragraph| %>
            <p class="text-sm leading-7 token-text-muted"><%= paragraph %></p>
          <% end %>
        </section>
      <% end %>
    <% end %>
  </div>
</section>
