<%
  navigation_items = [
    { label: t("admin.navigation.dashboard"), path: admin_root_path, icon: "dashboard" },
    { label: t("admin.navigation.receipt_analysis_runs"), path: admin_receipt_analysis_runs_path, icon: "analytics" },
    { label: t("admin.navigation.audit_logs"), path: admin_audit_logs_path, icon: "manage_search" },
    { label: t("admin.navigation.security_events"), path: admin_security_events_path, icon: "security" },
    { label: t("admin.navigation.ip_blocks"), path: admin_ip_blocks_path, icon: "block" },
    { label: t("admin.navigation.announcements"), path: admin_announcements_path, icon: "campaign" },
    { label: t("admin.navigation.contact_requests"), path: admin_contact_requests_path, icon: "contact_support" },
    { label: t("admin.navigation.users"), path: admin_users_path, icon: "group" },
    { label: t("admin.navigation.cleanup"), path: admin_receipt_analysis_cleanup_path, icon: "cleaning_services" },
    { label: t("admin.navigation.system_operations"), path: admin_system_operations_path, icon: "manufacturing" },
    { label: t("admin.navigation.system_settings"), path: admin_system_settings_path, icon: "settings" }
  ]

  base_link_class = "ui-touch-control admin-navigation-link inline-flex min-w-0 max-w-full items-center gap-1.5 rounded-md px-1 py-1 font-semibold transition-colors"
%>

<nav class="admin-navigation rounded-lg border token-border-soft token-bg-card px-4 py-3" aria-label="<%= t("admin.navigation.aria_label") %>">
  <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <div class="admin-navigation-items flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
      <% navigation_items.each_with_index do |item, index| %>
        <% active = current_page?(item[:path]) %>
        <% link_class = [ base_link_class, active ? "admin-navigation-current token-brand-soft-bg token-text-brand" : "token-text-muted token-hover-text-brand" ].compact.join(" ") %>
        <%= link_to item[:path],
              class: link_class,
              aria: { label: item[:label], current: active ? "page" : nil } do %>
          <span class="admin-navigation-icon material-symbols-outlined hidden text-base leading-none" aria-hidden="true"><%= item[:icon] %></span>
          <span class="admin-navigation-label min-w-0 break-words [overflow-wrap:anywhere]"><%= item[:label] %></span>
        <% end %>

        <% unless index == navigation_items.size - 1 %>
          <span class="admin-navigation-separator token-text-muted" aria-hidden="true">/</span>
        <% end %>
      <% end %>
    </div>

    <%= link_to receipts_path,
          class: "ui-touch-control admin-navigation-link admin-navigation-back inline-flex min-w-0 max-w-full items-center gap-1.5 rounded-md px-1 py-1 text-sm font-semibold token-text-muted token-hover-text-base transition-colors",
          aria: { label: t("admin.navigation.back_to_app") } do %>
      <span class="admin-navigation-icon material-symbols-outlined hidden text-base leading-none" aria-hidden="true">arrow_back</span>
      <span class="admin-navigation-label min-w-0 break-words [overflow-wrap:anywhere]"><%= t("admin.navigation.back_to_app") %></span>
    <% end %>
  </div>
</nav>
