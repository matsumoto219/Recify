<%
  pagination = local_assigns.fetch(:pagination)
  path_method = local_assigns.fetch(:path_method)
  previous_label = local_assigns.fetch(:previous_label)
  next_label = local_assigns.fetch(:next_label)
%>

<div class="flex flex-wrap items-center gap-2">
  <% if pagination.has_previous? %>
    <%= link_to previous_label,
          public_send(path_method, admin_index_page_params(pagination, :backward)),
          class: "rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-brand hover:underline" %>
  <% else %>
    <span class="rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-muted opacity-60"><%= previous_label %></span>
  <% end %>

  <% if pagination.has_next? %>
    <%= link_to next_label,
          public_send(path_method, admin_index_page_params(pagination, :forward)),
          class: "rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-brand hover:underline" %>
  <% else %>
    <span class="rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-muted opacity-60"><%= next_label %></span>
  <% end %>
</div>
