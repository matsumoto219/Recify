<div class="mt-3 min-w-0 max-w-full border-t token-border-soft pt-3" data-provider-error-diagnostic>
  <% if diagnostic.recorded? %>
    <details class="min-w-0 max-w-full">
      <summary class="cursor-pointer text-xs font-semibold token-text-base">
        <%= t("admin.provider_error_diagnostic.title") %>
      </summary>
      <div class="mt-3 min-w-0 max-w-full space-y-3">
        <p class="text-xs leading-relaxed token-text-muted"><%= t("admin.provider_error_diagnostic.description") %></p>
        <% if diagnostic.local_issue %>
          <p class="break-words text-xs token-text-muted [overflow-wrap:anywhere]"><%= diagnostic.local_issue %></p>
        <% end %>
        <% diagnostic.nodes.each do |node| %>
          <div class="min-w-0 max-w-full rounded-lg border token-border-soft p-3" data-provider-error-node>
            <p class="break-words font-mono text-xs font-semibold token-text-base [overflow-wrap:anywhere]"><%= node[:path] %></p>
            <dl class="mt-2 grid min-w-0 max-w-full gap-2 text-xs">
              <% node[:fields].each do |label, value| %>
                <div class="min-w-0">
                  <dt class="font-semibold token-text-muted"><%= label %></dt>
                  <dd class="mt-0.5 break-words font-mono token-text-base [overflow-wrap:anywhere]"><%= value %></dd>
                </div>
              <% end %>
            </dl>
          </div>
        <% end %>
        <% if diagnostic.omissions.any? %>
          <div class="min-w-0 max-w-full">
            <p class="text-xs font-semibold token-text-muted"><%= t("admin.provider_error_diagnostic.omissions") %></p>
            <ul class="mt-2 space-y-1 text-xs token-text-muted">
              <% diagnostic.omissions.each do |entry| %>
                <li class="break-words [overflow-wrap:anywhere]">
                  <span class="font-mono"><%= entry[:path] %></span> — <%= entry[:reason] %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    </details>
  <% else %>
    <p class="text-xs leading-relaxed token-text-muted"><%= diagnostic.notice %></p>
  <% end %>
</div>
