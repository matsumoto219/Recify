<% if rows.empty? %>
  <p class="text-sm token-text-muted"><%= t("admin.current_amount_inspector.record_missing") %></p>
<% else %>
  <dl class="grid min-w-0 gap-3 sm:grid-cols-2">
    <% rows.each do |label, value| %>
      <div class="min-w-0 rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= label %></dt>
        <dd class="mt-1 break-words text-sm token-text-base [overflow-wrap:anywhere]"><%= value %></dd>
      </div>
    <% end %>
  </dl>
<% end %>
