<% content_for :title, t("admin.receipt_analysis_runs.index.title") %>

<%
  filters = @filters || {}
  query_base = filters.except(:offset).compact_blank
  limit = @result.limit
  offset = @result.offset
  total_count = @result.total_count
  start_number = total_count.zero? ? 0 : offset + 1
  end_number = [ offset + @result.records.size, total_count ].min
  previous_offset = [ offset - limit, 0 ].max
  next_offset = offset + limit
  has_previous = offset.positive?
  has_next = next_offset < total_count

  status_options = ReceiptAnalysisRun::STATUSES.map { |value| [ value, value ] }
  stage_options = ReceiptAnalysisRun::STAGES.map { |value| [ value, value ] }
  source_options = ReceiptAnalysisRun::SOURCES.map { |value| [ value, value ] }
  receipt_status_options = Receipt.statuses.keys.map { |value| [ value, value ] }
  needs_attention_options = [
    [ t("admin.receipt_analysis_runs.index.filters.unspecified"), "" ],
    [ t("admin.receipt_analysis_runs.index.filters.needs_attention_only"), "1" ]
  ]
  limit_options = [ 25, 50, 100 ].map { |value| [ t("admin.receipt_analysis_runs.index.filters.limit_unit", count: value), value.to_s ] }
  admin_select_class = "h-10 w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 text-sm token-text-base"
%>

<section class="mx-auto w-full max-w-7xl space-y-6 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "admin/shared/navigation" %>

  <%= render "shared/ui/layout/section_header",
        title: t("admin.receipt_analysis_runs.index.title"),
        subtitle: t("admin.receipt_analysis_runs.index.description"),
        title_size: "text-3xl",
        subtitle_size: "text-base" %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4 flex items-center justify-between gap-3">
      <div>
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_runs.index.filters.title") %></h2>
        <p class="text-sm token-text-muted"><%= t("admin.receipt_analysis_runs.index.filters.description") %></p>
      </div>

      <%= link_to t("admin.receipt_analysis_runs.index.filters.reset"), admin_receipt_analysis_runs_path, class: "text-sm font-semibold token-text-brand hover:underline" %>
    </div>

    <%= form_with url: admin_receipt_analysis_runs_path, method: :get, local: true, class: "grid gap-4 md:grid-cols-4" do |form| %>
      <div class="space-y-1">
        <%= form.label :status, t("admin.receipt_analysis_runs.index.filters.labels.status"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.select :status,
              options_for_select([[ t("admin.receipt_analysis_runs.index.filters.all"), "" ]] + status_options, filters[:status]),
              {},
              class: admin_select_class %>
      </div>

      <div class="space-y-1">
        <%= form.label :stage, t("admin.receipt_analysis_runs.index.filters.labels.stage"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.select :stage,
              options_for_select([[ t("admin.receipt_analysis_runs.index.filters.all"), "" ]] + stage_options, filters[:stage]),
              {},
              class: admin_select_class %>
      </div>

      <div class="space-y-1">
        <%= form.label :source, t("admin.receipt_analysis_runs.index.filters.labels.source"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.select :source,
              options_for_select([[ t("admin.receipt_analysis_runs.index.filters.all"), "" ]] + source_options, filters[:source]),
              {},
              class: admin_select_class %>
      </div>

      <div class="space-y-1">
        <%= form.label :receipt_status, t("admin.receipt_analysis_runs.index.filters.labels.receipt_status"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.select :receipt_status,
              options_for_select([[ t("admin.receipt_analysis_runs.index.filters.all"), "" ]] + receipt_status_options, filters[:receipt_status]),
              {},
              class: admin_select_class %>
      </div>

      <div class="space-y-1">
        <%= form.label :needs_attention, t("admin.receipt_analysis_runs.index.filters.labels.needs_attention"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.select :needs_attention,
              options_for_select(needs_attention_options, filters[:needs_attention]),
              {},
              class: admin_select_class %>
      </div>

      <div class="space-y-1">
        <%= form.label :error_code, t("admin.receipt_analysis_runs.index.filters.labels.error_code"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.text_field :error_code, value: filters[:error_code], class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 text-sm token-text-base" %>
      </div>

      <div class="space-y-1">
        <%= form.label :run_key, t("admin.receipt_analysis_runs.index.filters.labels.run_key"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.text_field :run_key, value: filters[:run_key], class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 text-sm token-text-base" %>
      </div>

      <div class="space-y-1">
        <%= form.label :receipt_public_id, t("admin.receipt_analysis_runs.index.filters.labels.receipt_public_id"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.text_field :receipt_public_id, value: filters[:receipt_public_id], class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 text-sm token-text-base" %>
      </div>

      <div class="space-y-1">
        <%= form.label :user_id, t("admin.receipt_analysis_runs.index.filters.labels.user_id"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.text_field :user_id, value: filters[:user_id], inputmode: "numeric", class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 text-sm token-text-base" %>
      </div>

      <div class="space-y-1">
        <%= form.label :limit, t("admin.receipt_analysis_runs.index.filters.labels.limit"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.select :limit,
              options_for_select(limit_options, filters[:limit].presence || limit.to_s),
              {},
              class: admin_select_class %>
      </div>

      <div class="flex items-end gap-3 md:col-span-2">
        <%= render "shared/ui/actions/button",
              label: t("admin.receipt_analysis_runs.index.filters.submit"),
              type: "submit",
              size: :compact,
              icon: "filter_alt" %>

        <%= render "shared/ui/actions/button",
              as: :link,
              href: admin_receipt_analysis_runs_path,
              label: t("admin.receipt_analysis_runs.index.filters.clear"),
              variant: :secondary,
              size: :compact,
              icon: "restart_alt" %>
      </div>
    <% end %>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_runs.index.results.title") %></h2>
        <p class="text-sm token-text-muted"><%= t("admin.receipt_analysis_runs.index.results.count_summary", total: total_count, start: start_number, end: end_number) %></p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <% if has_previous %>
          <%= link_to t("admin.receipt_analysis_runs.index.results.previous"),
                admin_receipt_analysis_runs_path(query_base.merge(limit: limit, offset: previous_offset)),
                class: "rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-brand hover:underline" %>
        <% else %>
          <span class="rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-muted opacity-60"><%= t("admin.receipt_analysis_runs.index.results.previous") %></span>
        <% end %>

        <% if has_next %>
          <%= link_to t("admin.receipt_analysis_runs.index.results.next"),
                admin_receipt_analysis_runs_path(query_base.merge(limit: limit, offset: next_offset)),
                class: "rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-brand hover:underline" %>
        <% else %>
          <span class="rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-muted opacity-60"><%= t("admin.receipt_analysis_runs.index.results.next") %></span>
        <% end %>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead class="token-text-muted">
          <tr class="border-b token-border-soft">
            <th class="px-3 py-2 font-semibold"><%= t("admin.receipt_analysis_runs.index.table.run_key") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.receipt_analysis_runs.index.table.receipt") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.receipt_analysis_runs.index.table.user") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.receipt_analysis_runs.index.table.run") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.receipt_analysis_runs.index.table.receipt_status") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.receipt_analysis_runs.index.table.source") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.receipt_analysis_runs.index.table.error") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.receipt_analysis_runs.index.table.created") %></th>
          </tr>
        </thead>
        <tbody>
          <% @result.records.each do |record| %>
            <tr class="border-b token-border-soft">
              <td class="px-3 py-3 font-mono text-xs">
                <%= link_to record[:run_key], admin_receipt_analysis_run_path(record[:run_key]), class: "token-text-brand hover:underline" %>
              </td>
              <td class="px-3 py-3">
                <div class="font-semibold token-text-base"><%= record.dig(:receipt_info, :display_id) %></div>
                <div class="font-mono text-xs token-text-muted"><%= record.dig(:receipt_info, :public_id) %></div>
              </td>
              <td class="px-3 py-3">
                <div class="font-mono text-xs token-text-base">#<%= record.dig(:user_info, :id) %></div>
                <div class="text-xs token-text-muted"><%= record.dig(:user_info, :guest) ? t("admin.receipt_analysis_runs.index.user_kind.guest") : t("admin.receipt_analysis_runs.index.user_kind.registered") %></div>
              </td>
              <td class="px-3 py-3">
                <div class="token-text-base"><%= record[:stage] %> / <%= record[:status] %></div>
              </td>
              <td class="px-3 py-3"><%= record[:receipt_status] %></td>
              <td class="px-3 py-3"><%= record[:source] %></td>
              <td class="px-3 py-3"><%= record[:error_code].presence || "-" %></td>
              <td class="px-3 py-3 whitespace-nowrap"><%= l(record[:timestamps][:created_at], format: :short) %></td>
            </tr>
          <% end %>

          <% if @result.records.empty? %>
            <tr>
              <td colspan="8" class="px-3 py-10 text-center text-sm token-text-muted"><%= t("admin.receipt_analysis_runs.index.results.empty") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
