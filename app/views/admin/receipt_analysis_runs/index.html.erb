<% content_for :title, t("admin.receipt_analysis_runs.index.title") %>

<%
  filters = @filters || {}
  pagination = admin_index_pagination(@result, filters: filters)
  filter_options = admin_receipt_analysis_run_filter_options(@filter_options || {})
  filter_label_class = "text-xs font-semibold token-text-muted normal-case tracking-normal px-0"
  filter_wrapper_class = "space-y-1"
  filter_control_class = "rounded-lg text-sm"
%>

<section class="mx-auto w-full max-w-7xl space-y-6 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "admin/shared/navigation" %>

  <%= render "shared/ui/layout/section_header",
        title: t("admin.receipt_analysis_runs.index.title"),
        subtitle: t("admin.receipt_analysis_runs.index.description"),
        title_size: "text-2xl md:text-3xl",
        subtitle_size: "text-sm md:text-base" %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4 flex items-center justify-between gap-3">
      <div>
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_runs.index.filters.title") %></h2>
        <p class="text-sm token-text-muted"><%= t("admin.receipt_analysis_runs.index.filters.description") %></p>
      </div>

      <%= link_to t("admin.receipt_analysis_runs.index.filters.reset"), admin_receipt_analysis_runs_path, class: "text-sm font-semibold token-text-brand hover:underline" %>
    </div>

    <%= form_with url: admin_receipt_analysis_runs_path, method: :get, local: true, class: "grid gap-4 md:grid-cols-4" do |form| %>
      <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :status,
            label: t("admin.receipt_analysis_runs.index.filters.labels.status"),
            options: [[ t("admin.receipt_analysis_runs.index.filters.all"), "" ]] + filter_options[:statuses],
            selected: filters[:status],
            with_icon: false,
            size: :dense,
            select_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            select_class: filter_control_class %>

      <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :stage,
            label: t("admin.receipt_analysis_runs.index.filters.labels.stage"),
            options: [[ t("admin.receipt_analysis_runs.index.filters.all"), "" ]] + filter_options[:stages],
            selected: filters[:stage],
            with_icon: false,
            size: :dense,
            select_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            select_class: filter_control_class %>

      <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :source,
            label: t("admin.receipt_analysis_runs.index.filters.labels.source"),
            options: [[ t("admin.receipt_analysis_runs.index.filters.all"), "" ]] + filter_options[:sources],
            selected: filters[:source],
            with_icon: false,
            size: :dense,
            select_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            select_class: filter_control_class %>

      <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :receipt_status,
            label: t("admin.receipt_analysis_runs.index.filters.labels.receipt_status"),
            options: [[ t("admin.receipt_analysis_runs.index.filters.all"), "" ]] + filter_options[:receipt_statuses],
            selected: filters[:receipt_status],
            with_icon: false,
            size: :dense,
            select_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            select_class: filter_control_class %>

      <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :needs_attention,
            label: t("admin.receipt_analysis_runs.index.filters.labels.needs_attention"),
            options: filter_options[:needs_attention],
            selected: filters[:needs_attention],
            with_icon: false,
            size: :dense,
            select_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            select_class: filter_control_class %>

      <%= render "shared/ui/form/text_field",
            f: form,
            attribute: :error_code,
            label: t("admin.receipt_analysis_runs.index.filters.labels.error_code"),
            value: filters[:error_code],
            with_icon: false,
            size: :dense,
            input_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            input_class: filter_control_class %>

      <%= render "shared/ui/form/text_field",
            f: form,
            attribute: :run_key,
            label: t("admin.receipt_analysis_runs.index.filters.labels.run_key"),
            value: filters[:run_key],
            with_icon: false,
            size: :dense,
            input_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            input_class: filter_control_class %>

      <%= render "shared/ui/form/text_field",
            f: form,
            attribute: :receipt_public_id,
            label: t("admin.receipt_analysis_runs.index.filters.labels.receipt_public_id"),
            value: filters[:receipt_public_id],
            with_icon: false,
            size: :dense,
            input_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            input_class: filter_control_class %>

      <%= render "shared/ui/form/text_field",
            f: form,
            attribute: :user_id,
            label: t("admin.receipt_analysis_runs.index.filters.labels.user_id"),
            value: filters[:user_id],
            with_icon: false,
            size: :dense,
            input_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            input_class: filter_control_class,
            html_options: { inputmode: "numeric" } %>

      <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :limit,
            label: t("admin.receipt_analysis_runs.index.filters.labels.limit"),
            options: filter_options[:limits],
            selected: filters[:limit].presence || pagination.limit.to_s,
            with_icon: false,
            size: :dense,
            select_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            select_class: filter_control_class %>

      <div class="flex items-end gap-3 md:col-span-2">
        <%= render "shared/ui/actions/button",
              label: t("admin.receipt_analysis_runs.index.filters.submit"),
              type: "submit",
              size: :compact,
              icon: "filter_alt" %>

        <%= render "shared/ui/actions/button",
              as: :link,
              href: admin_receipt_analysis_runs_path,
              label: t("admin.receipt_analysis_runs.index.filters.clear"),
              variant: :secondary,
              size: :compact,
              icon: "restart_alt" %>
      </div>
    <% end %>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_runs.index.results.title") %></h2>
        <p class="text-sm token-text-muted"><%= t("admin.receipt_analysis_runs.index.results.count_summary", total: pagination.total_count, start: pagination.start_number, end: pagination.end_number) %></p>
      </div>

      <%= render "admin/shared/index_pagination",
            pagination: pagination,
            path_method: :admin_receipt_analysis_runs_path,
            previous_label: t("admin.receipt_analysis_runs.index.results.previous"),
            next_label: t("admin.receipt_analysis_runs.index.results.next") %>
    </div>

    <%= render "admin/shared/table_frame", size: :lg do %>
        <thead class="token-text-muted">
          <tr class="border-b token-border-soft">
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :long_id) %>"><%= t("admin.receipt_analysis_runs.index.table.run_key") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :long_id) %>"><%= t("admin.receipt_analysis_runs.index.table.receipt") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :id) %>"><%= t("admin.receipt_analysis_runs.index.table.user") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :status) %>"><%= t("admin.receipt_analysis_runs.index.table.run") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :status) %>"><%= t("admin.receipt_analysis_runs.index.table.receipt_status") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :status) %>"><%= t("admin.receipt_analysis_runs.index.table.source") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :status) %>"><%= t("admin.receipt_analysis_runs.index.table.error") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :datetime) %>"><%= t("admin.receipt_analysis_runs.index.table.created") %></th>
          </tr>
        </thead>
        <tbody>
          <% @result.records.each do |record| %>
            <tr class="border-b token-border-soft">
              <td class="px-3 py-3 <%= admin_table_cell_classes(type: :long_id) %>">
                <%= link_to record[:run_key], admin_receipt_analysis_run_path(record[:run_key]), class: "token-text-brand hover:underline" %>
              </td>
              <td class="px-3 py-3 <%= admin_table_cell_classes(type: :long_id) %>">
                <div class="font-semibold token-text-base"><%= record.dig(:receipt_info, :display_id) %></div>
                <div class="font-mono text-xs token-text-muted"><%= record.dig(:receipt_info, :public_id) %></div>
              </td>
              <td class="px-3 py-3 <%= admin_table_cell_classes(type: :id) %>">
                <div class="font-mono text-xs token-text-base">#<%= record.dig(:user_info, :id) %></div>
                <div class="text-xs token-text-muted"><%= record.dig(:user_info, :guest) ? t("admin.receipt_analysis_runs.index.user_kind.guest") : t("admin.receipt_analysis_runs.index.user_kind.registered") %></div>
              </td>
              <td class="px-3 py-3 <%= admin_table_cell_classes(type: :status) %>">
                <div class="token-text-base"><%= record[:stage] %> / <%= record[:status] %></div>
              </td>
              <td class="px-3 py-3 <%= admin_table_cell_classes(type: :status) %>"><%= record[:receipt_status] %></td>
              <td class="px-3 py-3 <%= admin_table_cell_classes(type: :status) %>"><%= record[:source] %></td>
              <td class="px-3 py-3 <%= admin_table_cell_classes(type: :status) %>"><%= record[:error_code].presence || "-" %></td>
              <td class="px-3 py-3 <%= admin_table_cell_classes(type: :datetime) %>"><%= l(record[:timestamps][:created_at], format: :short) %></td>
            </tr>
          <% end %>

          <% if @result.records.empty? %>
            <tr>
              <td colspan="8" class="px-3 py-10 text-center text-sm token-text-muted"><%= t("admin.receipt_analysis_runs.index.results.empty") %></td>
            </tr>
          <% end %>
        </tbody>
    <% end %>
  <% end %>
</section>
