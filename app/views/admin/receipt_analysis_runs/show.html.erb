<% content_for :title, t("admin.receipt_analysis_runs.show.title") %>

<%
  admin_label_class = "text-xs font-semibold token-text-muted normal-case tracking-normal px-0"
  admin_control_class = "rounded-lg text-sm"
  admin_mono_control_class = "rounded-lg font-mono text-sm"
%>

<section class="mx-auto w-full max-w-6xl space-y-6 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "admin/shared/navigation" %>

  <%
    receipt = @record[:receipt]
    receipt_image = receipt.image if receipt&.image&.attached?
    receipt_image_blob = receipt_image&.blob
    receipt_image_attachment = receipt_image&.attachment
    receipt_image_metadata = receipt_image_blob&.metadata.to_h
    receipt_image_width = receipt_image_metadata["width"] || receipt_image_metadata[:width]
    receipt_image_height = receipt_image_metadata["height"] || receipt_image_metadata[:height]
    receipt_image_dimensions = if receipt_image_width.present? && receipt_image_height.present?
                                 t(
                                   "admin.receipt_analysis_runs.show.image_metadata.dimensions_value",
                                   width: receipt_image_width,
                                   height: receipt_image_height
                                 )
                               else
                                 "-"
                               end
  %>

  <%= render "shared/ui/layout/section_header",
        title: t("admin.receipt_analysis_runs.show.title"),
        subtitle: @record[:run_key],
        breadcrumb_label: t("admin.receipt_analysis_runs.index.title"),
        breadcrumb_path: admin_receipt_analysis_runs_path,
        title_size: "text-2xl md:text-3xl",
        subtitle_size: "text-sm" %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="grid gap-6 lg:grid-cols-3">
      <section class="space-y-3">
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_runs.show.sections.run") %></h2>
        <dl class="space-y-3 text-sm">
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.labels.run_key") %></dt>
            <dd class="break-words font-mono token-text-base [overflow-wrap:anywhere]"><%= @record[:run_key] %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.labels.stage_status") %></dt>
            <dd class="token-text-base"><%= @record[:stage] %> / <%= @record[:status] %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.labels.source") %></dt>
            <dd class="token-text-base"><%= @record[:source] %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.labels.error") %></dt>
            <dd class="token-text-base"><%= @record[:error_code].presence || "-" %></dd>
          </div>
        </dl>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_runs.show.sections.receipt") %></h2>
        <dl class="space-y-3 text-sm">
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.labels.display_public_id") %></dt>
            <dd class="token-text-base">
              <%= @record.dig(:receipt_info, :display_id) %>
              <span class="font-mono text-xs token-text-muted"><%= @record.dig(:receipt_info, :public_id) %></span>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.labels.receipt_status") %></dt>
            <dd class="token-text-base"><%= @record[:receipt_status] %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.labels.store_total") %></dt>
            <dd class="token-text-base">
              <%= @record.dig(:receipt_info, :store_name).presence || "-" %>
              /
              <%= @record.dig(:receipt_info, :total_amount).presence || "-" %>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.labels.purchased_at") %></dt>
            <dd class="token-text-base"><%= @record.dig(:receipt_info, :purchased_at).present? ? l(@record.dig(:receipt_info, :purchased_at), format: :short) : "-" %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.labels.review_reasons") %></dt>
            <dd class="break-words font-mono text-xs token-text-base [overflow-wrap:anywhere]"><%= Array(@record.dig(:receipt_info, :review_reasons)).presence&.join(", ") || "-" %></dd>
          </div>
        </dl>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_runs.show.sections.user") %></h2>
        <dl class="space-y-3 text-sm">
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.labels.user_id") %></dt>
            <dd class="font-mono token-text-base">#<%= @record.dig(:user_info, :id) %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.labels.kind") %></dt>
            <dd class="token-text-base"><%= @record.dig(:user_info, :guest) ? t("admin.receipt_analysis_runs.show.user_kind.guest") : t("admin.receipt_analysis_runs.show.user_kind.registered") %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.labels.admin") %></dt>
            <dd class="token-text-base"><%= @record.dig(:user_info, :admin) ? t("admin.receipt_analysis_runs.show.boolean.true") : t("admin.receipt_analysis_runs.show.boolean.false") %></dd>
          </div>
        </dl>
      </section>
    </div>
  <% end %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render "shared/ui/card/receipt_image_card",
          receipt: receipt,
          title: t("admin.receipt_analysis_runs.show.sections.original_image"),
          show_toggle: true,
          show_modal: true,
          show_download: false,
          initially_open: false,
          collapse_on_mobile: true,
          keep_image_enabled: receipt.keep_image?,
          wrapper_class: "h-full",
          card_class: "h-full flex flex-col",
          preview_width_class: "w-full max-w-[320px]",
          preview_height_class: "h-[420px]",
          empty_message: t("admin.receipt_analysis_runs.show.image_metadata.empty") %>

    <%= render "shared/ui/layout/surface_card", padding: :md, class: "h-full flex flex-col" do %>
      <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_runs.show.sections.image_metadata") %></h2>
      <dl class="grid gap-4 text-sm md:grid-cols-2">
        <div>
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.image_metadata.filename") %></dt>
          <dd class="break-words font-mono text-xs token-text-base [overflow-wrap:anywhere]"><%= receipt_image_blob&.filename&.to_s.presence || "-" %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.image_metadata.content_type") %></dt>
          <dd class="font-mono text-xs token-text-base"><%= receipt_image_blob&.content_type.presence || "-" %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.image_metadata.byte_size") %></dt>
          <dd class="font-mono text-xs token-text-base"><%= receipt_image_blob.present? ? number_to_human_size(receipt_image_blob.byte_size) : "-" %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.image_metadata.dimensions") %></dt>
          <dd class="font-mono text-xs token-text-base"><%= receipt_image_dimensions %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.image_metadata.attached_at") %></dt>
          <dd class="font-mono text-xs token-text-base"><%= receipt_image_attachment&.created_at.present? ? l(receipt_image_attachment.created_at, format: :short) : "-" %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.image_metadata.keep_image") %></dt>
          <dd class="font-mono text-xs token-text-base"><%= receipt.keep_image? ? t("admin.receipt_analysis_runs.show.boolean.true") : t("admin.receipt_analysis_runs.show.boolean.false") %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.image_metadata.purge_eligible_at") %></dt>
          <dd class="font-mono text-xs token-text-base"><%= receipt.image_purge_eligible_at.present? ? l(receipt.image_purge_eligible_at, format: :short) : "-" %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.image_metadata.purged_at") %></dt>
          <dd class="font-mono text-xs token-text-base"><%= receipt.image_purged_at.present? ? l(receipt.image_purged_at, format: :short) : "-" %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.image_metadata.purged_reason") %></dt>
          <dd class="font-mono text-xs token-text-base"><%= receipt.image_purged_reason.present? ? t("admin.receipt_analysis_runs.show.image_metadata.purged_reasons.#{receipt.image_purged_reason}", default: receipt.image_purged_reason) : "-" %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.image_metadata.ocr_input_image") %></dt>
          <dd class="text-xs token-text-muted"><%= t("admin.receipt_analysis_runs.show.image_metadata.ocr_input_image_not_implemented") %></dd>
        </div>
      </dl>
    <% end %>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render "shared/ui/layout/surface_card", padding: :md do %>
      <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_runs.show.sections.timing_provider") %></h2>
      <dl class="grid gap-4 text-sm md:grid-cols-2">
        <% @record[:timestamps].each do |name, value| %>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= name %></dt>
            <dd class="token-text-base"><%= value.present? ? l(value, format: :short) : "-" %></dd>
          </div>
        <% end %>

        <% @record[:latency_ms].each do |name, value| %>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.labels.latency", name: name) %></dt>
            <dd class="token-text-base"><%= value.present? ? "#{value}ms" : "-" %></dd>
          </div>
        <% end %>
      </dl>

      <%
        polling_metrics = (@record[:polling_metrics] || {}).with_indifferent_access
        poll_count = polling_metrics[:poll_count]
        max_poll_count = polling_metrics[:max_poll_count]
        poll_count_label = if poll_count.present? || max_poll_count.present?
                             "#{poll_count.presence || "-"} / #{max_poll_count.presence || "-"}"
                           else
                             "-"
                           end
        polling_metric_rows = [
          [ t("admin.receipt_analysis_runs.show.polling_metrics.elapsed_ms"), polling_metrics[:elapsed_ms].present? ? "#{polling_metrics[:elapsed_ms]}ms" : "-" ],
          [ t("admin.receipt_analysis_runs.show.polling_metrics.poll_count"), poll_count_label ],
          [ t("admin.receipt_analysis_runs.show.polling_metrics.final_status"), polling_metrics[:final_status].presence || "-" ],
          [ t("admin.receipt_analysis_runs.show.polling_metrics.poll_interval"), polling_metrics[:poll_interval].present? ? "#{polling_metrics[:poll_interval]}s" : "-" ],
          [ t("admin.receipt_analysis_runs.show.polling_metrics.total_poll_sleep_ms"), polling_metrics[:total_poll_sleep_ms].present? ? "#{polling_metrics[:total_poll_sleep_ms]}ms" : "-" ],
          [ t("admin.receipt_analysis_runs.show.polling_metrics.max_poll_interval"), polling_metrics[:max_poll_interval].present? ? "#{polling_metrics[:max_poll_interval]}s" : "-" ],
          [ t("admin.receipt_analysis_runs.show.polling_metrics.poll_backoff_factor"), polling_metrics[:poll_backoff_factor].presence || "-" ],
          [ t("admin.receipt_analysis_runs.show.polling_metrics.reached_max_poll"), polling_metrics.key?(:reached_max_poll) ? t("admin.receipt_analysis_runs.show.boolean.#{polling_metrics[:reached_max_poll]}") : "-" ],
          [ t("admin.receipt_analysis_runs.show.polling_metrics.retry_after_used"), polling_metrics.key?(:retry_after_used) ? t("admin.receipt_analysis_runs.show.boolean.#{polling_metrics[:retry_after_used]}") : "-" ],
          [ t("admin.receipt_analysis_runs.show.polling_metrics.retry_count"), polling_metrics[:retry_count].presence || "-" ]
        ]
      %>
      <div class="mt-4 rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <h3 class="text-sm font-semibold token-text-base"><%= t("admin.receipt_analysis_runs.show.polling_metrics.title") %></h3>
        <dl class="mt-3 grid gap-3 text-sm md:grid-cols-2">
          <% polling_metric_rows.each do |label, value| %>
            <div>
              <dt class="text-xs font-semibold token-text-muted"><%= label %></dt>
              <dd class="font-mono text-xs token-text-base"><%= value %></dd>
            </div>
          <% end %>
        </dl>
      </div>

      <%
        ai_metrics = (@record[:ai_metrics] || {}).with_indifferent_access
        token_usage = (ai_metrics[:token_usage] || {}).with_indifferent_access
        token_usage_label = if token_usage.present?
                              t(
                                "admin.receipt_analysis_runs.show.ai_metrics.token_usage_value",
                                input: token_usage[:input_tokens].presence || "-",
                                output: token_usage[:output_tokens].presence || "-",
                                total: token_usage[:total_tokens].presence || "-"
                              )
                            else
                              "-"
                            end
        ai_metric_rows = [
          [ t("admin.receipt_analysis_runs.show.ai_metrics.elapsed_ms"), ai_metrics[:elapsed_ms].present? ? "#{ai_metrics[:elapsed_ms]}ms" : "-" ],
          [ t("admin.receipt_analysis_runs.show.ai_metrics.retry_count"), ai_metrics[:retry_count].presence || "-" ],
          [ t("admin.receipt_analysis_runs.show.ai_metrics.retry_after_used"), ai_metrics.key?(:retry_after_used) ? t("admin.receipt_analysis_runs.show.boolean.#{ai_metrics[:retry_after_used]}") : "-" ],
          [ t("admin.receipt_analysis_runs.show.ai_metrics.total_retry_sleep_ms"), ai_metrics[:total_retry_sleep_ms].present? ? "#{ai_metrics[:total_retry_sleep_ms]}ms" : "-" ],
          [ t("admin.receipt_analysis_runs.show.ai_metrics.rate_limited"), ai_metrics.key?(:rate_limited) ? t("admin.receipt_analysis_runs.show.boolean.#{ai_metrics[:rate_limited]}") : "-" ],
          [ t("admin.receipt_analysis_runs.show.ai_metrics.provider_status"), ai_metrics[:provider_status].presence || "-" ],
          [ t("admin.receipt_analysis_runs.show.ai_metrics.final_provider"), ai_metrics[:final_provider].presence || "-" ],
          [ t("admin.receipt_analysis_runs.show.ai_metrics.fallback_used"), ai_metrics.key?(:fallback_used) ? t("admin.receipt_analysis_runs.show.boolean.#{ai_metrics[:fallback_used]}") : "-" ],
          [ t("admin.receipt_analysis_runs.show.ai_metrics.fallback_provider"), ai_metrics[:fallback_provider].presence || "-" ],
          [ t("admin.receipt_analysis_runs.show.ai_metrics.fallback_reason"), ai_metrics[:fallback_reason].presence || "-" ],
          [ t("admin.receipt_analysis_runs.show.ai_metrics.response_id"), ai_metrics[:response_id].presence || "-" ],
          [ t("admin.receipt_analysis_runs.show.ai_metrics.token_usage"), token_usage_label ]
        ]
      %>
      <div class="mt-4 rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <h3 class="text-sm font-semibold token-text-base"><%= t("admin.receipt_analysis_runs.show.ai_metrics.title") %></h3>
        <dl class="mt-3 grid gap-3 text-sm md:grid-cols-2">
          <% ai_metric_rows.each do |label, value| %>
            <div>
              <dt class="text-xs font-semibold token-text-muted"><%= label %></dt>
              <dd class="break-words font-mono text-xs token-text-base [overflow-wrap:anywhere]"><%= value %></dd>
            </div>
          <% end %>
        </dl>
      </div>

      <div class="mt-4 space-y-2">
        <% @record[:provider].each do |name, provider| %>
          <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
            <div class="text-xs font-semibold token-text-muted"><%= name %></div>
            <div class="mt-1 break-words font-mono text-xs token-text-base [overflow-wrap:anywhere]"><%= provider.presence || "-" %></div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= render "shared/ui/layout/surface_card", padding: :md do %>
      <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_runs.show.sections.snapshot_presence") %></h2>
      <div class="grid gap-2 md:grid-cols-2">
        <% @record[:snapshot_presence].each do |name, present| %>
          <div class="flex min-w-0 items-center justify-between gap-3 rounded-lg border token-border-soft token-bg-card-subtle px-3 py-2 text-sm">
            <span class="min-w-0 break-words font-mono text-xs token-text-base [overflow-wrap:anywhere]"><%= name %></span>
            <span class="shrink-0 whitespace-nowrap <%= present ? "token-text-success" : "token-text-muted" %>"><%= present ? t("admin.receipt_analysis_runs.show.snapshot.present") : t("admin.receipt_analysis_runs.show.snapshot.missing") %></span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <section class="space-y-4" data-admin-analysis-section="ocr">
      <h2 class="text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_runs.show.sections.ocr") %></h2>
      <section class="<%= admin_json_container_classes %>">
        <h3 class="mb-2 text-sm font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.summary_labels.ocr_summary") %></h3>
        <pre class="<%= admin_json_pre_classes %>"><%= admin_pretty_json(@record.dig(:summaries, :ocr) || {}) %></pre>
      </section>
      <details class="<%= admin_json_container_classes(extra_class: "rounded-lg border token-border-soft token-bg-card-subtle p-4") %>">
        <summary class="cursor-pointer text-sm font-semibold token-text-base">
          <%= t("admin.receipt_analysis_runs.show.snapshot_details.names.ocr_result_snapshot") %>
        </summary>
        <div class="<%= admin_json_container_classes(extra_class: "mt-3") %>">
          <pre class="<%= admin_json_pre_classes(details: true) %>"><%= admin_pretty_json(@record.dig(:detailed_snapshots, :ocr_result_snapshot).presence || {}) %></pre>
        </div>
      </details>
    </section>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <% ai_input_highlights = @record[:ai_input_highlights] || {} %>
    <section class="space-y-4" data-admin-analysis-section="ai">
      <h2 class="text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_runs.show.sections.ai") %></h2>
      <section class="min-w-0 max-w-full space-y-4 rounded-lg border token-border-soft token-bg-card-subtle p-4" data-admin-ai-input-highlights>
        <h3 class="text-sm font-semibold token-text-base"><%= t("admin.receipt_analysis_runs.show.ai_input_highlights.title") %></h3>
        <div class="grid gap-4 lg:grid-cols-2">
          <section class="<%= admin_json_container_classes %>">
            <h4 class="mb-2 text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.ai_input_highlights.purchase") %></h4>
            <pre class="<%= admin_json_pre_classes %>"><%= admin_pretty_json(ai_input_highlights[:purchase] || {}) %></pre>
          </section>
          <section class="<%= admin_json_container_classes %>">
            <h4 class="mb-2 text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.ai_input_highlights.tax") %></h4>
            <pre class="<%= admin_json_pre_classes %>"><%= admin_pretty_json(ai_input_highlights[:tax] || {}) %></pre>
          </section>
          <section class="<%= admin_json_container_classes %>">
            <h4 class="mb-2 text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.ai_input_highlights.items") %></h4>
            <pre class="<%= admin_json_pre_classes %>"><%= admin_pretty_json(ai_input_highlights[:items] || []) %></pre>
          </section>
          <section class="<%= admin_json_container_classes %>">
            <h4 class="mb-2 text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.ai_input_highlights.adjustments") %></h4>
            <pre class="<%= admin_json_pre_classes %>"><%= admin_pretty_json(ai_input_highlights[:adjustments] || {}) %></pre>
          </section>
        </div>
        <details class="<%= admin_json_container_classes(extra_class: "rounded-lg border token-border-soft token-bg-card-subtle p-4") %>">
          <summary class="cursor-pointer text-sm font-semibold token-text-base">
            <%= t("admin.receipt_analysis_runs.show.ai_input_highlights.context") %>
          </summary>
          <div class="<%= admin_json_container_classes(extra_class: "mt-3") %>">
            <pre class="<%= admin_json_pre_classes(details: true) %>"><%= admin_pretty_json(ai_input_highlights[:context] || {}) %></pre>
          </div>
        </details>
      </section>
      <div class="grid gap-4 lg:grid-cols-2">
        <section class="<%= admin_json_container_classes %>">
          <h3 class="mb-2 text-sm font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.summary_labels.ai_input_snapshot") %></h3>
          <pre class="<%= admin_json_pre_classes %>"><%= admin_pretty_json(@record.dig(:summaries, :ai_input) || {}) %></pre>
        </section>
        <section class="<%= admin_json_container_classes %>">
          <h3 class="mb-2 text-sm font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.summary_labels.ai_result_summary") %></h3>
          <pre class="<%= admin_json_pre_classes %>"><%= admin_pretty_json(@record.dig(:summaries, :ai_result) || {}) %></pre>
        </section>
      </div>
      <details class="<%= admin_json_container_classes(extra_class: "rounded-lg border token-border-soft token-bg-card-subtle p-4") %>">
        <summary class="cursor-pointer text-sm font-semibold token-text-base">
          <%= t("admin.receipt_analysis_runs.show.snapshot_details.names.ai_normalized_result_snapshot") %>
        </summary>
        <div class="<%= admin_json_container_classes(extra_class: "mt-3") %>">
          <pre class="<%= admin_json_pre_classes(details: true) %>"><%= admin_pretty_json(@record.dig(:detailed_snapshots, :ai_normalized_result_snapshot).presence || {}) %></pre>
        </div>
      </details>
    </section>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <section class="space-y-4" data-admin-analysis-section="build_params">
      <h2 class="text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_runs.show.sections.build_params") %></h2>
      <details class="<%= admin_json_container_classes(extra_class: "rounded-lg border token-border-soft token-bg-card-subtle p-4") %>">
        <summary class="cursor-pointer text-sm font-semibold token-text-base">
          <%= t("admin.receipt_analysis_runs.show.snapshot_details.names.build_params_snapshot") %>
        </summary>
        <div class="<%= admin_json_container_classes(extra_class: "mt-3") %>">
          <pre class="<%= admin_json_pre_classes(details: true) %>"><%= admin_pretty_json(@record.dig(:detailed_snapshots, :build_params_snapshot).presence || {}) %></pre>
        </div>
      </details>
    </section>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <%
      correction_summary = @record[:correction_summary] || {}
      purchased_at_fallback = correction_summary[:purchased_at_fallback] || {}
    %>
    <section class="space-y-4" data-admin-correction-summary>
      <h2 class="text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_runs.show.correction_summary.title") %></h2>
      <dl class="grid gap-3 text-sm md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.correction_summary.purchased_at_fallback") %></dt>
          <dd class="mt-1 token-text-base">
            <%= purchased_at_fallback[:applied] ? t("admin.receipt_analysis_runs.show.correction_summary.applied") : t("admin.receipt_analysis_runs.show.correction_summary.not_applied") %>
          </dd>
          <p class="mt-1 text-xs token-text-muted">
            <%= [ purchased_at_fallback[:result], purchased_at_fallback[:source] ].compact.presence&.join(" / ") || t("admin.receipt_analysis_runs.show.correction_summary.empty") %>
          </p>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.correction_summary.tax_rate_corrections") %></dt>
          <dd class="mt-1 font-mono token-text-base"><%= correction_summary[:tax_rate_corrections_count] || 0 %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.correction_summary.adjustments") %></dt>
          <dd class="mt-1 font-mono token-text-base">
            <%= t(
              "admin.receipt_analysis_runs.show.correction_summary.adjustment_counts",
              count: correction_summary[:adjustment_count] || 0,
              uncertain: correction_summary[:uncertain_adjustments_count] || 0
            ) %>
          </dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.correction_summary.amount_warnings") %></dt>
          <dd class="mt-1 font-mono token-text-base"><%= correction_summary[:amount_warnings_count] || 0 %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.correction_summary.amount_blocking") %></dt>
          <dd class="mt-1 font-mono token-text-base"><%= correction_summary[:amount_blocking_count] || 0 %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.correction_summary.tax_detail_amount_basis") %></dt>
          <dd class="mt-1 font-mono token-text-base"><%= correction_summary[:tax_detail_amount_basis].presence || t("admin.receipt_analysis_runs.show.correction_summary.empty") %></dd>
        </div>
      </dl>
    </section>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <section class="space-y-4" data-admin-analysis-section="amount">
      <h2 class="text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_runs.show.sections.amount") %></h2>
      <section class="<%= admin_json_container_classes %>">
        <h3 class="mb-2 text-sm font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.sections.amount_calculation_profile") %></h3>
        <pre class="<%= admin_json_pre_classes %>"><%= admin_pretty_json(@record[:amount_calculation_profile]) %></pre>
      </section>
    </section>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <section class="space-y-4" data-admin-analysis-section="finalize">
      <h2 class="text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_runs.show.sections.finalize") %></h2>
      <div class="grid gap-4 lg:grid-cols-2">
        <section class="<%= admin_json_container_classes %>">
          <h3 class="mb-2 text-sm font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.sections.finalize_decision") %></h3>
          <pre class="<%= admin_json_pre_classes %>"><%= admin_pretty_json(@record[:finalize_decision]) %></pre>
        </section>
        <section class="<%= admin_json_container_classes %>">
          <h3 class="mb-2 text-sm font-semibold token-text-muted"><%= t("admin.receipt_analysis_runs.show.summary_labels.final_result_summary") %></h3>
          <pre class="<%= admin_json_pre_classes %>"><%= admin_pretty_json(@record.dig(:summaries, :final_result) || {}) %></pre>
        </section>
      </div>
    </section>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_runs.show.sections.retry_options") %></h2>
    <% if admin_retry_enabled? %>
      <p class="mb-4 text-sm token-text-muted"><%= t("admin.receipt_analysis_runs.show.retry.authenticated_guidance") %></p>
    <% else %>
      <div class="mb-4 space-y-3 rounded-lg border token-border-soft token-bg-card-subtle p-4">
        <p class="text-sm token-text-muted"><%= t("admin.receipt_analysis_runs.show.retry.reauthentication_guidance") %></p>
        <%= render "shared/ui/actions/button",
              as: :link,
              href: new_admin_passkey_reauthentication_path(return_to: admin_receipt_analysis_run_path(@record[:run_key])),
              label: t("admin.receipt_analysis_runs.show.retry.reauthentication_link"),
              size: :compact,
              icon: "passkey" %>
      </div>
    <% end %>
    <div class="grid gap-3 md:grid-cols-2">
      <% @record[:retry_options].each do |option| %>
        <div class="space-y-3 rounded-lg border token-border-soft token-bg-card-subtle p-4">
          <div class="font-semibold token-text-base"><%= option[:type] %></div>
          <div class="mt-1 text-sm <%= option[:possible] ? "token-text-success" : "token-text-muted" %>">
            <%= option[:possible] ? t("admin.receipt_analysis_runs.show.retry.available") : t("admin.receipt_analysis_runs.show.retry.disabled", reason: option[:disabled_reason]) %>
          </div>
          <% if admin_retry_enabled? && option[:possible] %>
            <%= form_with url: retry_admin_receipt_analysis_run_path(@record[:run_key]), method: :post, local: true, class: "space-y-2" do |form| %>
              <%= hidden_field_tag :retry_kind, option[:type] %>
              <%= render "shared/ui/form/textarea_field",
                    f: form,
                    attribute: :reason,
                    label: t("admin.receipt_analysis_runs.show.retry.reason_label"),
                    placeholder: t("admin.receipt_analysis_runs.show.retry.reason_placeholder"),
                    rows: 2,
                    required: true,
                    with_icon: false,
                    label_class: admin_label_class,
                    textarea_class: "min-h-20 #{admin_control_class}" %>
              <%= render "shared/ui/form/text_field",
                    f: form,
                    attribute: :confirmation,
                    label: t("admin.receipt_analysis_runs.show.retry.confirmation_label", confirmation: retry_confirmation_text),
                    required: true,
                    autocomplete: "off",
                    with_icon: false,
                    size: :dense,
                    label_class: admin_label_class,
                    input_class: admin_mono_control_class %>
              <%= render "shared/ui/actions/button",
                    label: t("admin.receipt_analysis_runs.show.retry.execute"),
                    type: "submit",
                    size: :compact,
                    icon: "replay" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
