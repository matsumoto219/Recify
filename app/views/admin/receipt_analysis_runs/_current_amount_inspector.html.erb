<section class="min-w-0 space-y-6" data-admin-analysis-section="amount" data-current-amount-inspector>
  <header class="space-y-2">
    <h2 class="text-lg font-bold token-text-base"><%= t("admin.current_amount_inspector.title") %></h2>
    <p class="text-sm token-text-muted"><%= t("admin.current_amount_inspector.current_notice") %></p>
    <% if inspector.omitted? %>
      <p class="rounded-lg border token-border-soft token-bg-warning-soft p-3 text-sm token-text-base"><%= t("admin.current_amount_inspector.omitted") %></p>
    <% end %>
  </header>

  <% if inspector.state != :available %>
    <p class="text-sm token-text-muted"><%= t("admin.current_amount_inspector.states.#{inspector.state}") %></p>
  <% else %>
    <% data = inspector.data %>
    <% engine = data["amount_engine"] || {} %>
    <% selected = inspector.selected_candidate %>
    <section class="space-y-3" data-amount-inspector-section="summary">
      <h3 class="text-base font-semibold token-text-base"><%= t("admin.current_amount_inspector.sections.summary") %></h3>
      <%= render "admin/receipt_analysis_runs/current_amount_inspector_rows", rows: inspector.rows(data.slice("context", "schema_version")) %>
      <%= render "admin/receipt_analysis_runs/current_amount_inspector_rows", rows: inspector.rows((data["profile"] || {}).except("item_amount_basis_assignments")) %>
      <h4 class="text-sm font-semibold token-text-base"><%= t("admin.current_amount_inspector.rounding") %></h4>
      <%= render "admin/receipt_analysis_runs/current_amount_inspector_rows", rows: inspector.rows(data["rounding_mode"] || {}) %>
      <div class="grid min-w-0 gap-4 lg:grid-cols-2">
        <% %w[computed resolved].each do |kind| %>
          <div class="min-w-0 space-y-2">
            <h4 class="text-sm font-semibold token-text-base"><%= t("admin.current_amount_inspector.#{kind}") %></h4>
            <%= render "admin/receipt_analysis_runs/current_amount_inspector_rows", rows: inspector.rows(data[kind] || {}) %>
          </div>
        <% end %>
      </div>
    </section>

    <section class="space-y-3" data-amount-inspector-section="selected">
      <h3 class="text-base font-semibold token-text-base"><%= t("admin.current_amount_inspector.sections.selected") %></h3>
      <% if inspector.engine_state != :available %>
        <p class="text-sm token-text-muted"><%= t("admin.current_amount_inspector.engine_states.#{inspector.engine_state}") %></p>
      <% else %>
        <% if engine["no_safe_candidate"] == true %>
          <p class="rounded-lg border token-border-soft token-bg-warning-soft p-3 text-sm font-semibold token-text-base"><%= t("admin.current_amount_inspector.no_safe_candidate") %></p>
        <% end %>
        <%= render "admin/receipt_analysis_runs/current_amount_inspector_rows", rows: inspector.rows(engine.slice("schema_version", "selected_candidate_status")) %>
        <% if selected.empty? %>
          <p class="text-sm token-text-muted"><%= t("admin.current_amount_inspector.record_missing") %></p>
        <% else %>
          <%= render "admin/receipt_analysis_runs/current_amount_inspector_reasons", inspector: inspector, label: t("admin.current_amount_inspector.hard_rejects"), reasons: selected["hard_reject_reasons"] %>
          <p class="text-sm token-text-muted"><%= t("admin.current_amount_inspector.eligibility_notice") %></p>
          <p class="text-sm token-text-muted"><%= t("admin.current_amount_inspector.score_notice") %></p>
          <%= render "admin/receipt_analysis_runs/current_amount_inspector_rows", rows: inspector.rows(selected.except("score_breakdown", "hard_reject_reasons", "warnings", "evidence", "computed_items")) %>
          <details class="min-w-0 rounded-lg border token-border-soft p-3">
            <summary class="cursor-pointer text-sm font-semibold token-text-base"><%= t("admin.current_amount_inspector.score_breakdown") %></summary>
            <div class="mt-3">
              <%= render "admin/receipt_analysis_runs/current_amount_inspector_rows", rows: inspector.rows(selected["score_breakdown"] || {}) %>
            </div>
          </details>
        <% end %>
      <% end %>
    </section>

    <section class="space-y-3" data-amount-inspector-section="comparison">
      <h3 class="text-base font-semibold token-text-base"><%= t("admin.current_amount_inspector.sections.comparison") %></h3>
      <p class="text-sm token-text-muted"><%= t("admin.current_amount_inspector.comparison_notice") %></p>
      <p class="text-sm token-text-muted"><%= t("admin.current_amount_inspector.score_notice") %></p>
      <% if inspector.candidates.empty? %>
        <p class="text-sm token-text-muted"><%= t("admin.current_amount_inspector.#{engine.key?('candidates') ? 'no_comparison_candidates' : 'record_missing'}") %></p>
      <% else %>
        <div class="min-w-0 max-w-full overflow-x-auto">
          <table class="w-full table-fixed text-left text-sm">
            <caption class="sr-only"><%= t("admin.current_amount_inspector.sections.comparison") %></caption>
            <thead class="token-text-muted">
              <tr class="border-b token-border-soft">
                <% %w[candidate hard_rejects score].each do |column| %>
                  <th scope="col" class="break-words px-2 py-2 font-semibold [overflow-wrap:anywhere]"><%= t("admin.current_amount_inspector.#{column}") %></th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <% inspector.candidates.each do |candidate| %>
                <tr class="border-b token-border-soft align-top">
                  <th scope="row" class="break-words px-2 py-3 font-normal token-text-base [overflow-wrap:anywhere]">
                    <%= inspector.value(candidate["candidate_id"]) %>
                    <p class="mt-1 token-text-muted"><%= inspector.value(candidate["basis"]) %></p>
                  </th>
                  <td class="break-words px-2 py-3 token-text-base [overflow-wrap:anywhere]"><%= Array(inspector.reasons(candidate["hard_reject_reasons"])).join(" / ") %></td>
                  <td class="break-words px-2 py-3 token-text-base [overflow-wrap:anywhere]"><%= inspector.value(candidate["score"]) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <% inspector.candidates.each do |candidate| %>
          <details class="min-w-0 rounded-lg border token-border-soft p-3">
            <summary class="cursor-pointer break-words text-sm font-semibold token-text-base [overflow-wrap:anywhere]"><%= t("admin.current_amount_inspector.candidate_details", candidate: inspector.value(candidate["candidate_id"])) %></summary>
            <div class="mt-3 space-y-3">
              <%= render "admin/receipt_analysis_runs/current_amount_inspector_rows", rows: inspector.rows(candidate.except("score_breakdown", "hard_reject_reasons", "warnings", "evidence", "computed_items")) %>
              <h4 class="text-sm font-semibold token-text-base"><%= t("admin.current_amount_inspector.score_breakdown") %></h4>
              <%= render "admin/receipt_analysis_runs/current_amount_inspector_rows", rows: inspector.rows(candidate["score_breakdown"] || {}) %>
            </div>
          </details>
        <% end %>
      <% end %>
    </section>

    <section class="space-y-3" data-amount-inspector-section="rejection">
      <h3 class="text-base font-semibold token-text-base"><%= t("admin.current_amount_inspector.sections.rejection") %></h3>
      <p class="text-sm token-text-muted"><%= t("admin.current_amount_inspector.rejection_notice") %></p>
      <% if inspector.candidates.empty? %>
        <p class="text-sm token-text-muted"><%= t("admin.current_amount_inspector.record_missing") %></p>
      <% else %>
        <% inspector.candidates.each do |candidate| %>
          <details class="min-w-0 rounded-lg border token-border-soft p-3">
            <summary class="cursor-pointer break-words text-sm font-semibold token-text-base [overflow-wrap:anywhere]"><%= inspector.value(candidate["candidate_id"]) %></summary>
            <div class="mt-3 space-y-3">
              <%= render "admin/receipt_analysis_runs/current_amount_inspector_reasons", inspector: inspector, label: t("admin.current_amount_inspector.hard_rejects"), reasons: candidate["hard_reject_reasons"] %>
              <%= render "admin/receipt_analysis_runs/current_amount_inspector_reasons", inspector: inspector, label: t("admin.current_amount_inspector.saved_warnings"), reasons: candidate["warnings"] %>
            </div>
          </details>
        <% end %>
      <% end %>
    </section>

    <section class="space-y-3" data-amount-inspector-section="review">
      <h3 class="text-base font-semibold token-text-base"><%= t("admin.current_amount_inspector.sections.review") %></h3>
      <%= render "admin/receipt_analysis_runs/current_amount_inspector_reasons", inspector: inspector, label: t("admin.current_amount_inspector.blocking"), reasons: data["blocking_mismatch_codes"] %>
      <div class="space-y-1">
        <h4 class="text-sm font-semibold token-text-base"><%= t("admin.current_amount_inspector.review_required_warning") %> / <%= t("admin.current_amount_inspector.diagnostic_warning") %></h4>
        <p class="text-sm token-text-muted"><%= t("admin.current_amount_inspector.review_classification_missing") %></p>
      </div>
      <%= render "admin/receipt_analysis_runs/current_amount_inspector_reasons", inspector: inspector, label: t("admin.current_amount_inspector.saved_warning_codes"), reasons: data["warning_mismatch_codes"] %>
      <%= render "admin/receipt_analysis_runs/current_amount_inspector_reasons", inspector: inspector, label: t("admin.current_amount_inspector.saved_warnings"), reasons: data["warnings"] %>
      <%= render "admin/receipt_analysis_runs/current_amount_inspector_rows", rows: inspector.rows({ "safe_to_auto_complete" => data["safe_to_auto_complete"] }) %>
      <p class="text-sm token-text-muted"><%= t("admin.current_amount_inspector.completion_notice") %></p>
    </section>

    <section class="space-y-3" data-amount-inspector-section="evidence">
      <h3 class="text-base font-semibold token-text-base"><%= t("admin.current_amount_inspector.sections.evidence") %></h3>
      <p class="text-sm token-text-muted"><%= t("admin.current_amount_inspector.evidence_notice") %></p>
      <% assignments = data.dig("profile", "item_amount_basis_assignments") || [] %>
      <% if inspector.evidence.empty? && inspector.computed_items.empty? && assignments.empty? %>
        <p class="text-sm token-text-muted"><%= t("admin.current_amount_inspector.record_missing") %></p>
      <% end %>
      <% [[ "evidence_entry", inspector.evidence ], [ "computed_item", inspector.computed_items ], [ "basis_assignment", assignments ]].each do |kind, entries| %>
        <% entries.each_with_index do |entry, index| %>
          <details class="min-w-0 rounded-lg border token-border-soft p-3">
            <summary class="cursor-pointer text-sm font-semibold token-text-base"><%= t("admin.current_amount_inspector.#{kind}", number: index + 1) %></summary>
            <div class="mt-3">
              <%= render "admin/receipt_analysis_runs/current_amount_inspector_rows", rows: inspector.rows(entry) %>
            </div>
          </details>
        <% end %>
      <% end %>
    </section>
  <% end %>
</section>
