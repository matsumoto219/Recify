<%
  snapshot = (external_services || {}).with_indifferent_access
  upload = (snapshot[:upload] || {}).with_indifferent_access
  upload_allowed = upload[:allowed] == true

  format_status_time = lambda do |value|
    parsed = value.is_a?(String) ? Time.zone.parse(value) : value
    parsed.present? ? l(parsed, format: :short) : t("admin.dashboard.common.not_available")
  rescue ArgumentError, TypeError
    t("admin.dashboard.common.not_available")
  end

  service_state_class = lambda do |state|
    case state.to_s
    when "ok"
      "token-text-success"
    when "degraded"
      "token-text-warning"
    when "down"
      "token-text-error"
    else
      "token-text-muted"
    end
  end

  service_rows = %i[ocr ai].map do |service|
    service_payload = (snapshot[service] || {}).with_indifferent_access
    state = service_payload[:state].presence || "unknown"

    {
      service: service,
      payload: service_payload,
      state: state,
      state_text: service_payload[:text].presence || t("shared.service_status.#{state}", default: t("shared.service_status.unknown")),
      state_class: service_state_class.call(state)
    }
  end
%>

<%= render "shared/ui/layout/surface_card", padding: :md, class: "h-full flex flex-col" do %>
  <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
    <div>
      <h2 class="text-lg font-bold token-text-base"><%= t("admin.dashboard.external_services.title") %></h2>
      <p class="text-sm token-text-muted"><%= t("admin.dashboard.external_services.description") %></p>
    </div>
    <%= render "shared/ui/actions/button",
          label: t("admin.dashboard.external_services.refresh"),
          variant: :ghost,
          size: :sm,
          icon: "refresh",
          type: "button",
          data: {
            action: "service-status-polling#pollNow"
          } %>
  </div>

  <dl class="grid gap-3 text-sm md:grid-cols-2">
    <% service_rows.each do |row| %>
      <% payload = row[:payload] %>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("settings.index.services.#{row[:service]}") %></dt>
        <dd class="mt-1 flex flex-wrap items-center gap-2">
          <span class="font-semibold <%= row[:state_class] %>"><%= row[:state_text] %></span>
          <% if payload[:monitoring] == true %>
            <span class="rounded-lg border token-border-soft px-2 py-0.5 text-xs font-semibold token-text-muted">
              <%= t("admin.dashboard.external_services.monitoring") %>
            </span>
          <% end %>
        </dd>

        <dl class="mt-3 grid gap-2 text-xs">
          <div class="flex min-w-0 items-center justify-between gap-3">
            <dt class="token-text-muted"><%= t("admin.dashboard.external_services.checked_at") %></dt>
            <dd class="shrink-0 whitespace-nowrap font-mono token-text-base"><%= format_status_time.call(payload[:checked_at]) %></dd>
          </div>
          <div class="flex min-w-0 items-center justify-between gap-3">
            <dt class="token-text-muted"><%= t("admin.dashboard.external_services.next_check_at") %></dt>
            <dd class="shrink-0 whitespace-nowrap font-mono token-text-base"><%= format_status_time.call(payload[:next_check_at]) %></dd>
          </div>
        </dl>

        <% if payload[:message].present? %>
          <p class="mt-3 break-words text-xs leading-relaxed token-text-muted [overflow-wrap:anywhere]"><%= payload[:message] %></p>
        <% end %>
      </div>
    <% end %>
  </dl>

  <div class="mt-auto pt-4">
    <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3 text-sm">
      <div class="flex flex-col gap-1 md:flex-row md:items-center md:justify-between">
        <span class="font-semibold token-text-muted"><%= t("admin.dashboard.external_services.upload") %></span>
        <span class="font-semibold <%= upload_allowed ? "token-text-success" : "token-text-error" %>">
          <%= upload_allowed ? t("admin.dashboard.external_services.upload_allowed") : t("admin.dashboard.external_services.upload_blocked") %>
        </span>
      </div>
      <% if snapshot.dig(:notices, :ai_down) == true %>
        <p class="mt-2 text-xs leading-relaxed token-text-muted"><%= t("admin.dashboard.external_services.ocr_only_fallback") %></p>
      <% end %>
    </div>
  </div>
<% end %>
