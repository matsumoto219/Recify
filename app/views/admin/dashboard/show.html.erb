<% content_for :title, t("admin.dashboard.title") %>

<%
  receipt_analysis = @dashboard.receipt_analysis
  cleanup = @dashboard.cleanup
  audit = @dashboard.audit
  contact_requests = @dashboard.contact_requests
  security = @dashboard.security
  external_services = @dashboard.external_services
  storage = @dashboard.storage
  database_status = @dashboard.database_status
  system_operations = @dashboard.system_operations
  reauth_context = admin_reauthentication_context
  reauth_active = admin_passkey_reauthenticated?
%>

<section class="mx-auto w-full max-w-7xl space-y-6 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "admin/shared/navigation" %>

  <%= render "shared/ui/layout/section_header",
        title: t("admin.dashboard.title"),
        subtitle: t("admin.dashboard.description"),
        title_size: "text-2xl md:text-3xl",
        subtitle_size: "text-sm md:text-base" %>

  <div class="grid gap-6 lg:grid-cols-2">
    <div
      class="h-full"
      data-controller="service-status-polling"
      data-service-status-polling-status-url-value="<%= admin_external_services_status_path %>"
      data-service-status-polling-interval-value="30000">
      <div class="h-full" data-service-status-polling-target="serviceStatusCard">
        <%= render "admin/dashboard/external_services_card", external_services: external_services %>
      </div>
    </div>
    <%= render "admin/dashboard/storage_card", storage: storage %>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render "shared/ui/layout/surface_card", padding: :md, class: "h-full flex flex-col" do %>
      <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
        <div>
          <h2 class="text-lg font-bold token-text-base"><%= t("admin.dashboard.receipt_analysis.title") %></h2>
          <p class="text-sm token-text-muted"><%= t("admin.dashboard.receipt_analysis.description") %></p>
        </div>
        <%= link_to t("admin.dashboard.receipt_analysis.link"), admin_receipt_analysis_runs_path, class: "text-sm font-semibold token-text-brand hover:underline" %>
      </div>

      <dl class="grid gap-3 text-sm md:grid-cols-2">
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.dashboard.receipt_analysis.active_runs") %></dt>
          <dd class="font-mono text-2xl font-bold token-text-base"><%= receipt_analysis[:active_runs_count] %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.dashboard.receipt_analysis.failed_runs") %></dt>
          <dd class="font-mono text-2xl font-bold token-text-base"><%= receipt_analysis[:failed_runs_count] %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.dashboard.receipt_analysis.review_needed_receipts") %></dt>
          <dd class="font-mono text-2xl font-bold token-text-base"><%= receipt_analysis[:review_needed_receipts_count] %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.dashboard.receipt_analysis.needs_attention") %></dt>
          <dd class="font-mono text-2xl font-bold token-text-base"><%= receipt_analysis[:needs_attention_count] %></dd>
        </div>
      </dl>

      <p class="mt-auto pt-4 text-sm token-text-muted">
        <%= t("admin.dashboard.receipt_analysis.latest_run") %>:
        <span class="font-mono token-text-base">
          <%= receipt_analysis[:latest_run_at].present? ? l(receipt_analysis[:latest_run_at], format: :short) : "-" %>
        </span>
      </p>
    <% end %>

    <%= render "shared/ui/layout/surface_card", padding: :md, class: "h-full flex flex-col" do %>
      <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
        <div>
          <h2 class="text-lg font-bold token-text-base"><%= t("admin.dashboard.contact_requests.title") %></h2>
          <p class="text-sm token-text-muted"><%= t("admin.dashboard.contact_requests.description") %></p>
        </div>
        <%= link_to t("admin.dashboard.contact_requests.link"), admin_contact_requests_path, class: "text-sm font-semibold token-text-brand hover:underline" %>
      </div>

      <dl class="grid gap-3 text-sm md:grid-cols-3">
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.dashboard.contact_requests.unresolved") %></dt>
          <dd class="font-mono text-2xl font-bold token-text-base" data-admin-contact-requests-unresolved-count><%= contact_requests[:unresolved_count] %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.dashboard.contact_requests.open") %></dt>
          <dd class="font-mono text-2xl font-bold token-text-base"><%= contact_requests[:open_count] %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.dashboard.contact_requests.security") %></dt>
          <dd class="font-mono text-2xl font-bold token-text-base"><%= contact_requests[:security_open_count] %></dd>
        </div>
      </dl>

      <p class="mt-auto pt-4 text-sm token-text-muted">
        <%= t("admin.dashboard.contact_requests.latest") %>:
        <span class="font-mono token-text-base">
          <%= contact_requests[:latest_created_at].present? ? l(contact_requests[:latest_created_at], format: :short) : "-" %>
        </span>
      </p>
    <% end %>

    <%= render "shared/ui/layout/surface_card", padding: :md, class: "h-full flex flex-col" do %>
      <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
        <div>
          <h2 class="text-lg font-bold token-text-base"><%= t("admin.dashboard.cleanup.title") %></h2>
          <p class="text-sm token-text-muted"><%= t("admin.dashboard.cleanup.description") %></p>
        </div>
        <%= link_to t("admin.dashboard.cleanup.link"), admin_receipt_analysis_cleanup_path, class: "text-sm font-semibold token-text-brand hover:underline" %>
      </div>

      <dl class="grid gap-3 text-sm md:grid-cols-2">
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.dashboard.cleanup.stale_candidates") %></dt>
          <dd class="font-mono text-2xl font-bold token-text-base"><%= cleanup[:stale_dry_run_count] %></dd>
          <dd class="mt-1 text-xs token-text-muted"><%= l(cleanup[:stale_cutoff], format: :short) %> <%= t("admin.dashboard.cleanup.cutoff_suffix") %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.dashboard.cleanup.expired_candidates") %></dt>
          <dd class="font-mono text-2xl font-bold token-text-base"><%= cleanup[:expired_dry_run_count] %></dd>
          <dd class="mt-1 text-xs token-text-muted"><%= l(cleanup[:retention_cutoff], format: :short) %> <%= t("admin.dashboard.cleanup.cutoff_suffix") %></dd>
        </div>
      </dl>

      <p class="mt-auto pt-4 text-sm token-text-muted">
        <%= t("admin.dashboard.cleanup.execution_requirement") %>
      </p>
    <% end %>

    <%= render "admin/dashboard/database_status_card", database_status: database_status %>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render "shared/ui/layout/surface_card", padding: :md, class: "h-full flex flex-col" do %>
      <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
        <div>
          <h2 class="text-lg font-bold token-text-base"><%= t("admin.dashboard.audit.title") %></h2>
          <p class="text-sm token-text-muted"><%= t("admin.dashboard.audit.description") %></p>
        </div>
        <%= link_to t("admin.dashboard.audit.link"), admin_audit_logs_path, class: "text-sm font-semibold token-text-brand hover:underline" %>
      </div>

      <dl class="grid gap-3 text-sm md:grid-cols-3">
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.dashboard.audit.failed_admin_actions") %></dt>
          <dd class="font-mono text-2xl font-bold token-text-base"><%= audit[:recent_failed_admin_actions_count] %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.dashboard.audit.retry_actions") %></dt>
          <dd class="font-mono text-2xl font-bold token-text-base"><%= audit[:recent_retry_actions_count] %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.dashboard.audit.cleanup_execute") %></dt>
          <dd class="font-mono text-2xl font-bold token-text-base"><%= audit[:recent_cleanup_execute_count] %></dd>
        </div>
      </dl>

      <div class="mt-auto flex flex-wrap gap-2 pt-4 text-sm">
        <%= render "shared/ui/actions/button",
              as: :link,
              href: admin_audit_logs_path(audit_action: "receipt_analysis.full_reanalyze"),
              label: t("admin.dashboard.audit.retry_logs"),
              variant: :secondary,
              size: :sm %>
        <%= render "shared/ui/actions/button",
              as: :link,
              href: admin_audit_logs_path(audit_action: "receipt_analysis_runs.cleanup_stale.execute"),
              label: t("admin.dashboard.audit.cleanup_logs"),
              variant: :secondary,
              size: :sm %>
      </div>
    <% end %>

    <%= render "shared/ui/layout/surface_card", padding: :md, class: "h-full flex flex-col" do %>
      <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
        <div>
          <h2 class="text-lg font-bold token-text-base"><%= t("admin.dashboard.security.title") %></h2>
          <p class="text-sm token-text-muted"><%= t("admin.dashboard.security.description") %></p>
        </div>
        <%= link_to t("admin.dashboard.security.link"), admin_security_events_path, class: "text-sm font-semibold token-text-brand hover:underline" %>
      </div>

      <dl class="grid gap-3 text-sm md:grid-cols-2">
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.dashboard.security.admin_passkeys") %></dt>
          <dd class="font-mono text-2xl font-bold token-text-base"><%= security[:admin_passkey_count] %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.dashboard.security.open_security_events") %></dt>
          <dd class="font-mono text-2xl font-bold token-text-base"><%= security[:open_security_events_count] %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.dashboard.security.high_security_events") %></dt>
          <dd class="font-mono text-2xl font-bold token-text-base"><%= security[:high_security_events_count] %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.dashboard.security.reauthentication_status") %></dt>
          <dd class="font-semibold <%= reauth_active ? "token-text-success" : "token-text-muted" %>"><%= reauth_active ? t("admin.dashboard.security.active") : t("admin.dashboard.security.expired") %></dd>
          <dd class="mt-1 text-xs token-text-muted">
            <%= reauth_context[:reauthenticated_at].present? ? l(reauth_context[:reauthenticated_at], format: :short) : "-" %>
          </dd>
        </div>
      </dl>

      <div class="mt-auto flex flex-wrap gap-2 pt-4 text-sm">
        <%= render "shared/ui/actions/button",
              as: :link,
              href: settings_security_path,
              label: t("admin.dashboard.security.passkey_settings"),
              variant: :secondary,
              size: :sm %>
        <%= render "shared/ui/actions/button",
              as: :link,
              href: new_admin_passkey_reauthentication_path(return_to: admin_root_path),
              label: t("admin.dashboard.security.reauthenticate"),
              variant: :secondary,
              size: :sm %>
      </div>
    <% end %>
  </div>

  <%= render "shared/ui/layout/surface_card", padding: :md, class: "min-w-0 max-w-full overflow-hidden" do %>
    <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
      <div>
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.dashboard.system_operations.title") %></h2>
        <p class="text-sm token-text-muted"><%= t("admin.dashboard.system_operations.description") %></p>
      </div>
      <%= link_to t("admin.dashboard.system_operations.link"), admin_system_operations_path, class: "text-sm font-semibold token-text-brand hover:underline" %>
    </div>

    <div class="grid min-w-0 max-w-full gap-6 overflow-hidden lg:grid-cols-2">
      <div class="min-w-0 max-w-full overflow-hidden">
        <h3 class="mb-3 text-base font-bold token-text-base"><%= t("admin.dashboard.system_operations.queues") %></h3>
        <ul class="grid min-w-0 max-w-full gap-2 overflow-hidden text-sm md:grid-cols-2">
          <% system_operations[:queues].each do |queue| %>
            <li class="min-w-0 max-w-full overflow-hidden break-words rounded-lg border token-border-soft token-bg-card-subtle p-3 font-mono token-text-base [overflow-wrap:anywhere]"><%= queue %></li>
          <% end %>
        </ul>
      </div>

      <div class="min-w-0 max-w-full overflow-hidden">
        <h3 class="mb-3 text-base font-bold token-text-base"><%= t("admin.dashboard.system_operations.recurring_summary") %></h3>
        <p class="rounded-lg border token-border-soft token-bg-card-subtle p-3 text-sm token-text-base">
          <%= t("admin.dashboard.system_operations.recurring_tasks") %>:
          <span class="font-mono font-bold"><%= system_operations[:recurring_dry_run_count] %></span>
        </p>
        <div class="mt-3 flex min-w-0 max-w-full flex-wrap gap-2 overflow-hidden text-sm">
          <% system_operations[:recurring_tasks].first(3).each do |task| %>
            <span class="inline-flex min-w-0 max-w-full overflow-hidden break-words whitespace-normal rounded-lg border token-border-soft px-3 py-2 font-mono text-xs token-text-muted [overflow-wrap:anywhere]"><%= task[:key] %></span>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.dashboard.locked_operations.title") %></h2>
    <p class="mb-4 text-sm token-text-muted"><%= t("admin.dashboard.locked_operations.description") %></p>
    <ul class="grid min-w-0 max-w-full gap-3 overflow-hidden text-sm md:grid-cols-2 lg:grid-cols-3">
      <% @dashboard.locked_future_operations.each do |operation| %>
        <li class="min-w-0 max-w-full overflow-hidden break-words rounded-lg border token-border-soft token-bg-card-subtle p-3 token-text-base [overflow-wrap:anywhere]"><%= operation %></li>
      <% end %>
    </ul>
  <% end %>
</section>
