<%
  status = legal_documents
  documents = status&.documents || {}
  ready = status&.ready?
  missing_types = status&.missing_types || []

  state_text = ready ? t("admin.dashboard.legal_documents.states.ready") : t("admin.dashboard.legal_documents.states.missing")
  state_class = ready ? "token-text-success" : "token-text-warning"
%>

<%= render "shared/ui/layout/surface_card", padding: :md, class: "h-full flex flex-col" do %>
  <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
    <div>
      <h2 class="text-lg font-bold token-text-base"><%= t("admin.dashboard.legal_documents.title") %></h2>
      <p class="text-sm token-text-muted"><%= t("admin.dashboard.legal_documents.description") %></p>
    </div>
    <span class="inline-flex rounded-full border token-border-soft px-3 py-1 text-xs font-semibold <%= state_class %>">
      <%= state_text %>
    </span>
  </div>

  <dl class="grid gap-3 text-sm md:grid-cols-2">
    <% LegalDocument::DOCUMENT_TYPES.each do |document_type| %>
      <% document = (documents[document_type] || {}).with_indifferent_access %>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted">
          <%= t("admin.dashboard.legal_documents.document_types.#{document_type}") %>
        </dt>
        <dd class="mt-1 font-semibold <%= document[:present] ? "token-text-success" : "token-text-warning" %>">
          <%= document[:present] ? t("admin.dashboard.legal_documents.present") : t("admin.dashboard.legal_documents.missing") %>
        </dd>
        <dd class="mt-1 font-mono text-xs token-text-base">
          <%= document[:version].presence || t("admin.dashboard.common.not_available") %>
        </dd>
        <dd class="mt-1 text-xs token-text-muted">
          <%= document[:updated_at].present? ? l(document[:updated_at], format: :short) : t("admin.dashboard.common.not_available") %>
        </dd>
      </div>
    <% end %>
  </dl>

  <% if missing_types.any? %>
    <div class="mt-4 rounded-lg border token-border-soft token-bg-card-subtle p-3 text-sm">
      <p class="font-semibold token-text-warning"><%= t("admin.dashboard.legal_documents.recovery_title") %></p>
      <p class="mt-1 token-text-muted"><%= t("admin.dashboard.legal_documents.recovery_description") %></p>
      <ul class="mt-3 space-y-1 font-mono text-xs token-text-base">
        <% t("admin.dashboard.legal_documents.recovery_commands").each do |command| %>
          <li><%= command %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p class="mt-auto pt-4 text-sm token-text-muted">
    <%= t("admin.dashboard.legal_documents.readonly_note") %>
    <% if status&.checked_at.present? %>
      <span class="font-mono token-text-base"><%= l(status.checked_at, format: :short) %></span>
    <% end %>
  </p>
<% end %>
