<%
  snapshot = (database_status || {}).with_indifferent_access

  state_text = lambda do |state|
    t(
      "admin.dashboard.database_status.states.#{state}",
      default: t("admin.dashboard.database_status.states.unavailable")
    )
  end

  state_class = lambda do |state|
    case state.to_s
    when "ok", "current"
      "token-text-success"
    when "pending"
      "token-text-warning"
    else
      "token-text-muted"
    end
  end

  database_time = snapshot[:database_time]
%>

<%= render "shared/ui/layout/surface_card", padding: :md, class: "h-full flex flex-col" do %>
  <div class="mb-4">
    <h2 class="text-lg font-bold token-text-base"><%= t("admin.dashboard.database_status.title") %></h2>
    <p class="text-sm token-text-muted"><%= t("admin.dashboard.database_status.description") %></p>
  </div>

  <dl class="grid gap-3 text-sm sm:grid-cols-3 xl:grid-cols-1 2xl:grid-cols-3">
    <div class="min-w-0 rounded-lg border token-border-soft token-bg-card-subtle p-3">
      <dt class="text-xs font-semibold token-text-muted"><%= t("admin.dashboard.database_status.primary") %></dt>
      <dd class="mt-1 font-semibold <%= state_class.call(snapshot[:primary]) %>">
        <%= state_text.call(snapshot[:primary]) %>
      </dd>
    </div>

    <div class="min-w-0 rounded-lg border token-border-soft token-bg-card-subtle p-3">
      <dt class="text-xs font-semibold token-text-muted"><%= t("admin.dashboard.database_status.migration") %></dt>
      <dd class="mt-1 font-semibold <%= state_class.call(snapshot[:migration]) %>">
        <%= state_text.call(snapshot[:migration]) %>
      </dd>
    </div>

    <div class="min-w-0 rounded-lg border token-border-soft token-bg-card-subtle p-3">
      <dt class="text-xs font-semibold token-text-muted"><%= t("admin.dashboard.database_status.database_time") %></dt>
      <dd class="mt-1 break-words font-mono font-semibold token-text-base [overflow-wrap:anywhere]">
        <%= database_time.present? ? l(database_time, format: :short) : t("admin.dashboard.common.not_available") %>
      </dd>
    </div>
  </dl>

  <p class="mt-auto pt-4 text-sm token-text-muted">
    <%= t("admin.dashboard.database_status.readonly_note") %>
  </p>
<% end %>
