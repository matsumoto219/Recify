<% content_for :title, t("admin.audit_logs.index.title") %>

<%
  filters = @filters || {}
  query_base = filters.except(:offset).compact_blank
  query_base[:audit_action] = query_base.delete(:action) if query_base.key?(:action)
  limit = @result.limit
  offset = @result.offset
  total_count = @result.total_count
  start_number = total_count.zero? ? 0 : offset + 1
  end_number = [ offset + @result.records.size, total_count ].min
  previous_offset = [ offset - limit, 0 ].max
  next_offset = offset + limit
  has_previous = offset.positive?
  has_next = next_offset < total_count

  actor_kind_options = AuditLog::ACTOR_KINDS.map { |value| [ value, value ] }
  outcome_options = AuditLog::OUTCOMES.map { |value| [ value, value ] }
  limit_options = [ 25, 50, 100 ].map { |value| [ t("admin.audit_logs.index.filters.limit_unit", count: value), value.to_s ] }
  filter_label_class = "text-xs font-semibold token-text-muted normal-case tracking-normal px-0"
  filter_wrapper_class = "space-y-1"
  filter_control_class = "rounded-lg text-sm"
%>

<section class="mx-auto w-full max-w-7xl space-y-6 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "admin/shared/navigation" %>

  <%= render "shared/ui/layout/section_header",
        title: t("admin.audit_logs.index.title"),
        subtitle: t("admin.audit_logs.index.description"),
        title_size: "text-3xl",
        subtitle_size: "text-base" %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4 flex items-center justify-between gap-3">
      <div>
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.audit_logs.index.filters.title") %></h2>
        <p class="text-sm token-text-muted"><%= t("admin.audit_logs.index.filters.description") %></p>
      </div>

      <%= link_to t("admin.audit_logs.index.filters.reset"), admin_audit_logs_path, class: "text-sm font-semibold token-text-brand hover:underline" %>
    </div>

    <%= form_with url: admin_audit_logs_path, method: :get, local: true, class: "grid gap-4 md:grid-cols-4" do |form| %>
      <%= render "shared/ui/form/text_field",
            f: form,
            attribute: :actor_user_id,
            label: t("admin.audit_logs.index.filters.labels.actor_user_id"),
            value: filters[:actor_user_id],
            with_icon: false,
            size: :dense,
            input_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            input_class: filter_control_class,
            html_options: { inputmode: "numeric" } %>

      <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :actor_kind,
            label: t("admin.audit_logs.index.filters.labels.actor_kind"),
            options: [[ t("admin.audit_logs.index.filters.all"), "" ]] + actor_kind_options,
            selected: filters[:actor_kind],
            with_icon: false,
            size: :dense,
            select_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            select_class: filter_control_class %>

      <%= render "shared/ui/form/text_field",
            f: form,
            attribute: :audit_action,
            label: t("admin.audit_logs.index.filters.labels.action"),
            value: filters[:action],
            with_icon: false,
            size: :dense,
            input_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            input_class: filter_control_class %>

      <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :outcome,
            label: t("admin.audit_logs.index.filters.labels.outcome"),
            options: [[ t("admin.audit_logs.index.filters.all"), "" ]] + outcome_options,
            selected: filters[:outcome],
            with_icon: false,
            size: :dense,
            select_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            select_class: filter_control_class %>

      <%= render "shared/ui/form/text_field",
            f: form,
            attribute: :target_uid,
            label: t("admin.audit_logs.index.filters.labels.target_uid"),
            value: filters[:target_uid],
            with_icon: false,
            size: :dense,
            input_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            input_class: filter_control_class %>

      <%= render "shared/ui/form/text_field",
            f: form,
            attribute: :request_id,
            label: t("admin.audit_logs.index.filters.labels.request_id"),
            value: filters[:request_id],
            with_icon: false,
            size: :dense,
            input_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            input_class: filter_control_class %>

      <%= render "shared/ui/form/text_field",
            f: form,
            attribute: :error_code,
            label: t("admin.audit_logs.index.filters.labels.error_code"),
            value: filters[:error_code],
            with_icon: false,
            size: :dense,
            input_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            input_class: filter_control_class %>

      <%= render "shared/ui/form/datetime_field",
            name: :created_from,
            id: :created_from,
            type: "datetime-local",
            label: t("admin.audit_logs.index.filters.labels.created_from"),
            value: filters[:created_from],
            field_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            field_class: "h-10 min-h-10 rounded-lg py-2 text-sm" %>

      <%= render "shared/ui/form/datetime_field",
            name: :created_to,
            id: :created_to,
            type: "datetime-local",
            label: t("admin.audit_logs.index.filters.labels.created_to"),
            value: filters[:created_to],
            field_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            field_class: "h-10 min-h-10 rounded-lg py-2 text-sm" %>

      <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :limit,
            label: t("admin.audit_logs.index.filters.labels.limit"),
            options: limit_options,
            selected: filters[:limit].presence || limit.to_s,
            with_icon: false,
            size: :dense,
            select_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            select_class: filter_control_class %>

      <div class="flex items-end gap-3 md:col-span-2">
        <%= render "shared/ui/actions/button",
              label: t("admin.audit_logs.index.filters.submit"),
              type: "submit",
              size: :compact,
              icon: "filter_alt" %>

        <%= render "shared/ui/actions/button",
              as: :link,
              href: admin_audit_logs_path,
              label: t("admin.audit_logs.index.filters.clear"),
              variant: :secondary,
              size: :compact,
              icon: "restart_alt" %>
      </div>
    <% end %>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.audit_logs.index.results.title") %></h2>
        <p class="text-sm token-text-muted"><%= t("admin.audit_logs.index.results.count_summary", total: total_count, start: start_number, end: end_number) %></p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <% if has_previous %>
          <%= link_to t("admin.audit_logs.index.results.previous"),
                admin_audit_logs_path(query_base.merge(limit: limit, offset: previous_offset)),
                class: "rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-brand hover:underline" %>
        <% else %>
          <span class="rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-muted opacity-60"><%= t("admin.audit_logs.index.results.previous") %></span>
        <% end %>

        <% if has_next %>
          <%= link_to t("admin.audit_logs.index.results.next"),
                admin_audit_logs_path(query_base.merge(limit: limit, offset: next_offset)),
                class: "rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-brand hover:underline" %>
        <% else %>
          <span class="rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-muted opacity-60"><%= t("admin.audit_logs.index.results.next") %></span>
        <% end %>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead class="token-text-muted">
          <tr class="border-b token-border-soft">
            <th class="px-3 py-2 font-semibold"><%= t("admin.audit_logs.index.table.created") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.audit_logs.index.table.actor") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.audit_logs.index.table.action") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.audit_logs.index.table.outcome") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.audit_logs.index.table.target") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.audit_logs.index.table.error") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.audit_logs.index.table.request") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.audit_logs.index.table.ip") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.audit_logs.index.table.reason") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.audit_logs.index.table.detail") %></th>
          </tr>
        </thead>
        <tbody>
          <% @result.records.each do |record| %>
            <tr class="border-b token-border-soft">
              <td class="px-3 py-3 whitespace-nowrap"><%= l(record[:created_at], format: :short) %></td>
              <td class="px-3 py-3">
                <div class="token-text-base"><%= record.dig(:actor, :kind) %></div>
                <div class="font-mono text-xs token-text-muted"><%= record.dig(:actor, :user_id).present? ? "##{record.dig(:actor, :user_id)}" : "-" %></div>
              </td>
              <td class="px-3 py-3 font-mono text-xs"><%= record[:action] %></td>
              <td class="px-3 py-3"><%= record[:outcome] %></td>
              <td class="px-3 py-3">
                <div class="token-text-base"><%= record[:target_uid].presence || "-" %></div>
                <div class="text-xs token-text-muted"><%= record[:target_type].presence || "-" %></div>
              </td>
              <td class="px-3 py-3"><%= record[:error_code].presence || "-" %></td>
              <td class="px-3 py-3 font-mono text-xs"><%= record[:request_id].to_s.first(12).presence || "-" %></td>
              <td class="px-3 py-3 font-mono text-xs"><%= record[:ip_address].presence || "-" %></td>
              <td class="px-3 py-3"><%= truncate(record[:reason].to_s, length: 40) %></td>
              <td class="px-3 py-3"><%= link_to t("admin.audit_logs.index.table.detail_link"), admin_audit_log_path(record[:id]), class: "token-text-brand hover:underline" %></td>
            </tr>
          <% end %>

          <% if @result.records.empty? %>
            <tr>
              <td colspan="10" class="px-3 py-10 text-center text-sm token-text-muted"><%= t("admin.audit_logs.index.results.empty") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
