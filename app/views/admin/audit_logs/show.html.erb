<% content_for :title, t("admin.audit_logs.show.title") %>

<section class="mx-auto w-full max-w-6xl space-y-6 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "admin/shared/navigation" %>

  <%= render "shared/ui/layout/section_header",
        title: t("admin.audit_logs.show.title"),
        subtitle: "##{@record[:id]}",
        breadcrumb_label: t("admin.audit_logs.index.title"),
        breadcrumb_path: admin_audit_logs_path,
        title_size: "text-3xl",
        subtitle_size: "text-sm" %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="grid gap-6 lg:grid-cols-3">
      <section class="space-y-3">
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.audit_logs.show.sections.action") %></h2>
        <dl class="space-y-3 text-sm">
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.audit_logs.show.labels.action") %></dt>
            <dd class="break-words font-mono token-text-base [overflow-wrap:anywhere]"><%= @record[:action] %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.audit_logs.show.labels.outcome") %></dt>
            <dd class="token-text-base"><%= @record[:outcome] %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.audit_logs.show.labels.error_code") %></dt>
            <dd class="token-text-base"><%= @record[:error_code].presence || "-" %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.audit_logs.show.labels.created_at") %></dt>
            <dd class="token-text-base"><%= l(@record[:created_at], format: :short) %></dd>
          </div>
        </dl>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.audit_logs.show.sections.actor_target") %></h2>
        <dl class="space-y-3 text-sm">
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.audit_logs.show.labels.actor") %></dt>
            <dd class="token-text-base">
              <%= @record.dig(:actor, :kind) %>
              <span class="font-mono text-xs token-text-muted"><%= @record.dig(:actor, :user_id).present? ? "##{@record.dig(:actor, :user_id)}" : "-" %></span>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.audit_logs.show.labels.target") %></dt>
            <dd class="token-text-base">
              <%= @record[:target_type].presence || "-" %>
              <span class="font-mono text-xs token-text-muted"><%= @record[:target_id].present? ? "##{@record[:target_id]}" : "-" %></span>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.audit_logs.show.labels.target_uid") %></dt>
            <dd class="break-words font-mono token-text-base [overflow-wrap:anywhere]"><%= @record[:target_uid].presence || "-" %></dd>
          </div>
        </dl>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.audit_logs.show.sections.request") %></h2>
        <dl class="space-y-3 text-sm">
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.audit_logs.show.labels.request_id") %></dt>
            <dd class="break-words font-mono token-text-base [overflow-wrap:anywhere]"><%= @record[:request_id].presence || "-" %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.audit_logs.show.labels.ip_address") %></dt>
            <dd class="font-mono token-text-base"><%= @record[:ip_address].presence || "-" %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.audit_logs.show.labels.user_agent") %></dt>
            <dd class="break-words token-text-base [overflow-wrap:anywhere]"><%= @record[:user_agent].presence || "-" %></dd>
          </div>
        </dl>
      </section>
    </div>

    <div class="mt-6 border-t token-border-soft pt-4">
      <h2 class="text-sm font-semibold token-text-muted"><%= t("admin.audit_logs.show.labels.reason") %></h2>
      <p class="mt-2 whitespace-pre-wrap break-words text-sm token-text-base [overflow-wrap:anywhere]"><%= @record[:reason].presence || "-" %></p>
    </div>
  <% end %>

  <div class="grid gap-6 lg:grid-cols-3">
    <%= render "shared/ui/layout/surface_card", padding: :md do %>
      <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.audit_logs.show.sections.metadata") %></h2>
      <pre class="overflow-x-auto rounded-lg token-bg-input token-border-soft border p-4 text-xs token-text-base"><%= admin_pretty_json(@record[:metadata]) %></pre>
    <% end %>

    <%= render "shared/ui/layout/surface_card", padding: :md do %>
      <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.audit_logs.show.sections.before_state") %></h2>
      <pre class="overflow-x-auto rounded-lg token-bg-input token-border-soft border p-4 text-xs token-text-base"><%= admin_pretty_json(@record[:before_state]) %></pre>
    <% end %>

    <%= render "shared/ui/layout/surface_card", padding: :md do %>
      <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.audit_logs.show.sections.after_state") %></h2>
      <pre class="overflow-x-auto rounded-lg token-bg-input token-border-soft border p-4 text-xs token-text-base"><%= admin_pretty_json(@record[:after_state]) %></pre>
    <% end %>
  </div>
</section>
