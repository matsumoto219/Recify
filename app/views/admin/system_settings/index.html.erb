<% content_for :title, t("admin.system_settings.index.title") %>

<section class="mx-auto w-full max-w-7xl space-y-6 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "admin/shared/navigation" %>

  <%= render "shared/ui/layout/section_header",
        title: t("admin.system_settings.index.title"),
        subtitle: t("admin.system_settings.index.description"),
        title_size: "text-3xl",
        subtitle_size: "text-base" %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
      <div>
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.system_settings.index.list_title") %></h2>
        <p class="text-sm token-text-muted"><%= t("admin.system_settings.index.list_description") %></p>
      </div>
      <span class="rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-muted">
        <%= t("admin.system_settings.index.total") %> <span class="font-mono"><%= @result.total_count %></span>
      </span>
    </div>

    <%= render "admin/shared/table_frame", size: :xl, table_class: "divide-y token-border-soft" do %>
        <thead>
          <tr class="text-left text-xs uppercase tracking-wide token-text-muted">
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :long_id) %>"><%= t("admin.system_settings.index.table.key") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :status) %>"><%= t("admin.system_settings.index.table.category") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :status) %>"><%= t("admin.system_settings.index.table.value_type") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :long_text) %>"><%= t("admin.system_settings.index.table.current_value") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :long_text) %>"><%= t("admin.system_settings.index.table.default_value") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :status) %>"><%= t("admin.system_settings.index.table.source") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :status) %>"><%= t("admin.system_settings.index.table.risk_level") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :action) %>"><%= t("admin.system_settings.index.table.detail") %></th>
          </tr>
        </thead>
        <tbody class="divide-y token-border-soft">
          <% @result.records.each do |record| %>
            <tr>
              <td class="px-3 py-3 token-text-base <%= admin_table_cell_classes(type: :long_id) %>"><%= record[:key] %></td>
              <td class="px-3 py-3 token-text-base <%= admin_table_cell_classes(type: :status) %>"><%= record[:category] %></td>
              <td class="px-3 py-3 token-text-muted <%= admin_table_cell_classes(type: :status, extra_class: "font-mono text-xs") %>"><%= record[:value_type] %></td>
              <td class="px-3 py-3 token-text-base <%= admin_table_cell_classes(type: :long_text, extra_class: "font-mono text-xs") %>"><%= record[:current_value].inspect %></td>
              <td class="px-3 py-3 token-text-muted <%= admin_table_cell_classes(type: :long_text, extra_class: "font-mono text-xs") %>"><%= record[:default_value].inspect %></td>
              <td class="px-3 py-3 token-text-base <%= admin_table_cell_classes(type: :status) %>"><%= record[:source] %></td>
              <td class="px-3 py-3 token-text-base <%= admin_table_cell_classes(type: :status) %>"><%= record[:risk_level] %></td>
              <td class="px-3 py-3 <%= admin_table_cell_classes(type: :action) %>">
                <%= link_to t("admin.system_settings.index.table.detail"), admin_system_setting_path(record[:key]), class: "font-semibold token-text-brand hover:underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
    <% end %>
  <% end %>
</section>
