<% content_for :title, "System settings" %>

<section class="mx-auto w-full max-w-7xl space-y-6 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "admin/shared/navigation" %>

  <%= render "shared/ui/layout/section_header",
        title: "System settings",
        subtitle: "code-side definition allowlist で管理されるread-only一覧",
        title_size: "text-3xl",
        subtitle_size: "text-base" %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
      <div>
        <h2 class="text-lg font-bold token-text-base">Definition allowlist</h2>
        <p class="text-sm token-text-muted">書き込みUIは未実装です。</p>
      </div>
      <span class="rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-muted">
        total <span class="font-mono"><%= @result.total_count %></span>
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y token-border-soft text-sm">
        <thead>
          <tr class="text-left text-xs uppercase tracking-wide token-text-muted">
            <th class="px-3 py-2 font-semibold">key</th>
            <th class="px-3 py-2 font-semibold">category</th>
            <th class="px-3 py-2 font-semibold">type</th>
            <th class="px-3 py-2 font-semibold">current</th>
            <th class="px-3 py-2 font-semibold">default</th>
            <th class="px-3 py-2 font-semibold">source</th>
            <th class="px-3 py-2 font-semibold">risk</th>
            <th class="px-3 py-2 font-semibold">detail</th>
          </tr>
        </thead>
        <tbody class="divide-y token-border-soft">
          <% @result.records.each do |record| %>
            <tr>
              <td class="px-3 py-3 font-mono text-xs token-text-base"><%= record[:key] %></td>
              <td class="px-3 py-3 token-text-base"><%= record[:category] %></td>
              <td class="px-3 py-3 font-mono text-xs token-text-muted"><%= record[:value_type] %></td>
              <td class="px-3 py-3 font-mono text-xs token-text-base"><%= record[:current_value].inspect %></td>
              <td class="px-3 py-3 font-mono text-xs token-text-muted"><%= record[:default_value].inspect %></td>
              <td class="px-3 py-3 token-text-base"><%= record[:source] %></td>
              <td class="px-3 py-3 token-text-base"><%= record[:risk_level] %></td>
              <td class="px-3 py-3">
                <%= link_to "詳細", admin_system_setting_path(record[:key]), class: "font-semibold token-text-brand hover:underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
