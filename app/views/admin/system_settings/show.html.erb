<% content_for :title, t("admin.system_settings.show.title", key: @record[:key]) %>

<%
  form_presenter = @form_presenter || Admin::SystemSettingFormPresenter.new(
    record: @record,
    reauthenticated: admin_passkey_reauthenticated?,
    form_values: @form_values
  )
  setting_card_class = "min-w-0 max-w-full overflow-hidden rounded-lg border token-border-soft token-bg-card-subtle p-3"
  setting_value_class = "min-w-0 max-w-full break-words font-mono text-base font-bold token-text-base [overflow-wrap:anywhere] md:text-lg"
  setting_meta_value_class = "min-w-0 max-w-full break-words token-text-base [overflow-wrap:anywhere]"
  setting_mono_meta_value_class = "#{setting_meta_value_class} font-mono"
  setting_key_copy_action = render(
    "shared/ui/actions/copyable_value",
    value: @record[:key],
    label: t("admin.system_settings.index.table.key"),
    wrapper_class: "inline-flex items-center gap-1 align-middle",
    value_class: "sr-only"
  )
  snapshot_limit_keys = %w[limits.snapshot_ocr_items_max limits.snapshot_ai_normalized_items_max]
  amount_limit_keys = SystemSettings::AMOUNT_LIMIT_KEYS
  analysis_run_retention_keys = %w[
    retention.analysis_runs_short_days
    retention.analysis_runs_default_days
    retention.analysis_runs_failed_days
  ]
  ocr_response_artifact_keys = %w[
    analysis_artifact.ocr_raw_response_capture_enabled
    analysis_artifact.ocr_raw_response_max_bytes
    analysis_artifact.ocr_raw_response_retention_days
  ]
  usage_limit_safety_keys = %w[
    limits.max_uploads_per_day
    limits.max_ocr_per_day
    limits.max_ai_per_day
    limits.max_storage_bytes
  ]
  global_storage_limit_keys = %w[
    storage.global_hard_stop_bytes
    storage.global_usage_warning_percentage
    storage.global_usage_critical_percentage
  ]
  setting_notice_key =
    if snapshot_limit_keys.include?(@record[:key].to_s)
      "snapshot_limit_note"
    elsif @record[:key].to_s == "limits.store_name_casing_context_lines_max"
      "store_name_casing_context_lines_note"
    elsif %w[operations.ocr_enabled operations.ai_enabled].include?(@record[:key].to_s)
      "operation_service_toggle_note"
    elsif SystemSettings::EXTERNAL_SERVICE_RUNTIME_TUNING_KEYS.include?(@record[:key].to_s)
      "external_service_tuning_note"
    elsif @record[:key].to_s == "amount_engine.tax_excluded_price_conversion_enabled"
      "amount_engine_tax_excluded_price_conversion_note"
    elsif @record[:key].to_s == "security.user_reauth_window_minutes"
      "user_reauth_window_note"
    elsif amount_limit_keys.include?(@record[:key].to_s)
      "amount_limit_note"
    elsif usage_limit_safety_keys.include?(@record[:key].to_s)
      "usage_limit_safety_note"
    elsif global_storage_limit_keys.include?(@record[:key].to_s)
      "global_storage_limit_note"
    elsif @record[:key].to_s == "limits.receipt_adjustments_per_receipt"
      "receipt_adjustments_limit_note"
    elsif @record[:key].to_s == "limits.receipt_payments_per_receipt"
      "receipt_payments_limit_note"
    elsif @record[:key].to_s == "limits.notifications_per_user"
      "notifications_limit_note"
    elsif @record[:key].to_s == "limits.batch_upload_max_files"
      "batch_upload_max_files_note"
    elsif @record[:key].to_s == "retention.notifications_read_days"
      "notifications_read_retention_note"
    elsif @record[:key].to_s == "retention.guest_users_days"
      "guest_users_retention_note"
    elsif @record[:key].to_s == "retention.user_sessions_days"
      "user_sessions_retention_note"
    elsif @record[:key].to_s == "retention.contact_requests_days"
      "contact_requests_retention_note"
    elsif analysis_run_retention_keys.include?(@record[:key].to_s)
      "analysis_runs_retention_note"
    elsif ocr_response_artifact_keys.include?(@record[:key].to_s)
      "ocr_response_artifact_note"
    elsif @record[:key].to_s == "retention.orphan_blobs_hours"
      "orphan_blobs_retention_note"
    elsif @record[:key].to_s == "retention.receipt_images_days"
      "receipt_images_retention_note"
    end
  setting_notice = setting_notice_key.present? ? t("admin.system_settings.show.#{setting_notice_key}") : nil
%>

<section class="mx-auto w-full max-w-5xl space-y-6 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "admin/shared/navigation" %>

  <%= render "shared/ui/layout/section_header",
        title: @record[:key],
        title_suffix: setting_key_copy_action,
        title_suffix_wrapper_class: "inline-flex items-center",
        subtitle: t("admin.system_settings.show.subtitle"),
        title_size: "text-2xl md:text-3xl",
        subtitle_size: "text-sm md:text-base" %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
      <div>
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.system_settings.show.current.title") %></h2>
        <p class="text-sm token-text-muted"><%= t("admin.system_settings.show.current.description") %></p>
      </div>
      <%= link_to t("admin.system_settings.show.current.back"), admin_system_settings_path, class: "text-sm font-semibold token-text-brand hover:underline" %>
    </div>

    <dl class="grid gap-3 text-sm md:grid-cols-2">
      <div class="<%= setting_card_class %>">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.system_settings.show.current.current_value") %></dt>
        <dd class="min-w-0 max-w-full break-words <%= setting_value_class %> [overflow-wrap:anywhere]"><%= @record[:current_value].inspect %></dd>
      </div>
      <div class="<%= setting_card_class %>">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.system_settings.show.current.default_value") %></dt>
        <dd class="min-w-0 max-w-full break-words <%= setting_value_class %> [overflow-wrap:anywhere]"><%= @record[:default_value].inspect %></dd>
      </div>
      <div class="<%= setting_card_class %>">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.system_settings.show.current.source") %></dt>
        <dd class="min-w-0 max-w-full break-words <%= setting_meta_value_class %> font-semibold [overflow-wrap:anywhere]"><%= form_presenter.source_label %></dd>
      </div>
      <div class="<%= setting_card_class %>">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.system_settings.show.current.updated_by") %></dt>
        <dd class="min-w-0 max-w-full break-words <%= setting_mono_meta_value_class %> [overflow-wrap:anywhere]"><%= @record[:updated_by_user_id].presence || "-" %></dd>
      </div>
    </dl>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.system_settings.show.definition.title") %></h2>
    <% if setting_notice.present? %>
      <p class="mb-4 min-w-0 max-w-full break-words rounded-lg border token-border-soft token-bg-warning-soft p-3 text-sm token-text-base [overflow-wrap:anywhere]">
        <%= setting_notice %>
      </p>
    <% end %>
    <dl class="grid gap-3 text-sm md:grid-cols-2">
      <div class="<%= setting_card_class %>">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.system_settings.show.definition.category") %></dt>
        <dd class="min-w-0 max-w-full break-words <%= setting_meta_value_class %> [overflow-wrap:anywhere]"><%= @record[:category] %></dd>
      </div>
      <div class="<%= setting_card_class %>">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.system_settings.show.definition.value_type") %></dt>
        <dd class="min-w-0 max-w-full break-words <%= setting_mono_meta_value_class %> [overflow-wrap:anywhere]"><%= @record[:value_type] %></dd>
      </div>
      <div class="<%= setting_card_class %>">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.system_settings.show.definition.editable") %></dt>
        <dd class="min-w-0 max-w-full break-words <%= setting_mono_meta_value_class %> [overflow-wrap:anywhere]"><%= @record[:editable] %></dd>
      </div>
      <div class="<%= setting_card_class %>">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.system_settings.show.definition.risk_level") %></dt>
        <dd class="min-w-0 max-w-full break-words <%= setting_meta_value_class %> [overflow-wrap:anywhere]"><%= @record[:risk_level] %></dd>
      </div>
      <div class="<%= setting_card_class %>">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.system_settings.show.definition.min") %></dt>
        <dd class="min-w-0 max-w-full break-words <%= setting_mono_meta_value_class %> [overflow-wrap:anywhere]"><%= @record[:min].presence || "-" %></dd>
      </div>
      <div class="<%= setting_card_class %>">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.system_settings.show.definition.max") %></dt>
        <dd class="min-w-0 max-w-full break-words <%= setting_mono_meta_value_class %> [overflow-wrap:anywhere]"><%= @record[:max].presence || "-" %></dd>
      </div>
    </dl>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4">
      <h2 class="text-lg font-bold token-text-base"><%= t("admin.system_settings.show.update.title") %></h2>
      <p class="text-sm token-text-muted"><%= t("admin.system_settings.show.update.description") %></p>
    </div>

    <% if form_presenter.readonly? %>
      <p class="min-w-0 max-w-full rounded-lg border token-border-soft token-bg-card-subtle p-4 text-sm token-text-muted">
        <%= t("admin.system_settings.show.update.readonly") %>
      </p>
    <% elsif form_presenter.reauthentication_required? %>
      <div class="min-w-0 max-w-full rounded-lg border token-border-soft token-bg-card-subtle p-4">
        <p class="mb-3 text-sm token-text-muted"><%= t("admin.system_settings.show.update.reauthentication_required") %></p>
        <%= render "shared/ui/actions/button",
              as: :link,
              href: new_admin_passkey_reauthentication_path(return_to: admin_system_setting_path(@record[:key])),
              label: t("admin.system_settings.show.update.reauthentication_link"),
              size: :compact,
              icon: "passkey" %>
      </div>
    <% else %>
      <%= form_with url: admin_system_setting_path(@record[:key]), method: :patch, local: true, class: "space-y-4" do |form| %>
        <% value_field = form_presenter.value_field_render(form: form) %>
        <%= render value_field.partial, **value_field.locals %>

        <% if form_presenter.numeric_field? %>
          <p class="min-w-0 max-w-full break-words text-xs leading-relaxed token-text-muted [overflow-wrap:anywhere]" data-system-setting-input-hint>
            <%= t(
                  "admin.system_settings.show.update.numeric_hint",
                  min: @record[:min],
                  max: @record[:max],
                  default_value: @record[:default_value],
                  source: form_presenter.source_label
                ) %>
          </p>
        <% end %>

        <%= render "shared/ui/form/textarea_field",
              f: form,
              attribute: :reason,
              label: t("admin.system_settings.show.update.reason_label"),
              value: form_presenter.reason_value,
              rows: 3,
              required: true,
              with_icon: false,
              label_class: form_presenter.label_class,
              textarea_class: form_presenter.textarea_control_class %>

        <% if form_presenter.requires_confirmation? %>
          <%= render "shared/ui/form/checkbox_field",
                f: form,
                attribute: :confirm,
                label: t("admin.system_settings.show.update.confirm_label"),
                required: true,
                checkbox_class: "mt-1",
                html_options: { checked: form_presenter.confirmation_checked? } %>
        <% end %>

        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <%= render "shared/ui/actions/button",
                label: t("admin.system_settings.show.update.submit"),
                type: "submit",
                size: :compact,
                icon: "save" %>

          <% if form_presenter.reset_available? %>
            <%= render "shared/ui/actions/button",
                  label: t("admin.system_settings.show.update.reset"),
                  type: "submit",
                  variant: :secondary,
                  size: :compact,
                  icon: "restart_alt",
                  html_options: { formaction: admin_system_setting_reset_path(@record[:key]) } %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.system_settings.show.audit_logs.title") %></h2>
    <p class="mb-3 text-sm token-text-muted"><%= t("admin.system_settings.show.audit_logs.description") %></p>
    <%= link_to t("admin.system_settings.show.audit_logs.link"),
          admin_audit_logs_path(target_uid: @record[:key]),
          class: "text-sm font-semibold token-text-brand hover:underline" %>
  <% end %>
</section>
