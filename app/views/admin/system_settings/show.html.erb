<% content_for :title, t("admin.system_settings.show.title", key: @record[:key]) %>

<%
  admin_label_class = "text-xs font-semibold token-text-muted normal-case tracking-normal px-0"
  admin_control_class = "rounded-lg text-sm"
  admin_mono_control_class = "rounded-lg font-mono text-sm"
%>

<section class="mx-auto w-full max-w-5xl space-y-6 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "admin/shared/navigation" %>

  <%= render "shared/ui/layout/section_header",
        title: @record[:key],
        subtitle: t("admin.system_settings.show.subtitle"),
        title_size: "text-3xl",
        subtitle_size: "text-base" %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
      <div>
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.system_settings.show.current.title") %></h2>
        <p class="text-sm token-text-muted"><%= t("admin.system_settings.show.current.description") %></p>
      </div>
      <%= link_to t("admin.system_settings.show.current.back"), admin_system_settings_path, class: "text-sm font-semibold token-text-brand hover:underline" %>
    </div>

    <dl class="grid gap-3 text-sm md:grid-cols-2">
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.system_settings.show.current.current_value") %></dt>
        <dd class="font-mono text-lg font-bold token-text-base"><%= @record[:current_value].inspect %></dd>
      </div>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.system_settings.show.current.default_value") %></dt>
        <dd class="font-mono text-lg font-bold token-text-base"><%= @record[:default_value].inspect %></dd>
      </div>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.system_settings.show.current.source") %></dt>
        <dd class="font-semibold token-text-base"><%= @record[:source] %></dd>
      </div>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.system_settings.show.current.updated_by") %></dt>
        <dd class="font-mono token-text-base"><%= @record[:updated_by_user_id].presence || "-" %></dd>
      </div>
    </dl>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.system_settings.show.definition.title") %></h2>
    <dl class="grid gap-3 text-sm md:grid-cols-2">
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.system_settings.show.definition.category") %></dt>
        <dd class="token-text-base"><%= @record[:category] %></dd>
      </div>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.system_settings.show.definition.value_type") %></dt>
        <dd class="font-mono token-text-base"><%= @record[:value_type] %></dd>
      </div>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.system_settings.show.definition.editable") %></dt>
        <dd class="font-mono token-text-base"><%= @record[:editable] %></dd>
      </div>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.system_settings.show.definition.risk_level") %></dt>
        <dd class="token-text-base"><%= @record[:risk_level] %></dd>
      </div>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.system_settings.show.definition.min") %></dt>
        <dd class="font-mono token-text-base"><%= @record[:min].presence || "-" %></dd>
      </div>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.system_settings.show.definition.max") %></dt>
        <dd class="font-mono token-text-base"><%= @record[:max].presence || "-" %></dd>
      </div>
    </dl>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4">
      <h2 class="text-lg font-bold token-text-base"><%= t("admin.system_settings.show.update.title") %></h2>
      <p class="text-sm token-text-muted"><%= t("admin.system_settings.show.update.description") %></p>
    </div>

    <% if @record[:editable] != true %>
      <p class="rounded-lg border token-border-soft token-bg-card-subtle p-4 text-sm token-text-muted">
        <%= t("admin.system_settings.show.update.readonly") %>
      </p>
    <% elsif !admin_passkey_reauthenticated? %>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-4">
        <p class="mb-3 text-sm token-text-muted"><%= t("admin.system_settings.show.update.reauthentication_required") %></p>
        <%= render "shared/ui/actions/button",
              as: :link,
              href: new_admin_passkey_reauthentication_path(return_to: admin_system_setting_path(@record[:key])),
              label: t("admin.system_settings.show.update.reauthentication_link"),
              size: :compact,
              icon: "passkey" %>
      </div>
    <% else %>
      <%= form_with url: admin_system_setting_path(@record[:key]), method: :patch, local: true, class: "space-y-4" do |form| %>
        <% current_value = @record[:current_value] %>
        <% case @record[:value_type].to_s %>
        <% when "boolean" %>
          <%= render "shared/ui/form/select_field",
                f: form,
                attribute: :value,
                label: t("admin.system_settings.show.update.value_label"),
                options: [[ t("admin.system_settings.show.update.enabled"), "true" ], [ t("admin.system_settings.show.update.disabled"), "false" ]],
                selected: current_value.to_s,
                with_icon: false,
                size: :dense,
                label_class: admin_label_class,
                select_class: admin_control_class %>
        <% when "integer", "duration" %>
          <%= render "shared/ui/form/number_field",
                f: form,
                attribute: :value,
                label: t("admin.system_settings.show.update.value_label"),
                value: current_value,
                min: @record[:min],
                max: @record[:max],
                step: 1,
                required: true,
                size: :dense,
                text_align: :left,
                label_class: admin_label_class,
                input_class: admin_control_class %>
        <% when "decimal", "percentage" %>
          <%= render "shared/ui/form/number_field",
                f: form,
                attribute: :value,
                label: t("admin.system_settings.show.update.value_label"),
                value: current_value,
                min: @record[:min],
                max: @record[:max],
                step: :any,
                required: true,
                size: :dense,
                text_align: :left,
                label_class: admin_label_class,
                input_class: admin_control_class %>
        <% when "enum" %>
          <%= render "shared/ui/form/select_field",
                f: form,
                attribute: :value,
                label: t("admin.system_settings.show.update.value_label"),
                options: Array(@record[:allowed_values]).map { |value| [ value, value ] },
                selected: current_value.to_s,
                with_icon: false,
                size: :dense,
                label_class: admin_label_class,
                select_class: admin_control_class %>
        <% when "user_allowlist" %>
          <%= render "shared/ui/form/textarea_field",
                f: form,
                attribute: :value,
                label: t("admin.system_settings.show.update.value_label"),
                value: Array(current_value).join("\n"),
                rows: 5,
                with_icon: false,
                label_class: admin_label_class,
                textarea_class: admin_control_class %>
        <% when "feature_flag" %>
          <%= render "shared/ui/form/textarea_field",
                f: form,
                attribute: :value,
                label: t("admin.system_settings.show.update.value_label"),
                value: JSON.pretty_generate(current_value),
                rows: 8,
                with_icon: false,
                label_class: admin_label_class,
                textarea_class: admin_mono_control_class %>
        <% else %>
          <%= render "shared/ui/form/text_field",
                f: form,
                attribute: :value,
                label: t("admin.system_settings.show.update.value_label"),
                value: current_value,
                with_icon: false,
                size: :dense,
                label_class: admin_label_class,
                input_class: admin_control_class %>
        <% end %>

        <%= render "shared/ui/form/textarea_field",
              f: form,
              attribute: :reason,
              label: t("admin.system_settings.show.update.reason_label"),
              rows: 3,
              required: true,
              with_icon: false,
              label_class: admin_label_class,
              textarea_class: admin_control_class %>

        <% if @record[:requires_confirmation] %>
          <%= render "shared/ui/form/checkbox_field",
                f: form,
                attribute: :confirm,
                label: t("admin.system_settings.show.update.confirm_label"),
                required: true,
                checkbox_class: "mt-1" %>
        <% end %>

        <%= render "shared/ui/actions/button",
              label: t("admin.system_settings.show.update.submit"),
              type: "submit",
              size: :compact,
              icon: "save" %>
      <% end %>
    <% end %>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.system_settings.show.audit_logs.title") %></h2>
    <p class="mb-3 text-sm token-text-muted"><%= t("admin.system_settings.show.audit_logs.description") %></p>
    <%= link_to t("admin.system_settings.show.audit_logs.link"),
          admin_audit_logs_path(target_uid: @record[:key]),
          class: "text-sm font-semibold token-text-brand hover:underline" %>
  <% end %>
</section>
