<% content_for :title, t("admin.contact_requests.show.title") %>

<%
  status_options = admin_contact_request_filter_options(@filter_options || {})[:statuses]
  admin_label_class = "text-xs font-semibold token-text-muted normal-case tracking-normal px-0"
  admin_control_class = "rounded-lg text-sm"
%>

<section class="mx-auto w-full max-w-6xl space-y-6 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "admin/shared/navigation" %>

  <%= render "shared/ui/layout/section_header",
        title: t("admin.contact_requests.show.title"),
        subtitle: @record[:request_uid],
        breadcrumb_label: t("admin.contact_requests.index.title"),
        breadcrumb_path: admin_contact_requests_path,
        title_size: "text-2xl md:text-3xl",
        subtitle_size: "text-sm" %>

  <div class="grid gap-6 lg:grid-cols-3">
    <%= render "shared/ui/layout/surface_card", padding: :md, class: "lg:col-span-2" do %>
      <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.contact_requests.show.sections.message") %></h2>
      <dl class="space-y-4 text-sm">
        <div>
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.contact_requests.show.labels.subject") %></dt>
          <dd class="mt-1 break-words token-text-base [overflow-wrap:anywhere]"><%= @record[:subject] %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.contact_requests.show.labels.body") %></dt>
          <dd class="mt-2 whitespace-pre-wrap break-words rounded-lg border token-border-soft token-bg-input p-4 token-text-base [overflow-wrap:anywhere]"><%= @record[:body] %></dd>
        </div>
      </dl>
    <% end %>

    <%= render "shared/ui/layout/surface_card", padding: :md do %>
      <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.contact_requests.show.sections.status_update") %></h2>
      <%= form_with model: @record[:contact_request], url: admin_contact_request_path(@record[:id]), method: :patch, local: true, class: "space-y-4" do |form| %>
        <%= render "shared/ui/form/select_field",
              f: form,
              attribute: :status,
              label: t("admin.contact_requests.show.labels.status"),
              options: status_options,
              selected: @record[:status],
              with_icon: false,
              size: :dense,
              label_class: admin_label_class,
              select_class: admin_control_class %>

        <%= render "shared/ui/actions/button",
              label: t("admin.contact_requests.show.buttons.update_status"),
              type: "submit",
              icon: "published_with_changes",
              full_width: true %>
      <% end %>
      <p class="mt-3 text-xs token-text-muted"><%= t("admin.contact_requests.show.status_update_notice") %></p>
    <% end %>
  </div>

  <%= render "shared/ui/layout/surface_card", padding: :md, class: "min-w-0 max-w-full" do %>
    <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.contact_requests.show.sections.summary") %></h2>
    <dl class="grid min-w-0 max-w-full gap-4 text-sm md:grid-cols-2 lg:grid-cols-3">
      <div>
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.contact_requests.show.labels.request_uid") %></dt>
        <dd class="break-words font-mono token-text-base [overflow-wrap:anywhere]"><%= @record[:request_uid] %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.contact_requests.show.labels.status") %></dt>
        <dd class="token-text-base"><%= t("admin.contact_requests.statuses.#{@record[:status]}") %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.contact_requests.show.labels.category") %></dt>
        <dd class="token-text-base"><%= t("admin.contact_requests.categories.#{@record[:category]}") %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.contact_requests.show.labels.source") %></dt>
        <dd class="token-text-base"><%= t("admin.contact_requests.sources.#{@record[:source]}") %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.contact_requests.show.labels.user") %></dt>
        <dd class="font-mono token-text-base">
          <% if @record[:user_id].present? %>
            <%= link_to "##{@record[:user_id]}", admin_user_path(@record[:user_id]), class: "token-text-brand hover:underline" %>
          <% else %>
            -
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.contact_requests.show.labels.sender_name") %></dt>
        <dd class="break-words token-text-base [overflow-wrap:anywhere]"><%= @record[:anonymized] ? t("admin.contact_requests.common.redacted") : @record[:sender_name].presence || t("admin.contact_requests.common.sender_name_blank") %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.contact_requests.show.labels.email_masked") %></dt>
        <dd class="break-words font-mono token-text-base [overflow-wrap:anywhere]"><%= @record[:email_masked] %></dd>
      </div>
      <div class="min-w-0 max-w-full">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.contact_requests.show.labels.email_digest") %></dt>
        <dd class="break-words font-mono text-xs token-text-base [overflow-wrap:anywhere]"><%= @record[:email_digest] %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.contact_requests.show.labels.created_at") %></dt>
        <dd class="token-text-base"><%= l(@record[:created_at], format: :short) %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.contact_requests.show.labels.handled_by") %></dt>
        <dd class="font-mono token-text-base"><%= @record[:handled_by_user_id].present? ? "##{@record[:handled_by_user_id]}" : "-" %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.contact_requests.show.labels.handled_at") %></dt>
        <dd class="token-text-base"><%= @record[:handled_at].present? ? l(@record[:handled_at], format: :short) : "-" %></dd>
      </div>
      <div class="min-w-0 max-w-full">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.contact_requests.show.labels.request_id") %></dt>
        <dd class="break-words font-mono text-xs token-text-base [overflow-wrap:anywhere]"><%= @record[:request_id].presence || "-" %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.contact_requests.show.labels.ip_address") %></dt>
        <dd class="font-mono token-text-base"><%= @record[:ip_address].presence || "-" %></dd>
      </div>
      <div class="min-w-0 max-w-full md:col-span-2 lg:col-span-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.contact_requests.show.labels.user_agent") %></dt>
        <dd class="break-words token-text-base [overflow-wrap:anywhere]"><%= @record[:user_agent].presence || "-" %></dd>
      </div>
    </dl>
  <% end %>
</section>
