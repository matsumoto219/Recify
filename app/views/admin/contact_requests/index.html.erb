<% content_for :title, t("admin.contact_requests.index.title") %>

<%
  filters = @filters || {}
  pagination = admin_index_pagination(@result, filters: filters)
  filter_options = admin_contact_request_filter_options(@filter_options || {})
  filter_label_class = "text-xs font-semibold token-text-muted normal-case tracking-normal px-0"
  filter_wrapper_class = "space-y-1"
  filter_control_class = "rounded-lg text-sm"
%>

<section class="mx-auto w-full max-w-7xl space-y-6 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "admin/shared/navigation" %>

  <%= render "shared/ui/layout/section_header",
        title: t("admin.contact_requests.index.title"),
        subtitle: t("admin.contact_requests.index.description"),
        title_size: "text-2xl md:text-3xl",
        subtitle_size: "text-sm md:text-base" %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4 flex items-center justify-between gap-3">
      <div>
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.contact_requests.index.filters.title") %></h2>
        <p class="text-sm token-text-muted"><%= t("admin.contact_requests.index.filters.description") %></p>
      </div>

      <%= link_to t("admin.contact_requests.index.filters.reset"), admin_contact_requests_path, class: "text-sm font-semibold token-text-brand hover:underline" %>
    </div>

    <%= form_with url: admin_contact_requests_path, method: :get, local: true, class: "grid gap-4 md:grid-cols-4" do |form| %>
      <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :status,
            label: t("admin.contact_requests.index.filters.labels.status"),
            options: [[ t("admin.contact_requests.index.filters.all"), "" ]] + filter_options[:statuses],
            selected: filters[:status],
            with_icon: false,
            size: :dense,
            select_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            select_class: filter_control_class %>

      <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :category,
            label: t("admin.contact_requests.index.filters.labels.category"),
            options: [[ t("admin.contact_requests.index.filters.all"), "" ]] + filter_options[:categories],
            selected: filters[:category],
            with_icon: false,
            size: :dense,
            select_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            select_class: filter_control_class %>

      <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :source,
            label: t("admin.contact_requests.index.filters.labels.source"),
            options: [[ t("admin.contact_requests.index.filters.all"), "" ]] + filter_options[:sources],
            selected: filters[:source],
            with_icon: false,
            size: :dense,
            select_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            select_class: filter_control_class %>

      <%= render "shared/ui/form/text_field",
            f: form,
            attribute: :user_id,
            label: t("admin.contact_requests.index.filters.labels.user_id"),
            value: filters[:user_id],
            with_icon: false,
            size: :dense,
            input_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            input_class: filter_control_class,
            html_options: { inputmode: "numeric" } %>

      <%= render "shared/ui/form/text_field",
            f: form,
            attribute: :request_uid,
            label: t("admin.contact_requests.index.filters.labels.request_uid"),
            value: filters[:request_uid],
            with_icon: false,
            size: :dense,
            input_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            input_class: filter_control_class %>

      <%= render "shared/ui/form/text_field",
            f: form,
            attribute: :email_digest,
            label: t("admin.contact_requests.index.filters.labels.email_digest"),
            value: filters[:email_digest],
            with_icon: false,
            size: :dense,
            input_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            input_class: filter_control_class %>

      <%= render "shared/ui/form/datetime_field",
            name: :created_from,
            id: :created_from,
            type: "datetime-local",
            label: t("admin.contact_requests.index.filters.labels.created_from"),
            value: filters[:created_from],
            field_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            field_class: "h-10 min-h-10 rounded-lg py-2 text-sm" %>

      <%= render "shared/ui/form/datetime_field",
            name: :created_to,
            id: :created_to,
            type: "datetime-local",
            label: t("admin.contact_requests.index.filters.labels.created_to"),
            value: filters[:created_to],
            field_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            field_class: "h-10 min-h-10 rounded-lg py-2 text-sm" %>

      <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :limit,
            label: t("admin.contact_requests.index.filters.labels.limit"),
            options: filter_options[:limits],
            selected: filters[:limit].presence || pagination.limit.to_s,
            with_icon: false,
            size: :dense,
            select_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            select_class: filter_control_class %>

      <div class="flex items-end gap-3 md:col-span-2">
        <%= render "shared/ui/actions/button",
              label: t("admin.contact_requests.index.filters.submit"),
              type: "submit",
              size: :compact,
              icon: "filter_alt" %>

        <%= render "shared/ui/actions/button",
              as: :link,
              href: admin_contact_requests_path,
              label: t("admin.contact_requests.index.filters.clear"),
              variant: :secondary,
              size: :compact,
              icon: "restart_alt" %>
      </div>
    <% end %>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.contact_requests.index.results.title") %></h2>
        <p class="text-sm token-text-muted"><%= t("admin.contact_requests.index.results.count_summary", total: pagination.total_count, start: pagination.start_number, end: pagination.end_number) %></p>
      </div>

      <%= render "admin/shared/index_pagination",
            pagination: pagination,
            path_method: :admin_contact_requests_path,
            previous_label: t("admin.contact_requests.index.results.previous"),
            next_label: t("admin.contact_requests.index.results.next") %>
    </div>

    <%= render "admin/shared/table_frame", size: :lg do %>
        <thead class="token-text-muted">
          <tr class="border-b token-border-soft">
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :datetime) %>"><%= t("admin.contact_requests.index.table.created") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :id) %>"><%= t("admin.contact_requests.index.table.request_uid") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :status) %>"><%= t("admin.contact_requests.index.table.status") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :status) %>"><%= t("admin.contact_requests.index.table.category") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :subject) %>"><%= t("admin.contact_requests.index.table.subject") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :subject) %>"><%= t("admin.contact_requests.index.table.sender_name") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.contact_requests.index.table.user") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :email) %>"><%= t("admin.contact_requests.index.table.email") %></th>
            <th class="px-3 py-2 font-semibold <%= admin_table_cell_classes(type: :action) %>"><%= t("admin.contact_requests.index.table.detail") %></th>
          </tr>
        </thead>
        <tbody>
          <% @result.records.each do |record| %>
            <tr class="border-b token-border-soft">
              <td class="px-3 py-3 <%= admin_table_cell_classes(type: :datetime) %>"><%= l(record[:created_at], format: :short) %></td>
              <td class="px-3 py-3 <%= admin_table_cell_classes(type: :id) %>"><%= record[:request_uid] %></td>
              <td class="px-3 py-3 <%= admin_table_cell_classes(type: :status) %>"><%= t("admin.contact_requests.statuses.#{record[:status]}") %></td>
              <td class="px-3 py-3 <%= admin_table_cell_classes(type: :status) %>"><%= t("admin.contact_requests.categories.#{record[:category]}") %></td>
              <td class="px-3 py-3 <%= admin_table_cell_classes(type: :subject) %>" title="<%= record[:subject] %>"><%= record[:subject] %></td>
              <td class="px-3 py-3 <%= admin_table_cell_classes(type: :subject) %>" title="<%= record[:anonymized] ? t("admin.contact_requests.common.redacted") : record[:sender_name].presence || t("admin.contact_requests.common.sender_name_blank") %>"><%= record[:anonymized] ? t("admin.contact_requests.common.redacted") : record[:sender_name].presence || t("admin.contact_requests.common.sender_name_blank") %></td>
              <td class="px-3 py-3 <%= admin_table_cell_classes(type: :id) %>">
                <% if record[:user_id].present? %>
                  <%= link_to "##{record[:user_id]}", admin_user_path(record[:user_id]), class: "token-text-brand hover:underline" %>
                <% else %>
                  -
                <% end %>
              </td>
              <td class="px-3 py-3 <%= admin_table_cell_classes(type: :email) %>">
                <%= render "shared/ui/text/email_address",
                      email: record[:email_masked],
                      mode: :one_line,
                      class: "font-mono text-xs" %>
              </td>
              <td class="px-3 py-3 <%= admin_table_cell_classes(type: :action) %>"><%= link_to t("admin.contact_requests.index.table.detail_link"), admin_contact_request_path(record[:id]), class: "token-text-brand hover:underline" %></td>
            </tr>
          <% end %>

          <% if @result.records.empty? %>
            <tr>
              <td colspan="9" class="px-3 py-10 text-center text-sm token-text-muted"><%= t("admin.contact_requests.index.results.empty") %></td>
            </tr>
          <% end %>
        </tbody>
    <% end %>
  <% end %>
</section>
