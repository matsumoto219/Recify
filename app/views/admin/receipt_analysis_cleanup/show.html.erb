<% content_for :title, t("admin.receipt_analysis_cleanup.title") %>

<%
  stale = @preview.stale
  retention = @preview.retention
  preview_params = @preview.params

  stale_cutoff_value = preview_params[:stale_cutoff]&.strftime("%Y-%m-%dT%H:%M")
  retention_cutoff_value = preview_params[:retention_cutoff]&.strftime("%Y-%m-%dT%H:%M")

  stale_records = Array(stale[:records])
  retention_records = Array(retention[:records])
%>

<section class="mx-auto w-full max-w-7xl space-y-6 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "admin/shared/navigation" %>

  <%= render "shared/ui/layout/section_header",
        title: t("admin.receipt_analysis_cleanup.title"),
        subtitle: t("admin.receipt_analysis_cleanup.description"),
        title_size: "text-3xl",
        subtitle_size: "text-base" %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="space-y-3">
      <h2 class="text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_cleanup.overview.title") %></h2>
      <p class="text-sm token-text-muted">
        <%= t("admin.receipt_analysis_cleanup.overview.readonly_description") %>
      </p>
      <p class="text-sm token-text-muted">
        <%= t("admin.receipt_analysis_cleanup.overview.execution_requirement") %>
      </p>
    </div>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4 flex items-center justify-between gap-3">
      <div>
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_cleanup.filters.title") %></h2>
        <p class="text-sm token-text-muted"><%= t("admin.receipt_analysis_cleanup.filters.description") %></p>
      </div>

      <%= link_to t("admin.receipt_analysis_cleanup.filters.reset"), admin_receipt_analysis_cleanup_path, class: "text-sm font-semibold token-text-brand hover:underline" %>
    </div>

    <%= form_with url: admin_receipt_analysis_cleanup_path, method: :get, local: true, class: "grid gap-4 md:grid-cols-4" do |form| %>
      <div class="space-y-1">
        <%= form.label :stale_cutoff, t("admin.receipt_analysis_cleanup.filters.labels.stale_cutoff"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.datetime_field :stale_cutoff, value: stale_cutoff_value, class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 text-sm token-text-base" %>
      </div>

      <div class="space-y-1">
        <%= form.label :stale_limit, t("admin.receipt_analysis_cleanup.filters.labels.stale_limit"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.number_field :stale_limit, value: preview_params[:stale_limit], min: 1, max: 100, class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 text-sm token-text-base" %>
      </div>

      <div class="space-y-1">
        <%= form.label :retention_cutoff, t("admin.receipt_analysis_cleanup.filters.labels.retention_cutoff"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.datetime_field :retention_cutoff, value: retention_cutoff_value, class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 text-sm token-text-base" %>
      </div>

      <div class="space-y-1">
        <%= form.label :retention_limit, t("admin.receipt_analysis_cleanup.filters.labels.retention_limit"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.number_field :retention_limit, value: preview_params[:retention_limit], min: 1, max: 1000, class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 text-sm token-text-base" %>
      </div>

      <div class="flex items-end gap-3 md:col-span-4">
        <%= render "shared/ui/actions/button",
              label: t("admin.receipt_analysis_cleanup.filters.submit"),
              type: "submit",
              size: :compact,
              icon: "visibility" %>

        <%= render "shared/ui/actions/button",
              as: :link,
              href: admin_receipt_analysis_cleanup_path,
              label: t("admin.receipt_analysis_cleanup.filters.clear"),
              variant: :secondary,
              size: :compact,
              icon: "restart_alt" %>
      </div>
    <% end %>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4">
      <h2 class="text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_cleanup.stale.title") %></h2>
      <p class="text-sm token-text-muted">
        <%= t("admin.receipt_analysis_cleanup.stale.description", cutoff: l(stale[:cutoff], format: :short)) %>
      </p>
    </div>

    <dl class="mb-6 grid gap-3 text-sm md:grid-cols-4">
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_cleanup.common.no_updates_label") %></dt>
        <dd class="font-mono token-text-base"><%= t("admin.receipt_analysis_cleanup.common.no_updates_value") %></dd>
      </div>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_cleanup.common.limit") %></dt>
        <dd class="font-mono token-text-base"><%= stale[:limit] %></dd>
      </div>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_cleanup.stale.stale_count") %></dt>
        <dd class="font-mono token-text-base"><%= stale[:stale_count] %></dd>
      </div>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_cleanup.stale.skipped_count") %></dt>
        <dd class="font-mono token-text-base"><%= stale[:skipped_count] %></dd>
      </div>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_cleanup.stale.failed_count") %></dt>
        <dd class="font-mono token-text-base"><%= stale[:failed_count] %></dd>
      </div>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_cleanup.stale.canceled_count") %></dt>
        <dd class="font-mono token-text-base"><%= stale[:canceled_count] %></dd>
      </div>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3 md:col-span-2">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_cleanup.stale.errors") %></dt>
        <dd class="font-mono token-text-base"><%= Array(stale[:errors]).size %></dd>
      </div>
    </dl>

    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead class="token-text-muted">
          <tr class="border-b token-border-soft">
            <th class="px-3 py-2 font-semibold"><%= t("admin.receipt_analysis_cleanup.common.run_key") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.receipt_analysis_cleanup.common.status") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.receipt_analysis_cleanup.common.stage") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.receipt_analysis_cleanup.common.receipt_status") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.receipt_analysis_cleanup.stale.updated_at") %></th>
          </tr>
        </thead>
        <tbody>
          <% stale_records.each do |record| %>
            <tr class="border-b token-border-soft">
              <td class="px-3 py-3 font-mono text-xs">
                <%= link_to record[:run_key], admin_receipt_analysis_run_path(record[:run_key]), class: "token-text-brand hover:underline" %>
              </td>
              <td class="px-3 py-3"><%= record[:status] %></td>
              <td class="px-3 py-3"><%= record[:stage] %></td>
              <td class="px-3 py-3"><%= record[:receipt_status] %></td>
              <td class="px-3 py-3 whitespace-nowrap"><%= record[:updated_at].present? ? l(record[:updated_at], format: :short) : "-" %></td>
            </tr>
          <% end %>

          <% if stale_records.empty? %>
            <tr>
              <td colspan="5" class="px-3 py-10 text-center text-sm token-text-muted"><%= t("admin.receipt_analysis_cleanup.stale.empty") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-6 rounded-lg border token-border-soft token-bg-card-subtle p-4">
      <h3 class="mb-2 text-base font-bold token-text-base"><%= t("admin.receipt_analysis_cleanup.stale.execute_title") %></h3>
      <p class="mb-4 text-sm token-text-muted">
        <%= t("admin.receipt_analysis_cleanup.stale.execute_description") %>
      </p>

      <% if cleanup_execution_enabled? %>
        <%= form_with url: admin_receipt_analysis_cleanup_stale_path, method: :post, local: true, class: "space-y-4" do |form| %>
          <%= form.hidden_field :stale_cutoff, value: stale_cutoff_value %>
          <%= form.hidden_field :stale_limit, value: preview_params[:stale_limit] %>
          <%= form.hidden_field :retention_cutoff, value: retention_cutoff_value %>
          <%= form.hidden_field :retention_limit, value: preview_params[:retention_limit] %>

          <div class="space-y-1">
            <%= form.label :reason, t("admin.receipt_analysis_cleanup.common.reason_label"), class: "text-xs font-semibold token-text-muted" %>
            <%= form.text_area :reason, rows: 3, required: true, class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 text-sm token-text-base" %>
          </div>

          <label class="flex items-start gap-3 text-sm token-text-base">
            <%= form.check_box :confirm, required: true, class: "mt-1" %>
            <span><%= t("admin.receipt_analysis_cleanup.stale.confirm_label") %></span>
          </label>

          <%= render "shared/ui/actions/button",
                label: t("admin.receipt_analysis_cleanup.stale.submit"),
                type: "submit",
                size: :compact,
                icon: "warning" %>
        <% end %>
      <% else %>
        <p class="mb-3 text-sm token-text-muted"><%= t("admin.receipt_analysis_cleanup.common.reauthentication_required") %></p>
        <%= link_to t("admin.receipt_analysis_cleanup.common.reauthentication_link"),
              new_admin_passkey_reauthentication_path(return_to: admin_receipt_analysis_cleanup_path),
              class: "inline-flex min-h-10 items-center justify-center rounded-lg px-4 text-sm font-semibold token-bg-primary token-text-inverse hover:opacity-90" %>
      <% end %>
    </div>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4">
      <h2 class="text-lg font-bold token-text-base"><%= t("admin.receipt_analysis_cleanup.retention.title") %></h2>
      <p class="text-sm token-text-muted">
        <%= t("admin.receipt_analysis_cleanup.retention.description", cutoff: l(retention[:cutoff], format: :short)) %>
      </p>
    </div>

    <dl class="mb-6 grid gap-3 text-sm md:grid-cols-4">
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_cleanup.common.no_updates_label") %></dt>
        <dd class="font-mono token-text-base"><%= t("admin.receipt_analysis_cleanup.common.no_updates_value") %></dd>
      </div>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_cleanup.common.limit") %></dt>
        <dd class="font-mono token-text-base"><%= retention[:limit] %></dd>
      </div>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_cleanup.retention.expired_count") %></dt>
        <dd class="font-mono token-text-base"><%= retention[:expired_count] %></dd>
      </div>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.receipt_analysis_cleanup.retention.deleted_count") %></dt>
        <dd class="font-mono token-text-base"><%= retention[:deleted_count] %></dd>
      </div>
    </dl>

    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead class="token-text-muted">
          <tr class="border-b token-border-soft">
            <th class="px-3 py-2 font-semibold"><%= t("admin.receipt_analysis_cleanup.common.run_key") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.receipt_analysis_cleanup.common.status") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.receipt_analysis_cleanup.common.stage") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.receipt_analysis_cleanup.retention.expires_at") %></th>
          </tr>
        </thead>
        <tbody>
          <% retention_records.each do |record| %>
            <tr class="border-b token-border-soft">
              <td class="px-3 py-3 font-mono text-xs">
                <%= link_to record[:run_key], admin_receipt_analysis_run_path(record[:run_key]), class: "token-text-brand hover:underline" %>
              </td>
              <td class="px-3 py-3"><%= record[:status] %></td>
              <td class="px-3 py-3"><%= record[:stage] %></td>
              <td class="px-3 py-3 whitespace-nowrap"><%= record[:expires_at].present? ? l(record[:expires_at], format: :short) : "-" %></td>
            </tr>
          <% end %>

          <% if retention_records.empty? %>
            <tr>
              <td colspan="4" class="px-3 py-10 text-center text-sm token-text-muted"><%= t("admin.receipt_analysis_cleanup.retention.empty") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-6 rounded-lg border token-border-soft token-bg-card-subtle p-4">
      <h3 class="mb-2 text-base font-bold token-text-base"><%= t("admin.receipt_analysis_cleanup.retention.execute_title") %></h3>
      <p class="mb-4 text-sm token-text-muted">
        <%= t("admin.receipt_analysis_cleanup.retention.execute_description") %>
      </p>

      <% if cleanup_execution_enabled? %>
        <%= form_with url: admin_receipt_analysis_cleanup_retention_path, method: :post, local: true, class: "space-y-4" do |form| %>
          <%= form.hidden_field :stale_cutoff, value: stale_cutoff_value %>
          <%= form.hidden_field :stale_limit, value: preview_params[:stale_limit] %>
          <%= form.hidden_field :retention_cutoff, value: retention_cutoff_value %>
          <%= form.hidden_field :retention_limit, value: preview_params[:retention_limit] %>

          <div class="space-y-1">
            <%= form.label :reason, t("admin.receipt_analysis_cleanup.common.reason_label"), class: "text-xs font-semibold token-text-muted" %>
            <%= form.text_area :reason, rows: 3, required: true, class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 text-sm token-text-base" %>
          </div>

          <label class="flex items-start gap-3 text-sm token-text-base">
            <%= form.check_box :confirm, required: true, class: "mt-1" %>
            <span><%= t("admin.receipt_analysis_cleanup.retention.confirm_label") %></span>
          </label>

          <div class="space-y-1">
            <%= form.label :confirmation_text, t("admin.receipt_analysis_cleanup.retention.confirmation_label"), class: "text-xs font-semibold token-text-muted" %>
            <%= form.text_field :confirmation_text, required: true, class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 font-mono text-sm token-text-base" %>
          </div>

          <%= render "shared/ui/actions/button",
                label: t("admin.receipt_analysis_cleanup.retention.submit"),
                type: "submit",
                size: :compact,
                icon: "delete" %>
        <% end %>
      <% else %>
        <p class="mb-3 text-sm token-text-muted"><%= t("admin.receipt_analysis_cleanup.common.reauthentication_required") %></p>
        <%= link_to t("admin.receipt_analysis_cleanup.common.reauthentication_link"),
              new_admin_passkey_reauthentication_path(return_to: admin_receipt_analysis_cleanup_path),
              class: "inline-flex min-h-10 items-center justify-center rounded-lg px-4 text-sm font-semibold token-bg-primary token-text-inverse hover:opacity-90" %>
      <% end %>
    </div>
  <% end %>
</section>
