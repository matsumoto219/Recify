<% content_for :title, t("admin.announcements.show.title") %>

<section class="mx-auto w-full min-w-0 max-w-6xl space-y-6 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "admin/shared/navigation" %>

  <%= render "shared/ui/layout/section_header",
        title: t("admin.announcements.show.title"),
        subtitle: @announcement.public_id,
        breadcrumb_label: t("admin.announcements.index.title"),
        breadcrumb_path: admin_announcements_path,
        title_size: "text-2xl md:text-3xl",
        subtitle_size: "text-sm" %>

  <div class="min-w-0 space-y-3 rounded-xl border token-border-soft token-bg-card-subtle p-4">
    <div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
      <div class="min-w-0 space-y-1">
        <h2 class="text-base font-bold token-text-base"><%= t("admin.announcements.show.operations.title") %></h2>
        <p class="break-words text-sm token-text-muted [overflow-wrap:anywhere]"><%= t("admin.announcements.show.operations.description") %></p>
        <% unless admin_passkey_reauthenticated? %>
          <p class="break-words text-xs font-semibold token-text-warning [overflow-wrap:anywhere]">
            <%= t("admin.announcements.show.operations.reauthentication_required") %>
          </p>
        <% end %>
      </div>

      <% unless admin_passkey_reauthenticated? %>
        <%= render "shared/ui/actions/button",
              as: :link,
              href: new_admin_passkey_reauthentication_path(return_to: admin_announcement_path(@announcement)),
              label: t("admin.announcements.show.actions.reauthenticate"),
              icon: "passkey",
              size: :compact,
              variant: :secondary %>
      <% end %>
    </div>

    <div class="flex flex-wrap justify-end gap-3">
      <% if @announcement.status == "draft" %>
        <%= render "shared/ui/actions/button",
              as: :link,
              href: edit_admin_announcement_path(@announcement),
              label: t("admin.announcements.show.actions.edit"),
              icon: "edit",
              size: :compact,
              variant: :secondary %>

        <%= form_with url: publish_admin_announcement_path(@announcement),
              method: :patch,
              local: true,
              data: confirm_dialog_data(
                t("admin.announcements.show.confirm.publish.message"),
                variant: :neutral,
                icon: :warning,
                title: t("admin.announcements.show.confirm.publish.title"),
                confirm_label: t("admin.announcements.show.actions.publish")
              ) do %>
          <%= render "shared/ui/actions/button",
                label: t("admin.announcements.show.actions.publish"),
                type: "submit",
                icon: "publish",
                size: :compact %>
        <% end %>

        <%= form_with url: archive_admin_announcement_path(@announcement),
              method: :patch,
              local: true,
              data: confirm_dialog_data(
                t("admin.announcements.show.confirm.archive.message"),
                variant: :danger,
                icon: :warning,
                title: t("admin.announcements.show.confirm.archive.title"),
                confirm_label: t("admin.announcements.show.actions.archive")
              ) do %>
          <%= render "shared/ui/actions/button",
                label: t("admin.announcements.show.actions.archive"),
                type: "submit",
                icon: "archive",
                size: :compact,
                variant: :danger %>
        <% end %>
      <% elsif @announcement.status == "published" %>
        <span class="max-w-full break-words rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-muted [overflow-wrap:anywhere]">
          <%= t("admin.announcements.show.readonly_notice") %>
        </span>

        <%= form_with url: archive_admin_announcement_path(@announcement),
              method: :patch,
              local: true,
              data: confirm_dialog_data(
                t("admin.announcements.show.confirm.archive.message"),
                variant: :danger,
                icon: :warning,
                title: t("admin.announcements.show.confirm.archive.title"),
                confirm_label: t("admin.announcements.show.actions.archive")
              ) do %>
          <%= render "shared/ui/actions/button",
                label: t("admin.announcements.show.actions.archive"),
                type: "submit",
                icon: "archive",
                size: :compact,
                variant: :danger %>
        <% end %>
      <% else %>
        <span class="max-w-full break-words rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-muted [overflow-wrap:anywhere]">
          <%= t("admin.announcements.show.archived_notice") %>
        </span>
      <% end %>
    </div>
  </div>

  <div class="grid min-w-0 max-w-full gap-6 lg:grid-cols-3">
    <%= render "shared/ui/layout/surface_card", padding: :md, class: "min-w-0 max-w-full lg:col-span-2" do %>
      <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.announcements.show.sections.content") %></h2>
      <dl class="space-y-4 text-sm">
        <div>
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.announcements.show.labels.title") %></dt>
          <dd class="mt-1 break-words token-text-base [overflow-wrap:anywhere]"><%= @announcement.title %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.announcements.show.labels.body") %></dt>
          <dd class="mt-2 whitespace-pre-wrap break-words rounded-lg border token-border-soft token-bg-input p-4 token-text-base [overflow-wrap:anywhere]"><%= @announcement.body %></dd>
        </div>
      </dl>
    <% end %>

    <%= render "shared/ui/layout/surface_card", padding: :md, class: "min-w-0 max-w-full" do %>
      <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.announcements.show.sections.status") %></h2>
      <dl class="space-y-4 text-sm">
        <div>
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.announcements.show.labels.status") %></dt>
          <dd class="min-w-0 max-w-full break-words token-text-base [overflow-wrap:anywhere]"><%= t("admin.announcements.statuses.#{@announcement.status}") %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.announcements.show.labels.kind") %></dt>
          <dd class="min-w-0 max-w-full break-words token-text-base [overflow-wrap:anywhere]"><%= t("announcements.kinds.#{@announcement.kind}") %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.announcements.show.labels.pinned") %></dt>
          <dd class="min-w-0 max-w-full break-words token-text-base [overflow-wrap:anywhere]"><%= @announcement.pinned? ? t("admin.announcements.common.yes") : t("admin.announcements.common.no") %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.announcements.show.labels.priority") %></dt>
          <dd class="min-w-0 max-w-full break-words token-text-base [overflow-wrap:anywhere]"><%= @announcement.priority %></dd>
        </div>
      </dl>
    <% end %>
  </div>

  <%= render "shared/ui/layout/surface_card", padding: :md, class: "min-w-0" do %>
    <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.announcements.show.sections.image") %></h2>
    <% if @announcement.image.attached? && @announcement.image.blob&.persisted? %>
      <div class="grid gap-5 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
        <div class="overflow-hidden rounded-xl border token-border-soft token-bg-input">
          <div class="flex aspect-video items-center justify-center p-3">
            <%= image_tag @announcement.image,
                  alt: @announcement.image_alt_text.presence || t("admin.announcements.show.image_preview_alt"),
                  class: "max-h-full max-w-full rounded-lg object-contain" %>
          </div>
        </div>

        <dl class="min-w-0 space-y-4 text-sm">
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.announcements.show.labels.image_alt_text") %></dt>
            <dd class="mt-1 break-words token-text-base [overflow-wrap:anywhere]"><%= @announcement.image_alt_text.presence || "-" %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.announcements.show.labels.image_filename") %></dt>
            <dd class="mt-1 break-words token-text-base [overflow-wrap:anywhere]"><%= @announcement.image.filename.to_s %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.announcements.show.labels.image_content_type") %></dt>
            <dd class="min-w-0 max-w-full break-words token-text-base [overflow-wrap:anywhere]"><%= @announcement.image.blob.content_type %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold token-text-muted"><%= t("admin.announcements.show.labels.image_file_size") %></dt>
            <dd class="min-w-0 max-w-full break-words token-text-base [overflow-wrap:anywhere]"><%= number_to_human_size(@announcement.image.blob.byte_size) %></dd>
          </div>
        </dl>
      </div>
    <% else %>
      <p class="text-sm token-text-muted"><%= t("admin.announcements.show.image_empty") %></p>
    <% end %>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.announcements.show.sections.links") %></h2>
    <% links = @announcement.announcement_links.sort_by(&:position) %>
    <% if links.any? %>
      <ul class="space-y-3 text-sm">
        <% links.each do |link| %>
          <li class="min-w-0 overflow-hidden rounded-lg border token-border-soft token-bg-input p-4">
            <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
              <div class="min-w-0">
                <p class="break-words font-semibold token-text-base [overflow-wrap:anywhere]"><%= link.label %></p>
                <p class="mt-1 break-words font-mono text-xs token-text-muted [overflow-wrap:anywhere]"><%= link.url %></p>
              </div>
              <span class="shrink-0 rounded-full border token-border-soft px-3 py-1 text-xs font-semibold token-text-muted">
                <%= link.external? ? t("admin.announcements.show.link_kinds.external") : t("admin.announcements.show.link_kinds.internal") %>
              </span>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm token-text-muted"><%= t("admin.announcements.show.links_empty") %></p>
    <% end %>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md, class: "min-w-0 max-w-full" do %>
    <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.announcements.show.sections.metadata") %></h2>
    <dl class="grid min-w-0 max-w-full gap-4 text-sm md:grid-cols-2 lg:grid-cols-3">
      <div>
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.announcements.show.labels.public_id") %></dt>
        <dd class="break-words font-mono token-text-base [overflow-wrap:anywhere]"><%= @announcement.public_id %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.announcements.show.labels.published_at") %></dt>
        <dd class="min-w-0 max-w-full break-words token-text-base [overflow-wrap:anywhere]"><%= @announcement.published_at.present? ? l(@announcement.published_at, format: :short) : "-" %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.announcements.show.labels.starts_at") %></dt>
        <dd class="min-w-0 max-w-full break-words token-text-base [overflow-wrap:anywhere]"><%= @announcement.starts_at.present? ? l(@announcement.starts_at, format: :short) : "-" %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.announcements.show.labels.ends_at") %></dt>
        <dd class="min-w-0 max-w-full break-words token-text-base [overflow-wrap:anywhere]"><%= @announcement.ends_at.present? ? l(@announcement.ends_at, format: :short) : "-" %></dd>
      </div>
      <div class="min-w-0 max-w-full">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.announcements.show.labels.created_by") %></dt>
        <dd class="min-w-0 max-w-full">
          <%= render "shared/ui/text/email_address",
                email: @announcement.created_by&.email || "-",
                mode: :one_line,
                class: "token-text-base" %>
        </dd>
      </div>
      <div class="min-w-0 max-w-full">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.announcements.show.labels.updated_by") %></dt>
        <dd class="min-w-0 max-w-full">
          <%= render "shared/ui/text/email_address",
                email: @announcement.updated_by&.email || "-",
                mode: :one_line,
                class: "token-text-base" %>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.announcements.show.labels.created_at") %></dt>
        <dd class="min-w-0 max-w-full break-words token-text-base [overflow-wrap:anywhere]"><%= l(@announcement.created_at, format: :short) %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.announcements.show.labels.updated_at") %></dt>
        <dd class="min-w-0 max-w-full break-words token-text-base [overflow-wrap:anywhere]"><%= l(@announcement.updated_at, format: :short) %></dd>
      </div>
    </dl>
  <% end %>
</section>
