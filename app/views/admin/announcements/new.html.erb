<% content_for :title, t("admin.announcements.new.title") %>

<section class="mx-auto w-full max-w-5xl space-y-6 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "admin/shared/navigation" %>

  <%= render "shared/ui/layout/section_header",
        title: t("admin.announcements.new.title"),
        subtitle: t("admin.announcements.new.description"),
        breadcrumb_label: t("admin.announcements.index.title"),
        breadcrumb_path: admin_announcements_path,
        title_size: "text-2xl md:text-3xl",
        subtitle_size: "text-sm md:text-base" %>

  <%= render "form", announcement: @announcement, link_rows: @announcement_link_rows %>
</section>
