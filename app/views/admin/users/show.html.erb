<% content_for :title, t("admin.users.show.title") %>

<%
  record = @record
  active_sessions = record[:active_sessions] || { count: 0, recent: [] }
  boolean_label = ->(value) { value ? t("admin.users.common.yes") : t("admin.users.common.no") }
  timestamp_label = ->(value) { value.present? ? l(value, format: :short) : "-" }
%>

<section class="mx-auto w-full max-w-7xl space-y-6 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "admin/shared/navigation" %>

  <%= render "shared/ui/layout/section_header",
        title: t("admin.users.show.title"),
        subtitle: t("admin.users.show.description"),
        title_size: "text-3xl",
        subtitle_size: "text-base" %>

  <div class="flex flex-wrap gap-2 text-sm">
    <%= link_to t("admin.users.show.links.back"), admin_users_path, class: "rounded-lg border token-border-soft px-3 py-2 font-semibold token-text-brand hover:underline" %>
    <%= link_to t("admin.users.show.links.receipt_analysis_runs"), admin_receipt_analysis_runs_path(user_id: record[:id]), class: "rounded-lg border token-border-soft px-3 py-2 font-semibold token-text-brand hover:underline" %>
    <%= link_to t("admin.users.show.links.audit_logs"), admin_audit_logs_path(actor_user_id: record[:id]), class: "rounded-lg border token-border-soft px-3 py-2 font-semibold token-text-brand hover:underline" %>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render "shared/ui/layout/surface_card", padding: :md do %>
      <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.users.show.basic.title") %></h2>
      <dl class="grid gap-3 text-sm md:grid-cols-2">
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.basic.user_id") %></dt>
          <dd class="font-mono token-text-base">#<%= record[:id] %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.basic.email") %></dt>
          <dd class="break-all token-text-base"><%= record[:email] %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.basic.admin") %></dt>
          <dd class="token-text-base"><%= boolean_label.call(record[:admin]) %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.basic.guest") %></dt>
          <dd class="token-text-base"><%= boolean_label.call(record[:guest]) %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.basic.created") %></dt>
          <dd class="token-text-base"><%= timestamp_label.call(record.dig(:timestamps, :created_at)) %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.basic.updated") %></dt>
          <dd class="token-text-base"><%= timestamp_label.call(record.dig(:timestamps, :updated_at)) %></dd>
        </div>
      </dl>
    <% end %>

    <%= render "shared/ui/layout/surface_card", padding: :md do %>
      <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.users.show.security.title") %></h2>
      <dl class="grid gap-3 text-sm md:grid-cols-2">
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.security.confirmed") %></dt>
          <dd class="token-text-base"><%= boolean_label.call(record[:confirmed]) %></dd>
          <dd class="mt-1 text-xs token-text-muted"><%= timestamp_label.call(record.dig(:security, :confirmed_at)) %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.security.unconfirmed_email") %></dt>
          <dd class="token-text-base"><%= record.dig(:security, :unconfirmed_email_present) ? t("admin.users.show.security.present") : t("admin.users.show.security.absent") %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.security.locked") %></dt>
          <dd class="token-text-base"><%= boolean_label.call(record[:locked]) %></dd>
          <dd class="mt-1 text-xs token-text-muted"><%= timestamp_label.call(record.dig(:security, :locked_at)) %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.security.failed_attempts") %></dt>
          <dd class="font-mono token-text-base"><%= record.dig(:security, :failed_attempts) %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.security.unlock_sent") %></dt>
          <dd class="token-text-base"><%= timestamp_label.call(record.dig(:security, :unlock_sent_at)) %></dd>
        </div>
      </dl>
    <% end %>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render "shared/ui/layout/surface_card", padding: :md do %>
      <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.users.show.sign_in.title") %></h2>
      <dl class="grid gap-3 text-sm md:grid-cols-2">
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.sign_in.sign_in_count") %></dt>
          <dd class="font-mono token-text-base"><%= record.dig(:sign_in, :sign_in_count) %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.sign_in.current_sign_in") %></dt>
          <dd class="token-text-base"><%= timestamp_label.call(record.dig(:sign_in, :current_sign_in_at)) %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.sign_in.last_sign_in") %></dt>
          <dd class="token-text-base"><%= timestamp_label.call(record.dig(:sign_in, :last_sign_in_at)) %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.sign_in.current_ip") %></dt>
          <dd class="font-mono token-text-base"><%= record.dig(:sign_in, :current_sign_in_ip).presence || "-" %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.sign_in.last_ip") %></dt>
          <dd class="font-mono token-text-base"><%= record.dig(:sign_in, :last_sign_in_ip).presence || "-" %></dd>
        </div>
      </dl>
    <% end %>

    <%= render "shared/ui/layout/surface_card", padding: :md do %>
      <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.users.show.usage.title") %></h2>
      <dl class="grid gap-3 text-sm md:grid-cols-2">
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.usage.passkeys") %></dt>
          <dd class="font-mono text-2xl font-bold token-text-base" data-admin-user-passkeys-count><%= record[:passkeys_count] %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.usage.latest_passkey_use") %></dt>
          <dd class="token-text-base"><%= timestamp_label.call(record[:latest_passkey_last_used_at]) %></dd>
        </div>
        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
          <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.usage.receipts") %></dt>
          <dd class="font-mono text-2xl font-bold token-text-base" data-admin-user-receipts-count><%= record[:receipts_count] %></dd>
        </div>
      </dl>
    <% end %>
  </div>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4">
      <h2 class="text-lg font-bold token-text-base"><%= t("admin.users.show.sessions.title") %></h2>
      <p class="text-sm token-text-muted"><%= t("admin.users.show.sessions.description") %></p>
    </div>

    <dl class="mb-5 grid gap-3 text-sm md:grid-cols-4">
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.sessions.active_sessions") %></dt>
        <dd class="font-mono text-2xl font-bold token-text-base" data-admin-user-active-sessions-count><%= active_sessions[:count] %></dd>
      </div>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.sessions.latest_seen") %></dt>
        <dd class="token-text-base"><%= timestamp_label.call(active_sessions[:latest_seen_at]) %></dd>
      </div>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.sessions.latest_method") %></dt>
        <dd class="token-text-base"><%= active_sessions[:latest_sign_in_method].presence || "-" %></dd>
      </div>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
        <dt class="text-xs font-semibold token-text-muted"><%= t("admin.users.show.sessions.latest_ip") %></dt>
        <dd class="font-mono token-text-base"><%= active_sessions[:latest_ip].presence || "-" %></dd>
      </div>
    </dl>

    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead class="token-text-muted">
          <tr class="border-b token-border-soft">
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.show.sessions.started") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.show.sessions.last_seen") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.show.sessions.method") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.show.sessions.ip") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.show.sessions.user_agent") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.show.sessions.version") %></th>
          </tr>
        </thead>
        <tbody>
          <% active_sessions[:recent].each do |session_record| %>
            <tr class="border-b token-border-soft">
              <td class="px-3 py-3 whitespace-nowrap"><%= timestamp_label.call(session_record[:started_at]) %></td>
              <td class="px-3 py-3 whitespace-nowrap"><%= timestamp_label.call(session_record[:last_seen_at]) %></td>
              <td class="px-3 py-3"><%= session_record[:sign_in_method].presence || "-" %></td>
              <td class="px-3 py-3 font-mono"><%= session_record[:ip_address].presence || "-" %></td>
              <td class="max-w-md truncate px-3 py-3"><%= session_record[:user_agent].presence || "-" %></td>
              <td class="px-3 py-3 font-mono"><%= session_record[:session_version] %></td>
            </tr>
          <% end %>

          <% if active_sessions[:recent].empty? %>
            <tr>
              <td colspan="6" class="px-3 py-10 text-center text-sm token-text-muted"><%= t("admin.users.show.sessions.empty") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4">
      <h2 class="text-lg font-bold token-text-base"><%= t("admin.users.show.operations.title") %></h2>
      <p class="text-sm token-text-muted"><%= t("admin.users.show.operations.description") %></p>
    </div>

    <% if record[:admin] %>
      <p class="rounded-lg border token-border-soft token-bg-card-subtle p-4 text-sm token-text-muted">
        <%= t("admin.users.show.operations.admin_forbidden") %>
      </p>
    <% elsif record[:id] == current_user.id %>
      <p class="rounded-lg border token-border-soft token-bg-card-subtle p-4 text-sm token-text-muted">
        <%= t("admin.users.show.operations.self_forbidden") %>
      </p>
    <% elsif !admin_passkey_reauthenticated? %>
      <div class="rounded-lg border token-border-soft token-bg-card-subtle p-4">
        <p class="mb-3 text-sm token-text-muted"><%= t("admin.users.show.operations.reauthentication_required") %></p>
        <%= link_to t("admin.users.show.operations.reauthentication_link"),
              new_admin_passkey_reauthentication_path(return_to: admin_user_path(record[:id])),
              class: "inline-flex min-h-10 items-center justify-center rounded-lg px-4 text-sm font-semibold token-bg-primary token-text-inverse hover:opacity-90" %>
      </div>
    <% else %>
      <div class="grid gap-4 lg:grid-cols-2">
        <% if record[:locked] %>
          <div class="rounded-lg border token-border-soft token-bg-card-subtle p-4">
            <h3 class="mb-2 text-base font-bold token-text-base"><%= t("admin.users.show.operations.unlock.title") %></h3>
            <p class="mb-4 text-sm token-text-muted"><%= t("admin.users.show.operations.unlock.description") %></p>
            <%= form_with url: unlock_operation_admin_user_path(record[:id]), method: :post, local: true, class: "space-y-3" do |form| %>
              <div class="space-y-1">
                <%= form.label :reason, t("admin.users.show.operations.reason_label"), class: "text-xs font-semibold token-text-muted" %>
                <%= form.text_area :reason, rows: 3, required: true, class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 text-sm token-text-base" %>
              </div>
              <div class="space-y-1">
                <%= form.label :confirmation, t("admin.users.show.operations.unlock.confirmation_label"), class: "text-xs font-semibold token-text-muted" %>
                <%= form.text_field :confirmation, required: true, class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 font-mono text-sm token-text-base" %>
              </div>
              <%= render "shared/ui/actions/button",
                    label: t("admin.users.show.operations.unlock.submit"),
                    type: "submit",
                    size: :compact,
                    icon: "lock_open" %>
            <% end %>
          </div>
        <% else %>
          <div class="rounded-lg border token-border-soft token-bg-card-subtle p-4">
            <h3 class="mb-2 text-base font-bold token-text-base"><%= t("admin.users.show.operations.lock.title") %></h3>
            <p class="mb-4 text-sm token-text-muted"><%= t("admin.users.show.operations.lock.description") %></p>
            <%= form_with url: lock_operation_admin_user_path(record[:id]), method: :post, local: true, class: "space-y-3" do |form| %>
              <div class="space-y-1">
                <%= form.label :reason, t("admin.users.show.operations.reason_label"), class: "text-xs font-semibold token-text-muted" %>
                <%= form.text_area :reason, rows: 3, required: true, class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 text-sm token-text-base" %>
              </div>
              <div class="space-y-1">
                <%= form.label :confirmation, t("admin.users.show.operations.lock.confirmation_label"), class: "text-xs font-semibold token-text-muted" %>
                <%= form.text_field :confirmation, required: true, class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 font-mono text-sm token-text-base" %>
              </div>
              <%= render "shared/ui/actions/button",
                    label: t("admin.users.show.operations.lock.submit"),
                    type: "submit",
                    size: :compact,
                    icon: "lock" %>
            <% end %>
          </div>
        <% end %>

        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-4">
          <h3 class="mb-2 text-base font-bold token-text-base"><%= t("admin.users.show.operations.passkey_reset.title") %></h3>
          <p class="mb-4 text-sm token-text-muted"><%= t("admin.users.show.operations.passkey_reset.description") %></p>

          <% if record[:passkeys_count].to_i.zero? %>
            <p class="text-sm token-text-muted"><%= t("admin.users.show.operations.passkey_reset.empty") %></p>
          <% else %>
            <%= form_with url: force_passkey_reset_operation_admin_user_path(record[:id]), method: :post, local: true, class: "space-y-3" do |form| %>
              <div class="space-y-1">
                <%= form.label :reason, t("admin.users.show.operations.reason_label"), class: "text-xs font-semibold token-text-muted" %>
                <%= form.text_area :reason, rows: 3, required: true, class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 text-sm token-text-base" %>
              </div>
              <div class="space-y-1">
                <%= form.label :confirmation, t("admin.users.show.operations.passkey_reset.confirmation_label"), class: "text-xs font-semibold token-text-muted" %>
                <%= form.text_field :confirmation, required: true, class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 font-mono text-sm token-text-base" %>
              </div>
              <%= render "shared/ui/actions/button",
                    label: t("admin.users.show.operations.passkey_reset.submit"),
                    type: "submit",
                    size: :compact,
                    icon: "key_off" %>
            <% end %>
          <% end %>
        </div>

        <div class="rounded-lg border token-border-soft token-bg-card-subtle p-4">
          <h3 class="mb-2 text-base font-bold token-text-base"><%= t("admin.users.show.operations.revoke_sessions.title") %></h3>
          <p class="mb-4 text-sm token-text-muted"><%= t("admin.users.show.operations.revoke_sessions.description") %></p>
          <%= form_with url: revoke_sessions_operation_admin_user_path(record[:id]), method: :post, local: true, class: "space-y-3" do |form| %>
            <div class="space-y-1">
              <%= form.label :reason, t("admin.users.show.operations.reason_label"), class: "text-xs font-semibold token-text-muted" %>
              <%= form.text_area :reason, rows: 3, required: true, class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 text-sm token-text-base" %>
            </div>
            <div class="space-y-1">
              <%= form.label :confirmation, t("admin.users.show.operations.revoke_sessions.confirmation_label"), class: "text-xs font-semibold token-text-muted" %>
              <%= form.text_field :confirmation, required: true, class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 font-mono text-sm token-text-base" %>
            </div>
            <%= render "shared/ui/actions/button",
                  label: t("admin.users.show.operations.revoke_sessions.submit"),
                  type: "submit",
                  size: :compact,
                  icon: "logout" %>
          <% end %>
        </div>

        <div class="rounded-lg border token-border-danger token-bg-danger-soft p-4 lg:col-span-2">
          <h3 class="mb-2 text-base font-bold token-text-error"><%= t("admin.users.show.operations.delete.title") %></h3>
          <p class="mb-4 text-sm token-text-error-muted">
            <%= t("admin.users.show.operations.delete.description") %>
          </p>
          <%= form_with url: delete_operation_admin_user_path(record[:id]), method: :post, local: true, class: "space-y-3" do |form| %>
            <div class="space-y-1">
              <%= form.label :reason, t("admin.users.show.operations.reason_label"), class: "text-xs font-semibold token-text-muted" %>
              <%= form.text_area :reason, rows: 3, required: true, class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 text-sm token-text-base" %>
            </div>
            <div class="grid gap-3 md:grid-cols-2">
              <div class="space-y-1">
                <%= form.label :confirmation_email, t("admin.users.show.operations.delete.email_label"), class: "text-xs font-semibold token-text-muted" %>
                <%= form.email_field :confirmation_email, required: true, autocomplete: "off", class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 text-sm token-text-base" %>
              </div>
              <div class="space-y-1">
                <%= form.label :confirmation, t("admin.users.show.operations.delete.confirmation_label"), class: "text-xs font-semibold token-text-muted" %>
                <%= form.text_field :confirmation, required: true, autocomplete: "off", class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 font-mono text-sm token-text-base" %>
              </div>
            </div>
            <%= render "shared/ui/actions/button",
                  label: t("admin.users.show.operations.delete.submit"),
                  type: "submit",
                  variant: :danger,
                  size: :compact,
                  icon: "delete" %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
      <div>
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.users.show.audit_logs.title") %></h2>
        <p class="text-sm token-text-muted"><%= t("admin.users.show.audit_logs.description") %></p>
      </div>
      <%= link_to t("admin.users.show.audit_logs.link"), admin_audit_logs_path(actor_user_id: record[:id]), class: "text-sm font-semibold token-text-brand hover:underline" %>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead class="token-text-muted">
          <tr class="border-b token-border-soft">
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.show.audit_logs.created") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.show.audit_logs.action") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.show.audit_logs.outcome") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.show.audit_logs.target") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.show.audit_logs.detail") %></th>
          </tr>
        </thead>
        <tbody>
          <% @audit_result.records.each do |audit_record| %>
            <tr class="border-b token-border-soft">
              <td class="px-3 py-3 whitespace-nowrap"><%= timestamp_label.call(audit_record[:created_at]) %></td>
              <td class="px-3 py-3 font-mono text-xs"><%= audit_record[:action] %></td>
              <td class="px-3 py-3"><%= audit_record[:outcome] %></td>
              <td class="px-3 py-3"><%= audit_record[:target_uid].presence || "-" %></td>
              <td class="px-3 py-3"><%= link_to t("admin.users.show.audit_logs.detail_link"), admin_audit_log_path(audit_record[:id]), class: "token-text-brand hover:underline" %></td>
            </tr>
          <% end %>

          <% if @audit_result.records.empty? %>
            <tr>
              <td colspan="5" class="px-3 py-10 text-center text-sm token-text-muted"><%= t("admin.users.show.audit_logs.empty") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
