<% content_for :title, t("admin.users.index.title") %>

<%
  filters = @filters || {}
  pagination = admin_index_pagination(@result, filters: filters)
  filter_options = admin_user_filter_options
  filter_label_class = "text-xs font-semibold token-text-muted normal-case tracking-normal px-0"
  filter_wrapper_class = "space-y-1"
  filter_control_class = "rounded-lg text-sm"
%>

<section class="mx-auto w-full max-w-7xl space-y-6 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "admin/shared/navigation" %>

  <%= render "shared/ui/layout/section_header",
        title: t("admin.users.index.title"),
        subtitle: t("admin.users.index.description"),
        title_size: "text-3xl",
        subtitle_size: "text-base" %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4 flex items-center justify-between gap-3">
      <div>
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.users.index.filters.title") %></h2>
        <p class="text-sm token-text-muted"><%= t("admin.users.index.filters.description") %></p>
      </div>

      <%= link_to t("admin.users.index.filters.reset"), admin_users_path, class: "text-sm font-semibold token-text-brand hover:underline" %>
    </div>

    <%= form_with url: admin_users_path, method: :get, local: true, class: "grid gap-4 md:grid-cols-4" do |form| %>
      <%= render "shared/ui/form/text_field",
            f: form,
            attribute: :email,
            label: t("admin.users.index.filters.labels.email"),
            value: filters[:email],
            with_icon: false,
            size: :dense,
            input_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            input_class: filter_control_class %>

      <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :admin,
            label: t("admin.users.index.filters.labels.admin"),
            options: filter_options[:booleans],
            selected: filters[:admin],
            with_icon: false,
            size: :dense,
            select_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            select_class: filter_control_class %>

      <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :guest,
            label: t("admin.users.index.filters.labels.guest"),
            options: filter_options[:booleans],
            selected: filters[:guest],
            with_icon: false,
            size: :dense,
            select_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            select_class: filter_control_class %>

      <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :confirmed,
            label: t("admin.users.index.filters.labels.confirmed"),
            options: filter_options[:booleans],
            selected: filters[:confirmed],
            with_icon: false,
            size: :dense,
            select_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            select_class: filter_control_class %>

      <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :locked,
            label: t("admin.users.index.filters.labels.locked"),
            options: filter_options[:booleans],
            selected: filters[:locked],
            with_icon: false,
            size: :dense,
            select_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            select_class: filter_control_class %>

      <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :has_passkey,
            label: t("admin.users.index.filters.labels.passkey"),
            options: filter_options[:booleans],
            selected: filters[:has_passkey],
            with_icon: false,
            size: :dense,
            select_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            select_class: filter_control_class %>

      <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :limit,
            label: t("admin.users.index.filters.labels.limit"),
            options: filter_options[:limits],
            selected: filters[:limit].presence || pagination.limit.to_s,
            with_icon: false,
            size: :dense,
            select_wrapper_class: filter_wrapper_class,
            label_class: filter_label_class,
            select_class: filter_control_class %>

      <div class="flex items-end gap-3 md:col-span-1">
        <%= render "shared/ui/actions/button",
              label: t("admin.users.index.filters.submit"),
              type: "submit",
              size: :compact,
              icon: "filter_alt" %>
      </div>
    <% end %>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.users.index.results.title") %></h2>
        <p class="text-sm token-text-muted"><%= t("admin.users.index.results.count_summary", total: pagination.total_count, start: pagination.start_number, end: pagination.end_number) %></p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <% if pagination.has_previous? %>
          <%= link_to t("admin.users.index.results.previous"),
                admin_users_path(admin_index_page_params(pagination, :backward)),
                class: "rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-brand hover:underline" %>
        <% else %>
          <span class="rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-muted opacity-60"><%= t("admin.users.index.results.previous") %></span>
        <% end %>

        <% if pagination.has_next? %>
          <%= link_to t("admin.users.index.results.next"),
                admin_users_path(admin_index_page_params(pagination, :forward)),
                class: "rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-brand hover:underline" %>
        <% else %>
          <span class="rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-muted opacity-60"><%= t("admin.users.index.results.next") %></span>
        <% end %>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead class="token-text-muted">
          <tr class="border-b token-border-soft">
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.id") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.email") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.admin") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.guest") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.confirmed") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.locked") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.passkeys") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.receipts") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.sign_in") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.current") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.last") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.created") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.detail") %></th>
          </tr>
        </thead>
        <tbody>
          <% @result.records.each do |record| %>
            <tr class="border-b token-border-soft">
              <td class="px-3 py-3 font-mono text-xs">#<%= record[:id] %></td>
              <td class="px-3 py-3 token-text-base"><%= record[:email] %></td>
              <td class="px-3 py-3"><%= admin_user_boolean_label(record[:admin]) %></td>
              <td class="px-3 py-3"><%= admin_user_boolean_label(record[:guest]) %></td>
              <td class="px-3 py-3"><%= admin_user_boolean_label(record[:confirmed]) %></td>
              <td class="px-3 py-3"><%= admin_user_boolean_label(record[:locked]) %></td>
              <td class="px-3 py-3 font-mono" data-admin-user-passkeys-count="<%= record[:id] %>"><%= record[:passkeys_count] %></td>
              <td class="px-3 py-3 font-mono" data-admin-user-receipts-count="<%= record[:id] %>"><%= record[:receipts_count] %></td>
              <td class="px-3 py-3 font-mono"><%= record.dig(:sign_in, :sign_in_count) %></td>
              <td class="px-3 py-3 whitespace-nowrap"><%= admin_short_timestamp_label(record.dig(:sign_in, :current_sign_in_at)) %></td>
              <td class="px-3 py-3 whitespace-nowrap"><%= admin_short_timestamp_label(record.dig(:sign_in, :last_sign_in_at)) %></td>
              <td class="px-3 py-3 whitespace-nowrap"><%= admin_short_timestamp_label(record.dig(:timestamps, :created_at)) %></td>
              <td class="px-3 py-3"><%= link_to t("admin.users.index.table.detail_link"), admin_user_path(record[:id]), class: "token-text-brand hover:underline" %></td>
            </tr>
          <% end %>

          <% if @result.records.empty? %>
            <tr>
              <td colspan="13" class="px-3 py-10 text-center text-sm token-text-muted"><%= t("admin.users.index.results.empty") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
