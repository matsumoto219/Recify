<% content_for :title, t("admin.users.index.title") %>

<%
  filters = @filters || {}
  query_base = filters.except(:offset).compact_blank
  limit = @result.limit
  offset = @result.offset
  total_count = @result.total_count
  start_number = total_count.zero? ? 0 : offset + 1
  end_number = [ offset + @result.records.size, total_count ].min
  previous_offset = [ offset - limit, 0 ].max
  next_offset = offset + limit
  has_previous = offset.positive?
  has_next = next_offset < total_count
  boolean_options = [[ t("admin.users.common.all"), "" ], [ t("admin.users.common.yes"), "true" ], [ t("admin.users.common.no"), "false" ]]
  limit_options = [ 25, 50, 100 ].map { |value| [ t("admin.users.common.limit_unit", count: value), value.to_s ] }
  admin_select_class = "h-10 w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 text-sm token-text-base"
  boolean_label = ->(value) { value ? t("admin.users.common.yes") : t("admin.users.common.no") }
  timestamp_label = ->(value) { value.present? ? l(value, format: :short) : "-" }
%>

<section class="mx-auto w-full max-w-7xl space-y-6 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "admin/shared/navigation" %>

  <%= render "shared/ui/layout/section_header",
        title: t("admin.users.index.title"),
        subtitle: t("admin.users.index.description"),
        title_size: "text-3xl",
        subtitle_size: "text-base" %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4 flex items-center justify-between gap-3">
      <div>
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.users.index.filters.title") %></h2>
        <p class="text-sm token-text-muted"><%= t("admin.users.index.filters.description") %></p>
      </div>

      <%= link_to t("admin.users.index.filters.reset"), admin_users_path, class: "text-sm font-semibold token-text-brand hover:underline" %>
    </div>

    <%= form_with url: admin_users_path, method: :get, local: true, class: "grid gap-4 md:grid-cols-4" do |form| %>
      <div class="space-y-1">
        <%= form.label :email, t("admin.users.index.filters.labels.email"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.text_field :email, value: filters[:email], class: "w-full rounded-lg token-bg-input token-border-soft border px-3 py-2 text-sm token-text-base" %>
      </div>

      <div class="space-y-1">
        <%= form.label :admin, t("admin.users.index.filters.labels.admin"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.select :admin,
              options_for_select(boolean_options, filters[:admin]),
              {},
              class: admin_select_class %>
      </div>

      <div class="space-y-1">
        <%= form.label :guest, t("admin.users.index.filters.labels.guest"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.select :guest,
              options_for_select(boolean_options, filters[:guest]),
              {},
              class: admin_select_class %>
      </div>

      <div class="space-y-1">
        <%= form.label :confirmed, t("admin.users.index.filters.labels.confirmed"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.select :confirmed,
              options_for_select(boolean_options, filters[:confirmed]),
              {},
              class: admin_select_class %>
      </div>

      <div class="space-y-1">
        <%= form.label :locked, t("admin.users.index.filters.labels.locked"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.select :locked,
              options_for_select(boolean_options, filters[:locked]),
              {},
              class: admin_select_class %>
      </div>

      <div class="space-y-1">
        <%= form.label :has_passkey, t("admin.users.index.filters.labels.passkey"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.select :has_passkey,
              options_for_select(boolean_options, filters[:has_passkey]),
              {},
              class: admin_select_class %>
      </div>

      <div class="space-y-1">
        <%= form.label :limit, t("admin.users.index.filters.labels.limit"), class: "text-xs font-semibold token-text-muted" %>
        <%= form.select :limit,
              options_for_select(limit_options, filters[:limit].presence || limit.to_s),
              {},
              class: admin_select_class %>
      </div>

      <div class="flex items-end gap-3 md:col-span-1">
        <%= render "shared/ui/actions/button",
              label: t("admin.users.index.filters.submit"),
              type: "submit",
              size: :compact,
              icon: "filter_alt" %>
      </div>
    <% end %>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 class="text-lg font-bold token-text-base"><%= t("admin.users.index.results.title") %></h2>
        <p class="text-sm token-text-muted"><%= t("admin.users.index.results.count_summary", total: total_count, start: start_number, end: end_number) %></p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <% if has_previous %>
          <%= link_to t("admin.users.index.results.previous"),
                admin_users_path(query_base.merge(limit: limit, offset: previous_offset)),
                class: "rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-brand hover:underline" %>
        <% else %>
          <span class="rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-muted opacity-60"><%= t("admin.users.index.results.previous") %></span>
        <% end %>

        <% if has_next %>
          <%= link_to t("admin.users.index.results.next"),
                admin_users_path(query_base.merge(limit: limit, offset: next_offset)),
                class: "rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-brand hover:underline" %>
        <% else %>
          <span class="rounded-lg border token-border-soft px-3 py-2 text-sm font-semibold token-text-muted opacity-60"><%= t("admin.users.index.results.next") %></span>
        <% end %>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead class="token-text-muted">
          <tr class="border-b token-border-soft">
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.id") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.email") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.admin") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.guest") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.confirmed") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.locked") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.passkeys") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.receipts") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.sign_in") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.current") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.last") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.created") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("admin.users.index.table.detail") %></th>
          </tr>
        </thead>
        <tbody>
          <% @result.records.each do |record| %>
            <tr class="border-b token-border-soft">
              <td class="px-3 py-3 font-mono text-xs">#<%= record[:id] %></td>
              <td class="px-3 py-3 token-text-base"><%= record[:email] %></td>
              <td class="px-3 py-3"><%= boolean_label.call(record[:admin]) %></td>
              <td class="px-3 py-3"><%= boolean_label.call(record[:guest]) %></td>
              <td class="px-3 py-3"><%= boolean_label.call(record[:confirmed]) %></td>
              <td class="px-3 py-3"><%= boolean_label.call(record[:locked]) %></td>
              <td class="px-3 py-3 font-mono" data-admin-user-passkeys-count="<%= record[:id] %>"><%= record[:passkeys_count] %></td>
              <td class="px-3 py-3 font-mono" data-admin-user-receipts-count="<%= record[:id] %>"><%= record[:receipts_count] %></td>
              <td class="px-3 py-3 font-mono"><%= record.dig(:sign_in, :sign_in_count) %></td>
              <td class="px-3 py-3 whitespace-nowrap"><%= timestamp_label.call(record.dig(:sign_in, :current_sign_in_at)) %></td>
              <td class="px-3 py-3 whitespace-nowrap"><%= timestamp_label.call(record.dig(:sign_in, :last_sign_in_at)) %></td>
              <td class="px-3 py-3 whitespace-nowrap"><%= timestamp_label.call(record.dig(:timestamps, :created_at)) %></td>
              <td class="px-3 py-3"><%= link_to t("admin.users.index.table.detail_link"), admin_user_path(record[:id]), class: "token-text-brand hover:underline" %></td>
            </tr>
          <% end %>

          <% if @result.records.empty? %>
            <tr>
              <td colspan="13" class="px-3 py-10 text-center text-sm token-text-muted"><%= t("admin.users.index.results.empty") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
