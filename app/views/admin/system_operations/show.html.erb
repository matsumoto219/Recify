<% content_for :title, t("admin.system_operations.title") %>

<section class="mx-auto w-full max-w-7xl space-y-6 px-0 md:px-2 py-2 pb-28 md:pb-2">
  <%= render "admin/shared/navigation" %>

  <%= render "shared/ui/layout/section_header",
        title: t("admin.system_operations.title"),
        subtitle: t("admin.system_operations.description"),
        title_size: "text-3xl",
        subtitle_size: "text-base" %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4">
      <h2 class="text-lg font-bold token-text-base"><%= t("admin.system_operations.policy.title") %></h2>
      <p class="text-sm token-text-muted"><%= t("admin.system_operations.policy.description") %></p>
    </div>

    <ul class="grid gap-3 text-sm md:grid-cols-2">
      <% @dashboard.policy_items.each do |item| %>
        <li class="rounded-lg border token-border-soft token-bg-card-subtle p-3 font-mono token-text-base"><%= item %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render "shared/ui/layout/surface_card", padding: :md do %>
      <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.system_operations.receipt_analysis.title") %></h2>
      <div class="space-y-3 text-sm">
        <p class="token-text-muted"><%= t("admin.system_operations.receipt_analysis.description") %></p>
        <div class="flex flex-wrap gap-2">
          <%= link_to t("admin.system_operations.receipt_analysis.runs_link"), admin_receipt_analysis_runs_path, class: "rounded-lg border token-border-soft px-3 py-2 font-semibold token-text-brand hover:underline" %>
          <%= link_to t("admin.system_operations.receipt_analysis.retry_logs_link"), admin_audit_logs_path(audit_action: "receipt_analysis.full_reanalyze"), class: "rounded-lg border token-border-soft px-3 py-2 font-semibold token-text-brand hover:underline" %>
        </div>
      </div>
    <% end %>

    <%= render "shared/ui/layout/surface_card", padding: :md do %>
      <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.system_operations.cleanup.title") %></h2>
      <div class="space-y-3 text-sm">
        <p class="token-text-muted"><%= t("admin.system_operations.cleanup.description") %></p>
        <div class="flex flex-wrap gap-2">
          <%= link_to t("admin.system_operations.cleanup.execute_link"), admin_receipt_analysis_cleanup_path, class: "rounded-lg border token-border-soft px-3 py-2 font-semibold token-text-brand hover:underline" %>
          <%= link_to t("admin.system_operations.cleanup.execute_logs_link"), admin_audit_logs_path(audit_action: "receipt_analysis_runs.cleanup_stale.execute"), class: "rounded-lg border token-border-soft px-3 py-2 font-semibold token-text-brand hover:underline" %>
          <%= link_to t("admin.system_operations.cleanup.preview_logs_link"), admin_audit_logs_path(audit_action: "receipt_analysis_runs.cleanup_stale.dry_run"), class: "rounded-lg border token-border-soft px-3 py-2 font-semibold token-text-brand hover:underline" %>
        </div>
      </div>
    <% end %>
  </div>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <div class="mb-4">
      <h2 class="text-lg font-bold token-text-base"><%= t("admin.system_operations.jobs.title") %></h2>
      <p class="text-sm token-text-muted"><%= t("admin.system_operations.jobs.description") %></p>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
      <div>
        <h3 class="mb-3 text-base font-bold token-text-base"><%= t("admin.system_operations.jobs.queues") %></h3>
        <ul class="grid gap-2 text-sm md:grid-cols-2">
          <% @dashboard.queues.each do |queue| %>
            <li class="min-w-0 max-w-full break-all rounded-lg border token-border-soft token-bg-card-subtle p-3 font-mono token-text-base [overflow-wrap:anywhere]"><%= queue %></li>
          <% end %>
        </ul>
      </div>

      <div>
        <h3 class="mb-3 text-base font-bold token-text-base"><%= t("admin.system_operations.jobs.recurring_tasks") %></h3>
        <div class="space-y-2 text-sm">
          <% @dashboard.recurring_tasks.each do |task| %>
            <div class="min-w-0 max-w-full rounded-lg border token-border-soft token-bg-card-subtle p-3">
              <div class="min-w-0 max-w-full break-all font-mono text-xs token-text-muted [overflow-wrap:anywhere]"><%= task[:key] %></div>
              <div class="min-w-0 max-w-full break-all font-semibold token-text-base [overflow-wrap:anywhere]"><%= task[:class_name] %></div>
              <div class="min-w-0 max-w-full break-all token-text-muted [overflow-wrap:anywhere]"><%= t("admin.system_operations.jobs.recurring_task_detail", queue: task[:queue], schedule: task[:schedule], preview: task[:dry_run]) %></div>
            </div>
          <% end %>

          <% if @dashboard.recurring_tasks.empty? %>
            <p class="rounded-lg border token-border-soft token-bg-card-subtle p-3 token-text-muted"><%= t("admin.system_operations.jobs.empty") %></p>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.system_operations.audit_logs.title") %></h2>
    <div class="space-y-5">
      <div>
        <h3 class="mb-3 text-base font-bold token-text-base"><%= t("admin.system_operations.audit_logs.retention_policy") %></h3>
        <div class="grid gap-2 text-sm md:grid-cols-2">
          <% @dashboard.audit_log_retention_policies.each do |policy| %>
            <div class="rounded-lg border token-border-soft token-bg-card-subtle p-3">
              <div class="font-semibold token-text-base"><%= policy[:label] %></div>
              <div class="mt-1 text-xs token-text-muted">
                <%= t("admin.system_operations.audit_logs.policy_detail", category: policy[:category], retention: policy[:retention], actions_count: policy[:actions_count]) %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div>
        <h3 class="mb-3 text-base font-bold token-text-base"><%= t("admin.system_operations.audit_logs.links") %></h3>
        <div class="grid gap-2 text-sm md:grid-cols-2">
          <% @dashboard.audit_actions.each do |action| %>
            <%= link_to action,
                  admin_audit_logs_path(audit_action: action),
                  class: "min-w-0 max-w-full break-all rounded-lg border token-border-soft token-bg-card-subtle p-3 font-mono token-text-brand [overflow-wrap:anywhere] hover:underline" %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%= render "shared/ui/layout/surface_card", padding: :md do %>
    <h2 class="mb-4 text-lg font-bold token-text-base"><%= t("admin.system_operations.locked_operations.title") %></h2>
    <p class="mb-4 text-sm token-text-muted"><%= t("admin.system_operations.locked_operations.description") %></p>
    <ul class="grid gap-3 text-sm md:grid-cols-2">
      <% @dashboard.locked_future_operations.each do |operation| %>
        <li class="rounded-lg border token-border-soft token-bg-card-subtle p-3 token-text-base"><%= operation %></li>
      <% end %>
    </ul>
  <% end %>

</section>
