<% content_for :title, t("home.meta.title") %>
<% content_for :head do %>
  <%= tag.link rel: "stylesheet", href: home_lp_stylesheet_path %>
<% end %>

<%
  hero_heading_lines = t("home.hero.heading_lines")
  hero_heading_primary = hero_heading_lines.first
  hero_heading_secondary = hero_heading_lines.second
  hero_heading_secondary_segments = t("home.hero.heading_secondary_segments")
  hero_description_paragraphs = t("home.hero.description_paragraphs")
  hero_char_delay_ms = 34
  hero_type_complete_delay_ms =
    (hero_heading_primary.length + hero_heading_secondary.length) * hero_char_delay_ms + 340
  problem_items = t("home.problem.items")
  problem_title_lines = t("home.problem.title_lines")
  feature_items = t("home.features.items")
  feature_title_lines = t("home.features.title_lines")
  how_it_works_steps = t("home.how_it_works.steps")
  how_visual = t("home.how_it_works.visual")
  trust_items = t("home.trust.items")
  before_after = t("home.before_after")
  before_after_title_lines = before_after.fetch(:title_lines)
%>

<div class="home-lp overflow-hidden" data-controller="home-reveal">
  <div class="home-lp-fixed-grid" aria-hidden="true"></div>

  <nav class="home-section-nav" aria-label="<%= t("home.section_nav.label") %>"></nav>

  <section id="home-hero" class="home-hero-section mx-auto grid w-full max-w-7xl items-center gap-12 px-4 pb-18 pt-14 sm:px-6 md:pt-20 lg:px-8 lg:pb-24 xl:grid-cols-2 xl:gap-14" data-home-reveal-target="section" data-home-section-label="<%= t("home.section_nav.hero") %>">
    <div class="min-w-0 max-w-3xl">
      <p class="inline-flex rounded-lg token-brand-soft-bg px-3 py-1.5 text-xs font-bold token-text-brand sm:text-sm">
        <%= t("home.hero.badge") %>
      </p>

      <h1 class="home-hero-heading mt-8 font-black tracking-normal token-text-base">
        <span class="sr-only"><%= hero_heading_lines.join(" ") %></span>
        <span class="home-hero-heading-visual" style="--home-type-char-delay: <%= hero_char_delay_ms %>ms; --home-type-complete-delay: <%= hero_type_complete_delay_ms %>ms" aria-hidden="true">
          <span class="home-hero-heading-line">
            <span class="home-hero-heading-typing-unit">
              <span class="home-hero-heading-unit" data-home-heading-text="<%= hero_heading_primary %>"><%= hero_heading_primary %></span>
              <span class="home-hero-heading-caret" aria-hidden="true"></span>
            </span>
          </span>

          <span class="home-hero-heading-line home-hero-heading-line-accent">
            <span class="home-hero-heading-accent-base">
              <% hero_heading_secondary_segments.each do |segment| %>
                <span class="home-hero-heading-accent-segment">
                  <span class="home-hero-heading-typing-unit">
                    <span class="home-hero-heading-unit" data-home-heading-text="<%= segment %>"><%= segment %></span>
                    <span class="home-hero-heading-caret" aria-hidden="true"></span>
                  </span>
                </span>
              <% end %>
            </span>
          </span>
        </span>
      </h1>

      <div class="mt-7 max-w-2xl space-y-2 text-sm leading-7 token-text-muted sm:text-base">
        <% hero_description_paragraphs.each do |paragraph_lines| %>
          <% lines = Array(paragraph_lines) %>
          <p>
            <% lines.each_with_index do |line, index| %>
              <%= line %><%= tag.br if index < lines.size - 1 %>
            <% end %>
          </p>
        <% end %>
      </div>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <%= render "shared/ui/actions/button",
              as: :link,
              href: new_user_session_path,
              label: t("home.hero.login"),
              variant: :primary,
              size: :lg,
              weight: :bold,
              class: "sm:min-w-[10rem]" %>

        <%= render "shared/ui/actions/button",
              as: :link,
              href: new_user_registration_path,
              label: t("home.hero.sign_up"),
              variant: :secondary,
              size: :lg,
              weight: :bold,
              class: "sm:min-w-[10rem]" %>
      </div>
    </div>

    <%= render "home/hero_mock" %>
  </section>

  <%= render "home/announcements", announcements: @announcements %>

  <section id="home-problem" class="mx-auto w-full max-w-7xl px-4 py-14 sm:px-6 lg:px-8" aria-labelledby="home-problem-title" data-home-reveal-target="section" data-home-section-label="<%= t("home.section_nav.problem") %>">
    <div class="mx-auto max-w-3xl text-center" data-home-reveal-target="item">
      <h2 id="home-problem-title" class="home-lp-section-heading text-2xl font-black tracking-normal token-text-base sm:text-3xl">
        <span class="sr-only"><%= t("home.problem.title") %></span>
        <span class="home-lp-conditional-title" data-home-conditional-break aria-hidden="true">
          <% problem_title_lines.each_with_index do |line, index| %>
            <span><%= line %></span><%= tag.br(class: "home-lp-conditional-break") if index < problem_title_lines.size - 1 %>
          <% end %>
        </span>
        <span class="home-lp-section-accent" aria-hidden="true"></span>
      </h2>
    </div>

    <div class="mt-9 grid gap-5 md:grid-cols-3">
      <% problem_items.each do |item| %>
        <article class="home-lp-card rounded-2xl border token-border-soft token-bg-card p-6 surface-card-shadow" data-home-reveal-target="item">
          <span class="inline-flex h-14 w-14 items-center justify-center rounded-full token-brand-soft-bg token-text-brand">
            <span class="material-symbols-outlined text-3xl" aria-hidden="true"><%= item.fetch(:icon) %></span>
          </span>

          <h3 class="mt-5 text-lg font-bold token-text-base"><%= item.fetch(:title) %></h3>
          <p class="mt-3 text-sm leading-7 token-text-muted"><%= item.fetch(:body) %></p>
        </article>
      <% end %>
    </div>
  </section>

  <section id="home-before-after" class="mx-auto w-full max-w-7xl px-4 py-14 sm:px-6 lg:px-8" aria-labelledby="home-before-after-title" data-home-reveal-target="section" data-home-section-label="<%= t("home.section_nav.before_after") %>">
    <div class="mx-auto max-w-3xl text-center" data-home-reveal-target="item">
      <h2 id="home-before-after-title" class="home-lp-section-heading text-2xl font-black tracking-normal token-text-base sm:text-3xl">
        <span class="sr-only"><%= before_after.fetch(:title) %></span>
        <span class="home-lp-conditional-title" data-home-conditional-break aria-hidden="true">
          <% before_after_title_lines.each_with_index do |line, index| %>
            <span><%= line %></span><%= tag.br(class: "home-lp-conditional-break") if index < before_after_title_lines.size - 1 %>
          <% end %>
        </span>
        <span class="home-lp-section-accent" aria-hidden="true"></span>
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 token-text-muted sm:text-base"><%= before_after.fetch(:lead) %></p>
    </div>

    <div class="home-before-after-grid mt-9 grid gap-5 lg:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] lg:items-stretch">
      <article class="home-lp-card home-before-after-card rounded-2xl border token-border-soft token-bg-card p-6 surface-card-shadow" data-home-reveal-target="item">
        <p class="text-xs font-black uppercase tracking-[0.18em] token-text-muted"><%= before_after.dig(:before, :label) %></p>
        <h3 class="mt-3 text-xl font-black token-text-base"><%= before_after.dig(:before, :title) %></h3>
        <p class="mt-3 text-sm leading-7 token-text-muted"><%= before_after.dig(:before, :body) %></p>

        <div class="mt-6 rounded-xl token-bg-card-subtle p-4">
          <div class="space-y-3">
            <% before_after.dig(:before, :items).each do |item| %>
              <div class="flex items-center gap-3 rounded-lg token-bg-card px-3 py-2 text-sm token-text-muted">
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">remove</span>
                <span><%= item %></span>
              </div>
            <% end %>
          </div>
        </div>
      </article>

      <div class="home-before-after-arrow" aria-hidden="true">
        <span class="material-symbols-outlined">arrow_forward</span>
      </div>

      <article class="home-lp-card home-before-after-card home-before-after-card-after rounded-2xl border token-border-brand-soft token-bg-card p-6 surface-card-shadow" data-home-reveal-target="item">
        <p class="text-xs font-black uppercase tracking-[0.18em] token-text-brand"><%= before_after.dig(:after, :label) %></p>
        <h3 class="mt-3 text-xl font-black token-text-base"><%= before_after.dig(:after, :title) %></h3>
        <p class="mt-3 text-sm leading-7 token-text-muted"><%= before_after.dig(:after, :body) %></p>

        <div class="mt-6 rounded-xl token-brand-soft-bg p-4">
          <div class="space-y-3">
            <% before_after.dig(:after, :items).each do |item| %>
              <div class="flex items-center gap-3 rounded-lg token-bg-card px-3 py-2 text-sm token-text-base">
                <span class="material-symbols-outlined text-[18px] token-text-brand" aria-hidden="true">check</span>
                <span><%= item %></span>
              </div>
            <% end %>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section id="home-features" class="mx-auto w-full max-w-7xl px-4 py-14 sm:px-6 lg:px-8" aria-labelledby="home-features-title" data-home-reveal-target="section" data-home-section-label="<%= t("home.section_nav.features") %>">
    <div class="mx-auto max-w-3xl text-center" data-home-reveal-target="item">
      <h2 id="home-features-title" class="home-lp-section-heading text-2xl font-black tracking-normal token-text-base sm:text-3xl">
        <span class="sr-only"><%= t("home.features.title") %></span>
        <span class="home-lp-conditional-title" data-home-conditional-break aria-hidden="true">
          <% feature_title_lines.each_with_index do |line, index| %>
            <span><%= line %></span><%= tag.br(class: "home-lp-conditional-break") if index < feature_title_lines.size - 1 %>
          <% end %>
        </span>
        <span class="home-lp-section-accent" aria-hidden="true"></span>
      </h2>
    </div>

    <div class="home-lp-snap-track mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-5" data-home-reveal-target="snapTrack">
      <% feature_items.each do |item| %>
        <article class="home-lp-card rounded-2xl border token-border-soft token-bg-card p-6 text-center surface-card-shadow" data-home-reveal-target="item">
          <span class="home-lp-snap-card-icon mx-auto inline-flex h-16 w-16 items-center justify-center rounded-2xl token-brand-soft-bg token-text-brand">
            <span class="material-symbols-outlined text-4xl" aria-hidden="true"><%= item.fetch(:icon) %></span>
          </span>

          <h3 class="mt-5 text-base font-black leading-6 token-text-base"><%= item.fetch(:title) %></h3>
          <p class="mt-3 text-sm leading-7 token-text-muted"><%= item.fetch(:body) %></p>
        </article>
      <% end %>
    </div>
    <div class="home-lp-snap-hint" aria-hidden="true">
      <% feature_items.each_with_index do |_item, index| %>
        <span class="<%= "is-active" if index.zero? %>"></span>
      <% end %>
    </div>
  </section>

  <section id="home-how" class="mx-auto w-full max-w-7xl px-4 py-14 sm:px-6 lg:px-8" aria-labelledby="home-how-title" data-home-reveal-target="section" data-home-section-label="<%= t("home.section_nav.how_it_works") %>">
    <div class="mx-auto max-w-3xl text-center" data-home-reveal-target="item">
      <h2 id="home-how-title" class="home-lp-section-heading text-2xl font-black tracking-normal token-text-base sm:text-3xl">
        <%= t("home.how_it_works.title") %>
        <span class="home-lp-section-accent" aria-hidden="true"></span>
      </h2>
    </div>

    <ol class="mt-9 grid gap-5 lg:grid-cols-3">
      <% how_it_works_steps.each_with_index do |step, index| %>
        <li class="home-lp-card home-step-card relative rounded-2xl border token-border-soft token-bg-card p-6 surface-card-shadow" data-home-reveal-target="item">
          <div class="flex items-center gap-4">
            <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full token-bg-brand-strong text-sm font-black token-text-on-brand">
              <%= index + 1 %>
            </span>
            <h3 class="text-lg font-bold token-text-base"><%= step.fetch(:title) %></h3>
          </div>

          <div class="home-step-visual mt-6" aria-hidden="true">
            <% case index %>
            <% when 0 %>
              <div class="home-step-upload-mock">
                <div class="home-step-phone-frame">
                  <div class="home-step-phone-camera"></div>
                  <div class="home-step-capture-preview">
                    <span class="home-step-capture-title"><%= how_visual.fetch(:receipt_title) %></span>
                    <span class="home-step-capture-line"></span>
                    <span class="home-step-capture-line"></span>
                    <span class="home-step-capture-line"></span>
                  </div>
                </div>
                <div class="home-step-image-sheet">
                  <span class="home-step-image-sheet-title"><%= how_visual.fetch(:image_sheet_title) %></span>
                  <span class="home-step-image-sheet-line"></span>
                  <span class="home-step-image-sheet-line"></span>
                  <span class="home-step-image-sheet-line"></span>
                </div>
                <div class="home-step-upload-chip">
                  <span class="material-symbols-outlined" aria-hidden="true">cloud_upload</span>
                </div>
              </div>
            <% when 1 %>
              <div class="home-step-scan-mock">
                <div class="home-step-scan-frame">
                  <span class="home-step-scan-corner home-step-scan-corner-top-left"></span>
                  <span class="home-step-scan-corner home-step-scan-corner-top-right"></span>
                  <span class="home-step-scan-corner home-step-scan-corner-bottom-left"></span>
                  <span class="home-step-scan-corner home-step-scan-corner-bottom-right"></span>
                  <span class="home-step-scan-line"></span>
                  <div class="home-step-scan-document">
                    <span class="home-step-ocr-badge"><%= how_visual.fetch(:ocr_badge) %></span>
                    <span class="home-step-receipt-line w-3/4"></span>
                    <span class="home-step-receipt-line w-full"></span>
                    <span class="home-step-receipt-line w-5/6"></span>
                  </div>
                </div>
                <div class="home-step-result-card">
                  <% how_visual.fetch(:result_labels).each do |label| %>
                    <span class="home-step-result-row">
                      <span class="home-step-result-check" aria-hidden="true"></span>
                      <span class="home-step-result-label"><%= label %></span>
                    </span>
                  <% end %>
                </div>
              </div>
            <% else %>
              <div class="home-step-save-mock">
                <div class="home-step-review-card">
                  <span class="home-step-review-row">
                    <span class="home-step-review-icon material-symbols-outlined" aria-hidden="true">fact_check</span>
                    <span class="home-step-review-line"></span>
                  </span>
                  <span class="home-step-review-row">
                    <span class="home-step-review-icon material-symbols-outlined" aria-hidden="true">edit_square</span>
                    <span class="home-step-review-line"></span>
                  </span>
                  <span class="home-step-review-row">
                    <span class="home-step-review-icon material-symbols-outlined" aria-hidden="true">inventory_2</span>
                    <span class="home-step-review-line"></span>
                  </span>
                </div>
                <div class="home-step-complete-badge">
                  <span class="material-symbols-outlined" aria-hidden="true">check</span>
                </div>
                <div class="home-step-save-pill">
                  <span class="material-symbols-outlined" aria-hidden="true">save</span>
                  <span><%= t("home.how_it_works.save_label") %></span>
                </div>
              </div>
            <% end %>
          </div>

          <p class="mt-5 text-sm leading-7 token-text-muted"><%= step.fetch(:body) %></p>
        </li>
      <% end %>
    </ol>
  </section>

  <section id="home-trust" class="mx-auto w-full max-w-7xl px-4 py-14 sm:px-6 lg:px-8" aria-labelledby="home-trust-title" data-home-reveal-target="section" data-home-section-label="<%= t("home.section_nav.trust") %>">
    <div class="mx-auto max-w-3xl text-center" data-home-reveal-target="item">
      <h2 id="home-trust-title" class="home-lp-section-heading text-2xl font-black tracking-normal token-text-base sm:text-3xl">
        <%= t("home.trust.title") %>
        <span class="home-lp-section-accent" aria-hidden="true"></span>
      </h2>
    </div>

    <div class="home-lp-snap-track mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-5" data-home-reveal-target="snapTrack">
      <% trust_items.each do |item| %>
        <article class="home-lp-card rounded-2xl border token-border-soft token-bg-card p-6 text-center surface-card-shadow" data-home-reveal-target="item">
          <span class="home-lp-snap-card-icon mx-auto inline-flex h-16 w-16 items-center justify-center rounded-2xl token-brand-soft-bg token-text-brand">
            <span class="material-symbols-outlined text-4xl" aria-hidden="true"><%= item.fetch(:icon) %></span>
          </span>

          <h3 class="mt-5 text-base font-black leading-6 token-text-base"><%= item.fetch(:title) %></h3>
          <p class="mt-3 text-sm leading-7 token-text-muted"><%= item.fetch(:body) %></p>
        </article>
      <% end %>
    </div>
    <div class="home-lp-snap-hint" aria-hidden="true">
      <% trust_items.each_with_index do |_item, index| %>
        <span class="<%= "is-active" if index.zero? %>"></span>
      <% end %>
    </div>
  </section>

  <section id="home-final-cta" class="mx-auto w-full max-w-7xl px-4 pb-28 pt-14 sm:px-6 lg:px-8 lg:pb-32 lg:pt-20" aria-labelledby="home-final-cta-title" data-home-final-cta data-home-reveal-target="section" data-home-section-label="<%= t("home.section_nav.final_cta") %>">
    <div class="home-lp-final-cta-card grid items-center gap-8 rounded-3xl border token-border-soft token-bg-card p-6 surface-card-shadow sm:p-8 lg:grid-cols-[auto_minmax(0,1fr)_auto] lg:p-10" data-home-reveal-target="item">
      <div class="mx-auto flex h-24 w-24 items-center justify-center rounded-full token-brand-soft-bg lg:mx-0">
        <%= render "shared/brand/logo",
              href: nil,
              variant: :icon,
              size: :lg,
              label: "Recify" %>
      </div>

      <div class="text-center lg:text-left">
        <h2 id="home-final-cta-title" class="text-2xl font-black leading-tight tracking-normal token-text-base sm:text-3xl">
          <span class="sr-only"><%= t("home.final_cta.heading_lines").join %></span>
          <span class="home-lp-conditional-title" data-home-conditional-break aria-hidden="true">
            <span><%= t("home.final_cta.heading_lines").first %></span><br class="home-lp-conditional-break">
            <span><%= t("home.final_cta.heading_lines").second %></span>
          </span>
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 token-text-muted sm:text-base lg:mx-0"><%= t("home.final_cta.description") %></p>
      </div>

      <div class="flex flex-col justify-center gap-3 sm:flex-row lg:flex-col">
        <%= render "shared/ui/actions/button",
              as: :link,
              href: new_user_session_path,
              label: t("home.final_cta.login"),
              variant: :primary,
              size: :md,
              weight: :bold,
              class: "sm:min-w-[9rem]" %>

        <%= render "shared/ui/actions/button",
              as: :link,
              href: new_user_registration_path,
              label: t("home.final_cta.sign_up"),
              variant: :secondary,
              size: :md,
              weight: :bold,
              class: "sm:min-w-[9rem]" %>

        <%= render "shared/ui/actions/button",
              as: :link,
              href: contact_path,
              label: t("home.final_cta.contact"),
              variant: :ghost,
              size: :md,
              weight: :bold,
              class: "sm:min-w-[9rem]" %>
      </div>
    </div>
  </section>
</div>
