<%
  receipt = t("home.hero_mock.receipt")
  result = t("home.hero_mock.result")
  detail = t("home.hero_mock.detail")
  status = t("home.hero_mock.status")
  typed_style = ->(delay_ms) { "--home-typed-delay: #{delay_ms}ms" }
%>

<div class="home-hero-mock relative mx-auto w-full min-w-0 max-w-xl" aria-label="<%= t("home.hero_mock.aria_label") %>" data-home-reveal-target="mock">
  <div class="home-hero-mock-grid">
    <article class="home-hero-card home-hero-card-receipt rounded-2xl border token-border-soft token-bg-card p-3 surface-card-shadow sm:p-4">
      <p class="text-sm font-bold token-text-base"><%= receipt.fetch(:title) %></p>

      <div class="home-hero-receipt-scan-target mt-4 rounded-lg token-bg-card-subtle px-4 py-5 text-center sm:px-5 sm:py-6">
        <span class="home-hero-scan-line" aria-hidden="true"></span>
        <p class="text-xl font-black tracking-normal token-text-base">
          <span class="home-hero-typed-value home-hero-typed-value-ocr" style="<%= typed_style.call(900) %>"><%= receipt.fetch(:merchant) %></span>
        </p>
        <p class="mt-2 text-xs token-text-muted">
          <span class="home-hero-typed-value home-hero-typed-value-ocr" style="<%= typed_style.call(1080) %>"><%= receipt.fetch(:datetime) %></span>
        </p>
        <p class="mt-2 text-sm font-bold token-text-base"><%= receipt.fetch(:label) %></p>

        <div class="mt-5 space-y-2 text-left text-xs">
          <% receipt.fetch(:items).each_with_index do |item, index| %>
            <div class="flex items-center justify-between gap-3">
              <span class="truncate token-text-base">
                <span class="home-hero-typed-value home-hero-typed-value-ocr" style="<%= typed_style.call(1220 + (index * 120)) %>"><%= item.fetch(:name) %></span>
              </span>
              <span class="font-semibold token-text-base">
                <span class="home-hero-typed-value home-hero-typed-value-ocr" style="<%= typed_style.call(1280 + (index * 120)) %>"><%= item.fetch(:amount) %></span>
              </span>
            </div>
          <% end %>
        </div>

        <div class="mt-4 border-t token-border-soft pt-3 text-xs">
          <div class="flex items-center justify-between">
            <span class="token-text-muted"><%= receipt.fetch(:subtotal_label) %></span>
            <span class="font-semibold token-text-base">
              <span class="home-hero-typed-value home-hero-typed-value-ocr" style="<%= typed_style.call(1760) %>"><%= receipt.fetch(:total_amount) %></span>
            </span>
          </div>
          <div class="mt-1 flex items-center justify-between">
            <span class="token-text-muted"><%= receipt.fetch(:tax_label) %></span>
            <span class="token-text-muted">¥54</span>
          </div>
          <div class="mt-3 flex items-center justify-between text-sm">
            <span class="font-bold token-text-base"><%= receipt.fetch(:total_label) %></span>
            <span class="font-black token-text-base">
              <span class="home-hero-typed-value home-hero-typed-value-ocr" style="<%= typed_style.call(1880) %>"><%= receipt.fetch(:total_amount) %></span>
            </span>
          </div>
        </div>

        <div class="mx-auto mt-5 flex h-8 max-w-28 items-end justify-center gap-1" aria-hidden="true">
          <% 12.times do |index| %>
            <span class="w-1 rounded-sm bg-current token-text-muted" style="height: <%= 8 + ((index * 7) % 24) %>px"></span>
          <% end %>
        </div>
      </div>
    </article>

    <article class="home-hero-card home-hero-card-result rounded-2xl border token-border-soft token-bg-card p-3 surface-card-shadow sm:p-4">
      <p class="text-sm font-bold token-text-base"><%= result.fetch(:title) %></p>

      <dl class="mt-4 space-y-2 text-xs">
        <% result.fetch(:rows).each_with_index do |row, index| %>
          <div class="grid gap-1 sm:grid-cols-[5.25rem_minmax(0,1fr)] sm:gap-3">
            <dt class="token-text-muted"><%= row.fetch(:label) %></dt>
            <dd class="truncate font-semibold token-text-base">
              <span class="home-hero-typed-value home-hero-typed-value-ocr" style="<%= typed_style.call(1560 + (index * 160)) %>"><%= row.fetch(:value) %></span>
            </dd>
          </div>
        <% end %>
      </dl>
    </article>

    <article class="home-hero-card home-hero-card-detail rounded-2xl border token-border-soft token-bg-card p-3 surface-card-shadow sm:p-4">
      <p class="text-sm font-bold token-text-base"><%= detail.fetch(:title) %></p>

      <div class="mt-4 space-y-3 text-xs">
        <% detail.fetch(:items).each_with_index do |item, index| %>
          <div class="home-hero-line-item flex items-center gap-3" style="--home-detail-index: <%= index %>">
            <span class="home-hero-line-item-marker inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-lg token-brand-soft-bg token-text-brand">
              <span class="material-symbols-outlined text-[15px]" aria-hidden="true">check</span>
            </span>
            <span class="home-hero-line-item-content min-w-0 flex-1">
              <span class="home-hero-line-item-name truncate font-medium token-text-base">
                <span class="home-hero-typed-value home-hero-typed-value-ocr" style="<%= typed_style.call(1680 + (index * 160)) %>"><%= item.fetch(:name) %></span>
              </span>
              <span class="home-hero-line-item-category inline-flex items-center gap-1 rounded-full token-brand-soft-bg px-2 py-0.5 text-[0.6875rem] font-bold token-text-brand">
                <span>AI:</span>
                <span><%= item.fetch(:category) %></span>
              </span>
            </span>
            <span class="home-hero-line-item-value font-bold token-text-base">
              <span class="home-hero-typed-value home-hero-typed-value-ocr" style="<%= typed_style.call(1760 + (index * 160)) %>"><%= item.fetch(:amount) %></span>
            </span>
          </div>
        <% end %>
      </div>

      <p class="mt-4 text-xs font-semibold token-text-brand"><%= detail.fetch(:add) %></p>
    </article>

    <article class="home-hero-card home-hero-card-status rounded-2xl border token-border-soft token-bg-card p-3 surface-card-shadow sm:p-4">
      <p class="text-sm font-bold token-text-base"><%= status.fetch(:title) %></p>

      <ul class="home-hero-status-list mt-4 space-y-2 text-xs">
        <% status.fetch(:items).each_with_index do |item, index| %>
          <li class="home-hero-status-step <%= "home-hero-status-attention" if index == 3 %> flex items-center gap-2" style="--home-status-index: <%= index %>">
            <span class="home-hero-status-icon inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full">
              <span class="home-hero-status-symbol material-symbols-outlined text-[13px]" aria-hidden="true"><%= index == 3 ? "priority_high" : "check" %></span>
            </span>
            <span class="font-medium token-text-base"><%= item %></span>
          </li>
        <% end %>
      </ul>
    </article>
  </div>
</div>
