<% unlock_url_value = unlock_url(@resource, unlock_token: @token) %>

<h2 style="margin: 0 0 24px; color: #131313; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 24px; font-weight: 700; line-height: 1.3;">
  <%= t("auth.mailer.unlock_instructions.title") %>
</h2>

<p style="margin: 0 0 16px; color: #464555; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 15px; line-height: 1.7;">
  <%= t("auth.mailer.greeting", email: @resource.display_email) %>
</p>

<p style="margin: 0 0 16px; color: #464555; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 15px; line-height: 1.7;">
  <%= t("auth.mailer.unlock_instructions.body") %>
</p>

<p style="margin: 0 0 28px; color: #464555; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 15px; line-height: 1.7;">
  <%= t("auth.mailer.unlock_instructions.instructions") %>
</p>

<table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin: 0 0 28px;">
  <tr>
    <td align="center" bgcolor="#4b4dd8" style="border-radius: 6px;">
      <%= link_to t("auth.mailer.unlock_instructions.action"), unlock_url_value, style: "display: inline-block; padding: 14px 24px; color: #ffffff; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 15px; font-weight: 700; line-height: 1.2; text-decoration: none; border-radius: 6px;" %>
    </td>
  </tr>
</table>

<p style="margin: 0 0 8px; color: #6b687a; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 13px; line-height: 1.6;">
  <%= t("auth.mailer.common.fallback_url") %>
</p>

<p style="margin: 0; color: #4b4dd8; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 13px; line-height: 1.6; word-break: break-all;">
  <%= link_to unlock_url_value, unlock_url_value, style: "color: #4b4dd8; text-decoration: underline; word-break: break-all;" %>
</p>
