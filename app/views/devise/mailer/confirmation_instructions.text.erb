<% confirmation_url_value = confirmation_url(@resource, confirmation_token: @token) %>
<% confirmation_expires_in = mailer_duration_text(@resource.class.confirm_within) %>
<% recipient_name = devise_recipient_name(@resource, delivery_email: @email) %>
<%= t("auth.mailer.confirmation_instructions.title") %>

<%= t("auth.mailer.greeting", email: recipient_name) %>

<%= t("auth.mailer.confirmation_instructions.body") %>
<%= confirmation_url_value %>

<% if confirmation_expires_in.present? %>
<%= t("auth.mailer.confirmation_instructions.expires_in", duration: confirmation_expires_in) %>
<% end %>
<%= t("auth.mailer.confirmation_instructions.ignore") %>
