<% reset_password_url_value = edit_password_url(@resource, reset_password_token: @token) %>

<h2 style="margin: 0 0 24px; color: #1c1b1b; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 24px; font-weight: 700; line-height: 1.3;">
  <%= t("auth.mailer.reset_password_instructions.title") %>
</h2>

<p style="margin: 0 0 16px; color: #4d4b5f; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 15px; line-height: 1.7;">
  <%= t("auth.mailer.greeting", email: @resource.display_email) %>
</p>

<p style="margin: 0 0 28px; color: #4d4b5f; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 15px; line-height: 1.7;">
  <%= t("auth.mailer.reset_password_instructions.body") %>
</p>

<table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin: 0 0 28px;">
  <tr>
    <td align="center" bgcolor="#5a5cd6" style="border-radius: 6px; color: #f7f7fb;">
      <%= link_to t("auth.mailer.reset_password_instructions.action"), reset_password_url_value, style: "display: inline-block; background-color: #5a5cd6; padding: 14px 24px; color: #f7f7fb !important; -webkit-text-fill-color: #f7f7fb; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 15px; font-weight: 700; line-height: 1.2; text-decoration: none; border-radius: 6px;" %>
    </td>
  </tr>
</table>

<p style="margin: 0 0 8px; color: #6b687a; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 13px; line-height: 1.6;">
  <%= t("auth.mailer.common.fallback_url") %>
</p>

<p style="margin: 0 0 28px; color: #3130c0; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 13px; line-height: 1.6; word-break: break-all;">
  <%= link_to reset_password_url_value, reset_password_url_value, style: "color: #3130c0; text-decoration: underline; word-break: break-all;" %>
</p>

<p style="margin: 0 0 12px; color: #6b687a; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 13px; line-height: 1.6;">
  <%= t("auth.mailer.reset_password_instructions.ignore") %>
</p>

<p style="margin: 0; color: #6b687a; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 13px; line-height: 1.6;">
  <%= t("auth.mailer.reset_password_instructions.no_change_until_link") %>
</p>
