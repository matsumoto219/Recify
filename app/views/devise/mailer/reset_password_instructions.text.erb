<% reset_password_url_value = edit_password_url(@resource, reset_password_token: @token) %>
<% reset_password_expires_in = mailer_duration_text(@resource.class.reset_password_within) %>
<% recipient_name = devise_recipient_name(@resource, delivery_email: @email.presence || @resource.email) %>
<%= t("auth.mailer.reset_password_instructions.title") %>

<%= t("auth.mailer.greeting", email: recipient_name) %>

<%= t("auth.mailer.reset_password_instructions.body") %>
<%= reset_password_url_value %>

<% if reset_password_expires_in.present? %>
<%= t("auth.mailer.reset_password_instructions.expires_in", duration: reset_password_expires_in) %>
<% end %>
<%= t("auth.mailer.reset_password_instructions.single_use") %>
<%= t("auth.mailer.reset_password_instructions.ignore") %>
<%= t("auth.mailer.reset_password_instructions.no_change_until_link") %>
<%= t("auth.mailer.reset_password_instructions.protect_account") %>
