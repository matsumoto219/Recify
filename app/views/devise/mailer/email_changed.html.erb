<%# TODO: Devise mailer本実装時に auth/devise locale へ接続する %>
<p><%= t("auth.mailer.greeting", email: @email) %></p>

<% if @resource.try(:unconfirmed_email?) %>
  <p><%= t("auth.mailer.email_changed.changing", email: @resource.unconfirmed_email) %></p>
<% else %>
  <p><%= t("auth.mailer.email_changed.changed", email: @resource.display_email) %></p>
<% end %>
