<h2 style="margin: 0 0 24px; color: #1c1b1b; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 24px; font-weight: 700; line-height: 1.3;">
  <%= t("auth.mailer.email_changed.title") %>
</h2>

<p style="margin: 0 0 16px; color: #4d4b5f; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 15px; line-height: 1.7;">
  <%= t("auth.mailer.greeting", email: @email) %>
</p>

<% if @resource.try(:unconfirmed_email?) %>
  <p style="margin: 0; color: #4d4b5f; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 15px; line-height: 1.7;">
    <%= t("auth.mailer.email_changed.changing", email: @resource.unconfirmed_email) %>
  </p>
<% else %>
  <p style="margin: 0; color: #4d4b5f; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 15px; line-height: 1.7;">
    <%= t("auth.mailer.email_changed.changed", email: @resource.display_email) %>
  </p>
<% end %>
