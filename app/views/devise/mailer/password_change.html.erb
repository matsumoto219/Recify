<% recipient_name = devise_recipient_name(@resource, delivery_email: @email.presence || @resource.email) %>

<h2 style="margin: 0 0 24px; color: #1c1b1b; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 24px; font-weight: 700; line-height: 1.3;">
  <%= t("auth.mailer.password_change.title") %>
</h2>

<p style="margin: 0 0 16px; color: #4d4b5f; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 15px; line-height: 1.7;">
  <%= t("auth.mailer.greeting", email: recipient_name) %>
</p>

<p style="margin: 0 0 12px; color: #4d4b5f; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 15px; line-height: 1.7;">
  <%= t("auth.mailer.password_change.body") %>
</p>

<p style="margin: 0; color: #6b687a; font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 13px; line-height: 1.6;">
  <%= t("auth.mailer.password_change.ignore") %>
</p>
