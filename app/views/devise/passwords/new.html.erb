<div class="<%= auth_page_shell_class %>">
  <%= render "shared/ui/layout/ambient_background" unless user_signed_in? %>

  <div class="w-full max-w-[440px] z-10 space-y-8">
    <section aria-labelledby="password-reset-page-title">
      <%= render "shared/ui/miscellaneous/icon" if auth_page_show_icon? %>
      <%= render "shared/ui/layout/section_header",
            title: t("auth.passwords.new.title"),
            subtitle: t("auth.passwords.new.subtitle"),
            title_id: "password-reset-page-title",
            heading_tag: :h1,
            align: :center,
            title_size: "text-2xl md:text-3xl",
            subtitle_size: "text-sm",
            spacing_class: "space-y-3" %>
    </section>

    <%= render "shared/ui/feedback/maintenance_mode_banner" %>

    <%= render "shared/ui/layout/surface_card", title_id: "password-reset-form-title" do %>
      <div class="px-6 md:px-10 pt-6 md:pt-10 pb-6 md:pb-10 space-y-6">
        <h2 id="password-reset-form-title" class="sr-only"><%= t("auth.passwords.new.form_title") %></h2>

        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-6" }) do |f| %>

          <%= render "shared/ui/form/text_field",
                f: f,
                attribute: :email,
                label: t("auth.passwords.new.fields.email"),
                icon: "mail",
                field_type: :email_field,
                placeholder: t("auth.passwords.new.fields.email_placeholder"),
                autocomplete: "email",
                autofocus: true,
                required: true,
                size: :prominent,
                label_class: "text-xs font-bold uppercase tracking-widest block px-1",
                error_message_class: "px-1 text-xs leading-relaxed" %>

          <%= render "shared/bot_protection/turnstile_widget" %>

          <%= render "shared/ui/actions/button",
                label: t("auth.passwords.new.buttons.submit"),
                type: "submit",
                variant: :primary,
                size: :lg,
                weight: :bold,
                radius: :lg,
                full_width: true,
                disable_with: t("auth.passwords.new.buttons.submitting") %>
        <% end %>

        <%= render "shared/ui/layout/section_divider", variant: :gradient, class: "mt-10 mb-10" %>

        <%= render "shared/ui/navigation/navigation_link",
              path: new_session_path(resource_name),
              text: t("auth.passwords.new.back_to_login"),
              arrow: :left %>
      </div>
    <% end %>
  </div>
</div>
