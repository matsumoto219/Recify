<main class="min-h-screen flex items-center justify-center p-6 md:p-8 relative overflow-hidden">
  <%= render "shared/ui/ambient_background" %>

  <div class="w-full max-w-[440px] z-10 space-y-8">
    <section aria-labelledby="password-reset-page-title">
      <%= render "shared/ui/icon" %>
      <%= render "shared/ui/section_header",
            title: "パスワード再設定",
            subtitle: "登録したメールアドレスを入力してください",
            title_id: "password-reset-page-title",
            align: :center,
            title_size: "text-3xl",
            subtitle_size: "text-sm",
            spacing_class: "space-y-3" %>
    </section>

    <%= render "shared/ui/surface_card", title_id: "password-reset-form-title" do %>
      <div class="px-6 md:px-10 pt-6 md:pt-10 pb-6 md:pb-10 space-y-6">
        <h2 id="password-reset-form-title" class="sr-only">パスワード再設定フォーム</h2>

        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-6" }) do |f| %>

          <%= render "shared/ui/text_field",
                f: f,
                attribute: :email,
                label: "メールアドレス",
                icon: "mail",
                field_type: :email_field,
                placeholder: "your@email.com",
                autocomplete: "email",
                autofocus: true,
                required: true,
                size: :prominent,
                label_class: "text-xs font-bold uppercase tracking-widest block px-1",
                error_message_class: "px-1 text-xs leading-relaxed" %>

          <%= render "shared/ui/button",
                label: "再設定メールを送信",
                type: "submit",
                variant: :primary,
                size: :lg,
                weight: :bold,
                radius: :lg,
                full_width: true,
                disable_with: "送信中..." %>
        <% end %>

        <%= render "shared/ui/section_divider", variant: :gradient, class: "mt-10 mb-10" %>

        <%= render "shared/ui/navigation_link",
              path: new_session_path(resource_name),
              text: "ログインに戻る",
              arrow: :left %>
      </div>
    <% end %>
  </div>
</main>
