<main class="min-h-screen flex items-center justify-center p-6 md:p-8 relative overflow-hidden">
  <%= render "shared/ui/ambient_background" %>

  <div class="w-full max-w-[440px] z-10 space-y-8">
    <section aria-labelledby="password-reset-page-title">
      <%= render "shared/auth/icon" %>
      <%= render "shared/auth/header",
            title: "パスワード再設定",
            subtitle: "登録したメールアドレスを入力してください",
            title_id: "password-reset-page-title" %>
    </section>

    <%= render "shared/auth/card", title_id: "password-reset-form-title" do %>
      <h2 id="password-reset-form-title" class="sr-only">パスワード再設定フォーム</h2>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-6" }) do |f| %>

        <%= render "shared/auth/text_field",
              f: f,
              attribute: :email,
              label: "メールアドレス",
              icon: "mail",
              field_type: :email_field,
              placeholder: "your@email.com",
              autocomplete: "email",
              autofocus: true,
              required: true,
              input_class: "pl-11 py-3 text-sm placeholder:text-[#393939] focus:ring-[#C0C1FF]/40" %>

        <%= render "shared/auth/primary_button",
              f: f,
              label: "再設定メールを送信" %>
      <% end %>

      <%= render "shared/auth/separator" %>

      <%= render "shared/auth/navigation_link",
            path: new_session_path(resource_name),
            text: "ログインに戻る",
            arrow: :left %>
    <% end %>

    <%# TODO: フッターブランディングは必要性を確認して、認証画面共通化時に残すか削除するか決める %>
    <div class="text-center opacity-50">
      <span class="text-xs font-bold tracking-[0.2em] text-[#C7C4D8]">RECIFY ARCHIVE SYSTEM</span>
    </div>
  </div>

  <%# TODO: テクスチャ装飾は必要性を確認し、認証画面共通化時に扱いを決める %>
</main>
