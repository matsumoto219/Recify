<div class="min-h-screen flex items-center justify-center p-6 md:p-8 relative overflow-hidden">
  <%= render "shared/ui/layout/ambient_background" %>

  <div class="w-full max-w-[440px] z-10 space-y-8">
    <section aria-labelledby="password-edit-page-title">
      <%= render "shared/ui/miscellaneous/icon" %>
      <%= render "shared/ui/layout/section_header",
            title: t("auth.passwords.edit.title"),
            subtitle: t("auth.passwords.edit.subtitle"),
            title_id: "password-edit-page-title",
            align: :center,
            title_size: "text-3xl",
            subtitle_size: "text-sm",
            spacing_class: "space-y-3" %>
    </section>

    <%= render "shared/ui/layout/surface_card", title_id: "password-edit-form-title" do %>
      <div class="px-6 md:px-10 pt-6 md:pt-10 pb-6 md:pb-10 space-y-6">
        <h2 id="password-edit-form-title" class="sr-only"><%= t("auth.passwords.edit.form_title") %></h2>

        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
          <%= f.hidden_field :reset_password_token %>

          <div class="space-y-2">
            <div class="flex items-center justify-between gap-3">
              <%= f.label :password, t("auth.passwords.edit.fields.password"), class: "text-xs font-semibold uppercase tracking-widest token-text-muted ml-1 block" %>
              <% if @minimum_password_length %>
                <p class="text-[11px] token-text-subtle mr-1"><%= t("auth.passwords.edit.fields.minimum_password_length", count: @minimum_password_length) %></p>
              <% end %>
            </div>

            <%= render "shared/ui/form/text_field",
                  f: f,
                  attribute: :password,
                  label: t("auth.passwords.edit.fields.password"),
                  icon: "lock",
                  field_type: :password_field,
                  placeholder: "••••••••",
                  autocomplete: "new-password",
                  autofocus: true,
                  show_label: false,
                  size: :prominent,
                  error_message_class: "px-1 text-xs leading-relaxed" %>
          </div>

          <%= render "shared/ui/form/text_field",
                f: f,
                attribute: :password_confirmation,
                label: t("auth.passwords.edit.fields.password_confirmation"),
                icon: "lock",
                field_type: :password_field,
                placeholder: "••••••••",
                autocomplete: "new-password",
                size: :prominent,
                label_class: "text-xs font-bold uppercase tracking-widest block px-1",
                error_message_class: "px-1 text-xs leading-relaxed" %>

          <div class="pt-4">
            <%= render "shared/ui/actions/button",
                  label: t("auth.passwords.edit.buttons.submit"),
                  type: "submit",
                  variant: :primary,
                  size: :lg,
                  weight: :bold,
                  radius: :lg,
                  full_width: true,
                  disable_with: t("auth.passwords.edit.buttons.submitting") %>
          </div>
        <% end %>

        <%= render "shared/ui/layout/section_divider", variant: :gradient, class: "mt-10 mb-10" %>

        <%= render "shared/ui/navigation/navigation_link",
              path: new_session_path(resource_name),
              text: t("auth.passwords.edit.back_to_login"),
              arrow: :left %>
      </div>
    <% end %>
  </div>
</div>
