<main class="min-h-screen flex items-center justify-center p-4 md:p-8 relative overflow-hidden">
  <%# TODO: 背景ぼかしは shared/_ambient_background に切り出して共通化する
      - ログイン / 新規登録 / パスワード再設定で使い回す
      - このページからは削除予定
      - render "shared/ambient_background" に置き換える
  %>
  <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-[#C0C1FF]/5 blur-[120px]"></div>
  <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full bg-[#4B4DD8]/5 blur-[120px]"></div>

  <div class="w-full max-w-[440px] z-10 space-y-8">
    <section class="text-center space-y-3" aria-labelledby="login-page-title">
      <div class="flex justify-center mb-6">
        <div class="h-12 w-12 rounded-xl bg-gradient-to-br from-[#C0C1FF] to-[#4B4DD8] flex items-center justify-center shadow-lg shadow-[#C0C1FF]/20" aria-hidden="true">
          <span class="material-symbols-outlined text-black text-3xl" style="font-size: 32px; font-variation-settings: 'FILL' 1;">receipt_long</span>
        </div>
      </div>

      <h1 id="login-page-title" class="text-3xl font-bold tracking-tight text-[#E5E2E1]">ログイン</h1>
      <p class="text-[#C7C4D8] text-sm">Recify にログインしてレシート管理を続けましょう</p>
    </section>

    <section class="bg-[#201F1F] rounded-xl p-6 md:p-8 shadow-2xl space-y-6" aria-labelledby="login-form-title">
      <h2 id="login-form-title" class="sr-only">ログインフォーム</h2>

      <%# TODO: バリデーションエラー表示の追加
          - deviseのresource.errorsを表示
          - _error_messages partialと統合
          - flashとの役割分離を整理
      %>
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
        <div class="space-y-2">
          <%= f.label :email, "メールアドレス", class: "text-xs font-bold text-[#C7C4D8] uppercase tracking-widest block px-1" %>
          <div class="relative group">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#C7C4D8] group-focus-within:text-[#C0C1FF] transition-colors text-xl" aria-hidden="true">mail</span>
            <%= f.email_field :email,
                  autofocus: true,
                  autocomplete: "email",
                  placeholder: "メールアドレスを入力",
                  class: "w-full bg-[#0E0E0E] border-none rounded-lg py-3.5 pl-12 pr-4 text-[#E5E2E1] placeholder:text-zinc-600 focus:ring-2 focus:ring-[#C0C1FF]/50 transition-all outline-none" %>
          </div>
        </div>

        <div class="space-y-2">
          <div class="flex justify-between items-center px-1 gap-3">
            <%= f.label :password, "パスワード", class: "text-xs font-bold text-[#C7C4D8] uppercase tracking-widest block" %>
            <%= link_to "パスワードをお忘れですか？", new_password_path(resource_name), class: "text-xs text-[#C0C1FF] hover:text-white transition-colors whitespace-nowrap" %>
          </div>

          <div class="relative group">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#C7C4D8] group-focus-within:text-[#C0C1FF] transition-colors text-xl" aria-hidden="true">lock</span>
            <%= f.password_field :password,
                  autocomplete: "current-password",
                  placeholder: "パスワードを入力",
                  class: "w-full bg-[#0E0E0E] border-none rounded-lg py-3.5 pl-12 pr-4 text-[#E5E2E1] placeholder:text-zinc-600 focus:ring-2 focus:ring-[#C0C1FF]/50 transition-all outline-none" %>
          </div>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center gap-3 px-1">
            <%= f.check_box :remember_me, class: "rounded border-white/20 bg-[#0E0E0E] text-[#4B4DD8] focus:ring-[#C0C1FF]/50" %>
            <%= f.label :remember_me, "ログイン状態を保持する", class: "text-sm text-[#C7C4D8]" %>
          </div>
        <% end %>

        <div class="space-y-4">
          <%= f.submit "ログイン", class: "w-full py-4 bg-gradient-to-r from-[#C0C1FF] to-[#4B4DD8] text-black font-bold rounded-lg hover:brightness-110 active:scale-[0.98] transition-all shadow-lg shadow-[#C0C1FF]/10 cursor-pointer" %>
        </div>
      <% end %>

      <section class="text-center pt-2" aria-label="新規登録案内">
        <p class="text-sm text-[#C7C4D8]">
          アカウントをお持ちではありませんか？
          <%= link_to "新規登録", new_registration_path(resource_name), class: "text-[#C0C1FF] font-medium hover:underline underline-offset-4 ml-1" %>
        </p>
      </section>

      <div class="relative py-2 flex items-center" aria-hidden="true">
        <div class="flex-grow border-t border-white/10"></div>
        <span class="flex-shrink mx-4 text-xs font-bold text-zinc-500 uppercase tracking-widest">または</span>
        <div class="flex-grow border-t border-white/10"></div>
      </div>

      <section class="space-y-4" aria-labelledby="guest-login-title">
        <h3 id="guest-login-title" class="sr-only">ゲストログイン</h3>

        <%# TODO: ゲストログイン機能の本実装
            - 実際のルート（例: guest_sign_in_path）にlink_toで接続する
            - buttonではなくlink_toへ変更
            - 認証処理（Devise or 独自controller）と連携
            - 成功時はレシート一覧へリダイレクト
            - 失敗時はflashエラー表示
        %>
        <button type="button" class="w-full py-3.5 bg-[#353534] text-[#E5E2E1] font-medium rounded-lg hover:bg-[#393939] active:scale-[0.98] transition-all border border-white/10 flex items-center justify-center gap-2 opacity-70 cursor-not-allowed">
          <span class="material-symbols-outlined text-xl" aria-hidden="true">person_search</span>
          <span>ゲストとして試す</span>
        </button>

        <%# TODO: ゲストユーザー仕様の最終文言調整
            - 7日間未使用で削除など、正確な仕様に合わせる
            - 将来の仕様変更に対応できるようI18n化する
        %>
        <p class="text-center text-[11px] text-zinc-500 leading-relaxed">
          一部機能をすぐに体験できます。<br>
          一定期間利用がない場合、データは自動的に削除されます。
        </p>
      </section>
    </section>
  </div>
</main>
