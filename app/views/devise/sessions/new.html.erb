<div class="min-h-screen flex items-center justify-center p-6 md:p-8 relative overflow-hidden">
  <%= render "shared/ui/layout/ambient_background" %>

  <div class="w-full max-w-[440px] z-10 space-y-8">
    <section aria-labelledby="login-page-title">
      <%= render "shared/ui/miscellaneous/icon" %>
      <%= render "shared/ui/layout/section_header",
            title: t("auth.sessions.title"),
            subtitle: t("auth.sessions.subtitle"),
            title_id: "login-page-title",
            align: :center,
            title_size: "text-3xl",
            subtitle_size: "text-sm",
            spacing_class: "space-y-3" %>
    </section>

    <%= render "shared/ui/layout/surface_card", title_id: "login-form-title" do %>
      <div
        class="px-6 md:px-10 pt-6 md:pt-10 pb-6 md:pb-10 space-y-6"
        data-controller="passkey-session"
        data-passkey-session-options-url-value="<%= users_passkey_sessions_options_path %>"
        data-passkey-session-create-url-value="<%= users_passkey_sessions_path %>"
        data-passkey-session-unsupported-message-value="<%= t("auth.sessions.passkey.messages.unsupported") %>"
        data-passkey-session-canceled-message-value="<%= t("auth.sessions.passkey.messages.canceled") %>"
        data-passkey-session-failure-message-value="<%= t("auth.sessions.passkey.messages.failure") %>"
        data-passkey-session-request-failed-message-value="<%= t("auth.sessions.passkey.messages.request_failed") %>"
        data-passkey-session-conditional-value="true">
        <h2 id="login-form-title" class="sr-only"><%= t("auth.sessions.form_title") %></h2>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
          <%= render "shared/ui/form/text_field",
                f: f,
                attribute: :email,
                label: t("auth.sessions.fields.email"),
                icon: "mail",
                field_type: :email_field,
                placeholder: t("auth.sessions.fields.email_placeholder"),
                autocomplete: "username webauthn",
                autofocus: true,
                size: :prominent,
                label_class: "text-xs font-bold uppercase tracking-widest block px-1",
                error_message_class: "px-1 text-xs leading-relaxed" %>

          <div class="space-y-2">
            <div class="flex justify-between items-center px-1 gap-3">
              <%= f.label :password, t("auth.sessions.fields.password"), class: "text-xs font-bold token-text-muted uppercase tracking-widest block" %>
              <%= link_to t("auth.sessions.forgot_password"), new_password_path(resource_name), class: "text-xs token-text-brand hover:token-text-base transition-colors whitespace-nowrap" %>
            </div>

            <%= render "shared/ui/form/text_field",
                  f: f,
                  attribute: :password,
                  label: t("auth.sessions.fields.password"),
                  icon: "lock",
                  field_type: :password_field,
                  placeholder: t("auth.sessions.fields.password_placeholder"),
                  autocomplete: "current-password",
                  show_label: false,
                  size: :prominent,
                  error_message_class: "px-1 text-xs leading-relaxed" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="flex items-center gap-3 px-1">
              <%= f.check_box :remember_me, class: "rounded token-checkbox" %>
              <%= f.label :remember_me, t("auth.sessions.remember_me"), class: "text-sm token-text-muted" %>
            </div>
          <% end %>

          <div class="space-y-4">
            <%= render "shared/ui/actions/button",
                  label: t("auth.sessions.submit"),
                  type: "submit",
                  variant: :primary,
                  size: :lg,
                  weight: :bold,
                  radius: :lg,
                  full_width: true,
                  disable_with: t("auth.sessions.submitting") %>
          </div>
        <% end %>

        <section class="space-y-3">
          <p class="hidden px-1 text-xs leading-relaxed token-text-error" data-passkey-session-target="error"></p>
          <%= render "shared/ui/actions/button",
                label: t("auth.sessions.passkey.button"),
                type: "button",
                variant: :secondary,
                size: :lg,
                radius: :lg,
                full_width: true,
                icon: "passkey",
                data: {
                  action: "click->passkey-session#login",
                  passkey_session_target: "button"
                } %>
        </section>

        <section class="text-center pt-2" aria-label="<%= t("auth.sessions.sign_up.aria_label") %>">
          <p class="flex flex-col items-center gap-1 text-sm token-text-muted sm:block">
            <span><%= t("auth.sessions.sign_up.prompt") %></span>
            <%= link_to t("auth.sessions.sign_up.link"), new_registration_path(resource_name), class: "token-text-brand font-medium hover:underline underline-offset-4 sm:ml-1" %>
          </p>
        </section>

        <%= render "shared/ui/layout/section_divider", variant: :gradient, label: t("auth.sessions.divider"), class: "mt-8 mb-8" %>

        <section class="space-y-4" aria-labelledby="guest-login-title">
          <h3 id="guest-login-title" class="sr-only"><%= t("auth.sessions.guest.title") %></h3>

          <%= button_to guest_sign_in_path,
                        method: :post,
                        class: "w-full border-0 bg-transparent p-0 cursor-pointer" do %>
            <%= render "shared/ui/actions/button",
                  as: :content,
                  label: t("auth.sessions.guest.button"),
                  variant: :secondary,
                  size: :lg,
                  full_width: true,
                  icon: "person_search",
                  class: "py-3.5" %>
          <% end %>

          <%# TODO: ゲストユーザー仕様の最終文言調整
              - 7日間未使用で削除など、正確な仕様に合わせる
              - 将来の仕様変更に対応できるようI18n化する %>
          <p class="text-center text-[11px] token-text-subtle leading-relaxed">
            <%= t("auth.sessions.guest.description_line1") %><br>
            <%= t("auth.sessions.guest.description_line2") %>
          </p>
        </section>
      </div>
    <% end %>
  </div>
</div>
