<main class="min-h-screen flex items-center justify-center p-6 md:p-8 relative overflow-hidden">
  <%= render "shared/ui/ambient_background" %>

  <div class="w-full max-w-[440px] z-10 space-y-8">
    <section aria-labelledby="registration-page-title">
      <%= render "shared/auth/icon" %>
      <%= render "shared/auth/header",
            title: "新規登録",
            subtitle: "Recifyを始めましょう",
            title_id: "registration-page-title" %>
    </section>

    <%= render "shared/auth/card", title_id: "registration-form-title" do %>
      <h2 id="registration-form-title" class="sr-only">新規登録フォーム</h2>

      <%# TODO: devise/shared/error_messages と共通の _error_messages partial の役割を整理する %>
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <%= render "shared/auth/text_field",
              f: f,
              attribute: :email,
              label: "メールアドレス",
              icon: "mail",
              field_type: :email_field,
              placeholder: "example@email.com",
              autocomplete: "email",
              autofocus: true,
              input_class: "rounded-xl py-4 placeholder:text-[#918FA1]/50 focus:ring-[#C0C1FF]/20" %>

        <div class="space-y-2">
          <div class="flex items-center justify-between gap-3">
            <%= f.label :password, "パスワード", class: "text-xs font-semibold uppercase tracking-widest text-[#C7C4D8]/80 ml-1 block" %>
            <% if @minimum_password_length %>
              <p class="text-[11px] text-[#C7C4D8]/60 mr-1"><%= @minimum_password_length %>文字以上</p>
            <% end %>
          </div>
          <%= render "shared/auth/text_field",
                f: f,
                attribute: :password,
                label: "パスワード",
                icon: "lock",
                field_type: :password_field,
                placeholder: "••••••••",
                autocomplete: "new-password",
                show_label: false,
                input_class: "rounded-xl py-4 placeholder:text-[#918FA1]/50 focus:ring-[#C0C1FF]/20" %>
        </div>

        <%= render "shared/auth/text_field",
              f: f,
              attribute: :password_confirmation,
              label: "パスワード確認",
              icon: "lock",
              field_type: :password_field,
              placeholder: "••••••••",
              autocomplete: "new-password",
              input_class: "rounded-xl py-4 placeholder:text-[#918FA1]/50 focus:ring-[#C0C1FF]/20" %>

        <div class="pt-4">
          <%= render "shared/auth/primary_button",
                f: f,
                label: "登録する" %>
        </div>
      <% end %>

      <section class="text-center" aria-label="規約同意案内">
        <%# TODO: 利用規約 / プライバシーポリシーの静的ページ作成後に link_to で接続する %>
        <p class="text-[10px] text-center text-[#C7C4D8]/60 leading-relaxed">
          登録することで、Recifyの
          <span class="underline hover:text-[#C0C1FF] cursor-pointer">利用規約</span>
          および
          <span class="underline hover:text-[#C0C1FF] cursor-pointer">プライバシーポリシー</span>
          に同意したものとみなされます。
        </p>
      </section>

      <%= render "shared/auth/separator" %>
      <section class="text-center space-y-3" aria-label="ログイン案内">
        <p class="text-sm text-[#C7C4D8]">
          すでにアカウントをお持ちですか？
        </p>

        <%= render "shared/auth/navigation_link",
              path: new_session_path(resource_name),
              text: "ログインへ",
              arrow: :right %>
      </section>
    <% end %>
  </div>
</main>
