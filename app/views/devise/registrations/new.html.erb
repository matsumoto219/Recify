<div class="<%= auth_page_shell_class %>">
  <%= render "shared/ui/layout/ambient_background" unless user_signed_in? %>

  <div class="w-full max-w-[440px] z-10 space-y-8" data-controller="legal-dialog">
    <section aria-labelledby="registration-page-title">
      <%= render "shared/ui/miscellaneous/icon" if auth_page_show_icon? %>
      <%= render "shared/ui/layout/section_header",
            title: t("auth.registrations.new.title"),
            subtitle: t("auth.registrations.new.subtitle"),
            title_id: "registration-page-title",
            heading_tag: :h1,
            align: :center,
            title_size: "text-2xl md:text-3xl",
            subtitle_size: "text-sm",
            spacing_class: "space-y-3" %>
    </section>

    <%= render "shared/ui/feedback/maintenance_mode_banner" %>

    <%= render "shared/ui/layout/surface_card", title_id: "registration-form-title" do %>
      <div class="px-6 md:px-10 pt-6 md:pt-10 pb-6 md:pb-10 space-y-6">
        <h2 id="registration-form-title" class="sr-only"><%= t("auth.registrations.new.form_title") %></h2>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
          <%= render "shared/ui/form/text_field",
                f: f,
                attribute: :email,
                label: t("auth.registrations.new.fields.email"),
                icon: "mail",
                field_type: :email_field,
                placeholder: t("auth.registrations.new.fields.email_placeholder"),
                autocomplete: "email",
                autofocus: true,
                required: true,
                size: :prominent,
                label_class: "text-xs font-bold uppercase tracking-widest block px-1",
                error_message_class: "px-1 text-xs leading-relaxed" %>

          <div class="space-y-2">
            <div class="flex items-center justify-between gap-3">
              <%= f.label :password, t("auth.registrations.new.fields.password"), class: "text-xs font-semibold uppercase tracking-widest token-text-muted ml-1 block" %>
              <% if @minimum_password_length %>
                <p class="text-[11px] token-text-subtle mr-1"><%= t("auth.registrations.new.fields.minimum_password_length", count: @minimum_password_length) %></p>
              <% end %>
            </div>
            <%= render "shared/ui/form/text_field",
                  f: f,
                  attribute: :password,
                  label: t("auth.registrations.new.fields.password"),
                  icon: "lock",
                  field_type: :password_field,
                  placeholder: "••••••••",
                  autocomplete: "new-password",
                  required: true,
                  show_label: false,
                  size: :prominent,
                  error_message_class: "px-1 text-xs leading-relaxed" %>
          </div>

          <%= render "shared/ui/form/text_field",
                f: f,
                attribute: :password_confirmation,
                label: t("auth.registrations.new.fields.password_confirmation"),
                icon: "lock",
                field_type: :password_field,
                placeholder: "••••••••",
                autocomplete: "new-password",
                required: true,
                size: :prominent,
                label_class: "text-xs font-bold uppercase tracking-widest block px-1",
                error_message_class: "px-1 text-xs leading-relaxed" %>

          <%
            legal_agreement_errors = resource.errors.full_messages_for(:legal_agreement)
            legal_agreement_error = legal_agreement_errors.first
          %>
          <section aria-label="<%= t("auth.registrations.new.terms.aria_label") %>" class="space-y-2">
            <%
              legal_agreement_input_id = "registration_legal_agreement"
              legal_agreement_label = [
                t("auth.registrations.new.terms.prefix"),
                t("auth.registrations.new.terms.terms"),
                t("auth.registrations.new.terms.connector"),
                t("auth.registrations.new.terms.privacy"),
                t("auth.registrations.new.terms.suffix")
              ].join.squish
              legal_agreement_description_id = "registration-legal-agreement-description"
            %>
            <div class="flex items-start gap-3 rounded-lg border token-border-soft px-4 py-3 text-sm token-text-muted">
              <%= f.check_box :legal_agreement,
                    {
                      id: legal_agreement_input_id,
                      class: "mt-0.5 h-4 w-4 rounded token-checkbox",
                      required: true,
                      aria: {
                        label: legal_agreement_label,
                        describedby: legal_agreement_description_id
                      }
                    },
                    "1",
                    "0" %>
              <p id="<%= legal_agreement_description_id %>" class="min-w-0 leading-relaxed">
                <%= label_tag legal_agreement_input_id,
                      t("auth.registrations.new.terms.prefix"),
                      class: "cursor-pointer" %>
                <%= link_to t("auth.registrations.new.terms.terms"),
                      terms_path,
                      class: "inline-block whitespace-nowrap underline token-hover-text-brand",
                      data: {
                        action: "click->legal-dialog#open",
                        legal_dialog_dialog_param: "terms"
                      } %>
                <%= t("auth.registrations.new.terms.connector") %>
                <%= link_to t("auth.registrations.new.terms.privacy"),
                      privacy_path,
                      class: "inline-block whitespace-nowrap underline token-hover-text-brand",
                      data: {
                        action: "click->legal-dialog#open",
                        legal_dialog_dialog_param: "privacy"
                      } %>
                <%= label_tag legal_agreement_input_id,
                      t("auth.registrations.new.terms.suffix"),
                      class: "cursor-pointer" %>
              </p>
            </div>
            <% if legal_agreement_error.present? %>
              <p class="px-1 text-xs token-text-error leading-relaxed"><%= legal_agreement_error %></p>
            <% end %>
          </section>

          <%= render "shared/bot_protection/turnstile_widget" %>

          <div class="pt-4">
            <%= render "shared/ui/actions/button",
                  label: t("auth.registrations.new.submit"),
                  type: "submit",
                  variant: :primary,
                  size: :lg,
                  weight: :bold,
                  radius: :lg,
                  full_width: true,
                  disable_with: t("auth.registrations.new.submitting") %>
          </div>
        <% end %>

        <%= render "shared/ui/layout/section_divider", variant: :gradient, class: "mt-10 mb-10" %>
        <section class="text-center space-y-3" aria-label="<%= t("auth.registrations.new.login.aria_label") %>">
          <p class="text-sm token-text-muted">
            <%= t("auth.registrations.new.login.prompt") %>
          </p>

          <%= render "shared/ui/navigation/navigation_link",
                path: new_session_path(resource_name),
                text: t("auth.registrations.new.login_link"),
                arrow: :right %>
        </section>
      </div>
    <% end %>

    <%= render layout: "shared/ui/feedback/modal_dialog",
          locals: {
            id: "registration-terms-dialog",
            name: "terms",
            title: t("legal.terms.title")
          } do %>
      <%= render "shared/legal/terms_summary" %>
    <% end %>

    <%= render layout: "shared/ui/feedback/modal_dialog",
          locals: {
            id: "registration-privacy-dialog",
            name: "privacy",
            title: t("legal.privacy.title")
          } do %>
      <%= render "shared/legal/privacy_summary" %>
    <% end %>
  </div>
</div>
