<main class="min-h-screen flex items-center justify-center p-6 md:p-8 relative overflow-hidden">
  <%= render "shared/ui/ambient_background" %>

  <div class="w-full max-w-[440px] z-10 space-y-8">
    <section aria-labelledby="registration-page-title">
      <%= render "shared/ui/icon" %>
      <%= render "shared/ui/section_header",
            title: "新規登録",
            subtitle: "Recifyを始めましょう",
            title_id: "registration-page-title",
            align: :center,
            title_size: "text-3xl",
            subtitle_size: "text-sm",
            spacing_class: "space-y-3" %>
    </section>

    <%= render "shared/ui/surface_card", title_id: "registration-form-title" do %>
      <div class="px-6 md:px-10 pt-6 md:pt-10 pb-6 md:pb-10 space-y-6">
        <h2 id="registration-form-title" class="sr-only">新規登録フォーム</h2>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
          <%= render "shared/ui/text_field",
                f: f,
                attribute: :email,
                label: "メールアドレス",
                icon: "mail",
                field_type: :email_field,
                placeholder: "example@email.com",
                autocomplete: "email",
                autofocus: true,
                size: :prominent,
                label_class: "text-xs font-bold uppercase tracking-widest block px-1",
                error_message_class: "px-1 text-xs leading-relaxed" %>

          <div class="space-y-2">
            <div class="flex items-center justify-between gap-3">
              <%= f.label :password, "パスワード", class: "text-xs font-semibold uppercase tracking-widest token-text-muted ml-1 block" %>
              <% if @minimum_password_length %>
                <p class="text-[11px] token-text-subtle mr-1"><%= @minimum_password_length %>文字以上</p>
              <% end %>
            </div>
            <%= render "shared/ui/text_field",
                  f: f,
                  attribute: :password,
                  label: "パスワード",
                  icon: "lock",
                  field_type: :password_field,
                  placeholder: "••••••••",
                  autocomplete: "new-password",
                  show_label: false,
                  size: :prominent,
                  error_message_class: "px-1 text-xs leading-relaxed" %>
          </div>

          <%= render "shared/ui/text_field",
                f: f,
                attribute: :password_confirmation,
                label: "パスワード確認",
                icon: "lock",
                field_type: :password_field,
                placeholder: "••••••••",
                autocomplete: "new-password",
                size: :prominent,
                label_class: "text-xs font-bold uppercase tracking-widest block px-1",
                error_message_class: "px-1 text-xs leading-relaxed" %>

          <div class="pt-4">
            <%= render "shared/ui/button",
                  label: "登録する",
                  type: "submit",
                  variant: :primary,
                  size: :lg,
                  full_width: true,
                  disable_with: "登録中...",
                  class: "font-bold rounded-lg" %>
          </div>
        <% end %>

        <section class="text-center" aria-label="規約同意案内">
          <%# TODO: 利用規約 / プライバシーポリシーの静的ページ作成後に link_to で接続する %>
          <p class="text-[10px] text-center token-text-subtle leading-relaxed">
            登録することで、Recifyの
            <span class="underline token-hover-text-brand cursor-pointer">利用規約</span>
            および
            <span class="underline token-hover-text-brand cursor-pointer">プライバシーポリシー</span>
            に同意したものとみなされます。
          </p>
        </section>

        <%= render "shared/ui/section_divider", variant: :gradient, class: "mt-10 mb-10" %>
        <section class="text-center space-y-3" aria-label="ログイン案内">
          <p class="text-sm token-text-muted">
            すでにアカウントをお持ちですか？
          </p>

          <%= render "shared/ui/navigation_link",
                path: new_session_path(resource_name),
                text: "ログインへ",
                arrow: :right %>
        </section>
      </div>
    <% end %>
  </div>
</main>
