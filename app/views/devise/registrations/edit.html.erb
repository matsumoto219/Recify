<%
  guest_user = resource.respond_to?(:guest?) && resource.guest?
  primary_href = guest_user ? settings_security_path(anchor: "guest-registration") : settings_security_path
  primary_label = guest_user ? t("auth.registrations.edit.buttons.guest_registration") : t("auth.registrations.edit.buttons.security_settings")
  guidance_title = guest_user ? t("auth.registrations.edit.guest.title") : t("auth.registrations.edit.normal.title")
  guidance_description = guest_user ? t("auth.registrations.edit.guest.description") : t("auth.registrations.edit.normal.description")
%>

<%# Direct-access fallback for /users/edit. Actual profile, email, password, and guest registration updates live in settings pages. %>

<div class="min-h-screen flex items-center justify-center p-6 md:p-8 relative overflow-hidden">
  <div class="w-full max-w-[520px] z-10 space-y-8">
    <section aria-labelledby="edit-registration-title">
      <%= render "shared/ui/miscellaneous/icon" %>
      <%= render "shared/ui/layout/section_header",
            title: t("auth.registrations.edit.title"),
            subtitle: t("auth.registrations.edit.subtitle"),
            title_id: "edit-registration-title",
            align: :center,
            title_size: "text-2xl md:text-3xl",
            subtitle_size: "text-sm",
            spacing_class: "space-y-3" %>
    </section>

    <%= render "shared/ui/layout/surface_card", title_id: "edit-registration-guidance-title" do %>
      <div class="px-6 md:px-10 pt-6 md:pt-10 pb-6 md:pb-10 space-y-7">
        <%= render "shared/ui/layout/section_header",
              icon: guest_user ? "how_to_reg" : "settings",
              title: guidance_title,
              subtitle: guidance_description,
              title_id: "edit-registration-guidance-title",
              title_size: "text-xl",
              subtitle_size: "text-sm",
              spacing_class: "space-y-2" %>

        <%= render "shared/ui/layout/section_divider" %>

        <div class="space-y-3">
          <%= render "shared/ui/actions/button",
                as: :link,
                href: primary_href,
                label: primary_label,
                variant: :primary,
                size: :lg,
                weight: :bold,
                radius: :lg,
                full_width: true,
                icon: guest_user ? "how_to_reg" : "shield",
                trailing_icon: "chevron_right",
                trailing_icon_animated: true %>

          <%= render "shared/ui/actions/button",
                as: :link,
                href: settings_account_path,
                label: t("auth.registrations.edit.buttons.account_settings"),
                variant: :secondary,
                size: :md,
                full_width: true,
                icon: "person",
                trailing_icon: "chevron_right",
                trailing_icon_animated: true %>
        </div>
      </div>
    <% end %>
  </div>
</div>
