<%# TODO: 動線は settings 側を優先し、この画面は直リンク時の受け皿として残す /users/edit %>
<div class="relative min-h-screen overflow-hidden token-bg-page token-text-base">

  <div class="relative z-10 mx-auto flex min-h-screen w-full max-w-[1200px] items-center justify-center px-6 py-10 sm:px-8 lg:px-12">
    <section class="w-full max-w-[560px] space-y-8" aria-labelledby="edit-registration-title">
      <div class="space-y-5 text-center">
        <%= render "shared/ui/layout/section_header",
              title: t("auth.registrations.edit.title"),
              subtitle: t("auth.registrations.edit.subtitle"),
              title_id: "edit-registration-title",
              align: :center,
              title_size: "text-3xl",
              subtitle_size: "text-sm",
              spacing_class: "space-y-3" %>
      </div>

      <%= render "shared/ui/layout/surface_card", title_id: "edit-registration-title" do %>
        <div class="px-6 md:px-10 pt-6 md:pt-10 pb-6 md:pb-10 space-y-6">
          <h2 class="sr-only"><%= t("auth.registrations.edit.form_title") %></h2>

          <%= form_for(resource,
                      as: resource_name,
                      url: registration_path(resource_name),
                      html: { method: :put, class: "space-y-5" }) do |f| %>
            <%= hidden_field_tag :update_context, "registration" %>

            <%= render "shared/ui/form/text_field",
                      f: f,
                      attribute: :email,
                      label: t("auth.registrations.edit.fields.email"),
                      icon: "mail",
                      field_type: :email_field,
                      placeholder: "your@email.com",
                      autocomplete: "email",
                      autofocus: true,
                      value: resource.guest? ? "" : nil,
                      show_label: true,
                      size: :prominent,
                      label_class: "text-xs font-bold uppercase tracking-widest block px-1",
                      error_message_class: "px-1 text-xs leading-relaxed" %>

            <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
              <div class="rounded-2xl border token-border-soft token-state-warning-soft px-4 py-3 text-sm">
                <%= t("auth.registrations.edit.pending_reconfirmation", email: resource.unconfirmed_email) %>
              </div>
            <% end %>

            <%= render "shared/ui/layout/section_divider", class: "mt-8 mb-8" %>

            <%= render "shared/ui/form/text_field",
                      f: f,
                      attribute: :password,
                      label: t("auth.registrations.edit.fields.password"),
                      icon: "lock",
                      field_type: :password_field,
                      placeholder: t("auth.registrations.edit.fields.password_placeholder"),
                      autocomplete: "new-password",
                      show_label: true,
                      size: :prominent,
                      label_class: "text-xs font-bold uppercase tracking-widest block px-1",
                      error_message_class: "px-1 text-xs leading-relaxed" %>

            <% if @minimum_password_length %>
              <p class="px-1 text-xs token-text-muted">
                <%= t("auth.registrations.edit.fields.minimum_password_length", count: @minimum_password_length) %>
              </p>
            <% end %>

            <%= render "shared/ui/form/text_field",
                      f: f,
                      attribute: :password_confirmation,
                      label: t("auth.registrations.edit.fields.password_confirmation"),
                      icon: "verified_user",
                      field_type: :password_field,
                      placeholder: t("auth.registrations.edit.fields.password_confirmation_placeholder"),
                      autocomplete: "new-password",
                      show_label: true,
                      size: :prominent,
                      label_class: "text-xs font-bold uppercase tracking-widest block px-1",
                      error_message_class: "px-1 text-xs leading-relaxed" %>

            <%= render "shared/ui/form/text_field",
                      f: f,
                      attribute: :current_password,
                      label: t("auth.registrations.edit.fields.current_password"),
                      icon: "password",
                      field_type: :password_field,
                      placeholder: t("auth.registrations.edit.fields.current_password_placeholder"),
                      autocomplete: "current-password",
                      show_label: true,
                      size: :prominent,
                      label_class: "text-xs font-bold uppercase tracking-widest block px-1",
                      error_message_class: "px-1 text-xs leading-relaxed" %>

            <p class="px-1 text-xs token-text-muted"><%= t("auth.registrations.edit.current_password_required") %></p>

            <%= render "shared/ui/actions/button",
                      label: t("auth.registrations.edit.buttons.save"),
                      type: "submit",
                      variant: :primary,
                      size: :lg,
                      weight: :bold,
                      radius: :lg,
                      full_width: true,
                      disable_with: t("auth.registrations.edit.buttons.saving") %>

            <p class="text-[11px] token-text-subtle leading-relaxed mt-3">
              <%= t("auth.registrations.edit.settings_hint") %>
            </p>
          <% end %>

          <div class="space-y-5 pt-2">
            <div class="space-y-3">
              <%= render "shared/ui/actions/button",
                        as: :link,
                        href: settings_security_path,
                        label: t("auth.registrations.edit.buttons.security_settings"),
                        variant: :secondary,
                        size: :md,
                        full_width: true %>

              <%= render "shared/ui/actions/button",
                        as: :link,
                        href: settings_path,
                        label: t("auth.registrations.edit.buttons.settings_top"),
                        variant: :ghost,
                        size: :md,
                        full_width: true %>
            </div>
          </div>
        </div>
      <% end %>
    </section>
  </div>
</div>
