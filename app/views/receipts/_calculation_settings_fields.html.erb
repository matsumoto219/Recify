<%#
  レシート計算方式の入力

  必須:
  - form_presenter: 計算条件の表示を提供する presenter
%>

<%= render "shared/ui/layout/surface_card", class: "overflow-hidden" do %>
  <div class="p-6 border-b token-border-soft">
    <%= render "shared/ui/layout/section_header",
          title: t("receipts.form.calculation_settings.title"),
          subtitle: t("receipts.form.calculation_settings.description"),
          icon: "calculate" %>
  </div>
  <div class="p-6 space-y-5">
    <% if form_presenter.calculation_settings_unavailable? %>
      <p class="text-sm token-text-warning" role="status"><%= t("receipts.form.calculation_settings.unavailable") %></p>
    <% end %>
    <% %w[tax_rounding_mode discount_rounding_mode].each do |key| %>
      <div class="flex flex-col items-start justify-between gap-3 md:flex-row md:items-center">
        <p class="text-sm font-bold token-text-base"><%= t("receipts.form.calculation_settings.#{key}") %></p>
        <% if form_presenter.calculation_settings_unavailable? %>
          <span class="token-text-muted"><%= t("receipts.common.not_available") %></span>
        <% else %>
          <%= render "shared/ui/form/segmented_control",
                name: "receipt_calculation_settings[#{key}]",
                value: form_presenter.calculation_setting_value(key),
                options: form_presenter.rounding_mode_options,
                legend: t("receipts.form.calculation_settings.#{key}"),
                size: :sm,
                full_width: true,
                wrapper_class: "md:w-auto",
                data: {
                  action: "change->receipt-form#calculationSettingChanged",
                  receipt_form_calculation_setting: key
                } %>
        <% end %>
      </div>
      <% if receipt.persisted? && form_presenter.calculation_setting_fallback?(key) %>
        <p class="text-xs leading-relaxed token-text-muted"><%= t("receipts.form.calculation_settings.value_fallback") %></p>
      <% end %>
    <% end %>
    <div class="space-y-1 border-t token-border-soft pt-4 text-sm">
      <p class="token-text-base">
        <span class="font-bold"><%= t("receipts.form.calculation_settings.tax_rounding_scope") %>:</span>
        <% if form_presenter.tax_rounding_scope_value.present? %>
          <%= t("receipts.form.calculation_settings.scopes.#{form_presenter.tax_rounding_scope_value}", default: t("receipts.common.not_available")) %>
        <% else %>
          <%= t("receipts.common.not_available") %>
        <% end %>
      </p>
      <% if receipt.persisted? && form_presenter.calculation_setting_fallback?("tax_rounding_scope") %>
        <p class="text-xs leading-relaxed token-text-muted"><%= t("receipts.form.calculation_settings.scope_fallback") %></p>
      <% end %>
    </div>
  </div>
<% end %>
