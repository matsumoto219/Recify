<%#
  レシート処理エラーカード

  必須:
  - receipt: エラー状態を表示するレシートオブジェクト

  任意:
  - edit_path: 手動編集ボタンを表示する場合の遷移先
%>

<%
  strong_error = receipt.failed?
  card_variant = strong_error ? :danger : :warning
  icon = strong_error ? "error" : "info"
  icon_class = strong_error ? "token-state-error-soft" : "token-state-warning-soft"
  title_class = strong_error ? "token-text-error" : "token-text-warning"
  box_class = strong_error ? "token-border-error-soft token-bg-error-soft" : "token-border-soft token-bg-warning-soft"
  title = strong_error ? t("receipts.processing_error_card.failed_title") : t("receipts.processing_error_card.attention_title")
  edit_path = local_assigns[:edit_path]
%>

<%= render "shared/ui/layout/surface_card", variant: card_variant, padding: :md do %>
  <div class="flex items-start gap-3">
    <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full <%= icon_class %>">
      <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;"><%= icon %></span>
    </div>

    <div class="min-w-0 flex-1 space-y-4">
      <div>
        <h3 class="text-base font-bold <%= title_class %>"><%= title %></h3>
        <p class="mt-1 text-sm token-text-muted"><%= receipt.processing_error_user_message %></p>
        <% if strong_error %>
          <p class="mt-2 text-sm token-text-muted"><%= t("receipts.processing_error_card.manual_edit_hint") %></p>
        <% end %>
      </div>

      <% if edit_path.present? %>
        <div>
          <%= render "shared/ui/actions/button",
                as: :link,
                href: edit_path,
                label: t("receipts.processing_error_card.edit_action"),
                icon: "edit",
                variant: :secondary,
                size: :compact,
                radius: :lg %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
