<%#
  レシート明細入力行

  必須:
  - item_form: 明細用の form builder
  - item: 表示・編集するレシート明細オブジェクト

  任意:
  - new_record: 新規明細行として扱う場合は true。未指定時は false
%>

<%
  row_state = local_assigns.fetch(:row_state)
  new_record = row_state.new_record?
  item_name = row_state.item_name
  item_warning_reason_labels = row_state.warning_reason_labels
  row_class = row_state.row_class
  line_total_value = row_state.line_total_value
  line_total_display = receipt_detail_amount_display(line_total_value)
  line_total_data = row_state.line_total_data
  selected_unit = row_state.selected_unit
  quantity_value = row_state.quantity_value
  quantity_step = row_state.quantity_step
  quantity_inputmode = row_state.quantity_inputmode
  item_target_id = receipt_review_item_target_id(item)
%>

<div class="swipe-action rounded-lg"
     data-controller="swipe-action">
  <div class="ui-no-select swipe-action-background md:hidden" aria-hidden="true">
    <button type="button"
            class="ui-touch-control flex w-[88px] shrink-0 cursor-pointer items-center justify-center token-bg-error-soft token-text-error"
            data-action="click->receipt-form#removeItem click->swipe-action#close"
            data-swipe-action-target="action"
            data-swipe-ignore
            tabindex="-1"
            aria-label="<%= t("receipts.item_fields.remove_aria") %>">
      <span class="ui-no-select material-symbols-outlined" aria-hidden="true">delete</span>
    </button>
  </div>

  <div class="swipe-action-foreground"
       data-swipe-action-target="foreground"
       data-action="pointerdown->swipe-action#start pointermove->swipe-action#move pointerup->swipe-action#end pointercancel->swipe-action#cancel">
    <div class="<%= row_class %>"
         <% if item_target_id.present? %> id="<%= item_target_id %>" data-receipt-review-item-row="true"<% end %>
         data-receipt-form-target="itemRow"
         data-action="mouseenter->receipt-form#scheduleLineTotalTooltip mouseleave->receipt-form#hideLineTotalTooltip focusin->receipt-form#hideLineTotalTooltipOnFocus">
  <div class="col-span-2 md:col-span-6 relative">
    <div class="flex items-center gap-2 md:block">
      <span class="w-12 whitespace-nowrap text-xs font-bold uppercase tracking-wider token-text-muted md:hidden shrink-0"><%= t("receipts.item_fields.name") %></span>
      <div class="w-full min-w-0">
        <%= render "shared/ui/form/text_field",
                   f: item_form,
                   attribute: :confirmed_name,
                   label: t("receipts.item_fields.name"),
                   value: (new_record ? nil : item_name),
                   icon: nil,
                   with_icon: false,
                   placeholder: t("receipts.item_fields.name_placeholder"),
                   show_label: false,
                   highlight_variant: row_state.name_highlight_variant,
                   show_error_message: false,
                   size: :dense,
                   html_options: { maxlength: 500, autocomplete: "off" } %>
      </div>

      <button type="button"
              class="ui-touch-control receipt-form-item-mobile-name-toggle flex h-10 w-10 shrink-0 cursor-pointer items-center justify-center rounded-lg border token-border-soft token-bg-input token-text-muted transition-colors md:hidden"
              data-action="click->receipt-form#toggleItemDetails"
              data-receipt-form-target="itemDetailsToggle"
              aria-expanded="false"
              aria-label="<%= t("receipts.item_fields.details_aria") %>">
        <span class="material-symbols-outlined text-lg transition-transform duration-150" data-receipt-form-target="itemDetailsIcon">expand_more</span>
      </button>
    </div>
  </div>

  <div class="receipt-form-item-mobile-detail receipt-form-item-mobile-detail-field col-span-2 md:col-span-2">
    <div class="receipt-form-item-mobile-detail-divider md:hidden">
      <%= render "shared/ui/layout/section_divider", class: "mb-3" %>
    </div>

    <div class="flex items-center gap-2 md:block">
      <span class="w-12 whitespace-nowrap text-xs font-bold uppercase tracking-wider token-text-muted md:hidden shrink-0"><%= t("receipts.item_fields.quantity") %></span>
      <div class="flex-1 min-w-0 md:block">
        <%= render "shared/ui/form/quantity_unit_number_field",
                   f: item_form,
                   label: t("receipts.item_fields.quantity"),
                   value: quantity_value,
                   selected_unit: selected_unit,
                   unit_options: row_state.quantity_unit_options,
                   show_label: false,
                   min: 0,
                   max: 9999.999,
                   step: quantity_step,
                   decimal_precision: 3,
                   inputmode: quantity_inputmode,
                   text_align: :center,
                   unit_select_variant: :compact_suffix,
                   highlight_variant: row_state.quantity_highlight_variant,
                   show_error_message: false,
                   unit_data: { action: "change->receipt-form#quantityUnitChanged", receipt_form_target: "quantityUnitInput" },
                   unit_aria_label: t("receipts.item_fields.unit"),
                   html_options: {
                     data: {
                       action: "input->receipt-form#recalculate",
                       receipt_form_target: "quantityInput"
                     }
                   } %>
      </div>
    </div>
  </div>

  <div class="receipt-form-item-mobile-detail receipt-form-item-mobile-detail-field col-span-2 md:col-span-2">
    <div class="flex items-center gap-2 md:block">
      <span class="w-12 whitespace-nowrap text-xs font-bold uppercase tracking-wider token-text-muted md:hidden shrink-0"><%= t("receipts.item_fields.amount") %></span>
      <div class="flex-1 min-w-0 md:block">
        <%= render "shared/ui/form/number_field",
                   f: item_form,
                   attribute: :price,
                   label: t("receipts.item_fields.unit_price"),
                   show_label: false,
                   text_align: :center,
                   show_stepper_buttons: true,
                   stepper_button_class: "md:hidden",
                   value: row_state.price_value,
                   min: 0,
                   max: ReceiptAmountService.receipt_item_price_max,
                   step: 1,
                   inputmode: :numeric,
                   size: :dense,
                   highlight_variant: row_state.price_highlight_variant,
                   show_error_message: false,
                   html_options: {
                     data: {
                       action: "input->receipt-form#recalculate",
                       receipt_form_target: "priceInput"
                     }
                   } %>
      </div>
    </div>
  </div>

  <div class="hidden md:col-span-1 md:flex md:justify-center">
    <button type="button"
            class="ui-touch-control flex h-10 w-full cursor-pointer items-center justify-center gap-1 rounded-lg border token-border-soft token-bg-input token-text-muted transition-colors md:w-10"
            data-action="click->receipt-form#toggleItemDetails"
            data-receipt-form-target="itemDetailsToggle"
            aria-expanded="false"
            aria-label="<%= t("receipts.item_fields.details_aria") %>">
      <span class="text-xs font-bold md:sr-only"><%= t("receipts.item_fields.details") %></span>
      <span class="material-symbols-outlined text-lg transition-transform duration-150" data-receipt-form-target="itemDetailsIcon">expand_more</span>
    </button>
  </div>

  <div class="hidden md:col-span-1 md:flex md:justify-end">
    <button type="button"
            class="ui-touch-control flex h-10 w-full shrink-0 cursor-pointer items-center justify-center rounded-lg receipt-form-delete-button transition-colors md:w-10"
            data-action="click->receipt-form#removeItem"
            aria-label="<%= t("receipts.item_fields.remove_aria") %>">
      <span class="material-symbols-outlined">delete</span>
    </button>
  </div>

  <div class="col-span-2 md:col-span-12 collapsible-grid" data-receipt-form-target="itemDetailsPanel" aria-hidden="true" inert>
    <div class="collapsible-grid-inner min-w-0">
      <div class="grid grid-cols-2 md:grid-cols-12 gap-4 p-0 md:rounded-lg md:border token-border-default md:p-3">
        <div class="col-span-2 md:col-span-3">
          <div class="space-y-2">
            <p class="text-xs font-bold token-text-muted uppercase tracking-wider"><%= t("receipts.item_fields.discount_rate") %></p>
            <div>
              <%= render "shared/ui/form/number_field",
                         f: item_form,
                         attribute: :discount_rate,
                         label: t("receipts.item_fields.discount_rate"),
                         value: row_state.discount_rate_percentage_input,
                         step: 0.1,
                         decimal_precision: 1,
                         min: 0,
                         max: 100,
                         suffix: "%",
                         show_label: false,
                         text_align: :center,
                         show_stepper_buttons: true,
                         stepper_button_class: "md:hidden",
                         size: :dense,
                         highlight_variant: row_state.discount_rate_highlight_variant,
                         show_error_message: false,
                         html_options: {
                           data: {
                             action: "input->receipt-form#recalculate",
                             receipt_form_target: "discountRateInput",
                             original_discount_rate: row_state.discount_rate_percentage_input
                           }
                         } %>
            </div>
          </div>
        </div>

        <div class="col-span-2 md:col-span-3">
          <div class="space-y-2">
            <p class="text-xs font-bold token-text-muted uppercase tracking-wider"><%= t("receipts.item_fields.tax_rate") %></p>
            <div>
              <%= render "shared/ui/form/number_field",
                         f: item_form,
                         attribute: :tax_rate,
                         label: t("receipts.item_fields.tax_rate"),
                         value: row_state.tax_rate_percentage_value,
                         step: 0.1,
                         decimal_precision: 1,
                         min: 0,
                         max: 100,
                         suffix: "%",
                         show_label: false,
                         text_align: :center,
                         show_stepper_buttons: true,
                         stepper_button_class: "md:hidden",
                         size: :dense,
                         html_options: {
                           data: {
                             action: "input->receipt-form#recalculate",
                             receipt_form_target: "taxRateInput"
                           }
                         },
                         highlight_variant: row_state.tax_rate_highlight_variant,
                         show_error_message: false %>
            </div>
          </div>
        </div>

        <div class="col-span-2 md:col-span-3">
          <div class="space-y-2">
            <p class="text-xs font-bold token-text-muted uppercase tracking-wider"><%= t("receipts.item_fields.category") %></p>
            <div>
              <%= render "shared/ui/form/select_field",
                         f: item_form,
                         attribute: :category,
                         label: t("receipts.item_fields.category"),
                         options: row_state.category_options,
                         selected: row_state.selected_category,
                         include_blank: t("receipts.item_fields.uncategorized"),
                         show_label: false,
                         select_wrapper_class: "w-full",
                         size: :dense,
                         highlight_variant: row_state.category_highlight_variant,
                         show_error_message: false %>
            </div>
          </div>
        </div>

        <div class="receipt-form-item-detail-subtotal col-span-2 hidden md:col-span-3 md:flex md:items-start">
          <div class="w-full space-y-2">
            <p class="text-xs font-bold token-text-muted uppercase tracking-wider invisible" aria-hidden="true"><%= t("receipts.item_fields.subtotal") %></p>
            <div class="flex h-10 w-full items-center justify-between gap-3 rounded-lg border token-border-soft token-bg-card px-3 py-2">
              <span class="text-sm font-medium token-text-muted shrink-0"><%= t("receipts.item_fields.subtotal") %></span>
              <span class="text-base font-bold token-text-base truncate text-right" data-receipt-form-target="lineTotalDisplay"><%= line_total_display %></span>
            </div>
          </div>
        </div>
      </div>

      <% if item_warning_reason_labels.any? %>
        <div class="receipt-form-item-warning-notes mt-3 rounded-lg border token-border-soft token-bg-warning-soft px-3 py-2">
          <div class="flex items-start gap-2">
            <span class="ui-no-select material-symbols-outlined mt-0.5 text-base token-text-warning" aria-hidden="true">info</span>
            <div class="min-w-0">
              <p class="text-sm font-bold token-text-warning"><%= t("receipts.item_fields.warning_title") %></p>
              <ul class="mt-1 list-disc space-y-1 pl-5 text-sm token-text-base">
                <% item_warning_reason_labels.each do |label| %>
                  <li><%= label %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="receipt-form-item-mobile-summary col-span-2 md:hidden">
    <%= render "shared/ui/layout/section_divider", class: "mb-3" %>

    <div class="flex items-center justify-between gap-3">
      <div class="receipt-form-item-mobile-subtotal flex min-w-0 flex-1 items-center gap-2">
        <span class="text-sm font-medium token-text-muted shrink-0"><%= t("receipts.item_fields.subtotal") %></span>
        <span class="text-base font-bold token-text-base truncate text-right" data-receipt-form-target="lineTotalDisplay"><%= line_total_display %></span>
      </div>

      <button type="button"
              class="ui-touch-control flex h-10 w-10 shrink-0 cursor-pointer items-center justify-center rounded-lg receipt-form-delete-button transition-colors"
              data-action="click->receipt-form#removeItem"
              aria-label="<%= t("receipts.item_fields.remove_aria") %>">
        <span class="material-symbols-outlined">delete</span>
      </button>
    </div>
  </div>

  <div class="pointer-events-none absolute right-0 top-full mt-2 z-20 hidden lg:block rounded-lg border token-border-soft token-bg-input px-3 py-1.5 text-sm font-medium token-text-base receipt-form-line-total-tooltip opacity-0 transition-opacity duration-150" data-receipt-form-target="lineTotalTooltip">
    <span class="truncate" data-receipt-form-target="lineTotalDisplay" title="<%= t("receipts.item_fields.subtotal") %> <%= line_total_display %>"><%= t("receipts.item_fields.subtotal") %> <%= line_total_display %></span>
  </div>

  <% unless new_record %>
    <%= item_form.hidden_field :id %>
  <% end %>

  <% if new_record %>
    <%= item_form.hidden_field :line_total,
          value: 0,
          data: line_total_data %>
  <% else %>
    <%= item_form.hidden_field :line_total,
          data: line_total_data %>
    <%= item_form.hidden_field :_destroy, value: false, data: { receipt_form_target: "destroyField" } %>
  <% end %>
    </div>
  </div>
</div>
