<%#
  NOTE:
  この partial には最小限の locals のみ渡す。
  warning / review / display 用の派生値は partial 内で計算する。
  JS target / hidden field は itemRow 内に1セットだけ維持する。
%>

<%
  new_record = local_assigns.fetch(:new_record, false)
  item_name = item.confirmed_name.presence || item.suggested_name.presence || item.raw_text.presence || ""
  item_review_reason_codes = Array(item.review_reasons).map(&:to_s)
  item_warning_reason_labels = new_record ? [] : receipt_item_warning_reason_labels(item)
  item_review_reason_includes = ->(*codes) { (item_review_reason_codes & codes.map(&:to_s)).any? }
  item_error_flags = {
    name: item_review_reason_includes.call("item_name_uncertain"),
    category: item_review_reason_includes.call("item_category_uncertain"),
    tax_rate: item_review_reason_includes.call("item_tax_rate_uncertain")
  }

  row_class = if new_record
                "grid grid-cols-2 md:grid-cols-12 gap-4 items-center p-3 rounded-lg receipt-form-item-row transition-colors relative min-w-0"
              else
                [
                  "grid grid-cols-2 md:grid-cols-12 gap-4 items-center p-3 rounded-lg transition-colors relative min-w-0",
                  item.needs_review ? "border receipt-form-item-review-row" : "receipt-form-item-row"
                ].join(" ")
              end
  line_total_value = new_record ? 0 : item.line_total.to_i
  original_line_total_value = new_record ? 0 : (item.original_line_total.presence || item.line_total.to_i)
  selected_unit = new_record ? ReceiptItem::DEFAULT_QUANTITY_UNIT : item.quantity_unit.presence || ReceiptItem::DEFAULT_QUANTITY_UNIT
%>

<div class="<%= row_class %>"
     data-receipt-form-target="itemRow"
     data-action="mouseenter->receipt-form#scheduleLineTotalTooltip mouseleave->receipt-form#hideLineTotalTooltip focusin->receipt-form#hideLineTotalTooltipOnFocus">
  <div class="col-span-2 md:col-span-6 relative">
    <div class="flex items-center gap-2 md:block">
      <span class="w-12 whitespace-nowrap text-xs font-bold uppercase tracking-wider token-text-muted md:hidden shrink-0"><%= t("receipts.item_fields.name") %></span>
      <div class="w-full min-w-0">
        <%= render "shared/ui/text_field",
                   f: item_form,
                   attribute: :confirmed_name,
                   label: t("receipts.item_fields.name"),
                   value: (new_record ? nil : item_name),
                   icon: nil,
                   with_icon: false,
                   placeholder: t("receipts.item_fields.name_placeholder"),
                   show_label: false,
                   highlight_variant: (item.needs_review && item_error_flags[:name] ? :error : nil),
                   show_error_message: false,
                   size: :dense,
                   html_options: { maxlength: 500, autocomplete: "off" } %>
      </div>

      <button type="button"
              class="receipt-form-item-mobile-name-toggle flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border token-border-soft token-bg-input token-text-muted transition-colors md:hidden"
              data-action="click->receipt-form#toggleItemDetails"
              data-receipt-form-target="itemDetailsToggle"
              aria-expanded="false"
              aria-label="<%= t("receipts.item_fields.details_aria") %>">
        <span class="material-symbols-outlined text-lg transition-transform duration-150" data-receipt-form-target="itemDetailsIcon">expand_more</span>
      </button>
    </div>
  </div>

  <div class="receipt-form-item-mobile-detail receipt-form-item-mobile-detail-field col-span-2 md:col-span-2">
    <div class="receipt-form-item-mobile-detail-divider md:hidden">
      <%= render "shared/ui/section_divider", class: "mb-3" %>
    </div>

    <div class="flex items-center gap-2 md:block">
      <span class="w-12 whitespace-nowrap text-xs font-bold uppercase tracking-wider token-text-muted md:hidden shrink-0"><%= t("receipts.item_fields.quantity") %></span>
      <div class="flex-1 min-w-0 md:block">
        <%= render "shared/ui/quantity_unit_number_field",
                   f: item_form,
                   label: t("receipts.item_fields.quantity"),
                   value: (new_record ? nil : item.formatted_quantity_for_input),
                   selected_unit: selected_unit,
                   unit_options: ReceiptItem.quantity_unit_options,
                   show_label: false,
                   min: 0,
                   max: 9999.999,
                   step: 0.001,
                   decimal_precision: 3,
                   decimal_comma: true,
                   text_align: :center,
                   unit_select_variant: :compact_suffix,
                   highlight_variant: (item.errors[:quantity].any? ? :error : nil),
                   show_error_message: false,
                   unit_data: { receipt_form_target: "quantityUnitInput" },
                   unit_aria_label: t("receipts.item_fields.unit"),
                   html_options: {
                     data: {
                       action: "input->receipt-form#recalculate",
                       receipt_form_target: "quantityInput"
                     }
                   } %>
      </div>
    </div>
  </div>

  <div class="receipt-form-item-mobile-detail receipt-form-item-mobile-detail-field col-span-2 md:col-span-2">
    <div class="flex items-center gap-2 md:block">
      <span class="w-12 whitespace-nowrap text-xs font-bold uppercase tracking-wider token-text-muted md:hidden shrink-0"><%= t("receipts.item_fields.amount") %></span>
      <div class="flex-1 min-w-0 md:block">
        <%= render "shared/ui/number_field",
                   f: item_form,
                   attribute: :price,
                   label: t("receipts.item_fields.unit_price"),
                   show_label: false,
                   text_align: :center,
                   show_stepper_buttons: true,
                   stepper_button_class: "md:hidden",
                   min: 0,
                   max: 999999999,
                   step: 1,
                   size: :dense,
                   highlight_variant: (item.errors[:price].any? ? :error : nil),
                   show_error_message: false,
                   html_options: {
                     data: {
                       action: "input->receipt-form#recalculate",
                       receipt_form_target: "priceInput"
                     }
                   } %>
      </div>
    </div>
  </div>

  <div class="hidden md:col-span-1 md:flex md:justify-center">
    <button type="button"
            class="flex h-10 w-full items-center justify-center gap-1 rounded-lg border token-border-soft token-bg-input token-text-muted transition-colors md:w-10"
            data-action="click->receipt-form#toggleItemDetails"
            data-receipt-form-target="itemDetailsToggle"
            aria-expanded="false"
            aria-label="<%= t("receipts.item_fields.details_aria") %>">
      <span class="text-xs font-bold md:sr-only"><%= t("receipts.item_fields.details") %></span>
      <span class="material-symbols-outlined text-lg transition-transform duration-150" data-receipt-form-target="itemDetailsIcon">expand_more</span>
    </button>
  </div>

  <div class="hidden md:col-span-1 md:flex md:justify-end">
    <button type="button"
            class="flex h-10 w-full shrink-0 items-center justify-center rounded-lg receipt-form-delete-button transition-colors md:w-10"
            data-action="click->receipt-form#removeItem"
            aria-label="<%= t("receipts.item_fields.remove_aria") %>">
      <span class="material-symbols-outlined">delete</span>
    </button>
  </div>

  <div class="col-span-2 md:col-span-12 hidden" data-receipt-form-target="itemDetailsPanel">
    <div class="grid grid-cols-2 md:grid-cols-12 gap-4 p-0 md:rounded-lg md:border token-border-default md:p-3">
      <div class="col-span-2 md:col-span-2">
        <div class="space-y-2">
          <p class="text-xs font-bold token-text-muted uppercase tracking-wider"><%= t("receipts.item_fields.discount_rate") %></p>
          <div>
            <%= render "shared/ui/number_field",
                       f: item_form,
                       attribute: :discount_rate,
                       label: t("receipts.item_fields.discount_rate"),
                       value: (new_record ? nil : item.discount_rate_percentage_input),
                       step: 0.1,
                       decimal_precision: 1,
                       min: 0,
                       max: 100,
                       suffix: "%",
                       show_label: false,
                       text_align: :center,
                       show_stepper_buttons: true,
                       stepper_button_class: "md:hidden",
                       size: :dense,
                       highlight_variant: (item.errors[:discount_rate].any? ? :error : nil),
                       show_error_message: false,
                       html_options: {
                         data: {
                           action: "input->receipt-form#recalculate",
                           receipt_form_target: "discountRateInput",
                           original_discount_rate: (new_record ? nil : item.discount_rate_percentage_input)
                         }
                       } %>
          </div>
        </div>
      </div>

      <div class="col-span-2 md:col-span-2">
        <div class="space-y-2">
          <p class="text-xs font-bold token-text-muted uppercase tracking-wider"><%= t("receipts.item_fields.tax_rate") %></p>
          <div>
            <%= render "shared/ui/number_field",
                       f: item_form,
                       attribute: :tax_rate,
                       label: t("receipts.item_fields.tax_rate"),
                       value: (item.tax_rate.present? ? item.tax_rate * 100 : nil),
                       step: 0.1,
                       decimal_precision: 1,
                       min: 0,
                       max: 100,
                       suffix: "%",
                       show_label: false,
                       text_align: :center,
                       show_stepper_buttons: true,
                       stepper_button_class: "md:hidden",
                       size: :dense,
                       html_options: {
                         data: {
                           action: "input->receipt-form#recalculate",
                           receipt_form_target: "taxRateInput"
                         }
                       },
                       highlight_variant: ((item.errors[:tax_rate].any? || (item.needs_review && item_error_flags[:tax_rate])) ? :error : nil),
                       show_error_message: false %>
          </div>
        </div>
      </div>

      <div class="col-span-2 md:col-span-3">
        <div class="space-y-2">
          <p class="text-xs font-bold token-text-muted uppercase tracking-wider"><%= t("receipts.item_fields.category") %></p>
          <div>
            <%= render "shared/ui/select_field",
                       f: item_form,
                       attribute: :category,
                       label: t("receipts.item_fields.category"),
                       options: ReceiptItem.category_options,
                       selected: (new_record ? nil : item.category),
                       include_blank: t("receipts.item_fields.uncategorized"),
                       show_label: false,
                       select_wrapper_class: "w-full",
                       size: :dense,
                       highlight_variant: (item.needs_review && item_error_flags[:category] ? :error : nil),
                       show_error_message: false %>
          </div>
        </div>
      </div>

      <div class="receipt-form-item-detail-subtotal col-span-2 hidden md:col-span-5 md:flex md:justify-end">
        <div class="space-y-2">
          <p class="text-xs font-bold token-text-muted uppercase tracking-wider invisible" aria-hidden="true"><%= t("receipts.item_fields.subtotal") %></p>
          <div class="flex h-10 w-full items-center justify-between gap-3 rounded-lg border token-border-soft token-bg-card px-3 py-2 md:max-w-[280px]">
            <span class="text-sm font-medium token-text-muted shrink-0"><%= t("receipts.item_fields.subtotal") %></span>
            <span class="text-base font-bold token-text-base truncate text-right" data-receipt-form-target="lineTotalDisplay">¥<%= number_with_delimiter(line_total_value) %></span>
          </div>
        </div>
      </div>
    </div>

    <% if item_warning_reason_labels.any? %>
      <div class="receipt-form-item-warning-notes mt-3 rounded-lg border token-border-soft token-bg-warning-soft px-3 py-2">
        <div class="flex items-start gap-2">
          <span class="material-symbols-outlined mt-0.5 text-base token-text-warning" aria-hidden="true">info</span>
          <div class="min-w-0">
            <p class="text-sm font-bold token-text-warning"><%= t("receipts.item_fields.warning_title") %></p>
            <ul class="mt-1 list-disc space-y-1 pl-5 text-sm token-text-base">
              <% item_warning_reason_labels.each do |label| %>
                <li><%= label %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="receipt-form-item-mobile-summary col-span-2 md:hidden">
    <%= render "shared/ui/section_divider", class: "mb-3" %>

    <div class="flex items-center justify-between gap-3">
      <div class="receipt-form-item-mobile-subtotal flex min-w-0 flex-1 items-center gap-2">
        <span class="text-sm font-medium token-text-muted shrink-0"><%= t("receipts.item_fields.subtotal") %></span>
        <span class="text-base font-bold token-text-base truncate text-right" data-receipt-form-target="lineTotalDisplay">¥<%= number_with_delimiter(line_total_value) %></span>
      </div>

      <button type="button"
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg receipt-form-delete-button transition-colors"
              data-action="click->receipt-form#removeItem"
              aria-label="<%= t("receipts.item_fields.remove_aria") %>">
        <span class="material-symbols-outlined">delete</span>
      </button>
    </div>
  </div>

  <div class="pointer-events-none absolute right-0 top-full mt-2 z-20 hidden lg:block rounded-lg border token-border-soft token-bg-input px-3 py-1.5 text-sm font-medium token-text-base receipt-form-line-total-tooltip opacity-0 transition-opacity duration-150" data-receipt-form-target="lineTotalTooltip">
    <span class="truncate" data-receipt-form-target="lineTotalDisplay" title="<%= t("receipts.item_fields.subtotal") %> ¥<%= number_with_delimiter(line_total_value) %>"><%= t("receipts.item_fields.subtotal") %> ¥<%= number_with_delimiter(line_total_value) %></span>
  </div>

  <% unless new_record %>
    <%= item_form.hidden_field :id %>
  <% end %>

  <% if new_record %>
    <%= item_form.hidden_field :line_total,
          value: 0,
          data: {
            receipt_form_target: "lineTotalInput",
            original_line_total: original_line_total_value
          } %>
    <%= item_form.hidden_field :needs_review, value: false %>
  <% else %>
    <%= item_form.hidden_field :line_total,
          data: {
            receipt_form_target: "lineTotalInput",
            original_line_total: original_line_total_value
          } %>
    <%= item_form.hidden_field :needs_review %>
    <%= item_form.hidden_field :_destroy, value: false, data: { receipt_form_target: "destroyField" } %>
  <% end %>
</div>
