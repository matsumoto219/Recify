<%
  ocr_state = (@ocr_state || {}).with_indifferent_access[:state].to_s
  ai_state = (@ai_state || {}).with_indifferent_access[:state].to_s
  ocr_down = ocr_state == "down"
  ai_down = ai_state == "down"
%>

<section
  class="relative w-full max-w-4xl mx-auto space-y-10 md:space-y-12 px-4 md:px-0"
  data-controller="service-status-polling"
  data-service-status-polling-status-url-value="<%= external_services_status_path %>"
  data-service-status-polling-interval-value="30000">
  <%= render "shared/ui/layout/section_header",
    title: t("receipts.select_input_method.title"),
    subtitle: t("receipts.select_input_method.subtitle"),
    title_size: "text-[1.6rem] md:text-3xl",
    subtitle_size: "text-[15px] md:text-lg",
    align: :left,
    responsive_align: :center,
    wrapper_class: "space-y-3 md:space-y-4 pt-2 md:pt-0" %>

  <div class="space-y-3">
    <div
      class="rounded-xl border token-border-soft token-bg-warning-soft px-4 py-3 text-sm token-text-warning <%= "hidden" unless ocr_down %>"
      data-service-status-polling-target="serviceNotice"
      data-service-notice-key="ocr_down">
      <%= t("flash.receipts.ocr_unavailable") %>
    </div>

    <div
      class="rounded-xl border token-border-soft token-bg-info-soft px-4 py-3 text-sm token-text-base <%= "hidden" unless ai_down %>"
      data-service-status-polling-target="serviceNotice"
      data-service-notice-key="ai_down">
      <%= t("receipts.select_input_method.ai_down") %>
    </div>
  </div>

  <div class="flex flex-col gap-5 md:grid md:grid-cols-2 md:gap-8 px-0 md:px-4">
    <%= render "shared/ui/card/selection_card",
      path: new_upload_receipts_path,
      title: t("receipts.select_input_method.upload.title"),
      description: t("receipts.select_input_method.upload.description"),
      icon: "photo_camera",
      variant: :primary,
      desktop_badge: t("receipts.select_input_method.upload.badge"),
      title_size: "text-[1.2rem] md:text-2xl",
      description_size: "text-sm md:text-base",
      disabled: ocr_down,
      data: {
        service_status_polling_target: "ocrGatedLink",
        enabled_href: new_upload_receipts_path
      }.merge(ocr_down ? { service_disabled: "ocr" } : {}) %>

    <%= render "shared/ui/card/selection_card",
      path: new_receipt_path,
      title: t("receipts.select_input_method.manual.title"),
      description: t("receipts.select_input_method.manual.description"),
      icon: "edit_note",
      variant: :secondary,
      desktop_badge: t("receipts.select_input_method.manual.badge"),
      title_size: "text-[1.2rem] md:text-2xl",
      description_size: "text-sm md:text-base" %>
  </div>

  <%= render "shared/ui/layout/section_divider", variant: :gradient, class: "mt-8 mb-6" %>
  <div class="flex flex-col items-center text-center">
    <p class="text-sm token-text-muted mb-2 leading-relaxed">
      <%= t("receipts.select_input_method.footer.fallback") %>
    </p>
    <p class="text-xs token-text-subtle leading-relaxed">
      <%= t("receipts.select_input_method.footer.confirmation") %>
    </p>
  </div>
</section>
