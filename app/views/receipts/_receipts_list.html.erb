<% if receipts.any? %>
  <section class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 min-[1800px]:grid-cols-5">
    <% receipts.each do |receipt| %>
      <%= render "shared/receipts/receipt_card", receipt: receipt %>
    <% end %>
  </section>
<% else %>
  <section class="flex flex-col items-center justify-center py-24 text-center">
    <div class="w-24 h-24 mb-6 rounded-full token-bg-elevated flex items-center justify-center">
      <span class="material-symbols-outlined text-4xl empty-state-icon">search_off</span>
    </div>

    <% if defined?(query) && query.present? %>
      <h2 class="text-lg font-bold token-text-base mb-2">検索結果が見つかりません</h2>
      <p class="token-text-muted text-sm mb-6">
        「<span class="token-text-brand"><%= query %></span>」に一致するレシートはありません。
      </p>
      <%= link_to "一覧に戻る", receipts_path,
        class: "text-sm token-text-brand hover:underline" %>
    <% else %>
      <h2 class="text-lg font-bold token-text-base mb-2">レシートがありません</h2>
      <p class="token-text-muted text-sm mb-8">最初のレシートを登録しましょう。</p>
      <%= render "shared/ui/button",
        label: "今すぐ登録する",
        as: :link,
        href: select_input_method_receipts_path,
        variant: :secondary,
        size: :md %>
    <% end %>
  </section>
<% end %>
