<section id="receipts-list-grid" class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 min-[1800px]:grid-cols-5">
  <% receipts.each do |receipt| %>
    <%= render "shared/receipts/receipt_card", receipt: receipt %>
  <% end %>
</section>

<% unless receipts.any? %>
  <section id="receipts-empty-state" class="flex flex-col items-center justify-center py-24 text-center">
    <div class="w-24 h-24 mb-6 rounded-full token-bg-elevated flex items-center justify-center">
      <span class="material-symbols-outlined text-4xl empty-state-icon">search_off</span>
    </div>

    <% if defined?(query) && query.present? %>
      <h2 class="text-lg font-bold token-text-base mb-2"><%= t("receipt_cards.empty.search.title") %></h2>
      <p class="token-text-muted text-sm mb-6">
        <%= t("receipt_cards.empty.search.description_prefix") %><span class="token-text-brand"><%= query %></span><%= t("receipt_cards.empty.search.description_suffix") %>
      </p>
      <%= link_to t("receipt_cards.empty.search.back_to_index"), receipts_path,
        class: "text-sm token-text-brand hover:underline" %>
    <% else %>
      <h2 class="text-lg font-bold token-text-base mb-2"><%= t("receipt_cards.empty.default.title") %></h2>
      <p class="token-text-muted text-sm mb-8"><%= t("receipt_cards.empty.default.description") %></p>
      <%= render "shared/ui/button",
        label: t("receipt_cards.empty.default.action"),
        as: :link,
        href: select_input_method_receipts_path,
        variant: :secondary,
        size: :md %>
    <% end %>
  </section>
<% end %>
