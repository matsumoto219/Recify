<%#
  注意レビュー理由カード

  必須:
  - receipt: 注意理由を表示するレシートオブジェクト
  - description: カード上部に表示する説明文

  任意:
  - target_base_path: 確認リンクのベースパス。未指定時は同一ページ内アンカー。
%>

<%
  warning_notes_state = receipt_warning_notes_state(receipt)
  warning_groups = warning_notes_state.groups
  warning_count = warning_notes_state.count
  target_base_path = local_assigns[:target_base_path]
%>

<%= render "shared/ui/layout/surface_card", padding: :md, class: "min-w-0 max-w-full" do %>
  <details class="collapsible-details group w-full min-w-0 max-w-full" data-controller="collapsible-details" data-receipt-warning-notes-card>
    <summary class="ui-touch-control flex w-full min-w-0 max-w-full cursor-pointer list-none items-start gap-3 focus:outline-none [&::-webkit-details-marker]:hidden" data-receipt-notes-summary>
      <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full token-state-warning-soft">
        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">info</span>
      </div>

      <div class="min-w-0 max-w-full flex-1">
        <div class="flex min-w-0 max-w-full items-start justify-between gap-3">
          <div class="min-w-0 max-w-full">
            <h3 class="break-words [overflow-wrap:anywhere] text-base font-bold token-text-warning"><%= t("receipts.warning_notes_card.title") %></h3>
            <p class="mt-1 break-words [overflow-wrap:anywhere] text-sm token-text-muted"><%= description %></p>
          </div>

          <div class="flex shrink-0 items-center gap-2">
            <span class="rounded-full border token-border-soft token-bg-warning-soft px-2.5 py-1 text-xs font-bold token-text-warning">
              <%= warning_count %><%= t("receipts.common.count_suffix") %>
            </span>
            <span class="material-symbols-outlined token-text-warning transition-transform duration-150 group-open:rotate-180" aria-hidden="true">expand_more</span>
          </div>
        </div>
      </div>
    </summary>

    <div class="collapsible-grid min-w-0 max-w-full" data-collapsible-details-target="content" data-receipt-notes-details>
      <div class="collapsible-grid-inner">
        <div class="mt-4 min-w-0 max-w-full space-y-4 pl-12">
          <% warning_groups.each do |source, reasons| %>
            <div class="min-w-0 max-w-full rounded-lg border token-border-soft token-bg-warning-soft px-3 py-2">
              <div class="mb-1 break-words [overflow-wrap:anywhere] text-xs font-bold token-text-warning"><%= t("receipts.review_reason_sources.#{source}", default: t("receipts.review_reason_sources.unknown")) %></div>
              <ul class="min-w-0 max-w-full space-y-1 pl-5 text-sm token-text-base list-disc break-words [overflow-wrap:anywhere]">
                <% reasons.each do |reason| %>
                  <% reason_label = receipt.review_reason_labels_for([reason]).first %>
                  <li class="break-words [overflow-wrap:anywhere]">
                    <div class="flex min-w-0 max-w-full flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
                      <span class="min-w-0"><%= reason_label %></span>
                      <%= review_reason_target_link(reason, base_path: target_base_path, variant: :warning) %>
                    </div>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </details>
<% end %>
