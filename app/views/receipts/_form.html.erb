<% form_dom_id = receipt.persisted? ? "edit_receipt_form_#{receipt.id}" : "new_receipt_form" %>
<%= form_with model: receipt,
              html: {
                id: form_dom_id,
                data: {
                  controller: "receipt-form",
                  "receipt-form-next-index-value": receipt.receipt_items.size
                }
              } do |f| %>
  <%= render "shared/error_messages", obj: receipt %>

  <% page_title = receipt.persisted? ? "レシート編集" : "レシート登録" %>
  <% page_description = receipt.persisted? ? "内容を確認・修正して保存してください" : "内容を入力して保存してください" %>
  <% cancel_path = receipt.persisted? ? receipt_path(receipt) : receipts_path %>
  <% total_amount_value = receipt.total_amount.to_i %>
  <% subtotal_amount_value = receipt.subtotal_amount %>
  <% tax_amount_value = receipt.tax_amount %>
  <% tax_rate_value = receipt.tax_rate_percentage_input.present? ? "#{receipt.tax_rate_percentage_input}%" : "未設定" %>
  <% content_for :mobile_bottom_actions do %>
    <%= render "shared/ui/button",
          label: "保存",
          type: "submit",
          form: form_dom_id,
          full_width: true,
          class: "py-3 rounded-xl shadow-lg cursor-pointer" %>
    <%= render "shared/ui/button",
          as: :link,
          href: cancel_path,
          label: "キャンセル",
          variant: :secondary,
          full_width: true,
          class: "py-3 rounded-xl text-center" %>
  <% end %>

  <section class="max-w-5xl mx-auto px-0 md:px-2 py-2 pb-40 md:pb-2">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
      <%= render "shared/ui/section_header",
            title: page_title,
            subtitle: page_description,
            title_size: "text-3xl md:text-4xl" %>

      <div class="hidden md:flex items-center gap-3">
        <%= render "shared/ui/button",
              as: :link,
              href: cancel_path,
              label: "キャンセル",
              variant: :secondary,
              class: "px-6 py-2.5 rounded-xl hover:bg-[#444]" %>

        <%= render "shared/ui/button",
              label: "保存",
              type: "submit",
              class: "px-8 py-2.5 rounded-xl hover:opacity-90 shadow-lg shadow-[#4B4DD8]/20 cursor-pointer" %>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-8 space-y-8">
        <%= render "shared/ui/surface_card", class: "p-6" do %>
          <%= render "shared/ui/section_header",
                title: "基本情報",
                icon: "info",
                class: "mb-6" %>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <%= render "shared/ui/text_field",
                       f: f,
                       attribute: :store_name,
                       label: "店舗名",
                       icon: "storefront",
                       placeholder: "店舗名を入力",
                       input_class: "h-11" %>

            <%= render "shared/ui/select_field",
                       f: f,
                       attribute: :payment_method,
                       label: "支払い方法",
                       options: Receipt.payment_method_options,
                       selected: f.object.payment_method,
                       include_blank: "選択してください" %>

            <%= render "shared/ui/datetime_field",
                       name: "receipt[purchased_on]",
                       id: "receipt_purchased_on",
                       label: "購入日",
                       type: :date,
                       value: receipt.purchased_at&.in_time_zone&.to_date,
                       icon: "calendar_today" %>

            <%= render "shared/ui/datetime_field",
                       name: "receipt[purchased_time]",
                       id: "receipt_purchased_time",
                       label: "時刻",
                       type: :time,
                       value: receipt.purchased_at&.in_time_zone&.strftime("%H:%M"),
                       icon: "schedule" %>

            <div class="md:col-span-2">
              <%= render "shared/ui/text_field",
                         f: f,
                         attribute: :store_address,
                         label: "店舗住所",
                         icon: "location_on",
                         placeholder: "店舗住所を入力",
                         input_class: "h-11" %>
            </div>
            <div class="md:col-span-2">
              <%= render "shared/ui/text_field",
                         f: f,
                         attribute: :store_phone_number,
                         label: "電話番号",
                         icon: "call",
                         field_type: :telephone_field,
                         placeholder: "例: 03-1234-5678",
                         input_class: "h-11",
                         html_options: {
                           inputmode: "tel",
                           pattern: "[0-9\\-]*"
                         } %>
            </div>
          </div>
        <% end %>

        <%= render "shared/ui/surface_card", class: "overflow-hidden" do %>
          <div class="p-6 border-b border-white/10">
            <%= render "shared/ui/section_header",
                  title: "明細一覧",
                  icon: "receipt_long" %>
          </div>

          <div class="p-6 space-y-4" data-receipt-form-target="itemsContainer">
            <div class="hidden md:grid grid-cols-12 gap-4 px-2 text-xs font-bold uppercase tracking-wider text-[#C7C4D8]">
              <div class="col-span-5">品名</div>
              <div class="col-span-2">数量</div>
              <div class="col-span-2">単価</div>
              <div class="col-span-2">小計</div>
              <div class="col-span-1"></div>
            </div>

            <% if receipt.receipt_items.any? %>
              <%= f.fields_for :receipt_items do |item_form| %>
                <% item = item_form.object %>
                <% item_name = item.confirmed_name.presence || item.suggested_name.presence || item.raw_text.presence || "" %>

                <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center p-3 rounded-lg bg-[#1C1B1B] hover:bg-[#2A2A2A] transition-colors relative" data-receipt-form-target="itemRow">
                  <div class="col-span-5 relative pr-12 md:pr-0">
                    <% if item.needs_review %>
                      <%# TODO: 要確認項目は将来的に input を赤枠ハイライトする。低信頼理由の表示も追加する %>
                      <span class="absolute -top-6 left-2 px-2 py-0.5 rounded text-[10px] font-bold bg-[#FFB4AB]/10 text-[#FFB4AB] flex items-center gap-1">
                        <span class="material-symbols-outlined text-[12px]" style="font-variation-settings: 'FILL' 1;">error</span>
                        要確認
                      </span>
                    <% end %>
                    <%= render "shared/ui/text_field",
                               f: item_form,
                               attribute: :confirmed_name,
                               label: "品名",
                               value: item_name,
                               icon: nil,
                               with_icon: false,
                               placeholder: "品名を入力",
                               show_label: false,
                               highlight_variant: (item.needs_review ? :error : nil),
                               input_class: "h-10 px-3 py-2 rounded-md" %>

                  </div>

                  <div class="col-span-2">
                    <div class="flex items-center gap-2 md:block">
                      <%# NOTE: quantity は number_field かつ今後Stimulus再計算対象のため、text_field パーシャルでは置き換えない %>
                      <span class="text-xs font-bold uppercase tracking-wider text-[#C7C4D8] md:hidden shrink-0">QTY</span>
                      <%= item_form.number_field :quantity,
                                                 class: "w-full px-3 py-2 rounded-md text-center bg-[#0E0E0E] border border-white/10 text-[#E5E2E1]",
                                                 data: {
                                                   action: "input->receipt-form#recalculate",
                                                   receipt_form_target: "quantityInput"
                                                 } %>
                    </div>
                  </div>

                  <div class="col-span-2">
                    <div class="flex items-center gap-2 md:block">
                      <%# NOTE: price は number_field かつ今後Stimulus再計算対象のため、text_field パーシャルでは置き換えない %>
                      <span class="text-sm font-bold text-[#C7C4D8] md:hidden shrink-0">¥</span>
                      <%= item_form.number_field :price,
                                                 class: "w-full px-3 py-2 rounded-md text-right bg-[#0E0E0E] border border-white/10 text-[#E5E2E1]",
                                                 data: {
                                                   action: "input->receipt-form#recalculate",
                                                   receipt_form_target: "priceInput"
                                                 } %>
                    </div>
                  </div>

                  <div class="hidden md:block col-span-2 text-right text-[#E5E2E1] font-medium" data-receipt-form-target="lineTotalDisplay">
                    ¥<%= number_with_delimiter(item.line_total.to_i) %>
                  </div>

                  <div class="col-span-1 flex justify-end md:static absolute top-3 right-3 z-10">
                    <button type="button"
                            class="p-2 hover:text-[#FFB4AB] transition-colors"
                            data-action="click->receipt-form#removeItem">
                      <span class="material-symbols-outlined">delete</span>
                    </button>
                  </div>

                  <%= item_form.hidden_field :id %>
                  <%= item_form.hidden_field :line_total, data: { receipt_form_target: "lineTotalInput" } %>
                  <%= item_form.hidden_field :needs_review %>
                  <%= item_form.hidden_field :_destroy, value: false, data: { receipt_form_target: "destroyField" } %>
                </div>
              <% end %>
            <% else %>
              <%# TODO: 手動登録時の明細追加UIを改善し、空状態でも追加しやすくする %>
              <div class="rounded-xl border border-dashed border-white/10 p-8 text-center text-[#C7C4D8]" data-receipt-form-target="emptyState">
                明細はまだありません
              </div>
            <% end %>

            <%# TODO: 本実装時は手動で明細行を追加できる Stimulus UI に置き換える %>
            <button type="button"
                    data-action="click->receipt-form#addItem"
                    class="w-full mt-4 py-3 border-2 border-dashed border-white/20 rounded-xl text-[#C7C4D8] hover:text-[#C0C1FF] hover:border-[#C0C1FF] transition-all flex items-center justify-center gap-2 font-medium">
              <span class="material-symbols-outlined">add_circle</span>
              明細追加
            </button>

            <template data-receipt-form-target="template">
              <%= f.fields_for :receipt_items, ReceiptItem.new, child_index: "NEW_RECORD" do |item_form| %>
                <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center p-3 rounded-lg bg-[#1C1B1B] hover:bg-[#2A2A2A] transition-colors relative" data-receipt-form-target="itemRow">
                  <div class="col-span-5 relative pr-12 md:pr-0">
                    <%= render "shared/ui/text_field",
                               f: item_form,
                               attribute: :confirmed_name,
                               label: "品名",
                               icon: nil,
                               with_icon: false,
                               placeholder: "品名を入力",
                               show_label: false,
                               input_class: "h-10 px-3 py-2 rounded-md" %>
                  </div>

                  <div class="col-span-2">
                    <div class="flex items-center gap-2 md:block">
                      <%# NOTE: quantity は number_field かつ今後Stimulus再計算対象のため、text_field パーシャルでは置き換えない %>
                      <span class="text-xs font-bold uppercase tracking-wider text-[#C7C4D8] md:hidden shrink-0">QTY</span>
                      <%= item_form.number_field :quantity,
                                                 class: "w-full px-3 py-2 rounded-md text-center bg-[#0E0E0E] border border-white/10 text-[#E5E2E1]",
                                                 data: {
                                                   action: "input->receipt-form#recalculate",
                                                   receipt_form_target: "quantityInput"
                                                 } %>
                    </div>
                  </div>

                  <div class="col-span-2">
                    <div class="flex items-center gap-2 md:block">
                      <%# NOTE: price は number_field かつ今後Stimulus再計算対象のため、text_field パーシャルでは置き換えない %>
                      <span class="text-sm font-bold text-[#C7C4D8] md:hidden shrink-0">¥</span>
                      <%= item_form.number_field :price,
                                                 class: "w-full px-3 py-2 rounded-md text-right bg-[#0E0E0E] border border-white/10 text-[#E5E2E1]",
                                                 data: {
                                                   action: "input->receipt-form#recalculate",
                                                   receipt_form_target: "priceInput"
                                                 } %>
                    </div>
                  </div>

                  <div class="hidden md:block col-span-2 text-right text-[#E5E2E1] font-medium" data-receipt-form-target="lineTotalDisplay">
                    ¥0
                  </div>

                  <div class="col-span-1 flex justify-end md:static absolute top-3 right-3 z-10">
                    <button type="button"
                            class="p-2 hover:text-[#FFB4AB] transition-colors"
                            data-action="click->receipt-form#removeItem">
                      <span class="material-symbols-outlined">delete</span>
                    </button>
                  </div>

                  <%= item_form.hidden_field :line_total, value: 0, data: { receipt_form_target: "lineTotalInput" } %>
                  <%= item_form.hidden_field :needs_review, value: false %>
                </div>
              <% end %>
            </template>
          </div>
        <% end %>

        <%= render "shared/ui/surface_card", class: "p-6" do %>
          <%= render "shared/ui/section_header",
                title: "メモ",
                icon: "notes",
                class: "mb-4" %>

          <%= render "shared/ui/textarea_field",
                     f: f,
                     attribute: :memo,
                     label: "メモ",
                     placeholder: "用途や補足があれば入力してください",
                     show_label: false,
                     rows: 4,
                     textarea_class: "h-32" %>
        <% end %>
      </div>

      <div class="lg:col-span-4 space-y-8">
        <%= render "shared/ui/amount_summary_card",
              title: "Total Amount",
              amount: total_amount_value,
              icon: "payments",
              subtotal: (subtotal_amount_value.present? ? "¥#{number_with_delimiter(subtotal_amount_value)}" : "未設定"),
              tax_amount: (tax_amount_value.present? ? "¥#{number_with_delimiter(tax_amount_value)}" : "未設定"),
              tax_rate: tax_rate_value %>

        <%# TODO: 未設定値を他の値から自動計算する計算システムを実装予定 %>

        <%= render "shared/ui/receipt_image_card",
              receipt: receipt,
              title: "画像プレビュー",
              form_builder: f,
              show_toggle: true,
              show_upload: true,
              show_modal: true,
              initially_open: true,
              manual_mode: (@mode == "manual"),
              empty_message: "画像を選択してください",
              helper_text: "対応フォーマット:\nJPG / PNG / BMP / TIFF / HEIF / HEIC",
              accept: receipt_image_accept %>
      </div>
    </div>

  </section>
<% end %>
