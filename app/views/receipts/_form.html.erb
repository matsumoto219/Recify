<% form_dom_id = receipt.persisted? ? "edit_receipt_form_#{receipt.public_id}" : "new_receipt_form" %>
<%= form_with model: receipt,
              html: {
                id: form_dom_id,
                data: {
                  controller: "receipt-form",
                  "receipt-form-next-index-value": receipt.receipt_items.size,
                  "receipt-form-rounding-mode-value": "floor",
                  "receipt-form-delete-confirmation-enabled-value": current_user.delete_confirmation_enabled,
                  "receipt-form-delete-confirmation-message-value": t("receipts.form.delete_item_confirm"),
                  "receipt-form-receipt-tax-basis-value": receipt.receipt_tax_basis_for_form,
                  "receipt-form-subtotal-label-value": t("receipts.item_fields.subtotal"),
                  "receipt-form-unset-label-value": t("receipts.common.not_available"),
                  "receipt-form-multiple-tax-rates-label-value": t("receipts.common.multiple_tax_rates"),
                  "receipt-form-decimal-quantity-units-value": ReceiptItem::DECIMAL_QUANTITY_UNITS.join(","),
                  "receipt-form-integer-quantity-step-value": "1",
                  "receipt-form-decimal-quantity-step-value": "0.001"
                }
              } do |f| %>

  <% page_title = receipt.persisted? ? t("receipts.form.titles.edit") : t("receipts.form.titles.new") %>
  <% page_description = receipt.persisted? ? t("receipts.form.descriptions.edit") : t("receipts.form.descriptions.new") %>
  <% cancel_path = receipt.persisted? ? receipt_path(receipt) : receipts_path %>
  <% from_index = receipt.persisted? && params[:from].to_s == "index" %>
  <% breadcrumb_label = receipt.persisted? ? (from_index ? t("receipts.form.breadcrumbs.index") : t("receipts.form.breadcrumbs.show")) : nil %>
  <% breadcrumb_path = receipt.persisted? ? (from_index ? receipts_path : receipt_path(receipt)) : nil %>
  <% total_amount_value = receipt.total_amount %>
  <% subtotal_amount_value = receipt.subtotal_amount %>
  <% tax_amount_value = receipt.tax_amount %>

  <%# TODO: error_flags生成ロジックはViewからロジックを排除するため将来的に model または presenter（例 receipt.error_flags）へ移動する %>
  <%# TODO: Viewからロジックを排除するためmodel等に寄せられる内容を整理する %>

  <%
    item_tax_rates = receipt.receipt_items.filter_map(&:tax_rate).uniq
    tax_rate_summary = if item_tax_rates.empty?
                         nil
                       elsif item_tax_rates.one?
                         "#{number_with_precision(item_tax_rates.first * 100, precision: 1, strip_insignificant_zeros: true)}%"
                       else
                         t("receipts.common.multiple_tax_rates")
                       end

    receipt_review_reason_codes = Array(receipt.review_reasons).map(&:to_s)
    receipt_review_reason_includes = ->(*codes) { (receipt_review_reason_codes & codes.map(&:to_s)).any? }
    error_flags = {
      store_name: receipt_review_reason_includes.call("store_name_missing", "store_name_uncertain"),
      payment_method: receipt_review_reason_includes.call("payment_method_missing", "payment_method_uncertain"),
      purchased_at: receipt_review_reason_includes.call("purchased_at_missing", "purchased_at_uncertain", "purchased_at_conflicted") || receipt.errors[:purchased_at].any?,
      store_address: receipt_review_reason_includes.call("store_address_missing", "store_address_uncertain"),
      store_phone_number: receipt_review_reason_includes.call("store_phone_number_missing", "store_phone_number_uncertain")
    }
  %>
  <% content_for :mobile_bottom_actions do %>
    <%= render "shared/ui/actions/button",
          label: t("receipts.form.buttons.save"),
          type: "submit",
          form: form_dom_id,
          full_width: true,
          radius: :xl,
          class: "py-3" %>
  <% end %>

  <section class="w-full min-w-0 max-w-7xl mx-auto px-0 md:px-4 py-2 md:pb-2">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
      <%= render "shared/ui/layout/section_header",
            title: page_title,
            subtitle: page_description,
            title_size: "text-3xl md:text-4xl",
            breadcrumb_label: breadcrumb_label,
            breadcrumb_path: breadcrumb_path %>

      <div class="hidden md:flex items-center gap-3">
        <%= render "shared/ui/actions/button",
              as: :link,
              href: cancel_path,
              label: t("receipts.form.buttons.cancel"),
              variant: :secondary,
              size: :compact,
              radius: :xl %>

        <%= render "shared/ui/actions/button",
              label: t("receipts.form.buttons.save"),
              type: "submit",
              size: :compact,
              radius: :xl,
              class: "px-10" %>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <div class="lg:col-span-8 space-y-6 min-w-0">
        <% if receipt.has_processing_error? %>
          <%= render "receipts/processing_error_card", receipt: receipt %>
        <% end %>

        <% if receipt.has_blocking_review_notes? %>
          <%= render "receipts/review_notes_card",
                receipt: receipt,
                description: t("receipts.form.review.blocking_description") %>
        <% end %>

        <% if receipt.has_warning_notes? %>
          <%= render "receipts/warning_notes_card",
                receipt: receipt,
                description: t("receipts.form.review.warning_description") %>
        <% end %>

        <%= render "shared/ui/layout/surface_card", padding: :md do %>
          <%= render "shared/ui/layout/section_header",
                title: t("receipts.form.sections.basic_info"),
                icon: "info",
                class: "mb-6" %>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <%= render "shared/ui/form/text_field",
                       f: f,
                       attribute: :store_name,
                       label: t("receipts.form.fields.store_name"),
                       icon: "storefront",
                       placeholder: t("receipts.form.fields.store_name_placeholder"),
                       highlight_variant: (error_flags[:store_name] ? :error : nil),
                       size: :regular,
                       html_options: { maxlength: 100, autocomplete: "organization" } %>

            <%= render "shared/ui/form/select_field",
                       f: f,
                       attribute: :payment_method,
                       label: t("receipts.form.fields.payment_method"),
                       options: Receipt.payment_method_options,
                       selected: f.object.payment_method,
                       include_blank: t("receipts.form.fields.payment_method_blank"),
                       highlight_variant: (error_flags[:payment_method] ? :error : nil),
                       size: :regular %>

            <%= render "shared/ui/form/datetime_field",
                       name: "receipt[purchased_on]",
                       id: "receipt_purchased_on",
                       label: t("receipts.form.fields.purchased_on"),
                       type: :date,
                       value: receipt.purchased_at&.in_time_zone&.to_date,
                       icon: "calendar_today",
                       highlight_variant: (error_flags[:purchased_at] ? :error : nil),
                       error_message: receipt.errors.full_messages_for(:purchased_at).first,
                       size: :regular %>

            <%= render "shared/ui/form/datetime_field",
                       name: "receipt[purchased_time]",
                       id: "receipt_purchased_time",
                       label: t("receipts.form.fields.purchased_time"),
                       type: :time,
                       value: receipt.purchased_at&.in_time_zone&.strftime("%H:%M"),
                       icon: "schedule",
                       highlight_variant: (error_flags[:purchased_at] ? :error : nil),
                       size: :regular %>

            <div class="md:col-span-2">
              <%= render "shared/ui/form/text_field",
                         f: f,
                         attribute: :store_phone_number,
                         label: t("receipts.form.fields.store_phone_number"),
                         value: receipt.display_store_phone_number,
                         icon: "call",
                         field_type: :telephone_field,
                         placeholder: t("receipts.form.fields.store_phone_number_placeholder"),
                         highlight_variant: (error_flags[:store_phone_number] ? :error : nil),
                         size: :regular,
                         html_options: {
                           inputmode: "tel",
                           pattern: "[0-9\\-]*",
                           maxlength: 20,
                           autocomplete: "tel"
                         } %>
            </div>

            <div class="md:col-span-2">
              <%= render "shared/ui/form/text_field",
                         f: f,
                         attribute: :store_address,
                         label: t("receipts.form.fields.store_address"),
                         icon: "location_on",
                         placeholder: t("receipts.form.fields.store_address_placeholder"),
                         highlight_variant: (error_flags[:store_address] ? :error : nil),
                         size: :regular,
                         html_options: { maxlength: 255, autocomplete: "street-address" } %>
            </div>
          </div>
        <% end %>

        <%= render "shared/ui/layout/surface_card", class: "overflow-hidden" do %>
          <div class="p-6 border-b token-border-soft">
            <%= render "shared/ui/layout/section_header",
                  title: t("receipts.form.sections.items"),
                  icon: "receipt_long" %>
          </div>

          <div class="p-6 space-y-4" data-receipt-form-target="itemsContainer">
            <div class="hidden md:grid grid-cols-12 gap-4 px-2 text-xs font-bold uppercase tracking-wider token-text-muted">
              <%# NOTE: labels are short, no change needed but reserved for future %>
              <div class="col-span-6"><%= t("receipts.form.item_columns.name") %></div>
              <div class="col-span-2"><%= t("receipts.form.item_columns.quantity") %></div>
              <div class="col-span-2"><%= t("receipts.form.item_columns.unit_price") %></div>
              <div class="col-span-1"><%= t("receipts.form.item_columns.details") %></div>
              <div class="col-span-1"></div>
            </div>

            <% if receipt.receipt_items.any? %>
              <%= f.fields_for :receipt_items do |item_form| %>
                <%= render "receipts/receipt_item_fields",
                      item_form: item_form,
                      item: item_form.object,
                      new_record: false %>
              <% end %>
            <% end %>

            <button type="button"
                    data-action="click->receipt-form#addItem"
                    class="w-full mt-4 cursor-pointer py-3 border-2 border-dashed token-border-strong rounded-xl token-text-muted token-hover-text-brand token-hover-border-brand transition-all flex items-center justify-center gap-2 font-medium">
              <span class="material-symbols-outlined">add_circle</span>
              <%= t("receipts.form.buttons.add_item") %>
            </button>

            <template data-receipt-form-target="template">
              <%= f.fields_for :receipt_items, ReceiptItem.new, child_index: "NEW_RECORD" do |item_form| %>
                <%= render "receipts/receipt_item_fields",
                      item_form: item_form,
                      item: item_form.object,
                      new_record: true %>
              <% end %>
            </template>
          </div>
        <% end %>

        <%= render "shared/ui/layout/surface_card", padding: :md do %>
          <%= render "shared/ui/layout/section_header",
                title: t("receipts.form.sections.memo"),
                icon: "notes",
                class: "mb-4" %>

          <%= render "shared/ui/form/textarea_field",
                     f: f,
                     attribute: :memo,
                     label: t("receipts.form.fields.memo"),
                     placeholder: t("receipts.form.fields.memo_placeholder"),
                     show_label: false,
                     rows: 4,
                     size: :tall,
                     html_options: { maxlength: 1000 } %>
        <% end %>
      </div>

      <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-24 self-start">
        <%= render "shared/ui/card/amount_summary_card",
              title: t("receipts.common.total_amount_title"),
              amount: total_amount_value,
              icon: "payments",
              subtotal: subtotal_amount_value,
              tax_amount: tax_amount_value,
              tax_rate: receipt.tax_rate,
              tax_rate_summary: tax_rate_summary,
              subtotal_target: "subtotalAmount",
              tax_amount_target: "taxAmount",
              tax_rate_target: "taxRateSummary" %>

        <%= render "shared/ui/card/receipt_image_card",
              receipt: receipt,
              title: t("receipts.form.image.title"),
              form_builder: f,
              show_toggle: true,
              show_upload: true,
              show_modal: true,
              empty_message: t("receipts.form.image.empty"),
              helper_text: t("receipts.form.image.helper"),
              accept: receipt_image_accept,
              storage_usage: current_user.storage_usage %>
      </div>
    </div>

  </section>
<% end %>
