<%= form_with model: receipt do |f| %>
  <%= render "shared/error_messages", obj: receipt %>

  <div>
    <%= f.label :store_name %>
    <%= f.text_field :store_name %>
  </div>

  <div>
    <%= f.label :purchased_at %>
    <%= f.datetime_local_field :purchased_at %>
  </div>

  <div>
    <%= f.label :total_amount %>
    <%= f.number_field :total_amount %>
  </div>

  <div>
    <%= f.label :payment_method %>
    <%= f.select :payment_method,
                 options_for_select(Receipt.payment_method_options, f.object.payment_method),
                 include_blank: "選択してください" %>
  </div>

  <div>
    <%= f.label :memo %>
    <%= f.text_area :memo %>
  </div>

  <div>
    <%= f.label :image %>
    <%= f.file_field :image %>
  </div>

  <h2>明細</h2>

  <%= f.fields_for :receipt_items do |item_form| %>
    <div style="border: 1px solid #ccc; padding: 10px; margin-bottom: 10px;">
      <p>OCR原文: <%= item_form.object.raw_text %></p>
      <p>AI候補: <%= item_form.object.suggested_name %></p>

      <div>
        <%= item_form.label :confirmed_name %>
        <%= item_form.text_field :confirmed_name %>
      </div>

      <div>
        <%= item_form.label :category %>
        <%= item_form.select :category,
                             options_for_select(ReceiptItem.category_options, item_form.object.category),
                             include_blank: "選択してください" %>
      </div>

      <div>
        <%= item_form.label :price %>
        <%= item_form.number_field :price %>
      </div>

      <div>
        <%= item_form.label :quantity %>
        <%= item_form.number_field :quantity %>
      </div>

      <div>
        <%= item_form.label :line_total %>
        <%= item_form.number_field :line_total %>
      </div>

      <div>
        <%= item_form.label :needs_review %>
        <%= item_form.check_box :needs_review %>
      </div>
    </div>
  <% end %>

  <div>
    <%= f.submit %>
  </div>
<% end %>
