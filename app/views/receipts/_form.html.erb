<%#
  レシート作成・編集フォーム

  必須:
  - receipt: 作成または編集するレシートオブジェクト

  任意:
  - なし
%>

<% form_presenter = local_assigns[:presenter] || @receipt_form_presenter || ReceiptFormPresenter.new(receipt: receipt) %>
<% form_dom_id = form_presenter.form_dom_id %>
<% visible_receipt_items = form_presenter.visible_receipt_items %>
<% destroyed_receipt_items = form_presenter.destroyed_receipt_items %>
<% visible_receipt_adjustments = form_presenter.visible_receipt_adjustments %>
<% destroyed_receipt_adjustments = form_presenter.destroyed_receipt_adjustments %>
<% visible_receipt_payments = form_presenter.visible_receipt_payments %>
<% destroyed_receipt_payments = form_presenter.destroyed_receipt_payments %>
<%= form_with model: receipt,
              html: {
                id: form_dom_id,
                data: {
                  controller: "receipt-form",
                  "receipt-form-next-index-value": form_presenter.next_item_index,
                  "receipt-form-next-adjustment-index-value": form_presenter.next_adjustment_index,
                  "receipt-form-next-payment-index-value": form_presenter.next_payment_index,
                  "receipt-form-rounding-mode-value": current_user.tax_rounding_mode,
                  "receipt-form-discount-rounding-mode-value": current_user.discount_rounding_mode,
                  "receipt-form-delete-confirmation-enabled-value": current_user.delete_confirmation_enabled,
                  "receipt-form-delete-confirmation-message-value": t("receipts.form.delete_item_confirm"),
                  "receipt-form-delete-adjustment-confirmation-message-value": t("receipts.form.delete_adjustment_confirm"),
                  "receipt-form-delete-payment-confirmation-message-value": t("receipts.form.delete_payment_confirm"),
                  "receipt-form-delete-confirm-title-value": t("receipts.form.delete_confirm_title"),
                  "receipt-form-delete-confirm-label-value": t("common.delete"),
                  "receipt-form-delete-confirm-backdrop-value": "plain",
                  "receipt-form-receipt-tax-basis-value": receipt.receipt_tax_basis_for_form,
                  "receipt-form-subtotal-label-value": t("receipts.item_fields.subtotal"),
                  "receipt-form-unset-label-value": t("receipts.common.not_available"),
                  "receipt-form-multiple-tax-rates-label-value": t("receipts.common.multiple_tax_rates"),
                  "receipt-form-adjustment-payment-kinds-value": form_presenter.adjustment_payment_kinds_value,
                  "receipt-form-adjustment-surcharge-kinds-value": form_presenter.adjustment_surcharge_kinds_value,
                  "receipt-form-adjustment-discount-kinds-value": form_presenter.adjustment_discount_kinds_value,
                  "receipt-form-adjustment-surcharge-label-value": t("enums.receipt_adjustment.sign.surcharge"),
                  "receipt-form-adjustment-discount-label-value": t("enums.receipt_adjustment.sign.discount"),
                  "receipt-form-countable-quantity-units-value": form_presenter.countable_quantity_units_value,
                  "receipt-form-decimal-quantity-units-value": form_presenter.decimal_quantity_units_value,
                  "receipt-form-default-quantity-unit-value": form_presenter.default_quantity_unit_value,
                  "receipt-form-integer-quantity-step-value": form_presenter.integer_quantity_step_value,
                  "receipt-form-decimal-quantity-step-value": form_presenter.decimal_quantity_step_value,
                  "receipt-form-receipt-total-amount-max-value": ReceiptAmountLimits.receipt_total_amount_max,
                  "receipt-form-receipt-item-price-max-value": ReceiptAmountLimits.receipt_item_price_max,
                  "receipt-form-receipt-item-line-total-max-value": ReceiptAmountLimits.receipt_item_line_total_max,
                  "receipt-form-receipt-tax-amount-max-value": ReceiptAmountLimits.receipt_tax_amount_max,
                  "receipt-form-receipt-adjustment-amount-max-value": ReceiptAmountLimits.receipt_adjustment_amount_max,
                  "receipt-form-receipt-payment-amount-max-value": ReceiptAmountLimits.receipt_payment_amount_max,
                  "receipt-form-review-item-target-prefix-value": ReceiptsHelper::RECEIPT_REVIEW_TARGET_ITEM_ID_PREFIX,
                  "receipt-form-review-items-target-value": ReceiptsHelper::RECEIPT_REVIEW_TARGET_ITEMS
                }
              } do |f| %>

  <%= f.hidden_field :lock_version if receipt.persisted? %>

  <% page_title = receipt.persisted? ? t("receipts.form.titles.edit") : t("receipts.form.titles.new") %>
  <% page_description = receipt.persisted? ? t("receipts.form.descriptions.edit") : t("receipts.form.descriptions.new") %>
  <% cancel_path = receipt.persisted? ? receipt_path(receipt) : receipts_path %>
  <% from_index = receipt.persisted? && params[:from].to_s == "index" %>
  <% breadcrumb_label = receipt.persisted? ? (from_index ? t("receipts.form.breadcrumbs.index") : t("receipts.form.breadcrumbs.show")) : nil %>
  <% breadcrumb_path = receipt.persisted? ? (from_index ? receipts_path : receipt_path(receipt)) : nil %>
  <% total_amount_value = receipt.total_amount %>
  <% subtotal_amount_value = receipt.subtotal_amount %>
  <% tax_amount_value = receipt.tax_amount %>
  <% payment_adjustment_summary = receipt_payment_adjustment_summary(receipt) %>
  <% payment_reconciliation_final_total = payment_adjustment_summary&.final_payment_total || total_amount_value.to_i %>
  <% payment_amount_sum_value = visible_receipt_payments.sum { |payment| payment.amount.to_i } %>
  <% payment_difference_value = payment_amount_sum_value - payment_reconciliation_final_total.to_i %>
  <% payment_mismatch_visible = visible_receipt_payments.any? && payment_difference_value != 0 %>

  <%
    tax_rate_summary = receipt_tax_rate_summary(receipt, items: visible_receipt_items)
    error_flags = form_presenter.error_flags
  %>
  <% content_for :mobile_bottom_actions do %>
    <%= render "shared/ui/actions/button",
          label: t("receipts.form.buttons.save"),
          type: "submit",
          form: form_dom_id,
          full_width: true,
          radius: :xl,
          class: "py-3" %>
  <% end %>

  <section class="w-full min-w-0 max-w-7xl mx-auto px-0 md:px-4 py-2 md:pb-2">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
      <%= render "shared/ui/layout/section_header",
            title: page_title,
            subtitle: page_description,
            title_size: "text-2xl md:text-3xl lg:text-4xl",
            breadcrumb_label: breadcrumb_label,
            breadcrumb_path: breadcrumb_path %>

      <div class="hidden md:flex items-center gap-3">
        <%= render "shared/ui/actions/button",
              as: :link,
              href: cancel_path,
              label: t("receipts.form.buttons.cancel"),
              variant: :secondary,
              size: :compact,
              radius: :xl %>

        <%= render "shared/ui/actions/button",
              label: t("receipts.form.buttons.save"),
              type: "submit",
              size: :compact,
              radius: :xl,
              class: "px-10" %>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <div class="lg:col-span-8 space-y-6 min-w-0">
        <% if receipt.has_processing_error? %>
          <%= render "receipts/processing_error_card", receipt: receipt %>
        <% end %>

        <% if receipt.has_blocking_review_notes? %>
          <%= render "receipts/review_notes_card",
                receipt: receipt,
                description: t("receipts.form.review.blocking_description") %>
        <% end %>

        <% if receipt.has_warning_notes? %>
          <%= render "receipts/warning_notes_card",
                receipt: receipt,
                description: t("receipts.form.review.warning_description") %>
        <% end %>

        <%= render "shared/ui/layout/surface_card",
              id: ReceiptsHelper::RECEIPT_REVIEW_TARGET_BASIC_INFO,
              padding: :md,
              class: "scroll-mt-24" do %>
          <%= render "shared/ui/layout/section_header",
                title: t("receipts.form.sections.basic_info"),
                icon: "info",
                class: "mb-6" %>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <%= render "shared/ui/form/text_field",
                       f: f,
                       attribute: :store_name,
                       label: t("receipts.form.fields.store_name"),
                       icon: "storefront",
                       placeholder: t("receipts.form.fields.store_name_placeholder"),
                       highlight_variant: (error_flags[:store_name] ? :error : nil),
                       size: :regular,
                       html_options: { maxlength: 100, autocomplete: "organization" } %>

            <%= render "shared/ui/form/select_field",
                       f: f,
                       attribute: :payment_method,
                       label: t("receipts.form.fields.payment_method"),
                       options: Receipt.payment_method_options,
                       selected: f.object.payment_method,
                       include_blank: t("receipts.form.fields.payment_method_blank"),
                       highlight_variant: (error_flags[:payment_method] ? :error : nil),
                       size: :regular %>

            <%= render "shared/ui/form/datetime_field",
                       name: "receipt[purchased_on]",
                       id: "receipt_purchased_on",
                       label: t("receipts.form.fields.purchased_on"),
                       type: :date,
                       value: receipt.purchased_at&.in_time_zone&.to_date,
                       icon: "calendar_today",
                       highlight_variant: (error_flags[:purchased_at] ? :error : nil),
                       error_message: receipt.errors.full_messages_for(:purchased_at).first,
                       size: :regular %>

            <%= render "shared/ui/form/datetime_field",
                       name: "receipt[purchased_time]",
                       id: "receipt_purchased_time",
                       label: t("receipts.form.fields.purchased_time"),
                       type: :time,
                       value: receipt.purchased_at&.in_time_zone&.strftime("%H:%M"),
                       icon: "schedule",
                       highlight_variant: (error_flags[:purchased_at] ? :error : nil),
                       size: :regular %>

            <div class="md:col-span-2">
              <%= render "shared/ui/form/text_field",
                         f: f,
                         attribute: :store_phone_number,
                         label: t("receipts.form.fields.store_phone_number"),
                         value: receipt.display_store_phone_number,
                         icon: "call",
                         field_type: :telephone_field,
                         placeholder: t("receipts.form.fields.store_phone_number_placeholder"),
                         highlight_variant: (error_flags[:store_phone_number] ? :error : nil),
                         size: :regular,
                         html_options: {
                           inputmode: "tel",
                           pattern: "[0-9\\-]*",
                           maxlength: 20,
                           autocomplete: "tel"
                         } %>
            </div>

            <div class="md:col-span-2">
              <%= render "shared/ui/form/text_field",
                         f: f,
                         attribute: :store_address,
                         label: t("receipts.form.fields.store_address"),
                         icon: "location_on",
                         placeholder: t("receipts.form.fields.store_address_placeholder"),
                         highlight_variant: (error_flags[:store_address] ? :error : nil),
                         size: :regular,
                         html_options: { maxlength: 255, autocomplete: "street-address" } %>
            </div>
          </div>
        <% end %>

        <%= render "shared/ui/layout/surface_card",
              id: ReceiptsHelper::RECEIPT_REVIEW_TARGET_ITEMS,
              class: "overflow-hidden scroll-mt-24" do %>
          <div class="p-6 border-b token-border-soft">
            <%= render "shared/ui/layout/section_header",
                  title: t("receipts.form.sections.items"),
                  icon: "receipt_long" %>
          </div>

          <div class="p-6 space-y-4" data-receipt-form-target="itemsContainer">
            <div class="hidden md:grid grid-cols-12 gap-4 px-2 text-xs font-bold uppercase tracking-wider token-text-muted">
              <div class="col-span-6"><%= t("receipts.form.item_columns.name") %></div>
              <div class="col-span-2"><%= t("receipts.form.item_columns.quantity") %></div>
              <div class="col-span-2"><%= t("receipts.form.item_columns.unit_price") %></div>
              <div class="col-span-1"><%= t("receipts.form.item_columns.details") %></div>
              <div class="col-span-1"></div>
            </div>

            <% if visible_receipt_items.any? %>
              <%= f.fields_for :receipt_items, visible_receipt_items do |item_form| %>
                <%= render "receipts/receipt_item_fields",
                      item_form: item_form,
                      item: item_form.object,
                      new_record: false,
                      row_state: form_presenter.item_row(item_form.object, new_record: false) %>
              <% end %>
            <% end %>

            <% destroyed_receipt_items.each do |item| %>
              <%= hidden_field_tag "receipt[receipt_items_attributes][destroy_#{item.id}][id]", item.id %>
              <%= hidden_field_tag "receipt[receipt_items_attributes][destroy_#{item.id}][_destroy]", "1" %>
            <% end %>

            <button type="button"
                    data-action="click->receipt-form#addItem"
                    class="ui-touch-control w-full mt-4 cursor-pointer py-3 border-2 border-dashed token-border-strong rounded-xl token-text-muted token-hover-text-brand token-hover-border-brand transition-all flex items-center justify-center gap-2 font-medium">
              <span class="material-symbols-outlined">add_circle</span>
              <%= t("receipts.form.buttons.add_item") %>
            </button>

            <template data-receipt-form-target="template">
              <%= f.fields_for :receipt_items, form_presenter.new_item, child_index: "NEW_RECORD" do |item_form| %>
                <%= render "receipts/receipt_item_fields",
                      item_form: item_form,
                      item: item_form.object,
                      new_record: true,
                      row_state: form_presenter.item_row(item_form.object, new_record: true) %>
              <% end %>
            </template>
          </div>
        <% end %>

        <%= render "shared/ui/layout/surface_card",
              id: ReceiptsHelper::RECEIPT_REVIEW_TARGET_ADJUSTMENTS,
              class: "overflow-hidden scroll-mt-24" do %>
          <div class="p-6 border-b token-border-soft">
            <%= render "shared/ui/layout/section_header",
                  title: t("receipts.form.sections.adjustments"),
                  subtitle: t("receipts.form.adjustments.description"),
                  icon: "price_change" %>
          </div>

          <div class="p-6 space-y-4" data-receipt-form-target="adjustmentsContainer">
            <div class="hidden md:grid grid-cols-12 gap-4 px-2 text-xs font-bold uppercase tracking-wider token-text-muted">
              <div class="col-span-4"><%= t("receipts.adjustment_fields.label") %></div>
              <div class="col-span-3"><%= t("receipts.adjustment_fields.kind") %></div>
              <div class="col-span-3"><%= t("receipts.adjustment_fields.amount") %></div>
              <div class="col-span-1"><%= t("receipts.adjustment_fields.details") %></div>
              <div class="col-span-1"></div>
            </div>

            <% if visible_receipt_adjustments.any? %>
              <%= f.fields_for :receipt_adjustments, visible_receipt_adjustments do |adjustment_form| %>
                <%= render "receipts/receipt_adjustment_fields",
                      adjustment_form: adjustment_form,
                      adjustment: adjustment_form.object,
                      new_record: false,
                      row_state: form_presenter.adjustment_row(adjustment_form.object, new_record: false) %>
              <% end %>
            <% end %>

            <% destroyed_receipt_adjustments.each do |adjustment| %>
              <%= hidden_field_tag "receipt[receipt_adjustments_attributes][destroy_#{adjustment.id}][id]", adjustment.id %>
              <%= hidden_field_tag "receipt[receipt_adjustments_attributes][destroy_#{adjustment.id}][_destroy]", "1" %>
            <% end %>

            <button type="button"
                    data-action="click->receipt-form#addAdjustment"
                    class="ui-touch-control w-full mt-4 cursor-pointer py-3 border-2 border-dashed token-border-strong rounded-xl token-text-muted token-hover-text-brand token-hover-border-brand transition-all flex items-center justify-center gap-2 font-medium">
              <span class="material-symbols-outlined">add_circle</span>
              <%= t("receipts.form.buttons.add_adjustment") %>
            </button>

            <template data-receipt-form-target="adjustmentTemplate">
              <%= f.fields_for :receipt_adjustments, form_presenter.new_adjustment, child_index: "NEW_ADJUSTMENT_RECORD" do |adjustment_form| %>
                <%= render "receipts/receipt_adjustment_fields",
                      adjustment_form: adjustment_form,
                      adjustment: adjustment_form.object,
                      new_record: true,
                      row_state: form_presenter.adjustment_row(adjustment_form.object, new_record: true) %>
              <% end %>
            </template>
          </div>
        <% end %>

        <%= render "shared/ui/layout/surface_card",
              id: ReceiptsHelper::RECEIPT_REVIEW_TARGET_PAYMENTS,
              class: "overflow-hidden scroll-mt-24" do %>
          <div class="p-6 border-b token-border-soft">
            <%= render "shared/ui/layout/section_header",
                  title: t("receipts.form.sections.payments"),
                  subtitle: t("receipts.form.payments.description"),
                  icon: "account_balance_wallet" %>
          </div>

          <div class="p-6 space-y-4">
            <div class="rounded-lg border token-border-soft token-bg-card px-4 py-3 space-y-3">
              <div class="receipt-form-payment-summary grid grid-cols-3 gap-3 text-sm min-w-0"
                   data-receipt-form-target="paymentSummaryGrid">
                <div class="min-w-0 overflow-hidden">
                  <p class="truncate text-xs font-bold uppercase tracking-wider token-text-muted"><%= t("receipts.payment_fields.payment_amount_sum") %></p>
                  <p class="block max-w-full truncate font-bold token-text-base"
                     title="<%= receipt_detail_amount_display(payment_amount_sum_value) %>"
                     data-receipt-form-target="paymentAmountSum"
                     data-amount-value="<%= payment_amount_sum_value %>"><%= receipt_detail_amount_display(payment_amount_sum_value) %></p>
                </div>
                <div class="min-w-0 overflow-hidden">
                  <p class="truncate text-xs font-bold uppercase tracking-wider token-text-muted"><%= t("receipts.payment_fields.final_payment_total") %></p>
                  <p class="block max-w-full truncate font-bold token-text-base"
                     title="<%= receipt_detail_amount_display(payment_reconciliation_final_total) %>"
                     data-receipt-form-target="paymentReconciliationFinalAmount"
                     data-amount-value="<%= payment_reconciliation_final_total %>"><%= receipt_detail_amount_display(payment_reconciliation_final_total) %></p>
                </div>
                <div class="min-w-0 overflow-hidden">
                  <p class="truncate text-xs font-bold uppercase tracking-wider token-text-muted"><%= t("receipts.payment_fields.payment_difference") %></p>
                  <% payment_difference_display = payment_difference_value.zero? ? receipt_detail_amount_display(0) : receipt_signed_amount_display(payment_difference_value) %>
                  <p class="block max-w-full truncate font-bold token-text-base"
                     title="<%= payment_difference_display %>"
                     data-receipt-form-target="paymentDifferenceAmount"
                     data-amount-value="<%= payment_difference_value %>"><%= payment_difference_display %></p>
                </div>
              </div>

              <div class="<%= "hidden" unless payment_mismatch_visible %> rounded-lg border token-border-soft token-bg-warning-soft px-3 py-2 text-sm token-text-base"
                   data-receipt-form-target="paymentMismatchWarning">
                <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:justify-between">
                  <div class="flex items-start gap-2 min-w-0">
                    <span class="material-symbols-outlined text-base shrink-0" aria-hidden="true">warning</span>
                    <span class="min-w-0"><%= t("receipts.payment_fields.mismatch_warning") %></span>
                  </div>
                  <%= render "shared/ui/actions/button",
                        label: t("receipts.payment_fields.sync_to_final"),
                        type: "button",
                        variant: :secondary,
                        size: :sm,
                        weight: :bold,
                        icon: "sync_alt",
                        class: "shrink-0 whitespace-nowrap",
                        data: {
                          action: "click->receipt-form#syncPaymentAmountToFinal",
                          receipt_form_target: "syncPaymentAmountButton"
                        } %>
                </div>
              </div>
            </div>

            <div class="space-y-4" data-receipt-form-target="paymentsContainer">
              <div class="hidden md:grid grid-cols-12 gap-4 px-2 text-xs font-bold uppercase tracking-wider token-text-muted">
                <div class="col-span-6"><%= t("receipts.payment_fields.method") %></div>
                <div class="col-span-5"><%= t("receipts.payment_fields.amount") %></div>
                <div class="col-span-1"></div>
              </div>

              <% if visible_receipt_payments.any? %>
                <%= f.fields_for :receipt_payments, visible_receipt_payments do |payment_form| %>
                  <%= render "receipts/receipt_payment_fields",
                        payment_form: payment_form,
                        payment: payment_form.object,
                        new_record: false,
                        row_state: form_presenter.payment_row(payment_form.object, new_record: false) %>
                <% end %>
              <% end %>

              <% destroyed_receipt_payments.each do |payment| %>
                <%= hidden_field_tag "receipt[receipt_payments_attributes][destroy_#{payment.id}][id]", payment.id %>
                <%= hidden_field_tag "receipt[receipt_payments_attributes][destroy_#{payment.id}][_destroy]", "1" %>
              <% end %>

              <button type="button"
                      data-action="click->receipt-form#addPayment"
                      class="ui-touch-control w-full mt-4 cursor-pointer py-3 border-2 border-dashed token-border-strong rounded-xl token-text-muted token-hover-text-brand token-hover-border-brand transition-all flex items-center justify-center gap-2 font-medium">
                <span class="material-symbols-outlined">add_circle</span>
                <%= t("receipts.form.buttons.add_payment") %>
              </button>

              <template data-receipt-form-target="paymentTemplate">
                <%= f.fields_for :receipt_payments, form_presenter.new_payment, child_index: "NEW_PAYMENT_RECORD" do |payment_form| %>
                  <%= render "receipts/receipt_payment_fields",
                        payment_form: payment_form,
                        payment: payment_form.object,
                        new_record: true,
                        row_state: form_presenter.payment_row(payment_form.object, new_record: true) %>
                <% end %>
              </template>
            </div>
          </div>
        <% end %>

        <%= render "shared/ui/layout/surface_card", padding: :md do %>
          <%= render "shared/ui/layout/section_header",
                title: t("receipts.form.sections.memo"),
                icon: "notes",
                class: "mb-4" %>

          <%= render "shared/ui/form/textarea_field",
                     f: f,
                     attribute: :memo,
                     label: t("receipts.form.fields.memo"),
                     placeholder: t("receipts.form.fields.memo_placeholder"),
                     show_label: false,
                     rows: 4,
                     size: :tall,
                     html_options: { maxlength: 1000 } %>
        <% end %>
      </div>

      <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-24 self-start">
        <div id="<%= ReceiptsHelper::RECEIPT_REVIEW_TARGET_AMOUNT_SUMMARY %>" class="scroll-mt-24">
          <%= render "shared/ui/card/amount_summary_card",
                title: t("receipts.common.total_amount_title"),
                amount: total_amount_value,
                icon: "payments",
                subtotal: subtotal_amount_value,
                tax_amount: tax_amount_value,
                tax_rate: receipt.tax_rate,
                tax_rate_summary: tax_rate_summary,
                payment_adjustment_total: payment_adjustment_summary&.payment_adjustment_total,
                final_payment_total: payment_adjustment_summary&.final_payment_total,
                subtotal_target: "subtotalAmount",
                tax_amount_target: "taxAmount",
                tax_rate_target: "taxRateSummary",
                payment_adjustment_row_target: "paymentAdjustmentRow",
                payment_adjustment_total_target: "paymentAdjustmentAmount",
                final_payment_row_target: "finalPaymentRow",
                final_payment_total_target: "finalPaymentAmount" %>
        </div>

        <div id="<%= ReceiptsHelper::RECEIPT_REVIEW_TARGET_IMAGE_PREVIEW %>" class="scroll-mt-24">
          <%= render "shared/ui/card/receipt_image_card",
                receipt: receipt,
                title: t("receipts.form.image.title"),
                form_builder: f,
                show_toggle: true,
                show_upload: true,
                show_modal: true,
                keep_image_enabled: (receipt.persisted? ? receipt.keep_image? : current_user.effective_keep_receipt_images),
                empty_message: t("receipts.form.image.empty"),
                helper_text: t("receipts.form.image.helper"),
                accept: receipt_image_accept,
                storage_usage: current_user.storage_usage,
                review_target: ReceiptsHelper::RECEIPT_REVIEW_TARGET_IMAGE_PREVIEW %>
