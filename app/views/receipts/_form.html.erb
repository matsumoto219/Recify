<% form_dom_id = receipt.persisted? ? "edit_receipt_form_#{receipt.id}" : "new_receipt_form" %>
<%= form_with model: receipt,
              html: {
                id: form_dom_id,
                data: {
                  controller: "receipt-form",
                  "receipt-form-next-index-value": receipt.receipt_items.size
                }
              } do |f| %>
  <%= render "shared/error_messages", obj: receipt %>

  <% page_title = receipt.persisted? ? "レシート編集" : "レシート登録" %>
  <% page_description = receipt.persisted? ? "内容を確認・修正して保存してください" : "内容を入力して保存してください" %>
  <% cancel_path = receipt.persisted? ? receipt_path(receipt) : receipts_path %>
  <% total_amount_value = receipt.total_amount.to_i %>
  <% subtotal_amount_value = receipt.subtotal_amount %>
  <% tax_amount_value = receipt.tax_amount %>
  <%
    item_tax_rates = receipt.receipt_items.filter_map(&:tax_rate).uniq
    tax_rate_summary = if item_tax_rates.empty?
                         nil
                       elsif item_tax_rates.one?
                         "#{number_with_precision(item_tax_rates.first * 100, precision: 1, strip_insignificant_zeros: true)}%"
                       else
                         "複数税率"
                       end
    tax_rate_value = receipt.tax_rate_percentage_input.present? ? "#{receipt.tax_rate_percentage_input}%" : nil

    receipt_review_reason_codes = Array(receipt.review_reasons).map(&:to_s)
    receipt_review_reason_labels = receipt_review_reason_codes.map do |code|
      I18n.t("enums.receipt_item.review_reason.#{code}", default: code)
    end
    receipt_review_reason_includes = ->(*codes) { (receipt_review_reason_codes & codes.map(&:to_s)).any? }
    review_items = receipt.receipt_items.select(&:needs_review)
    has_review_notes = receipt_review_reason_labels.any? || review_items.any?
  %>
  <% content_for :mobile_bottom_actions do %>
    <%= render "shared/ui/button",
          label: "保存",
          type: "submit",
          form: form_dom_id,
          full_width: true,
          class: "py-3 rounded-xl shadow-lg cursor-pointer" %>
    <%= render "shared/ui/button",
          as: :link,
          href: cancel_path,
          label: "キャンセル",
          variant: :secondary,
          full_width: true,
          class: "py-3 rounded-xl text-center" %>
  <% end %>

  <section class="max-w-7xl mx-auto px-0 md:px-4 py-2 md:pb-2">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
      <%= render "shared/ui/section_header",
            title: page_title,
            subtitle: page_description,
            title_size: "text-3xl md:text-4xl" %>

      <div class="hidden md:flex items-center gap-3">
        <%= render "shared/ui/button",
              as: :link,
              href: cancel_path,
              label: "キャンセル",
              variant: :secondary,
              class: "px-6 py-2.5 rounded-xl" %>

        <%= render "shared/ui/button",
              label: "保存",
              type: "submit",
              class: "px-10 py-2.5 rounded-xl shadow-lg cursor-pointer" %>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-8 space-y-8">
        <% if has_review_notes %>
          <%= render "shared/ui/surface_card", variant: :warning, class: "p-6" do %>
            <div class="flex items-start gap-3">
              <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#FFB4AB]/10 text-[#FFB4AB]">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">error</span>
              </div>

              <div class="min-w-0 flex-1 space-y-4">
                <div>
                  <h3 class="text-base font-bold text-[#FFB4AB]">要確認内容</h3>
                  <p class="mt-1 text-sm text-[#E5E2E1]/80">保存前に以下の内容を確認してください。</p>
                </div>

                <% if receipt_review_reason_labels.any? %>
                  <div class="rounded-lg border border-[#FFB4AB]/20 bg-[#FFB4AB]/5 px-3 py-2">
                    <div class="mb-1 text-xs font-bold text-[#FFB4AB]">レシート全体</div>
                    <ul class="space-y-1 pl-5 text-sm text-[#E5E2E1] list-disc">
                      <% receipt_review_reason_labels.each do |reason| %>
                        <li><%= reason %></li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>

                <% if review_items.any? %>
                  <div class="rounded-lg border border-[#FFB4AB]/20 bg-[#FFB4AB]/5 px-3 py-2">
                    <div class="mb-1 text-xs font-bold text-[#FFB4AB]">明細</div>
                    <ul class="space-y-2 text-sm text-[#E5E2E1]">
                      <% review_items.each do |review_item| %>
                        <% review_item_name = review_item.confirmed_name.presence || review_item.suggested_name.presence || review_item.raw_text.presence || "名称未設定" %>
                        <li>
                          <div class="font-semibold"><%= review_item_name %></div>
                          <% if review_item.review_reason_labels.any? %>
                            <ul class="mt-1 space-y-1 pl-5 text-xs text-[#E5E2E1]/85 list-disc">
                              <% review_item.review_reason_labels.each do |reason| %>
                                <li><%= reason %></li>
                              <% end %>
                            </ul>
                          <% else %>
                            <p class="mt-1 text-xs text-[#E5E2E1]/70">明細内容を確認してください。</p>
                          <% end %>
                        </li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
        <%= render "shared/ui/surface_card", class: "p-6" do %>
          <%= render "shared/ui/section_header",
                title: "基本情報",
                icon: "info",
                class: "mb-6" %>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <%= render "shared/ui/text_field",
                       f: f,
                       attribute: :store_name,
                       label: "店舗名",
                       icon: "storefront",
                       placeholder: "店舗名を入力",
                       highlight_variant: (receipt_review_reason_includes.call("store_name_missing", "store_name_uncertain") ? :error : nil),
                       input_class: "h-11" %>

            <%= render "shared/ui/select_field",
                       f: f,
                       attribute: :payment_method,
                       label: "支払い方法",
                       options: Receipt.payment_method_options,
                       selected: f.object.payment_method,
                       include_blank: "選択してください",
                       highlight_variant: (receipt_review_reason_includes.call("payment_method_missing", "payment_method_uncertain") ? :error : nil) %>

            <%= render "shared/ui/datetime_field",
                       name: "receipt[purchased_on]",
                       id: "receipt_purchased_on",
                       label: "購入日",
                       type: :date,
                       value: receipt.purchased_at&.in_time_zone&.to_date,
                       icon: "calendar_today",
                       highlight_variant: (receipt_review_reason_includes.call("purchased_at_missing", "purchased_at_uncertain", "purchased_at_conflicted") ? :error : nil) %>

            <%= render "shared/ui/datetime_field",
                       name: "receipt[purchased_time]",
                       id: "receipt_purchased_time",
                       label: "時刻",
                       type: :time,
                       value: receipt.purchased_at&.in_time_zone&.strftime("%H:%M"),
                       icon: "schedule",
                       highlight_variant: (receipt_review_reason_includes.call("purchased_at_missing", "purchased_at_uncertain", "purchased_at_conflicted") ? :error : nil) %>

            <div class="md:col-span-2">
              <%= render "shared/ui/text_field",
                         f: f,
                         attribute: :store_address,
                         label: "店舗住所",
                         icon: "location_on",
                         placeholder: "店舗住所を入力",
                         highlight_variant: (receipt_review_reason_includes.call("store_address_missing", "store_address_uncertain") ? :error : nil),
                         input_class: "h-11" %>
            </div>
            <div class="md:col-span-2">
              <%= render "shared/ui/text_field",
                         f: f,
                         attribute: :store_phone_number,
                         label: "電話番号",
                         icon: "call",
                         field_type: :telephone_field,
                         placeholder: "例: 03-1234-5678",
                         highlight_variant: (receipt_review_reason_includes.call("store_phone_number_missing", "store_phone_number_uncertain") ? :error : nil),
                         input_class: "h-11",
                         html_options: {
                           inputmode: "tel",
                           pattern: "[0-9\\-]*"
                         } %>
            </div>
          </div>
        <% end %>

        <%= render "shared/ui/surface_card", class: "overflow-hidden" do %>
          <div class="p-6 border-b border-white/10">
            <%= render "shared/ui/section_header",
                  title: "明細一覧",
                  icon: "receipt_long" %>
          </div>

          <div class="p-6 space-y-4" data-receipt-form-target="itemsContainer">
            <div class="hidden md:grid grid-cols-12 gap-4 px-2 text-xs font-bold uppercase tracking-wider text-[#C7C4D8]">
              <div class="col-span-3">品名</div>
              <div class="col-span-2">カテゴリ</div>
              <div class="col-span-2">数量</div>
              <div class="col-span-2">単価</div>
              <div class="col-span-2">税率</div>
              <div class="col-span-1"></div>
            </div>

            <% if receipt.receipt_items.any? %>
              <%= f.fields_for :receipt_items do |item_form| %>
                <% item = item_form.object %>
                <% item_name = item.confirmed_name.presence || item.suggested_name.presence || item.raw_text.presence || "" %>
                <% item_review_reason_codes = Array(item.review_reasons).map(&:to_s) %>
                <% item_review_reason_includes = ->(*codes) { (item_review_reason_codes & codes.map(&:to_s)).any? } %>

                <div class="grid grid-cols-2 md:grid-cols-12 gap-4 items-center p-3 rounded-lg transition-colors relative <%= item.needs_review ? 'border border-[#FFB4AB]/40 bg-[#2A1719]/70 hover:bg-[#3A2024]/80' : 'bg-[#1C1B1B] hover:bg-[#2A2A2A]' %>"
                     data-receipt-form-target="itemRow"
                     data-action="mouseenter->receipt-form#scheduleLineTotalTooltip mouseleave->receipt-form#hideLineTotalTooltip focusin->receipt-form#hideLineTotalTooltipOnFocus">
                  <div class="col-span-2 md:col-span-3 relative">
                    <div class="flex items-center gap-2 md:block">
                      <span class="text-xs font-bold uppercase tracking-wider text-[#C7C4D8] md:hidden shrink-0">品名</span>
                      <div class="w-full">
                    <%= render "shared/ui/text_field",
                               f: item_form,
                               attribute: :confirmed_name,
                               label: "品名",
                               value: item_name,
                               icon: nil,
                               with_icon: false,
                               placeholder: "品名を入力",
                               show_label: false,
                               highlight_variant: (item.needs_review && item_review_reason_includes.call("item_name_uncertain") ? :error : nil),
                               input_class: "h-10 px-3 py-2 rounded-md" %>
                      </div>
                    </div>
                  </div>

                  <div class="col-span-1 md:col-span-2">
                    <div class="flex items-center gap-2 md:block">
                      <span class="text-xs font-bold uppercase tracking-wider text-[#C7C4D8] md:hidden shrink-0">カテゴリ</span>
                      <%= render "shared/ui/select_field",
                                 f: item_form,
                                 attribute: :category,
                                 label: "カテゴリ",
                                 options: ReceiptItem.category_options,
                                 selected: item.category,
                                 include_blank: "未分類",
                                 show_label: false,
                                 select_wrapper_class: "w-full",
                                 select_class: "h-10 px-3 py-2 rounded-md",
                                 highlight_variant: (item.needs_review && item_review_reason_includes.call("item_category_uncertain") ? :error : nil) %>
                    </div>
                  </div>

                  <div class="col-span-1 md:col-span-2">
                    <div class="flex items-center gap-2 md:block">
                      <span class="text-xs font-bold uppercase tracking-wider text-[#C7C4D8] md:hidden shrink-0">QTY</span>
                      <%= render "shared/ui/number_field",
                                 f: item_form,
                                 attribute: :quantity,
                                 label: "数量",
                                 show_label: false,
                                 text_align: :center,
                                 show_stepper_buttons: true,
                                 stepper_button_class: "md:hidden",
                                 min: 0,
                                 step: 1,
                                 input_class: "h-10 px-3 py-2",
                                 html_options: {
                                   data: {
                                     action: "input->receipt-form#recalculate",
                                     receipt_form_target: "quantityInput"
                                   }
                                 } %>
                    </div>
                  </div>

                  <div class="col-span-1 md:col-span-2">
                    <div class="flex items-center gap-2 md:block">
                      <span class="text-sm font-bold text-[#C7C4D8] md:hidden shrink-0">¥</span>
                      <%= render "shared/ui/number_field",
                                 f: item_form,
                                 attribute: :price,
                                 label: "単価",
                                 show_label: false,
                                 text_align: :right,
                                 input_class: "h-10 px-3 py-2 rounded-md",
                                 html_options: {
                                   data: {
                                     action: "input->receipt-form#recalculate",
                                     receipt_form_target: "priceInput"
                                   }
                                 } %>
                    </div>
                  </div>

                  <div class="col-span-1 md:col-span-2">
                    <div class="flex items-center gap-2 md:block">
                      <span class="text-xs font-bold uppercase tracking-wider text-[#C7C4D8] md:hidden shrink-0">税率</span>
                      <div class="flex-1">
                        <%= render "shared/ui/number_field",
                                   f: item_form,
                                   attribute: :tax_rate,
                                   label: "税率",
                                   value: (item.tax_rate.present? ? item.tax_rate * 100 : nil),
                                   step: 0.1,
                                   min: 0,
                                   max: 100,
                                   suffix: "%",
                                   show_label: false,
                                   text_align: :right,
                                   input_class: "h-10 px-3 py-2 rounded-md",
                                   html_options: {
                                     data: {
                                       action: "input->receipt-form#recalculate",
                                       receipt_form_target: "taxRateInput"
                                     }
                                   },
                                   highlight_variant: (item.needs_review && item_review_reason_includes.call("item_tax_rate_uncertain") ? :error : nil) %>
                      </div>

                      <button type="button"
                              class="md:hidden p-2 hover:text-[#FFB4AB] transition-colors shrink-0"
                              data-action="click->receipt-form#removeItem">
                        <span class="material-symbols-outlined">delete</span>
                      </button>
                    </div>
                  </div>

                  <div class="pointer-events-none absolute right-0 top-full mt-2 z-20 hidden lg:block rounded-lg border border-white/10 bg-[#0E0E0E] px-3 py-1.5 text-sm font-medium text-[#E5E2E1] shadow-lg opacity-0 transition-opacity duration-150" data-receipt-form-target="lineTotalDisplay">
                    小計 ¥<%= number_with_delimiter(item.line_total.to_i) %>
                  </div>

                  <div class="hidden md:flex col-span-1 justify-end">
                    <button type="button"
                            class="p-2 hover:text-[#FFB4AB] transition-colors"
                            data-action="click->receipt-form#removeItem">
                      <span class="material-symbols-outlined">delete</span>
                    </button>
                  </div>

                  <%= item_form.hidden_field :id %>
                  <%= item_form.hidden_field :line_total, data: { receipt_form_target: "lineTotalInput" } %>
                  <%= item_form.hidden_field :needs_review %>
                  <%= item_form.hidden_field :_destroy, value: false, data: { receipt_form_target: "destroyField" } %>
                </div>
              <% end %>
            <% end %>

            <button type="button"
                    data-action="click->receipt-form#addItem"
                    class="w-full mt-4 py-3 border-2 border-dashed border-white/20 rounded-xl text-[#C7C4D8] hover:text-[#C0C1FF] hover:border-[#C0C1FF] transition-all flex items-center justify-center gap-2 font-medium">
              <span class="material-symbols-outlined">add_circle</span>
              明細追加
            </button>

            <template data-receipt-form-target="template">
              <%= f.fields_for :receipt_items, ReceiptItem.new, child_index: "NEW_RECORD" do |item_form| %>
                <div class="grid grid-cols-2 md:grid-cols-12 gap-4 items-center p-3 rounded-lg bg-[#1C1B1B] hover:bg-[#2A2A2A] transition-colors relative"
                     data-receipt-form-target="itemRow"
                     data-action="mouseenter->receipt-form#scheduleLineTotalTooltip mouseleave->receipt-form#hideLineTotalTooltip focusin->receipt-form#hideLineTotalTooltipOnFocus">
                  <div class="col-span-2 md:col-span-3 relative">
                    <div class="flex items-center gap-2 md:block">
                      <span class="text-xs font-bold uppercase tracking-wider text-[#C7C4D8] md:hidden shrink-0">品名</span>
                      <div class="w-full">
                    <%= render "shared/ui/text_field",
                               f: item_form,
                               attribute: :confirmed_name,
                               label: "品名",
                               icon: nil,
                               with_icon: false,
                               placeholder: "品名を入力",
                               show_label: false,
                               input_class: "h-10 px-3 py-2 rounded-md" %>
                      </div>
                    </div>
                  </div>

                  <div class="col-span-1 md:col-span-2">
                    <div class="flex items-center gap-2 md:block">
                      <span class="text-xs font-bold uppercase tracking-wider text-[#C7C4D8] md:hidden shrink-0">カテゴリ</span>
                      <%= render "shared/ui/select_field",
                                 f: item_form,
                                 attribute: :category,
                                 label: "カテゴリ",
                                 options: ReceiptItem.category_options,
                                 selected: nil,
                                 include_blank: "未分類",
                                 show_label: false,
                                 select_wrapper_class: "w-full",
                                 select_class: "h-10 px-3 py-2 rounded-md" %>
                    </div>
                  </div>

                  <div class="col-span-1 md:col-span-2">
                    <div class="flex items-center gap-2 md:block">
                      <span class="text-xs font-bold uppercase tracking-wider text-[#C7C4D8] md:hidden shrink-0">QTY</span>
                      <%= render "shared/ui/number_field",
                                 f: item_form,
                                 attribute: :quantity,
                                 label: "数量",
                                 show_label: false,
                                 text_align: :center,
                                 show_stepper_buttons: true,
                                 stepper_button_class: "md:hidden",
                                 min: 0,
                                 step: 1,
                                 input_class: "h-10 px-3 py-2",
                                 html_options: {
                                   data: {
                                     action: "input->receipt-form#recalculate",
                                     receipt_form_target: "quantityInput"
                                   }
                                 } %>
                    </div>
                  </div>

                  <div class="col-span-1 md:col-span-2">
                    <div class="flex items-center gap-2 md:block">
                      <span class="text-sm font-bold text-[#C7C4D8] md:hidden shrink-0">¥</span>
                      <%= render "shared/ui/number_field",
                                 f: item_form,
                                 attribute: :price,
                                 label: "単価",
                                 show_label: false,
                                 text_align: :right,
                                 input_class: "h-10 px-3 py-2 rounded-md",
                                 html_options: {
                                   data: {
                                     action: "input->receipt-form#recalculate",
                                     receipt_form_target: "priceInput"
                                   }
                                 } %>
                    </div>
                  </div>

                  <div class="col-span-1 md:col-span-2">
                    <div class="flex items-center gap-2 md:block">
                      <span class="text-xs font-bold uppercase tracking-wider text-[#C7C4D8] md:hidden shrink-0">税率</span>
                      <div class="flex-1">
                        <%= render "shared/ui/number_field",
                                   f: item_form,
                                   attribute: :tax_rate,
                                   label: "税率",
                                   step: 0.1,
                                   min: 0,
                                   max: 100,
                                   suffix: "%",
                                   show_label: false,
                                   text_align: :right,
                                   input_class: "h-10 px-3 py-2 rounded-md",
                                   html_options: {
                                     data: {
                                       action: "input->receipt-form#recalculate",
                                       receipt_form_target: "taxRateInput"
                                     }
                                   } %>
                      </div>

                      <button type="button"
                              class="md:hidden p-2 hover:text-[#FFB4AB] transition-colors shrink-0"
                              data-action="click->receipt-form#removeItem">
                        <span class="material-symbols-outlined">delete</span>
                      </button>
                    </div>
                  </div>

                  <div class="pointer-events-none absolute right-0 top-full mt-2 z-20 hidden lg:block rounded-lg border border-white/10 bg-[#0E0E0E] px-3 py-1.5 text-sm font-medium text-[#E5E2E1] shadow-lg opacity-0 transition-opacity duration-150" data-receipt-form-target="lineTotalDisplay">
                    小計 ¥0
                  </div>

                  <div class="hidden md:flex col-span-1 justify-end">
                    <button type="button"
                            class="p-2 hover:text-[#FFB4AB] transition-colors"
                            data-action="click->receipt-form#removeItem">
                      <span class="material-symbols-outlined">delete</span>
                    </button>
                  </div>

                  <%= item_form.hidden_field :line_total, value: 0, data: { receipt_form_target: "lineTotalInput" } %>
                  <%= item_form.hidden_field :needs_review, value: false %>
                </div>
              <% end %>
            </template>
          </div>
        <% end %>

        <%= render "shared/ui/surface_card", class: "p-6" do %>
          <%= render "shared/ui/section_header",
                title: "メモ",
                icon: "notes",
                class: "mb-4" %>

          <%= render "shared/ui/textarea_field",
                     f: f,
                     attribute: :memo,
                     label: "メモ",
                     placeholder: "用途や補足があれば入力してください",
                     show_label: false,
                     rows: 4,
                     textarea_class: "h-32" %>
        <% end %>
      </div>

      <div class="lg:col-span-4 space-y-8 lg:sticky lg:top-24 self-start">
        <%= render "shared/ui/amount_summary_card",
              title: "Total Amount",
              amount: total_amount_value,
              icon: "payments",
              subtotal: (subtotal_amount_value.present? ? "¥#{number_with_delimiter(subtotal_amount_value)}" : "未設定"),
              tax_amount: (tax_amount_value.present? ? "¥#{number_with_delimiter(tax_amount_value)}" : "未設定"),
              tax_rate: tax_rate_value,
              tax_rate_summary: tax_rate_summary,
              subtotal_target: "subtotalAmount",
              tax_amount_target: "taxAmount",
              tax_rate_target: "taxRateSummary" %>

        <%= render "shared/ui/receipt_image_card",
              receipt: receipt,
              title: "画像プレビュー",
              form_builder: f,
              show_toggle: true,
              show_upload: true,
              show_modal: true,
              initially_open: true,
              empty_message: "画像を選択してください",
              helper_text: "対応フォーマット:\nJPG / PNG / BMP / TIFF / HEIF / HEIC",
              accept: receipt_image_accept %>
      </div>
    </div>

  </section>
<% end %>
