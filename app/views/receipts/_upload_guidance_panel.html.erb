<% upload_page = local_assigns.fetch(:upload_page) %>

<%= render "shared/ui/layout/surface_card", padding: :md, class: "space-y-6" do %>
  <section class="space-y-4">
    <h3 class="flex items-center gap-2 text-sm font-bold token-text-base">
      <span class="ui-no-select material-symbols-outlined text-base token-text-brand" aria-hidden="true">account_tree</span>
      <%= t("receipts.new_upload.guidance.flow_title") %>
    </h3>

    <ol class="space-y-3">
      <% t("receipts.new_upload.guidance.flow_steps").each_value.with_index(1) do |label, index| %>
        <li class="flex items-center gap-3">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full token-bg-card-subtle text-xs font-bold token-text-brand">
            <%= index %>
          </span>
          <span class="text-sm token-text-muted"><%= label %></span>
        </li>
      <% end %>
    </ol>
  </section>

  <section class="space-y-3 border-t token-border-soft pt-5">
    <h3 class="flex items-center gap-2 text-sm font-bold token-text-base">
      <span class="ui-no-select material-symbols-outlined text-base token-text-brand" aria-hidden="true">description</span>
      <%= t("receipts.new_upload.guidance.formats_title") %>
    </h3>
    <p class="text-xs leading-relaxed token-text-muted"><%= t("receipts.new_upload.guidance.formats") %></p>
  </section>

  <section class="space-y-3 border-t token-border-soft pt-5">
    <h3 class="flex items-center gap-2 text-sm font-bold token-text-base">
      <span class="ui-no-select material-symbols-outlined text-base token-text-brand" aria-hidden="true">tips_and_updates</span>
      <%= t("receipts.new_upload.guidance.tips_title") %>
    </h3>

    <ul class="space-y-2">
      <% t("receipts.new_upload.guidance.tips").each_value do |tip| %>
        <li class="flex items-start gap-2 text-xs leading-relaxed token-text-muted">
          <span class="ui-no-select material-symbols-outlined mt-0.5 shrink-0 text-[14px] token-text-brand" aria-hidden="true">check_circle</span>
          <span><%= tip %></span>
        </li>
      <% end %>
    </ul>
  </section>

  <section class="space-y-4 border-t token-border-soft pt-5">
    <div class="space-y-1">
      <h3 class="flex items-center gap-2 text-sm font-bold token-text-base">
        <span class="ui-no-select material-symbols-outlined text-base token-text-brand" aria-hidden="true">rule</span>
        <%= t("receipts.new_upload.guidance.limits_title") %>
      </h3>
      <p class="text-xs leading-relaxed token-text-muted"><%= upload_page.multiple_upload_hint %></p>
    </div>

    <%= render "shared/ui/status/storage_usage_meter",
      usage: upload_page.storage_usage,
      compact: true,
      title: t("receipts.new_upload.guidance.storage_title") %>
  </section>

  <section class="border-t token-border-soft pt-5">
    <div class="rounded-xl token-bg-card-subtle p-4">
      <h3 class="text-sm font-bold token-text-base"><%= t("receipts.new_upload.guidance.manual_title") %></h3>
      <p class="mt-1 text-xs leading-relaxed token-text-muted"><%= t("receipts.new_upload.guidance.manual_description") %></p>
      <%= link_to new_receipt_path, class: "mt-3 inline-flex items-center gap-1 text-sm font-bold token-text-brand transition-colors token-hover-text-base" do %>
        <span class="ui-no-select material-symbols-outlined text-base" aria-hidden="true">edit_document</span>
        <%= t("receipts.new_upload.guidance.manual_link") %>
      <% end %>
    </div>
  </section>
<% end %>
