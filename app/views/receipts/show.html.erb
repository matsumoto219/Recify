<section class="w-full min-w-0 max-w-7xl mx-auto px-0 md:px-2 py-2">
  <%
    item_tax_rates = @receipt.receipt_items.filter_map(&:tax_rate).uniq
    tax_rate_summary = if item_tax_rates.empty?
                         nil
                       elsif item_tax_rates.one?
                         "#{number_with_precision(item_tax_rates.first * 100, precision: 1, strip_insignificant_zeros: true)}%"
                       else
                         t("receipts.common.multiple_tax_rates")
                       end
    edit_from = params[:from].to_s == "index" ? "index" : "show"
    has_alert_cards = @receipt.has_processing_error? || @receipt.has_blocking_review_notes? || @receipt.has_warning_notes?
  %>
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
    <%= render "shared/ui/layout/section_header",
          title: t("receipts.show.title"),
          title_size: "text-3xl md:text-4xl",
          breadcrumb_label: t("receipts.show.breadcrumb_index"),
          breadcrumb_path: receipts_path %>

    <div class="flex items-center gap-3">
      <%= form_with url: receipt_path(@receipt),
            method: :delete,
            local: true,
            data: { turbo_confirm: t("common.confirm_delete") },
            class: "contents" do %>
        <%= render "shared/ui/actions/button",
              label: t("common.delete"),
              variant: :secondary,
              size: :compact,
              radius: :xl,
              type: "submit",
              icon: "delete" %>
      <% end %>

      <%= render "shared/ui/actions/button",
            as: :link,
            href: edit_receipt_path(@receipt, from: edit_from),
            label: t("common.edit"),
            icon: "edit",
            size: :compact,
            radius: :xl %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <% if has_alert_cards %>
      <div id="receipt-detail-alerts" class="order-1 md:order-2 lg:order-none lg:col-span-8 min-w-0 space-y-6">
        <% if @receipt.has_processing_error? %>
          <%= render "receipts/processing_error_card",
                receipt: @receipt,
                edit_path: edit_receipt_path(@receipt, from: edit_from) %>
        <% end %>

        <% if @receipt.has_blocking_review_notes? %>
          <%= render "receipts/review_notes_card",
                receipt: @receipt,
                description: t("receipts.show.review_description") %>
        <% end %>

        <% if @receipt.has_warning_notes? %>
          <%= render "receipts/warning_notes_card",
                receipt: @receipt,
                description: t("receipts.show.warning_description") %>
        <% end %>
      </div>
    <% end %>

    <div id="receipt-detail-main" class="order-3 md:order-3 lg:order-none lg:col-span-8 min-w-0 space-y-6">
      <%= render "shared/ui/layout/surface_card", padding: :lg do %>
        <div class="flex justify-between items-start mb-8 gap-4">
          <div class="flex items-center min-w-0">
            <div class="h-14 w-14 token-bg-brand-strong rounded-xl flex items-center justify-center mr-4 shrink-0">
              <span class="material-symbols-outlined token-text-on-brand text-3xl" style="font-size: 32px;">shopping_bag</span>
            </div>
            <div class="min-w-0">
              <p class="text-xs font-bold token-text-brand uppercase tracking-widest mb-1"><%= t("receipts.show.store_information") %></p>
              <h2 class="text-2xl font-bold token-text-base truncate"><%= @receipt.store_name.presence || t("receipts.show.store_name_missing") %></h2>
              <p class="truncate text-sm token-text-muted mt-1" title="<%= @receipt.store_address.presence || t("receipts.show.store_address_missing") %>"><%= @receipt.store_address.presence || t("receipts.show.store_address_missing") %></p>

              <!-- mobile only: ID + status -->
              <div class="flex items-center justify-between mt-2 md:hidden gap-3">
                <p class="text-xs token-text-muted truncate" title="ID: <%= @receipt.display_id %>">ID: <%= @receipt.display_id %></p>
                <%= render "shared/ui/badge/receipt_status_badge",
                      status: @receipt.status,
                      label: @receipt.status_label,
                      size: :md %>
              </div>
            </div>
          </div>

          <div class="hidden md:block text-right shrink-0">
            <%= render "shared/ui/badge/receipt_status_badge",
                  status: @receipt.status,
                  label: @receipt.status_label,
                  size: :md %>
            <p class="truncate text-sm token-text-muted mt-2" title="ID: <%= @receipt.display_id %>">ID: <%= @receipt.display_id %></p>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 py-6 border-y token-border-soft">
          <div>
            <p class="text-xs font-bold token-text-muted uppercase tracking-wider mb-1"><%= t("receipts.show.purchased_at") %></p>
            <p class="font-semibold token-text-base"><%= @receipt.purchased_at ? l(@receipt.purchased_at.to_date, format: :default) : t("receipts.common.unset") %></p>
          </div>

          <div>
            <p class="text-xs font-bold token-text-muted uppercase tracking-wider mb-1"><%= t("receipts.show.purchased_time") %></p>
            <p class="font-semibold token-text-base"><%= @receipt.purchased_at ? l(@receipt.purchased_at, format: :short).split.last : t("receipts.common.unset") %></p>
          </div>

          <div>
            <p class="text-xs font-bold token-text-muted uppercase tracking-wider mb-1"><%= t("receipts.show.payment_method") %></p>
            <p class="font-semibold token-text-base flex items-center min-w-0">
              <span class="material-symbols-outlined text-sm mr-1">payments</span>
              <% payment_method_text = @receipt.payment_method_label.presence || t("receipts.common.unset") %>
              <span class="min-w-0 truncate" title="<%= payment_method_text %>"><%= payment_method_text %></span>
            </p>
          </div>

          <div>
            <p class="text-xs font-bold token-text-muted uppercase tracking-wider mb-1"><%= t("receipts.show.phone_number") %></p>
            <p class="truncate font-semibold token-text-base" title="<%= display_phone_number(@receipt.display_store_phone_number) %>"><%= display_phone_number(@receipt.display_store_phone_number) %></p>
          </div>

          <div>
            <p class="text-xs font-bold token-text-muted uppercase tracking-wider mb-1"><%= t("receipts.show.image_saved") %></p>
            <p class="font-semibold token-text-base"><%= @receipt.image.attached? ? t("receipts.common.yes") : t("receipts.common.no") %></p>
          </div>

          <div>
            <p class="text-xs font-bold token-text-muted uppercase tracking-wider mb-1"><%= t("receipts.show.ocr_completed") %></p>
            <p class="font-semibold token-text-base"><%= @receipt.respond_to?(:ocr_completed_at) && @receipt.ocr_completed_at ? l(@receipt.ocr_completed_at, format: :short) : t("receipts.show.ocr_incomplete") %></p>
          </div>
        </div>

        <div class="mt-8">
          <div class="flex items-center justify-between mb-4 gap-4">
            <h3 class="text-sm font-bold token-text-base"><%= t("receipts.show.items_title") %></h3>
            <span class="text-xs token-text-muted"><%= @receipt.receipt_items.count %><%= t("receipts.common.count_suffix") %></span>
          </div>

          <% if @receipt.receipt_items.any? %>
            <div class="space-y-4">
              <% @receipt.receipt_items.order(:position_index).each do |item| %>
                <div class="flex justify-between items-center py-3 token-hover-bg-card-subtle rounded-lg px-3 transition-colors gap-4">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2">
                      <p class="font-medium token-text-base truncate"><%= item.confirmed_name.presence || item.suggested_name.presence || item.raw_text.presence || t("receipts.show.item_name_missing") %></p>
                      <% if item.needs_review %>
                        <span class="px-2 py-0.5 rounded-full token-state-warning-soft text-[10px] font-bold"><%= t("receipts.show.item_needs_review") %></span>
                      <% end %>
                    </div>
                    <p class="text-xs token-text-muted mt-1 break-words">
                      <span><%= t("receipts.show.item_category") %>: <%= item.category_label.presence || t("receipts.item_fields.uncategorized") %></span>
                      <span class="mx-2">/</span>
                      <span><%= t("receipts.show.item_quantity") %>: <%= item.formatted_quantity_with_unit %></span>
                      <% if item.price.present? %>
                        <span class="mx-2">/</span>
                        <span><%= t("receipts.show.item_unit_price") %>: <%= receipt_detail_amount_display(item.price) %></span>
                      <% end %>
                      <% if (discount_label = receipt_item_discount_label(item)).present? %>
                        <span class="mx-2">/</span>
                        <span><%= discount_label %></span>
                      <% end %>
                    </p>
                  </div>
                  <% line_total_display = receipt_detail_amount_display(item.line_total) %>
                  <p class="font-bold token-text-base shrink-0 truncate" title="<%= line_total_display %>"><%= line_total_display %></p>
                </div>
              <% end %>
            </div>
          <% else %>
            <%# TODO: 明細空状態の本実装
                - 空状態文言を I18n 化
                - 手動登録導線や編集導線を追加する %>
            <div class="rounded-xl border border-dashed token-border-soft p-8 text-center token-text-muted">
              <%= t("receipts.show.item_empty") %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= render "shared/ui/layout/surface_card", padding: :lg do %>
        <div class="flex items-center mb-4">
          <span class="material-symbols-outlined token-text-brand mr-2">notes</span>
          <h3 class="text-sm font-bold token-text-base uppercase tracking-wider"><%= t("receipts.show.memo") %></h3>
        </div>
        <%# TODO: メモ表示の本実装調整
            - 本実装時は文言を I18n 化し、空状態デザインも統一する %>
        <div class="token-text-muted leading-relaxed border-l-4 token-border-brand-soft pl-4 min-h-12 break-words whitespace-pre-wrap"><%= @receipt.memo.presence || t("receipts.show.memo_empty") %></div>
      <% end %>
    </div>

    <div id="receipt-detail-sidebar" class="order-2 md:order-1 lg:order-none lg:col-span-4 lg:col-start-9 lg:row-start-1 lg:row-span-2 flex flex-col gap-6 lg:sticky lg:top-24 self-start">
      <%# TODO: 未設定値を他の値から自動計算する計算システムを実装予定 %>
      <div class="order-first lg:order-none">
        <%= render "shared/ui/card/amount_summary_card",
              title: t("receipts.common.total_amount_title"),
              amount: @receipt.total_amount,
              icon: "payments",
              subtotal: @receipt.subtotal_amount,
              tax_amount: @receipt.tax_amount,
              tax_rate: @receipt.tax_rate,
              tax_rate_summary: tax_rate_summary,
              tax_details: @receipt.receipt_tax_details.order(:rate) %>
      </div>

      <%# TODO: keep_image 設定連動（user設定 or receiptカラム） %>
      <%= render "shared/ui/card/receipt_image_card",
            receipt: @receipt,
            title: t("receipts.show.image_preview"),
            show_toggle: true,
            show_modal: true,
            show_download: true,
            initially_open: true,
            collapse_on_mobile: true,
            keep_image_enabled: true,
            empty_message: t("receipts.show.image_empty") %>
    </div>
  </div>
</section>
