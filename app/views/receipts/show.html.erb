<section class="max-w-7xl mx-auto px-0 md:px-2 py-2">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
    <div>
      <nav class="flex items-center text-sm text-[#C7C4D8] mb-2 space-x-2">
        <%= link_to receipts_path, class: "hover:text-[#C0C1FF] transition-colors" do %>
          レシート一覧
        <% end %>
        <span class="material-symbols-outlined text-xs">chevron_right</span>
        <span class="text-[#C0C1FF] font-medium"><%= t(".title") %></span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-white"><%= t(".title") %></h1>
    </div>

    <div class="flex items-center gap-3">
      <%= link_to receipt_path(@receipt),
        data: { turbo_method: :delete, turbo_confirm: t("common.confirm_delete") },
        class: "px-6 py-2.5 rounded-lg bg-[#353534] text-[#E5E2E1] font-semibold hover:bg-[#393939] transition-all active:scale-95 flex items-center border border-white/10" do %>
        <span class="material-symbols-outlined mr-2 text-sm">delete</span>
        <span><%= t("common.delete") %></span>
      <% end %>

      <%= link_to edit_receipt_path(@receipt),
        class: "px-6 py-2.5 rounded-lg bg-gradient-to-br from-[#C0C1FF] to-[#4B4DD8] text-black font-semibold shadow-lg shadow-[#C0C1FF]/10 hover:opacity-90 transition-all active:scale-95 flex items-center" do %>
        <span class="material-symbols-outlined mr-2 text-sm">edit</span>
        <span><%= t("common.edit") %></span>
      <% end %>
    </div>
  </div>

  <% status_classes = case @receipt.status.to_s
     when "completed"
       "bg-[#22C55E]/10 text-[#4ADE80]"
     when "processing"
       "bg-[#C0C1FF]/10 text-[#C0C1FF]"
     when "review_needed"
       "bg-[#FFB695]/10 text-[#FFB695]"
     when "failed"
       "bg-[#FFB4AB]/10 text-[#FFB4AB]"
     else
       "bg-white/5 text-[#C7C4D8]"
     end %>

  <div class="grid grid-cols-1 xl:grid-cols-12 gap-6">
    <div class="xl:col-span-8 space-y-6">
      <div class="bg-[#201F1F] rounded-xl p-8 shadow-2xl border border-white/5">
        <div class="flex justify-between items-start mb-8 gap-4">
          <div class="flex items-center min-w-0">
            <div class="h-14 w-14 bg-[#4B4DD8] rounded-xl flex items-center justify-center mr-4 shrink-0">
              <span class="material-symbols-outlined text-white text-3xl" style="font-size: 32px;">shopping_bag</span>
            </div>
            <div class="min-w-0">
              <p class="text-xs font-bold text-[#C0C1FF] uppercase tracking-widest mb-1">Store Information</p>
              <h2 class="text-2xl font-bold text-white truncate"><%= @receipt.store_name.presence || "店舗名なし" %></h2>
              <%# TODO: 店舗住所の本実装
                  - receipts.store_address カラム追加後は respond_to? ガードを外す
                  - OCR / AI解析結果から住所候補を保存
                  - 未取得時のみ「未登録」を表示する %>
              <p class="text-sm text-[#C7C4D8] mt-1"><%= @receipt.respond_to?(:store_address) ? (@receipt.store_address.presence || "住所未登録（ダミー）") : "住所未登録（ダミー）" %></p>
            </div>
          </div>

          <div class="text-right shrink-0">
            <span class="px-3 py-1 rounded-full text-xs font-bold <%= status_classes %>"><%= @receipt.status_label %></span>
            <p class="text-sm text-[#C7C4D8] mt-2">ID: #RCP-<%= @receipt.id.to_s.rjust(6, "0") %></p>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 py-6 border-y border-white/10">
          <div>
            <p class="text-xs font-bold text-[#C7C4D8] uppercase tracking-wider mb-1"><%= t(".purchased_at") %></p>
            <p class="font-semibold text-white"><%= @receipt.purchased_at ? l(@receipt.purchased_at.to_date, format: :default) : "未設定" %></p>
          </div>

          <div>
            <p class="text-xs font-bold text-[#C7C4D8] uppercase tracking-wider mb-1">時刻</p>
            <p class="font-semibold text-white"><%= @receipt.purchased_at ? l(@receipt.purchased_at, format: :short).split.last : "未設定" %></p>
          </div>

          <div>
            <p class="text-xs font-bold text-[#C7C4D8] uppercase tracking-wider mb-1"><%= t(".payment_method") %></p>
            <p class="font-semibold text-white flex items-center">
              <span class="material-symbols-outlined text-sm mr-1">payments</span>
              <%= @receipt.payment_method_label %>
            </p>
          </div>

          <div>
            <p class="text-xs font-bold text-[#C7C4D8] uppercase tracking-wider mb-1">電話番号</p>
            <%# TODO: 店舗電話番号の本実装
                - receipts.store_phone_number カラム追加後は respond_to? ガードを外す
                - OCR / AI解析結果から電話番号候補を保存
                - 未取得時のみ「未登録」を表示する %>
            <p class="font-semibold text-white"><%= @receipt.respond_to?(:store_phone_number) ? (@receipt.store_phone_number.presence || "未登録（ダミー）") : "未登録（ダミー）" %></p>
          </div>

          <div>
            <p class="text-xs font-bold text-[#C7C4D8] uppercase tracking-wider mb-1">画像保存</p>
            <p class="font-semibold text-white"><%= @receipt.image.attached? ? "あり" : "なし" %></p>
          </div>

          <div>
            <p class="text-xs font-bold text-[#C7C4D8] uppercase tracking-wider mb-1">OCR完了</p>
            <%# TODO: OCR完了日時の本実装
                - receipts.ocr_completed_at を実際の解析完了時に保存
                - 非同期解析完了後に show / index の両方へ反映
                - 未解析時のみ「未完了」を表示する %>
            <p class="font-semibold text-white"><%= @receipt.respond_to?(:ocr_completed_at) && @receipt.ocr_completed_at ? l(@receipt.ocr_completed_at, format: :short) : "未完了（ダミー）" %></p>
          </div>
        </div>

        <div class="mt-8">
          <div class="flex items-center justify-between mb-4 gap-4">
            <h3 class="text-sm font-bold text-white">明細一覧</h3>
            <span class="text-xs text-[#C7C4D8]"><%= @receipt.receipt_items.count %>件</span>
          </div>

          <% if @receipt.receipt_items.any? %>
            <div class="space-y-4">
              <% @receipt.receipt_items.order(:position_index).each do |item| %>
                <div class="flex justify-between items-center py-3 hover:bg-[#1C1B1B] rounded-lg px-3 transition-colors gap-4">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2">
                      <p class="font-medium text-[#E5E2E1] truncate"><%= item.confirmed_name.presence || item.suggested_name.presence || item.raw_text.presence || "商品名なし" %></p>
                      <% if item.needs_review %>
                        <span class="px-2 py-0.5 rounded-full bg-[#FFB695]/10 text-[#FFB695] text-[10px] font-bold">要確認</span>
                      <% end %>
                    </div>
                    <p class="text-xs text-[#C7C4D8] mt-1">
                      <span>カテゴリ: <%= item.category_label %></span>
                      <span class="mx-2">/</span>
                      <span>数量: <%= item.quantity.presence || 1 %></span>
                      <% if item.price.present? %>
                        <span class="mx-2">/</span>
                        <span>単価: ¥<%= number_with_delimiter(item.price) %></span>
                      <% end %>
                    </p>
                  </div>
                  <p class="font-bold text-white shrink-0">¥<%= number_with_delimiter(item.line_total.to_i) %></p>
                </div>
              <% end %>
            </div>
          <% else %>
            <%# TODO: 明細空状態の本実装
                - 空状態文言を I18n 化
                - 手動登録導線や編集導線を追加する %>
            <div class="rounded-xl border border-dashed border-white/10 p-8 text-center text-[#C7C4D8]">
              明細はまだありません
            </div>
          <% end %>
        </div>
      </div>

      <div class="bg-[#201F1F] rounded-xl p-8 border border-white/5">
        <div class="flex items-center mb-4">
          <span class="material-symbols-outlined text-[#C0C1FF] mr-2">notes</span>
          <h3 class="text-sm font-bold text-white uppercase tracking-wider"><%= t(".memo") %></h3>
        </div>
        <%# TODO: メモ表示の本実装調整
            - 現在は空メモ時のダミー文言を表示
            - 本実装時は文言を I18n 化し、空状態デザインも統一する %>
        <p class="text-[#C7C4D8] leading-relaxed border-l-4 border-[#C0C1FF]/40 pl-4 min-h-12">
          <%= @receipt.memo.presence || "メモはありません（ダミー表示）" %>
        </p>
      </div>
    </div>

    <div class="xl:col-span-4 space-y-6">
      <div class="bg-gradient-to-br from-[#4B4DD8] to-[#2F2EBE] rounded-xl p-8 text-white shadow-2xl shadow-indigo-900/20 relative overflow-hidden">
        <div class="absolute -right-4 -top-4 opacity-10">
          <span class="material-symbols-outlined text-9xl" style="font-size: 120px;">payments</span>
        </div>
        <p class="text-xs font-bold uppercase tracking-widest opacity-80 mb-2">Total Amount</p>
        <h2 class="text-4xl font-black mb-6 truncate" title="<%= number_with_delimiter(@receipt.total_amount.to_i) %>">¥<%= number_with_delimiter(@receipt.total_amount.to_i) %></h2>
        <div class="space-y-3 pt-6 border-t border-white/20">
          <div class="flex justify-between text-sm">
            <span class="opacity-70">税抜金額</span>
            <%# TODO: 税抜金額の本実装
                - receipts.subtotal_amount カラム追加後は respond_to? ガードを外す
                - OCR / AI解析結果または合計・税額から算出して保存
                - 未取得時は 0 ではなく未設定表示も検討する %>
            <span class="font-medium">¥<%= number_with_delimiter(@receipt.respond_to?(:subtotal_amount) ? @receipt.subtotal_amount.to_i : 0) %></span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="opacity-70">税額</span>
            <%# TODO: 税額の本実装
                - receipts.tax_amount カラム追加後は respond_to? ガードを外す
                - OCR / AI解析結果または税率計算で保存
                - 未取得時は 0 ではなく未設定表示も検討する %>
            <span class="font-medium">¥<%= number_with_delimiter(@receipt.respond_to?(:tax_amount) ? @receipt.tax_amount.to_i : 0) %></span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="opacity-70">税率</span>
            <%# TODO: 税率の本実装
                - receipts.tax_rate カラム追加後は respond_to? ガードを外す
                - OCR / AI解析結果または税額計算から確定
                - 未取得時のみ未設定表示にする %>
            <span class="font-medium"><%= @receipt.respond_to?(:tax_rate) && @receipt.tax_rate.present? ? "#{@receipt.tax_rate}%" : "未設定（ダミー）" %></span>
          </div>
        </div>
      </div>

      <div class="bg-[#201F1F] rounded-xl p-4 shadow-sm border border-white/5">
        <p class="text-xs font-bold text-[#C7C4D8] uppercase tracking-widest mb-3 px-2">Original Scan</p>
        <% if @receipt.image.attached? %>
          <%# TODO: 本実装時はStimulusで開閉制御し、モーダルのズーム表示も追加 %>
          <details class="group" open="false">
            <summary class="list-none cursor-pointer select-none">
              <div class="rounded-lg border border-white/10 bg-[#1C1B1B] px-4 py-3 flex items-center justify-between hover:bg-[#2A2A2A] transition-colors">
                <div>
                  <p class="text-sm font-semibold text-white">画像を表示</p>
                  <p class="text-xs text-[#C7C4D8] mt-1">コンパクト表示で確認できます</p>
                </div>
                <span class="material-symbols-outlined text-[#C0C1FF] transition-transform group-open:rotate-180">expand_more</span>
              </div>
            </summary>

            <div class="mt-4 relative group rounded-lg overflow-hidden bg-black/30 h-48 w-full flex items-center justify-center">
              <%= image_tag @receipt.image, class: "max-w-full max-h-full object-contain grayscale brightness-90 contrast-125 opacity-80 group-hover:opacity-100 transition-opacity" %>
              <div class="absolute inset-0 bg-indigo-900/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center pointer-events-none">
                <span class="material-symbols-outlined text-white text-3xl">zoom_in</span>
              </div>
            </div>
          </details>

          <%# TODO: 本実装時は画像モーダル表示 / ダウンロード制御を追加 %>
          <button type="button" class="w-full mt-4 py-2 text-sm font-bold text-[#C0C1FF] hover:bg-[#1C1B1B] rounded-lg transition-colors flex items-center justify-center">
            <span class="material-symbols-outlined text-sm mr-2">open_in_full</span>
            フル画像表示（ダミー）
          </button>
        <% else %>
          <%# TODO: 画像なし状態の本実装
              - keep_image 設定に応じた表示へ変更
              - 再アップロード導線や「画像を保存しない」説明を追加する %>
          <div class="rounded-lg border border-dashed border-white/10 p-10 text-center text-[#C7C4D8] bg-[#1C1B1B]">
            <span class="material-symbols-outlined text-4xl mb-2">image</span>
            <p>画像なし</p>
          </div>
        <% end %>
      </div>

    </div>
  </div>

  <div class="mt-8 flex justify-start">
    <%= link_to receipts_path, class: "text-[#C7C4D8] hover:text-white transition-colors inline-flex items-center" do %>
      <span class="material-symbols-outlined mr-1 text-base">arrow_back</span>
      <span><%= t("common.back") %></span>
    <% end %>
  </div>
</section>
