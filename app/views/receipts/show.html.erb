<h1><%= t(".title") %></h1>

<p><%= t(".store_name") %>: <%= @receipt.store_name %></p>
<p><%= t(".purchased_at") %>: <%= @receipt.purchased_at %></p>
<p><%= t(".total_amount") %>: <%= @receipt.total_amount %>円</p>
<p><%= t(".payment_method") %>: <%= @receipt.payment_method_label %></p>
<p><%= t(".status") %>: <%= @receipt.status_label %></p>
<p><%= t(".memo") %>: <%= @receipt.memo %></p>

<% if @receipt.image.attached? %>
  <p>画像あり</p>
<% else %>
  <p>画像なし</p>
<% end %>

<h2>明細</h2>

<% if @receipt.receipt_items.any? %>
  <ul>
    <% @receipt.receipt_items.order(:position_index).each do |item| %>
      <li>
        <%= item.confirmed_name %>
        / <%= item.category_label %>
        / <%= item.line_total %>円
        <% if item.needs_review %>
          （要確認）
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>明細はまだありません</p>
<% end %>

<%= link_to t("common.edit"), edit_receipt_path(@receipt) %>
<%= link_to t("common.delete"), receipt_path(@receipt), data: { turbo_method: :delete, turbo_confirm: t("common.confirm_delete") } %>
<%= link_to t("common.back"), receipts_path %>
