<%#
  レシート調整行入力

  必須:
  - adjustment_form: 調整行用の form builder
  - adjustment: 表示・編集する調整行

  任意:
  - new_record: 新規調整行として扱う場合は true。未指定時は false
%>

<%
  row_state = local_assigns.fetch(:row_state)
  new_record = row_state.new_record?
  selected_kind = row_state.selected_kind
  selected_sign = row_state.selected_sign
  other_kind = row_state.other_kind?
  tax_rate_value = row_state.tax_rate_value
%>

<div class="swipe-action rounded-lg"
     data-controller="swipe-action">
  <div class="ui-no-select swipe-action-background md:hidden" aria-hidden="true">
    <button type="button"
            class="ui-touch-control flex w-[88px] shrink-0 cursor-pointer items-center justify-center token-bg-error-soft token-text-error"
            data-action="click->receipt-form#removeAdjustment click->swipe-action#close"
            data-swipe-action-target="action"
            data-swipe-ignore
            tabindex="-1"
            aria-label="<%= t("receipts.adjustment_fields.remove_aria") %>">
      <span class="ui-no-select material-symbols-outlined" aria-hidden="true">delete</span>
    </button>
  </div>

  <div class="swipe-action-foreground"
       data-swipe-action-target="foreground"
       data-action="pointerdown->swipe-action#start pointermove->swipe-action#move pointerup->swipe-action#end pointercancel->swipe-action#cancel">
    <div class="grid grid-cols-2 md:grid-cols-12 gap-4 items-center rounded-lg border border-transparent receipt-form-adjustment-row p-3 transition-colors relative min-w-0"
         data-receipt-form-target="adjustmentRow"
         data-receipt-form-adjustment-effect="<%= row_state.calculation_effect %>"
         data-receipt-form-adjustment-source-payment="<%= row_state.source_text_payment_adjustment? %>"
         data-receipt-form-adjustment-source-non-manual="<%= row_state.source_non_manual? %>">
  <div class="col-span-2 md:col-span-4">
    <div class="flex items-center gap-2 md:block">
      <span class="w-16 whitespace-nowrap text-xs font-bold uppercase tracking-wider token-text-muted md:hidden shrink-0"><%= t("receipts.adjustment_fields.label") %></span>
      <div class="flex-1 min-w-0 md:block">
        <%= render "shared/ui/form/text_field",
                   f: adjustment_form,
                   attribute: :label,
                   label: t("receipts.adjustment_fields.label"),
                   value: row_state.label_value,
                   icon: nil,
                   with_icon: false,
                   placeholder: t("receipts.adjustment_fields.label_placeholder"),
                   show_label: false,
                   size: :dense,
                   html_options: {
                     maxlength: 120,
                     autocomplete: "off",
                     data: { action: "input->receipt-form#adjustmentLabelChanged" }
                   } %>
      </div>

      <button type="button"
              class="ui-touch-control receipt-form-adjustment-mobile-name-toggle flex h-10 w-10 shrink-0 cursor-pointer items-center justify-center rounded-lg border token-border-soft token-bg-input token-text-muted transition-colors md:hidden"
              data-action="click->receipt-form#toggleAdjustmentDetails"
              data-receipt-form-target="adjustmentDetailsToggle"
              aria-expanded="false"
              aria-label="<%= t("receipts.adjustment_fields.details_aria") %>">
        <span class="material-symbols-outlined text-lg transition-transform duration-150" data-receipt-form-target="adjustmentDetailsIcon">expand_more</span>
      </button>
    </div>
  </div>

  <div class="receipt-form-adjustment-mobile-detail receipt-form-adjustment-mobile-detail-field col-span-2 md:col-span-3">
    <div class="receipt-form-adjustment-mobile-detail-divider md:hidden">
      <%= render "shared/ui/layout/section_divider", class: "mb-3" %>
    </div>

    <div class="flex items-center gap-2 md:block">
      <span class="w-16 whitespace-nowrap text-xs font-bold uppercase tracking-wider token-text-muted md:hidden shrink-0"><%= t("receipts.adjustment_fields.kind") %></span>
      <div class="flex-1 min-w-0 md:block">
        <%= render "shared/ui/form/select_field",
                   f: adjustment_form,
                   attribute: :kind,
                   label: t("receipts.adjustment_fields.kind"),
                   options: row_state.kind_options,
                   selected: selected_kind,
                   include_blank: t("receipts.adjustment_fields.kind_blank"),
                   show_label: false,
                   select_wrapper_class: "w-full",
                   size: :dense,
                   html_options: {
                     data: {
                       action: "change->receipt-form#adjustmentKindChanged",
                       receipt_form_target: "adjustmentKindInput"
                     }
                   } %>
      </div>
    </div>
  </div>

  <div class="receipt-form-adjustment-mobile-detail receipt-form-adjustment-mobile-detail-field col-span-2 md:col-span-3">
    <div class="flex items-center gap-2 md:block">
      <span class="w-16 whitespace-nowrap text-xs font-bold uppercase tracking-wider token-text-muted md:hidden shrink-0"><%= t("receipts.adjustment_fields.amount") %></span>
      <div class="flex-1 min-w-0 md:block">
        <%= render "shared/ui/form/number_field",
                   f: adjustment_form,
                   attribute: :amount,
                   label: t("receipts.adjustment_fields.amount"),
                   value: row_state.amount_value,
                   min: 0,
                   max: ReceiptAmountService.receipt_adjustment_amount_max,
                   step: 1,
                   inputmode: :numeric,
                   show_label: false,
                   text_align: :center,
                   show_stepper_buttons: true,
                   stepper_button_class: "md:hidden",
                   size: :dense,
                   html_options: {
                     data: {
                       action: "input->receipt-form#recalculate",
                       receipt_form_target: "adjustmentAmountInput"
                     }
                   } %>
      </div>
    </div>
  </div>

  <div class="hidden md:col-span-1 md:flex md:justify-center">
    <button type="button"
            class="ui-touch-control flex h-10 w-full cursor-pointer items-center justify-center gap-1 rounded-lg border token-border-soft token-bg-input token-text-muted transition-colors md:w-10"
            data-action="click->receipt-form#toggleAdjustmentDetails"
            data-receipt-form-target="adjustmentDetailsToggle"
            aria-expanded="false"
            aria-label="<%= t("receipts.adjustment_fields.details_aria") %>">
      <span class="text-xs font-bold md:sr-only"><%= t("receipts.adjustment_fields.details") %></span>
      <span class="material-symbols-outlined text-lg transition-transform duration-150" data-receipt-form-target="adjustmentDetailsIcon">expand_more</span>
    </button>
  </div>

  <div class="hidden md:col-span-1 md:flex md:justify-end">
    <button type="button"
            class="ui-touch-control flex h-10 w-10 shrink-0 cursor-pointer items-center justify-center rounded-lg receipt-form-delete-button transition-colors"
            data-action="click->receipt-form#removeAdjustment"
            aria-label="<%= t("receipts.adjustment_fields.remove_aria") %>">
      <span class="material-symbols-outlined">delete</span>
    </button>
  </div>

  <div class="col-span-2 md:col-span-12 collapsible-grid" data-receipt-form-target="adjustmentDetailsPanel" aria-hidden="true" inert>
    <div class="collapsible-grid-inner min-w-0">
      <div class="grid grid-cols-2 md:grid-cols-12 gap-4 p-0 md:rounded-lg md:border token-border-default md:p-3">
        <div class="col-span-2 md:col-span-3">
          <div class="space-y-2">
            <p class="text-xs font-bold token-text-muted uppercase tracking-wider"><%= t("receipts.adjustment_fields.tax_rate") %></p>
            <%= render "shared/ui/form/number_field",
                       f: adjustment_form,
                       attribute: :tax_rate,
                       label: t("receipts.adjustment_fields.tax_rate"),
                       value: tax_rate_value,
                       min: 0,
                       max: 100,
                       step: 0.1,
                       decimal_precision: 1,
                       suffix: "%",
                       show_label: false,
                       text_align: :center,
                       show_stepper_buttons: true,
                       stepper_button_class: "md:hidden",
                       size: :dense,
                       html_options: {
                         data: {
                           action: "input->receipt-form#recalculate",
                           receipt_form_target: "adjustmentTaxRateInput"
                         }
                       } %>
          </div>
        </div>

        <div class="col-span-2 md:col-span-4">
          <div class="space-y-2">
            <p class="text-xs font-bold token-text-muted uppercase tracking-wider"><%= t("receipts.adjustment_fields.sign") %></p>

            <%# 種別から加算/減算を自動設定し、合計反映位置はサーバー分類済みeffectで扱う。 %>
            <div data-receipt-form-target="adjustmentSignLabelWrapper"
                 class="<%= row_state.sign_label_wrapper_class %>">
              <span class="inline-flex h-10 w-full items-center justify-center rounded-lg border token-border-soft token-bg-card px-3 text-sm font-bold token-text-muted"
                    data-receipt-form-target="adjustmentSignLabel">
                <%= row_state.sign_label %>
              </span>
            </div>

            <div data-receipt-form-target="adjustmentSignSelectWrapper"
                 class="<%= row_state.sign_select_wrapper_class %>">
              <%= render "shared/ui/form/select_field",
                         f: adjustment_form,
                         attribute: :sign,
                         label: t("receipts.adjustment_fields.sign"),
                         options: row_state.sign_options,
                         selected: selected_sign,
                         include_blank: false,
                         show_label: false,
                         select_wrapper_class: "w-full",
                         size: :dense,
                         html_options: {
                           disabled: row_state.sign_select_disabled?,
                           data: {
                             action: "change->receipt-form#recalculate",
                             receipt_form_target: "adjustmentSignSelect"
                           }
                         } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="receipt-form-adjustment-mobile-summary col-span-2 md:hidden">
    <%= render "shared/ui/layout/section_divider", class: "mb-3" %>

    <div class="flex items-center justify-end">
      <button type="button"
              class="ui-touch-control flex h-10 w-10 shrink-0 cursor-pointer items-center justify-center rounded-lg receipt-form-delete-button transition-colors"
              data-action="click->receipt-form#removeAdjustment"
              aria-label="<%= t("receipts.adjustment_fields.remove_aria") %>">
        <span class="material-symbols-outlined">delete</span>
      </button>
    </div>
  </div>

  <%= adjustment_form.hidden_field :sign,
        value: selected_sign,
        disabled: other_kind,
        data: { receipt_form_target: "adjustmentSignInput" } %>

  <% unless new_record %>
    <%= adjustment_form.hidden_field :id %>
    <%= adjustment_form.hidden_field :_destroy, value: false, data: { receipt_form_target: "adjustmentDestroyField" } %>
  <% end %>
    </div>
  </div>
</div>
