<%
  ocr_state = (@ocr_state || {}).with_indifferent_access[:state].to_s
  ai_state = (@ai_state || {}).with_indifferent_access[:state].to_s
  ocr_down = ocr_state == "down"
  ocr_degraded = ocr_state == "degraded"
  ai_down = ai_state == "down"
  ai_degraded = ai_state == "degraded"
  ocr_available = !ocr_down
%>

<section class="max-w-3xl mx-auto space-y-8 pb-28 md:pb-2">
  <%= render "shared/ui/section_header",
    title: t("receipts.new_upload.title"),
    subtitle: t("receipts.new_upload.subtitle"),
    title_size: "text-2xl",
    align: :center,
    wrapper_class: "space-y-3" %>

  <% if ocr_down || ocr_degraded || ai_down || ai_degraded %>
    <div class="space-y-3">
      <% if ocr_down %>
        <div class="rounded-xl border token-border-soft token-bg-warning-soft px-4 py-3 text-sm token-text-warning">
          <p class="font-bold"><%= t("flash.receipts.ocr_unavailable") %></p>
          <%= link_to t("receipts.new_upload.manual_link"), new_receipt_path, class: "mt-2 inline-flex text-sm font-bold token-text-warning underline" %>
        </div>
      <% elsif ocr_degraded %>
        <div class="rounded-xl border token-border-soft token-bg-warning-soft px-4 py-3 text-sm token-text-warning">
          <%= t("receipts.new_upload.ocr_degraded") %>
        </div>
      <% end %>

      <% if ai_down %>
        <div class="rounded-xl border token-border-soft token-bg-info-soft px-4 py-3 text-sm token-text-base">
          <%= t("receipts.new_upload.ai_down") %>
        </div>
      <% elsif ai_degraded %>
        <div class="rounded-xl border token-border-soft token-bg-info-soft px-4 py-3 text-sm token-text-base">
          <%= t("receipts.new_upload.ai_degraded") %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= render "shared/ui/surface_card", padding: :md, class: "group" do %>
    <%= form_with model: @receipt, url: upload_receipts_path, method: :post, local: true, html: {
          multipart: true,
          data: {
            controller: "receipt-upload",
            action: "submit->receipt-upload#disableSubmit",
            receipt_upload_ocr_available_value: ocr_available,
            receipt_upload_invalid_image_message_value: t("receipts.new_upload.js.invalid_image"),
            receipt_upload_empty_file_message_value: t("receipts.new_upload.js.empty_file")
          }
        } do |form| %>
      <div class="space-y-6">
        <div>
          <p class="block text-sm font-medium token-text-base"><%= t("receipts.new_upload.image_label") %></p>

          <div class="mt-3 relative flex h-[400px] items-center justify-center overflow-hidden rounded-2xl border-2 border-dashed upload-dropzone px-6 py-10 text-center transition-colors"
               data-receipt-upload-target="dropzone"
               data-action="dragenter->receipt-upload#handleDragEnter dragover->receipt-upload#handleDragOver dragleave->receipt-upload#handleDragLeave drop->receipt-upload#handleDrop">
            <div class="flex flex-col items-center gap-4" data-receipt-upload-target="emptyState">
              <span class="material-symbols-outlined text-5xl token-text-brand opacity-80">photo_camera</span>
              <p class="text-base font-medium token-text-base"><%= t("receipts.new_upload.empty_title") %></p>
              <p class="text-xs token-text-muted">JPG, PNG, BMP, TIFF, HEIF, HEIC</p>
            </div>

            <div class="hidden absolute inset-0 h-full w-full" data-receipt-upload-target="previewWrapper">
              <img src="" alt="<%= t("receipts.new_upload.preview_alt") %>" class="h-full w-full object-contain" data-receipt-upload-target="preview">
            </div>

            <div class="pointer-events-none hidden absolute inset-0 z-10 flex flex-col items-center justify-center gap-3 rounded-2xl token-bg-card/90 backdrop-blur-sm" data-receipt-upload-target="dropOverlay">
              <span class="material-symbols-outlined text-5xl token-text-brand">upload_file</span>
              <p class="text-sm font-medium token-text-base"><%= t("receipts.new_upload.drop_here") %></p>
            </div>
          </div>
        </div>

        <section class="flex flex-col gap-4">
          <div class="grid grid-cols-2 gap-4">
            <%= render "shared/ui/button",
              label: t("receipts.new_upload.buttons.camera"),
              variant: :secondary,
              size: :md,
              icon: "camera_alt",
              full_width: true,
              type: "button",
              disabled: ocr_down,
              data: { action: "receipt-upload#openCamera" } %>

            <%= render "shared/ui/button",
              label: t("receipts.new_upload.buttons.library"),
              variant: :secondary,
              size: :md,
              icon: "folder_open",
              full_width: true,
              type: "button",
              disabled: ocr_down,
              data: { action: "receipt-upload#openLibrary" } %>
          </div>

          <p class="text-xs text-center token-text-muted" data-receipt-upload-target="fileName">
            <%= t("receipts.new_upload.file_empty") %>
          </p>

          <%= render "shared/ui/button",
            label: t("receipts.new_upload.buttons.upload"),
            variant: :primary,
            size: :lg,
            type: "submit",
            full_width: true,
            disabled: true,
            disable_with: t("receipts.new_upload.buttons.uploading"),
            icon: "cloud_upload",
            data: { receipt_upload_target: "submitButton" } %>
        </section>

        <%= form.file_field :image,
          accept: "image/*",
          capture: "environment",
          class: "hidden",
          disabled: ocr_down,
          data: { receipt_upload_target: "cameraInput", action: "change->receipt-upload#previewCamera" } %>

        <%= form.file_field :image,
          accept: "image/*",
          class: "hidden",
          disabled: ocr_down,
          data: { receipt_upload_target: "libraryInput", action: "change->receipt-upload#previewLibrary" } %>
      </div>
    <% end %>
  <% end %>

  <footer class="text-center space-y-6">
    <div class="flex items-center justify-center gap-2 text-sm token-text-muted token-bg-card-subtle py-2 px-4 rounded-full w-fit mx-auto">
      <span class="material-symbols-outlined text-sm token-text-brand">info</span>
      <%= t("receipts.new_upload.queued_hint") %>
    </div>

    <%= render "shared/ui/navigation_link",
      path: select_input_method_receipts_path,
      text: t("receipts.new_upload.back"),
      arrow: :left %>
  </footer>
</section>
