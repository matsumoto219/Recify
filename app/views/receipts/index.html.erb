<% content_for :title, t("meta.title_format", title: t("receipts.index.title"), site: t("meta.site_name")) %>

<%= turbo_stream_from [current_user, :receipts] %>
<%
  searching = @query.present?
  refresh_on_terminal = searching || %w[purchased_at_desc purchased_at_asc amount_desc amount_asc store_name updated review_priority].include?(@sort)
  page_header_action_classes = [
    "w-full justify-end md:w-auto md:block",
    searching ? "hidden md:block" : "flex"
  ].join(" ")
%>
<section id="receipts-page-header" class="mb-12 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
  <% if @query.present? %>
    <%= render "shared/ui/layout/section_header",
      title: t("dashboard.index.search_results_title"),
      title_suffix: t("dashboard.count", count: @receipts_count),
      title_suffix_class: "token-brand-soft-bg token-text-brand font-normal",
      subtitle: t("dashboard.index.search_results_subtitle", query: @query),
      title_size: "text-2xl",
      subtitle_size: "text-sm",
      wrapper_class: "mt-1" %>
  <% else %>
    <%= render "shared/ui/layout/section_header",
      title: t(".title"),
      title_suffix: t("dashboard.count", count: @receipts_count),
      title_suffix_class: "token-brand-soft-bg token-text-brand font-normal",
      subtitle: t("dashboard.index.default_subtitle"),
      title_size: "text-2xl",
      subtitle_size: "text-sm",
      wrapper_class: "mt-1" %>
  <% end %>

  <div class="<%= page_header_action_classes %>">
    <%= render "shared/ui/actions/button",
      label: t("dashboard.nav.new_receipt"),
      as: :link,
      href: select_input_method_receipts_path,
      variant: :primary,
      size: :md,
      icon: "add_circle" %>
  </div>
</section>

<div id="receipts-summary">
  <%= render "shared/receipts/summary_cards",
    receipts_count: @receipts_count,
    current_month_total: @current_month_total,
    overall_total: @overall_total,
    processing_count: @processing_count,
    review_needed_count: @review_needed_count,
    failed_count: @failed_count,
    monthly_change_label: @monthly_change_label,
    monthly_change_icon: @monthly_change_icon,
    monthly_change_icon_class: @monthly_change_icon_class,
    dom_id: searching ? "receipts_search_summary" : "receipts_summary",
    hide_on_mobile: searching %>
</div>

<div id="receipt-index-controls">
  <%= render "receipts/index_controls" %>
</div>

<div
  id="receipts-results"
  data-controller="receipt-processing-sync"
  data-receipt-processing-sync-url-value="<%= processing_cards_receipts_path %>"
  data-receipt-processing-sync-interval-value="3000"
  data-receipt-processing-sync-refresh-on-terminal-value="<%= refresh_on_terminal %>">
  <% if @query.blank? && @pagy.page == 1 && @receipt_index_query.default_index_view? %>
    <%= turbo_stream_from [current_user, :receipts, :index_first_page] %>
  <% end %>

  <div id="receipts-list">
    <%= render "receipts/receipts_list",
      receipts: @receipts,
      query: @query %>
  </div>

  <%= render "shared/ui/navigation/pagination",
    pagy: @pagy,
    query_params: @receipt_index_query.pagination_params %>

  <% if @pagy.count.positive? && @pagy.page == @pagy.last %>
    <%= render "shared/ui/layout/section_divider",
      variant: :gradient,
      label: t("common.pagination.end_of_archive"),
      class: "mt-20 mb-8" %>
  <% end %>
</div>
