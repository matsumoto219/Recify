<%= turbo_stream_from [current_user, :receipts] %>
<section id="receipts-page-header" class="mb-12 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
  <% if @query.present? %>
    <%= render "shared/ui/section_header",
      title: "検索結果",
      title_suffix: "#{@receipts_count}件",
      title_suffix_class: "token-brand-soft-bg token-text-brand font-normal",
      subtitle: "「#{@query}」の検索結果です。",
      title_size: "text-2xl",
      subtitle_size: "text-sm",
      wrapper_class: "mt-1" %>
  <% else %>
    <%= render "shared/ui/section_header",
      title: t(".title"),
      title_suffix: "#{@receipts_count}件",
      title_suffix_class: "token-brand-soft-bg token-text-brand font-normal",
      subtitle: "最新のレシートを一覧で確認できます。",
      title_size: "text-2xl",
      subtitle_size: "text-sm",
      wrapper_class: "mt-1" %>
  <% end %>

  <div class="w-full flex justify-end md:w-auto md:block">
    <%= render "shared/ui/button",
      label: "レシート登録",
      as: :link,
      href: select_input_method_receipts_path,
      variant: :primary,
      size: :md,
      icon: "add_circle" %>
  </div>
</section>

<div id="receipts-summary">
  <%= render "shared/receipts/summary_cards",
    receipts_count: @receipts_count,
    current_month_total: @current_month_total,
    overall_total: @overall_total,
    processing_count: @processing_count,
    review_needed_count: @review_needed_count,
    monthly_change_label: @monthly_change_label,
    monthly_change_icon: @monthly_change_icon,
    monthly_change_icon_class: @monthly_change_icon_class %>
</div>

<div id="receipts-list">
  <%= render "receipts/receipts_list",
    receipts: @receipts,
    query: @query %>
</div>

<%= render "shared/ui/section_divider", variant: :gradient, label: "End of Archive", class: "mt-20 mb-8" %>
