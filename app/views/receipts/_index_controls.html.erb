<%#
  レシート一覧コントロール

  必須:
  - sort: 選択中の並び順
  - per_page: 選択中の表示件数
  - count summary: 一覧の総件数と表示範囲

  任意:
  - query: 検索中のキーワード

  NOTE:
  - 並び替え / 表示件数 / 件数表示の処理ロジックは controller / service / helper 側へ寄せる。
%>

<%
  count_summary = receipt_index_count_summary_parts(@receipt_index_count_summary)
  sort_label = t("receipts.index.controls.sort_label")
  per_page_label = t("receipts.index.controls.per_page_label")
  control_icon_class = "material-symbols-outlined shrink-0 text-[20px] token-text-muted"
  control_select_container_class = "min-w-0 flex-1 sm:w-52 sm:flex-none"
  per_page_select_container_class = "min-w-0 flex-1 sm:w-28 sm:flex-none"
  control_select_wrapper_class = "min-w-0"
  control_select_class = "text-sm font-medium cursor-pointer"
%>

<%= render "shared/ui/layout/surface_card",
  padding: :sm,
  surface_variant: :bg_card,
  class: "mb-8" do %>
  <%= form_with url: receipts_path, method: :get, local: true, class: "flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between" do |form| %>
    <% if @query.present? %>
      <%= hidden_field_tag :q, @query %>
    <% end %>

    <div class="flex w-full min-w-0 items-center gap-2 sm:w-auto">
      <span class="<%= control_icon_class %>" aria-hidden="true">sort</span>
      <div class="<%= control_select_container_class %>">
        <%= render "shared/ui/form/select_field",
          f: form,
          attribute: :sort,
          label: sort_label,
          options: receipt_index_sort_options,
          selected: @sort,
          show_label: false,
          with_icon: false,
          size: :dense,
          select_wrapper_class: control_select_wrapper_class,
          select_class: control_select_class,
          html_options: {
            id: "receipts-sort-control",
            onchange: "this.form.requestSubmit()",
            aria: { label: sort_label }
          } %>
      </div>
    </div>

    <div class="flex w-full min-w-0 flex-col items-start gap-2 sm:w-auto sm:flex-row sm:items-center sm:justify-end sm:gap-3">
      <div class="flex w-full min-w-0 items-center gap-2 sm:w-auto">
        <span class="<%= control_icon_class %>" aria-hidden="true">list</span>
        <div class="<%= per_page_select_container_class %>">
          <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :per_page,
            label: per_page_label,
            options: receipt_index_per_page_options,
            selected: @per_page.to_s,
            show_label: false,
            with_icon: false,
            size: :dense,
            select_wrapper_class: control_select_wrapper_class,
            select_class: control_select_class,
            html_options: {
              id: "receipts-per-page-control",
              onchange: "this.form.requestSubmit()",
              aria: { label: per_page_label }
            } %>
        </div>
      </div>

      <p class="flex min-w-0 max-w-full flex-wrap items-center gap-x-1.5 gap-y-1 text-xs leading-relaxed token-text-muted sm:justify-end"
         aria-label="<%= count_summary.full_text %>">
        <span class="whitespace-nowrap"><%= count_summary.total_text %></span>
        <span class="whitespace-nowrap"><%= count_summary.range_text %></span>
      </p>
    </div>
  <% end %>
<% end %>
