<%#
  レシート一覧コントロール

  NOTE:
  - 並び替え / 表示件数の処理ロジックは controller / service 側で正規化する。
%>

<%
  sort_options = [
    [ "新しい順", "newest" ],
    [ "古い順", "oldest" ],
    [ "金額が大きい順", "amount_desc" ],
    [ "金額が小さい順", "amount_asc" ],
    [ "店名順", "store_name" ],
    [ "更新日順", "updated" ],
    [ "要確認優先", "review_priority" ]
  ]

  per_page_options = [
    [ "20件", "20" ],
    [ "50件", "50" ],
    [ "100件", "100" ]
  ]

  control_icon_class = "material-symbols-outlined shrink-0 text-[20px] token-text-muted"
  control_select_wrapper_class = "min-w-0"
  control_select_class = "text-sm font-medium cursor-pointer"
%>

<%= render "shared/ui/layout/surface_card",
  padding: :sm,
  surface_variant: :bg_card,
  class: "mb-8" do %>
  <%= form_with url: receipts_path, method: :get, local: true, class: "flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between" do |form| %>
    <% if @query.present? %>
      <%= hidden_field_tag :q, @query %>
    <% end %>

    <div class="flex w-full min-w-0 items-center gap-2 sm:w-auto">
      <span class="<%= control_icon_class %>" aria-hidden="true">sort</span>
      <div class="min-w-0 flex-1 sm:w-52 sm:flex-none">
        <%= render "shared/ui/form/select_field",
          f: form,
          attribute: :sort,
          label: "並び順",
          options: sort_options,
          selected: @sort,
          show_label: false,
          with_icon: false,
          size: :dense,
          select_wrapper_class: control_select_wrapper_class,
          select_class: control_select_class,
          html_options: {
            id: "receipts-sort-control",
            onchange: "this.form.requestSubmit()",
            aria: { label: "並び順" }
          } %>
      </div>
    </div>

    <div class="flex w-full min-w-0 flex-col gap-3 sm:w-auto sm:flex-row sm:items-center sm:justify-end">
      <div class="flex min-w-0 items-center gap-2">
        <span class="<%= control_icon_class %>" aria-hidden="true">list</span>
        <div class="w-full min-w-0 sm:w-28 sm:flex-none">
          <%= render "shared/ui/form/select_field",
            f: form,
            attribute: :per_page,
            label: "表示件数",
            options: per_page_options,
            selected: @per_page.to_s,
            show_label: false,
            with_icon: false,
            size: :dense,
            select_wrapper_class: control_select_wrapper_class,
            select_class: control_select_class,
            html_options: {
              id: "receipts-per-page-control",
              onchange: "this.form.requestSubmit()",
              aria: { label: "表示件数" }
            } %>
        </div>
      </div>

      <p class="text-xs leading-relaxed token-text-muted sm:whitespace-nowrap">
        全 <%= number_with_delimiter(@receipt_index_count_summary[:total]) %> 件中
        <%= number_with_delimiter(@receipt_index_count_summary[:start]) %>-<%= number_with_delimiter(@receipt_index_count_summary[:finish]) %> 件を表示
      </p>
    </div>
  <% end %>
<% end %>
